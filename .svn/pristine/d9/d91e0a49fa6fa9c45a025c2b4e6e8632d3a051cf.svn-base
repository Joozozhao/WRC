/* pages/activitydata/activitydata.wxss */
.vw-wrap{
  padding: 0 20rpx 150rpx;
}
.member{
  align-items: center;
  display: flex;
  padding: 30rpx 20rpx;
  font-size: 32rpx;
  color: #999;
  border-bottom: 1px solid #f0f0f0;
}
.member .user-infor{
  width: auto;
  display: flex;
  align-items: center;
  padding: 0;
}
.other-infor{
  /* margin-left: 40rpx; */
  color: #999;
}
.member .user-infor image{
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}
.member .user-infor .rank image{
  width: 50rpx;
  height: 50rpx;
}
.member .user-infor .infor{
  display: flex;
  align-items: center;
}
.member .user-infor .infor image{
  width: 25rpx;
  height: 25rpx;
  margin-left: 10rpx;
}
.user-pic{
  position: relative;
}
.user-pic.add-bd .pic{
  border: 3px solid #fcb81d;
}
.user-pic.add-bd1 .pic{
  border: 3px solid #e97376;
}
.user-pic.add-bd2 .pic{
  border: 3px solid #aaaaaa;
}
.member .user-infor .user-pic .vip{
  width: 30rpx;
  height: 30rpx;
  position: absolute;
  right: 20rpx;
  bottom: 0;
}
.member .distance{
  margin-left: auto;
  color: #4ec17e;
}
.member .speed{
  font-size: 26rpx;
}
.member.my-data{
  margin-top: 20rpx;
  background: #4ec17e;
  border: none;
  border-radius: 10rpx;
}
.member.my-data .other-infor,.member.my-data .distance{
  color: #fff;
}
.rank{
  margin-right: 10rpx;
}
.rank-num{
  display: inline-block;
  width: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
}