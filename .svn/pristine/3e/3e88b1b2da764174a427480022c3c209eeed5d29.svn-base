<!--pages/prizelist/prizelist.wxml-->
<radio-group class="radio-group">
  <label wx:for="{{listData}}" wx:key="index" wx:for-item="item">
    <view class="activity" id="{{key}}" data-id="{{item.id}}" data-name="{{item.goods_name}}" data-total="{{item.total}}" bindtap="radioChange" wx:if="{{item.state == 0}}">
      <view class="check-radio">
        <radio value="{{item.id}}" checked="{{item.id == id}}"/>
      </view>
      <view class="cover-img" data-id="{{item.id}}">
        <image src="{{item.goods_pic}}" mode="widthFix" style="height:auto;"></image>
      </view>
      <view class="activity-infor" data-id="{{item.id}}">
        <view class="title">{{item.goods_name}}</view>
        <view>库存：{{item.total}}</view><!-- 原始 -->
      </view>
    </view>
  </label>
</radio-group>
<view class="full-btn">
  <button class="btn btnTwo" bindtap="submit">选择奖品</button>
</view>