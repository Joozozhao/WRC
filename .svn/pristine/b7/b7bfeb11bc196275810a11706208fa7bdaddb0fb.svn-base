// pages/lotterydetail/lottery.js
const util = require('../../utils/util.js')
// 获取应用实例
const app = getApp()
Page({

  /**
   * 页面的初始数据
   */
  data: {
    addr: '',
    ltrId: '',
    getActy: '',
    getGoods: '',
    luckTime: '',
    luckState: '',
    luckId: '',
    lucky: false,
    joinState: 0
  },
  /**
   * 生命周期函数--监听页面加载
   */
  onLoad: function (options) {
    var id = options.id
    this.initCon(id)
    // this.getLuck()
  },
  initCon: function(id){
    var that = this
    var data = { 
      id: id
    }
    util.request('acty/getluckdraw', 'POST', data, '数据加载中 ...', (res)=>{
      if(res.data.success){
        console.log(res.data)
        that.setData({
          goods_num: res.data.data.goods_num,
          getActy: res.data.data.acty_id,
          getGoods: res.data.data.goods_id,
          luckTime: res.data.data.start_time.substring(0,19),
          luckState: res.data.data.state,
          luckId: res.data.data.id
        })
        var userId = app.globalData.userId
        // var userId = 34
        var actyId = that.data.getActy
        // 获取活动详情
        var data = {
          actyId: actyId,
          userId: userId
        }
        console.log(data)
        util.request('acty/getdetail', 'POST', data, '数据加载中 ...', (res)=>{
          console.log(res)
          if(res.data.success){
            var allData = res.data.data
            var createTime = allData.start_timestr.substring(0, 16)
            var endTime = allData.end_timestr.substring(11, 16)
            var createTime1 = util.dislodgeZero(createTime)
            var endTime1 = util.dislodgeZero(endTime)
            var region = allData.region
            allData.start_timestr = createTime1 
            allData.end_timestr = endTime1 
            this.setData({
              acty_img: allData.acty_img,
              state: allData.acty_state,
              acty_name: allData.acty_name,
              acty_type: allData.acty_type,
              start_time: createTime1,
              end_time: endTime1,
              address: allData.address,
              total_num: allData.serial_num,
              distance: allData.distance,
              has_clickon: allData.has_clickon,
              has_sign: allData.has_sign,
              has_name: allData.has_name,
              has_mobile: allData.has_mobile
            })
            if(that.data.state == 0){
              that.setData({
                state: '已结束'
              })
            }
            if(allData.acty_type == '挑战'){
              var area = {'1':'北京','2':'日照','3':'其他地区'}
              var regionArr = region.toString().split(',')
              var newArea = regionArr.map(item=>{
                return area[item]
              })
              var addr = newArea.join(',')
              that.setData({
                addr: addr
              })
            } else {
              that.setData({
                addr: allData.region
              })
            }
          }else{
            that.setData({
              addr: addr
            })
            // wx.showToast({
            //   title: res.data.error,
            //   icon: 'none',
            //   duration: 1500
            // })
          }
        })
        //获取奖品详情
        var data = {
          id: that.data.getGoods
        }
        util.request('goods/get', 'POST', data, '数据加载中...', (res)=>{
          console.log(res.data)
          if(res.data.success){
            that.setData({
              imgSrc: res.data.data.goods_pic,
              goodName: res.data.data.goods_name
            })
          }else{
            wx.showToast({
              title: res.data.error,
              icon: 'none',
              duration: 1500
            })  
          }
          
        })
      } else {
        // wx.showToast({
        //   title: res.data.error,
        //   icon: 'none',
        //   duration: 1500
        // })  
      }
      var data = {
        luck_draw_id:that.data.luckId,
        user_id: 0
      }
      console.log(data)
      util.request('acty/joinLuckDrawList', 'POST', data, '数据加载中 ...', (res)=>{
        if(res.data.success){
          console.log(res.data)
          var luckData = res.data.data
          that.setData({
            luckList: luckData
          })
          for (var index = 0; index < luckData.length; index++) {
            var luckNum = luckData[index].user_id
            var lkState= luckData[index].state
            if(userId == luckNum){
              that.setData({
                joinState: 1
              })
            }
            if(luckNum == userId&&lkState==1){
              that.setData({
                lucky: true
              })
              var data = {
                userId: userId,
                luck_draw_id: that.data.luckId
              }
              console.log(data)
              util.request('user/getusercode','POST',data,'数据加载中 ...',(res)=>{
                if(res.data.success){
                  console.log(res.data)
                  var codeList = res.data.data
                  for(var i=0;i<codeList.length;i++){
                    var id = codeList[i].user_id
                    if(id == userId){
                      that.setData({
                        codeNum:codeList[i].code
                      })
                    }
                  }
                } else {
                  console.log(res)
                  wx.showToast({
                    title: res.data.error,
                    icon: 'none',
                    duration: 1500
                  })
                }
              })
            }
            
          }
        } else {
          // wx.showToast({
          //   title: res.data.error,
          //   icon: 'none',
          //   duration: 1500
          // })  
        }
      })
    })
  },
  // 点击复制功能
  textPaste() {
    var that = this
    wx.navigateTo({
      url: '../prizedetails/prizedetails?id='+that.data.getGoods+'&code='+that.data.codeNum,
    })
    // wx.setClipboardData({
    //   data: that.data.codeNum.toString(),
    //   success: function () {
    //     wx.showToast({
    //       title: '复制成功',
    //     })
    //     wx.getClipboardData({
    //       success: function(res) {
    //         console.log(res.data) // data
            
    //       }
    //     })
    //   }
    // })
  }
})