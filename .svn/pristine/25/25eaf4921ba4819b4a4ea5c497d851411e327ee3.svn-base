/* pages/activitydetail/activitydetail.wxss */
@import "../index/index.wxss";
@import "../activity/activity.wxss";
@import "../member/member.wxss";
.activity.bg-blcak{
  background: #333;
  color: #fff;
}
.box-part-wrap.index-part{
  box-shadow: 0 -3px 5px rgba(0,0,0,.1);
}
.activity.bg-blcak .title{
  color: #fff;
}
.activity-infor .time{
  font-size: 24rpx;
}
.data-wrap{
  padding: 20rpx;
}
.all-data{
  padding: 20rpx;
  background: #f1f1f1;
  margin-bottom: 20rpx;
}
.nor-title{
  font-size: 32rpx;
  color: #333;
  font-weight: 700;
  text-align: left;
}
.data-con{
  display: flex;
  align-items: center;
  text-align: center;
  background: #fff;
  margin: 30rpx 0 10rpx;
  padding: 40rpx 0;
  border-radius: 6rpx;
}
.data-con>view{
  width: 50%;
  border-right: 1px solid #f1f1f1;
}
.data-con>view:nth-last-child(1){
  border: none;
}
.data-con .num{
  font-size: 40rpx;
  font-weight: bold;
}
.infor-con{
  display: flex;
  align-items: center;
  padding: 30rpx 0;
}
.list .item{
  width: 80rpx;
  height: 80rpx;
  background: #fff;
  border: 8rpx solid #fff;
  border-radius: 100rpx;
  float: left;
  margin-left: -20rpx;
}
.list .item image{
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.list .item:nth-child(1){
  margin-left: 0;
}
.total{
  position: relative;
  margin-left: auto;
  padding-right: 40rpx;
}
.total .gray{
  color: #999;
}
.add-arrow image{
  width: 30rpx;
  height: 30rpx;
  position: absolute;
  right: 0;
  top: 50%;
  margin-top: -15rpx;
}
.act-detail{
  color: #999;
  text-align: left;
  padding: 20rpx 0;
  line-height: 1.5;
}
.lottery-list{
  padding: 20rpx 0;
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  line-height: 2;
}
.lottery-list .con-item{
  width: 48%;
  position: relative;
  margin-bottom: 20rpx;
}
.lottery-list .con-item image{
  width: 100%;
  height: 210rpx;
}
.con-item .tag{
  line-height: 40rpx;
  padding: 0 10rpx;
  font-size: 24rpx;
  text-align: center;
}
.con-item .tag.tag1{
  background: #ff787e;
  position: absolute; 
  right: 0;
  top: 30rpx;
}
.con-item .tag.tag2{
  background: #1296db;
  position: absolute; 
  right: 0;
  top: 80rpx;
}
.btn-group{
  display: flex;
  width: 100%;
  box-sizing: border-box;
  position: fixed;
  bottom: 0;
  left: 0;
  z-index: 2;
}
.btn-group .btn{
  width: 50%;
  height: 140rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 32rpx;
  color: #fff;
  border-radius: 0;
  font-weight: normal;
}
.btn-group .btn.green{
  background: linear-gradient(to right, #38ef7d, #11998e);
}
.btn-group .btn.red{
  background: linear-gradient(to right, #ff5e62, #ff9966);
}
.opacity{
  opacity: .7;
}