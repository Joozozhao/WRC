/**index.wxss**/
page{
  background: #fff;
}
.top-part{
  width: 100%;
  height: 200rpx;
  /* background: #4ec17e; */
  background: #333;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 99;
}
.top-part .logo{
  display: block;
  width: 120rpx;
  height: 60rpx;
  margin: 100rpx auto 0;
}
.user-infor{
  display: flex;
  align-items: center;
  width: 100%;
  padding: 20rpx 0;
  color: #fff;
}
.user-pic{
  position: relative;
}
.user-pic.add-bd .pic{
  border: 3px solid #fcb81d;
}
.user-pic.add-bd1 .pic{
  border: 3px solid #e97376;
}
.user-pic.add-bd2 .pic{
  border: 3px solid #aaaaaa;
}
.user-pic .vip{
  width: 40rpx;
  height: 40rpx;
  position: absolute;
  right: 20rpx;
  bottom: 0;
}
.user-name{
  display: flex;
  align-items: center;
  font-size: 32rpx;
}
.user-name .tag{
  background: #fff;
  font-size: 16rpx;
  color: #333;
  padding: 0 15rpx;
  border-radius: 3rpx;
  margin-left: 8rpx;
}
.user-infor .infor{
  font-size: 28rpx;
  margin-top: 10rpx;
  line-height: 40rpx;
}
.user-infor image{
  width: 40rpx;
  height: 40rpx;
  float: left;
}
.check-points{
  padding: 0 10rpx;
  font-size: 32rpx;
  line-height: 94rpx;
  text-align: center;
  color: #4ec17e;
  margin-left: auto;
}
.my-points .ico{
  float: left;
  margin-right: 5rpx;
}
.my-points .ico image{
  width: 40rpx;
  height: 40rpx;
}
.box-part-wrap.index-part{
  background: #fff;
  margin-top: 10rpx;
  color: #333;
}
.box-part-wrap.index-part .box-part{
  display: flex;
  justify-content: space-around;
}
.box-part-wrap.index-part .my-points{
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.box-part-wrap.index-part .my-points.tal{
  margin-top: 10rpx;
  text-align: left;
}
.swiper .wx-swiper-dot{
  background: rgba(255,255,255,.3);
}
.swiper .wx-swiper-dot-active{
  background: #4ec17e;
}
.news-con{
  width: 100%;
  /* margin-top: 20rpx; */
  display: flex;
  justify-content: space-between;
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  line-height: 2;
}
.news-con .con-item{
  width: 48%;
  /* height: 300rpx; */
  position: relative;
}
.bg-wrap{
  width: 100%;
  padding: 0 10rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  background: rgba(0,0,0,.5);
  position: absolute;
  left: 0;
  bottom: 0;
}
.news-con .con-item image{
  width: 100%;
  height: 210rpx;
}
.grid-menu{
  margin-bottom: 20rpx;
}
.flex-wrap{
  width: 100%;
  background: #fff;
  padding: 20rpx 0;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  /* justify-content: center; */
  font-size: 28rpx;
  color: #333;
  text-align: center;
}
.flex-wrap .flex-item{
  width: 33.3333%;
  /* padding: 10rpx 0; */
}
.icon-circle image{
  width: 80rpx;
  margin: 0 auto 30rpx;
  padding-top: 20%;
}
/* 每日打卡 */
.daily-record{
  display: flex;
  align-items: center;
  border-radius: 10rpx;
  box-shadow: 0 0 5px rgba(0,0,0,.1) ;
  margin: 20rpx 0;
  padding: 20rpx;
}
.record{
  font-size: 32rpx;
  line-height: 2;
}
.record .days{
  color: #4ec17e;
  font-size: 26rpx;
}
.record .more{
  color: #999999;
  font-size: 26rpx;
}
.daily-record .record-btn{
  background-color: #4ec17e;
  border-radius: 50rpx;
  font-size: 32rpx;
  line-height: 2;
  color: #fff;
  padding: 0 30rpx;
  margin-left: auto;
}
