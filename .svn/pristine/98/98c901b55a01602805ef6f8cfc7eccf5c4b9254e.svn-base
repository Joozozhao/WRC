<!--pages/mydata/mydata.wxml-->

<view class="vw-wrap bg-green">
  <view class="user-infor">
    <view class="user-pic {{level == 'VIP'?'add-bd':''}}" wx:if="{{level == 'VIP'}}">
      <image src="{{headerImg}}" mode="widthFix" class="pic"></image>
      <image src="../../images/vip_1.svg" mode="cover" class="vip"></image>
    </view>
    <view class="user-pic {{level == '普通'?'add-bd1':''}}" wx:if="{{level == '普通'}}">
      <image src="{{headerImg}}" mode="widthFix" class="pic"></image>
      <image src="../../images/normal.svg" mode="cover" class="vip"></image>
    </view>
    <view class="user-pic {{level == '非会员'?'add-bd2':''}}" wx:if="{{level == '非会员'}}">
      <image src="{{headerImg}}" mode="widthFix" class="pic"></image>
      <image src="../../images/none.svg" mode="cover" class="vip"></image>
    </view>
    <view style="width:50%">
      <view class="infor">
        <view class="user-name" wx:if="{{userName==''}}">{{nickName}}</view>
        <view class="user-name" wx:else>{{userName}}</view>
        <view class="sex" wx:if="{{sex == 1}}"><image src="../../images/man.svg"></image></view>
        <view class="sex" wx:if="{{sex == 2}}"><image src="../../images/woman.svg"></image></view>
      <view class="user-name" style="margin-top:10rpx;"><text class="tag" wx:if="{{duty&&duty!=='团友'}}">{{duty}}</text><text class="tag" wx:if="{{userid>0}}">ID{{userid}}</text></view>
      </view>
      <navigator url="../userinfor/userinfor" hover-class="none"><view class="edit-infor"><image src="../../images/edit.png" style="margin-left:0;" ></image> 完善个人信息</view></navigator>
    </view>
  </view>
  <view class="box-part-wrap index-part">
    <view class="box-part">
      <view class="my-point">
        <!-- <view class="my-points">{{module1.toDecimal2(monthDistance)}} km</view> -->
        <view class="my-points">{{monthDistance}} km</view>
        <view>本月运动公里</view>
      </view>
      <!-- <wxs src="../../utils/toDecimal2.wxs" module="module1" /> -->
      <view class="my-point">
        <!-- <view class="my-points">{{module1.toDecimal2(totalDistance)}} km</view> -->
        <view class="my-points">{{totalDistance}} km</view>
        <view>运动总里程</view>
      </view>
    </view>
  </view>
</view>
<view class="week-data">
  <view class="acty-tit">最近一周</view>
  <view class="vw-wrap">
    <view class="week-con bg-white">
      <view class="echart_panel">
        <ec-canvas ec="{{ecBar}}"></ec-canvas>
      </view>
    </view>
  </view>
</view>
<view class="week-data">
  <view class="acty-tit">我的挑战</view>
  <view class="vw-wrap">
    <view class="data-con bg-blue" style="margin-bottom: 30rpx;">
      <view class="data-header">
        <view class="end-date">2021-12-29</view>
        <view class="wrap-tit">资格项</view>
      </view>
      <view class="icon-bg">
        <image src="/images/complete.svg" mode="widthFix" class="icon"></image>
      </view>
      <view class="data-body">
        <view class="flex-con">
          <view class="pre arrow"><image src="/images/arrow-l.png" mode="widthFix"></image></view>
          <view class="choose-date">2021-12</view>
          <view class="next arrow"><image src="/images/arrow-r.png" mode="widthFix"></image></view>
        </view>
        <view class="flex-con progress-content">
          <view class="progress ad-bdr"><text class="compelte">1</text> / 3 <text class="tit">周次数</text></view>
          <view class="progress"><text class="compelte">20</text> / 120 <text class="tit">公里</text></view>
        </view>
        <view class="flex-con pies-con">
          <view class="pies-wrap">
            <view class="pies-subwrap">
              <view class="echart_panel">
                <ec-canvas ec="{{ecPie1}}"></ec-canvas>
              </view>
            </view>
            <view class="line"></view>
            <view>
              <view>12/6</view>
            </view>
          </view>
          <view class="pies-wrap">
            <view class="pies-subwrap">
              <view class="echart_panel">
                <ec-canvas ec="{{ecPie2}}"></ec-canvas>
              </view>
            </view>
            <view class="line"></view>
            <view>
              <view>12/13</view>
            </view>
          </view>
          <view class="pies-wrap">
            <view class="pies-subwrap">
              <view class="echart_panel">
                <ec-canvas ec="{{ecPie3}}"></ec-canvas>
              </view>
            </view>
            <view class="line"></view>
            <view>
              <view>12/20</view>
            </view>
          </view>
          <view class="pies-wrap">
            <view class="pies-subwrap">
              <view class="echart_panel">
                <ec-canvas ec="{{ecPie4}}"></ec-canvas>
              </view>
            </view>
            <view class="line"></view>
            <view>
              <view>12/27</view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="data-con bg-blue">
      <view class="data-header">
        <view class="end-date">2021-12-31</view>
        <view class="wrap-tit">挑战项</view>
      </view>
      <view class="icon-bg red">
        <image src="/images/cancel.svg" mode="widthFix" class="icon"></image>
      </view>
      <view class="data-body">
        <view class="flex-con">
          <view class="pre arrow"><image src="/images/arrow-l.png" mode="widthFix"></image></view>
          <view class="choose-date">2021-12</view>
          <view class="next arrow"><image src="/images/arrow-r.png" mode="widthFix"></image></view>
        </view>
        <view class="flex-con progress-content">
          <view class="progress ad-bdr"><text class="compelte">1</text> / 3 <text class="tit">周次数</text></view>
          <view class="progress"><text class="compelte">20</text> / 120 <text class="tit">公里</text></view>
        </view>
        <view class="flex-con pies-con">
          <view class="pies-wrap">
            <view class="pies-subwrap">
              <view class="echart_panel">
                <ec-canvas ec="{{ecPie1}}"></ec-canvas>
              </view>
            </view>
            <view class="line"></view>
            <view>
              <view>12/6</view>
            </view>
          </view>
          <view class="pies-wrap">
            <view class="pies-subwrap">
              <view class="echart_panel">
                <ec-canvas ec="{{ecPie2}}"></ec-canvas>
              </view>
            </view>
            <view class="line"></view>
            <view>
              <view>12/13</view>
            </view>
          </view>
          <view class="pies-wrap">
            <view class="pies-subwrap">
              <view class="echart_panel">
                <ec-canvas ec="{{ecPie3}}"></ec-canvas>
              </view>
            </view>
            <view class="line"></view>
            <view>
              <view>12/20</view>
            </view>
          </view>
          <view class="pies-wrap">
            <view class="pies-subwrap">
              <view class="echart_panel">
                <ec-canvas ec="{{ecPie4}}"></ec-canvas>
              </view>
            </view>
            <view class="line"></view>
            <view>
              <view>12/27</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
<view>
  <view class="acty-tit" wx:if="{{userid == userId}}">我的挑战</view>
  <view class="acty-tit" wx:else>TA参加的挑战</view>
  <view class="vw-wrap challenge">
    <scroll-view scroll-x style="width:100%;white-space:nowrap;" bindscrolltolower="loadMore">
      <block wx:for="{{activityList}}" wx:key="index" wx:for-item="item" wx:if="{{item.acty_type=='挑战'}}">
      <view class="activity" id="{{key}}">
        <view class="cover-img" bindtap="toDet" data-id="{{item.id}}" data-type="{{item.acty_type}}">
          <image src="{{item.acty_img}}"></image>
        </view>
      </view>
    </block>
    </scroll-view>
  </view>
  
</view>
<view>
  <view class="acty-tit" wx:if="{{userid == userId}}">我的团跑</view>
  <view class="acty-tit" wx:else>TA参加的团跑</view>
  <view class="vw-wrap activitys">
    <scroll-view scroll-x style="width:100%;white-space:nowrap;" bindscrolltolower="loadMore2">
      <block wx:for="{{activityList}}" wx:key="index" wx:for-item="item" wx:if="{{item.acty_type=='团跑'}}">
      <view class="activity normal-acty" id="{{key}}">
        <view class="cover-img" bindtap="toDet" data-id="{{item.id}}" data-type="{{item.acty_type}}">
          <image src="{{item.acty_img}}"></image>
        </view>
        </view>
      </block>
    </scroll-view>
  </view>
</view>
<!-- <home/> -->