<!--pages/editaddress/editaddress.wxml-->
<!--pages/newaddress/newaddress.wxml-->
<form bindsubmit="onSubmit">
<view class="vw-wrap bg-white new-address">
    <view class="vw-form">
      <view class="fm-tit">联系人</view>
      <view class="fm-con"><input type="text" placeholder="请输入联系人" value="{{name}}" name="name">{{name}}</input></view>
    </view>
    <view class="vw-form">
      <view class="fm-tit">手机号</view>
      <view class="fm-con"><input type="tel" maxlength="11" placeholder="请输入手机号" value="{{mobile}}" name="mobile">{{mobile}}</input></view>
    </view>
    <view class="vw-form">
      <view class="fm-tit">省/市/区</view>
      <view class="fm-con">
        <picker mode="region" bindchange="bindRegionChange" value="{{address}}" custom-item="{{customItem}}"
      name="address" style='font-size:32rpx;color:#999;letter-spacing:2rpx;overflow: hidden;text-overflow: ellipsis;white-space: nowrap;}' >
          <view class="picker {{clas}}" wx:if="{{address == ''}}">请选择</view>
          <input type="text" class="picker {{clas}}" wx:else class="picker {{clas}}" name="address" value="{{address}}" disabled="disabled">{{address}}</input>
        </picker>
      </view>
    </view>
    <view class="vw-form">
      <view class="fm-tit">详细地址</view>
      <view class="fm-con"><input type="text" placeholder="请输入详细地址" value="{{addressDet}}" name="addressDet">{{addressDet}}</input></view>
    </view>
  
</view>
<view class="bg-white full-btn">
  <button class="btn btnOne" form-type="submit">保存</button>
</view>
</form>
<!-- <home /> -->