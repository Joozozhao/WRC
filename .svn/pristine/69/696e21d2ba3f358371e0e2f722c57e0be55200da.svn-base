/* pages/addtype/addtype.wxss */
.add-type{
  width: 100% !important;
  line-height: 80rpx;
  background: #333;
  text-align: center;
  color: #fff;
  border-radius: 0;
  font-weight: normal;
  margin-top: 30rpx;
}
.type-name{
  min-width: 100rpx;
  line-height: 50rpx;
}
.type-item{
  display: flex;
  margin-bottom: 20rpx;
}
.type-item:nth-last-child(1){
  margin-bottom: 0;
}
.tag-desc{
  background: #333;
  color: #fff;
  padding: 0 20rpx;
  line-height: 50rpx;
}
.tag-total{
  display: flex;
}
/*主容器*/  
.stepper {  
  width:200rpx;  
  height: 50rpx;  
  /*给主容器设一个边框*/  
  border: 1rpx solid #333;  
  border-radius: 5rpx;  
  margin:0 20rpx;  
  background: #fff;
}  

/*加号和减号*/  
.stepper .sign {  
  width: 50rpx;  
  line-height: 50rpx;  
  text-align: center;  
  float: left;  
}  

/*数值*/  
.stepper .number {  
  width: 88rpx;  
  height: 50rpx;  
  float: left;  
   margin: 0 auto;   
  text-align: center;  
  font-size: 28rpx;  
  color: #333;
  /*给中间的input设置左右边框即可*/  
  border-left: 1rpx solid #333;  
  border-right: 1rpx solid #333;  
}  

/*普通样式*/  
.stepper .normal{  
  color: black;  
}  
/*禁用样式*/  
.stepper .disabled{  
  color: #ccc;  
}  


.type-con{
  padding: 30rpx;
  position: relative;
}
.type-con .del{
  width: 60rpx;
  height: 60rpx;
  position: absolute;
  top: 10rpx;
  left: 20rpx;
}
.new-type{
  display: flex;
}
.new-type input,.contact-type input{
  width: 80%;
  border: 1px solid #e1e1e1;
  height: 100rpx;
  line-height: 100rpx;
  padding: 20rpx;
  box-sizing: border-box;
}
.new-btn{
  width: 16%;
  line-height: 100rpx;
  background: #333;
  margin-left: auto;
  font-size: 70rpx;
  color: #fff;
  text-align: center;
}
.contact-type{
  display: flex;
  margin-top: 30rpx;
}
.contact-type input{
  width: 48%; 
}
.contact-type input:nth-child(2){
  margin-left: auto;
}
.type-infor{
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 0;
  line-height: 50rpx;
}
.type-infor>view{
  margin-right: 20rpx;
}