<!--pages/lotterydetail/lottery.wxml-->
<view class="bg-white pro-detail">
  <image src="{{imgSrc}}" mode="widthFix" style="width:100%;height:auto;"></image>
  <view class="detail-wrap">
    <view>奖品名称：{{goodName}}</view>
    <view>奖品数量：{{goods_num}} 份</view>
    <view>开奖时间：{{luckTime}}</view>
    <!-- <view class="time">{{luckTime}} 自动开奖</view> -->
  </view>
  
</view>
<view class="activity bg-blcak">
    <view class="cover-img">
      <image src="{{acty_img}}" mode="aspectFill"></image>
      <view class="vw-cover" wx:if="{{state == '已结束'}}">
        <view class="state">{{state}}</view>
      </view>
    </view>
    <!-- <wxs src="../../utils/toPlace.wxs" module="module1" /> -->
    <view class="activity-infor">
      <view class="title">{{acty_name}}</view>
      <view><text class="tag">{{acty_type}}</text><text class="tag org">{{addr}}</text></view>
      <view class="time"><image src="/images/time.png"></image>{{start_time}}-{{end_time}}</view>
      <view class="address"><image src="/images/place.png"></image>{{address}}</view>
    </view>
  </view>



<view class="bg-white hasOrd" wx:if="{{luckState == 1&&joinState==1}}">
  <view class="result-con" wx:if="{{lucky}}">
    <view class="result">恭喜您！已经中奖</view>
    <!-- <view class="prize">{{goodName}}</view> -->
    <view class="prize-code">兑换码 {{codeNum}}<view class="copyNum" bindtap="textPaste">去兑换</view></view>
  </view>
  <view class="result-con" wx:else>
    <view class="result fail">很遗憾，您未中奖</view>
  </view>
</view>
<view class="bg-white hasOrd" wx:if="{{luckState == 1}}">
  <view wx:if="{{luckState==1&&luckList.length>0}}">
    <view class="nor-title">中奖名单</view>
    <view class="person-list">
      <block wx:for="{{luckList}}" wx:key="index" wx:if="{{item.state==1}}">
        <view class="list-item">
          <image src="{{item.header_url}}" class="avastar big"></image>
          <view wx:if="{{item.name==''}}">{{item.nick_name}}</view>
          <view wx:else>{{item.name}}</view>
        </view>
      </block>
    </view>
  </view>
</view>
<view class="bg-white exchange-list" wx:if="{{luckList.length>0}}">
  <view class="tit">{{luckList.length}}人已参与抽奖活动</view>
  <view class="user-list">
    <block wx:for="{{luckList}}" wx:key="index">
      <image src="{{item.header_url}}" class="avastar"></image>
    </block>
  </view>
</view>