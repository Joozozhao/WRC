/* pages/prizedetails/prizedetails.wxss */
.pg-wrap{
  margin-bottom: 150rpx;
}
.exchange-list{
  padding-bottom: 150rpx;
}
.prize-infor{
  padding: 30rpx 40rpx;
}
.prize-infor .need-points{
  display: flex;
  font-size: 32rpx;
  color: #666;
  line-height: 50rpx;
  padding-bottom: 20rpx;
}
.need-points .ico{
  width: 50rpx;
  height: 50rpx;
}
.need-points .points{
  color: #d73021;
  font-size: 40rpx;
  margin-right: 10rpx;
}
.prize-infor .prize-tit{
  font-weight: bold;
}
.page-tit{
  display: flex;
  justify-content: space-around;
  line-height: 60rpx;
  font-size: 36rpx;
}
.main-pic image{
  width: 100%;
}
.page-tit{
  margin: 40rpx 0;
}
.page-tit .line{
  width: 25%;
  height: 1px;
  background: #999;
  margin-top: 31rpx;
}
.prize-details{
  padding: 30rpx 40rpx;
  font-size: 28rpx;
}
.prize-details image{
  margin-bottom: 20rpx;
}
.pop-up{
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,.5);
  position: fixed;
  left: 0;
  top: 0;
  z-index: 3;
}
.isRuleShow{
  display: block;
}
.isRuleHide{
  display: none;
}
.content{
  width: 100%;
  color: #fff;
  text-align: center;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%,-50%);
  z-index: 4;
}
.prize-name{
  font-weight: bold;
  font-size: 42rpx;
  padding: 40rpx 0;
}
.exchange-list .tit{
  text-align: center;
  padding: 20rpx 0;
}
.user-list{
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}
.avastar{
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin: 10rpx;
}
.content .btn{
  width: 35%;
  line-height: 2.5;
  font-size: 28rpx;
  color: #fff;
  border: 1px solid #fff;
  border-radius: 5rpx;
  margin: 0 auto 20rpx;
}
.content .btn.white-btn{
  background: #fff;
  color: #333;
}
.btm-btn .btn{
  line-height: 90rpx;
}