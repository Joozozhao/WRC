/* pages/challengedetail/challengedetail.wxss */
@import "../challenge/challenge.wxss";
/* @import "../activitydetail/activitydetail.wxss"; */
page{
  padding-bottom: 150rpx;
}
.my-img{
  background: rgba(83,119,128,.5);
  border-radius: 0 50% 50% 0;
  padding-left: 40rpx;
  position: fixed;
  left: 0;
  top: 30rpx;
  z-index: 4;
}
.my-img .img-wrap{
  padding: 5rpx;
  background: #537780;
  border-radius: 50%;
  animation: headRotate 6s linear infinite;
}
/* 头像旋转效果  */
@keyframes headRotate{
  0% {transform: rotate(0deg);}
  50% {transform: rotate(180deg);}
  100% {transform: rotate(360deg);}
}
.my-img .img-wrap image{
  width: 100rpx;
  border-radius: 50%;
}
.acty-infor{
  background: rgba(255,255,255,.1);
  padding: 50rpx 0;
  font-size: 24rpx;
  color: #fff;
  text-align: center;
  margin-bottom: 30rpx;
}
.acty-infor .title{
  font-size: 32rpx;
}
.acty-infor .sub-tit{
  color: #fffcca;
}
.acty-infor .my-dis{
  display: flex;
  justify-content: center;
  align-items: baseline;
  /* margin: 30rpx 0; */
  font-weight: blod;
  font-size: 60rpx;
}
.acty-infor .dis{
  font-size: 120rpx;
  color: #f00;
}
.score-con{
  font-size: 32rpx;
}
.acty-infor .my-score{
  font-size: 120rpx;
  color: #38ef7d;
}
.circle-con{
  display: flex;
  justify-content: center;
  position: relative;
}
.circle-con .circleTxt{
  width: 100%;
  font-size: 28rpx;
  color: #4ec17e;
  text-align: center;
  position: absolute;
  left: 0;
  top: 56%;
}
.normal-wrap{
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 30rpx 20rpx;
  background: rgba(255,255,255,.1);
  font-size: 24rpx;
  color: #fffcca;
  margin-bottom: 30rpx;
}
.rules .title{
  font-size: 32rpx;
  margin-bottom: 10rpx;
}
.actyin-list{
  display: flex;
  align-items: center;
}
.acty-ava{
  width: 80%;
  display: flex;
}
.acty-ava .image{
  width: 80rpx;
  height: 80rpx;
  min-height: 80rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 100rpx;
  float: left;
  margin-left: 20rpx;
}
.acty-ava .image:nth-child(1) {
  margin-left: 0;
}
.acty-ava .image image{
  width: 100%;
  height: 100%;
}
.acty-in{
  text-align: right;
  margin-left: auto;
}
.circle-wrap{
  text-align: center;
}
.circle-wrap .content{
  padding: 10rpx 0 20rpx;
  background: none;
}
.data-wrap{
  padding: 20rpx;
}
.nor-title{
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
  text-align: left;
}
.lottery-list{
  padding: 20rpx 0;
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  line-height: 2;
  margin-bottom: 140rpx;
}
.lottery-list .con-item{
  width: 48%;
  position: relative;
  margin-bottom: 20rpx;
}
.lottery-list .con-item image{
  width: 100%;
  height: 210rpx;
}
.con-item .tag{
  line-height: 40rpx;
  padding: 0 10rpx;
  font-size: 24rpx;
  text-align: center;
}
.con-item .tag.tag1{
  background: #ff787e;
  position: absolute; 
  right: 0;
  top: 30rpx;
}
.con-item .tag.tag2{
  background: #1296db;
  position: absolute; 
  right: 0;
  top: 80rpx;
}
.new-data{
  border: 1px solid #e1e1e1;
  margin: 30rpx 0;
  line-height: 100rpx;
  height: 100rpx;
  font-size: 32rpx;
  color: #333;
  text-align: center;
}
/* .rules-con{
  max-height: 200rpx;
  overflow-y: scroll;
} */
.icon-state{
  text-align: center;
  padding-top: 20rpx;
}
.icon-state image{
  display: inline-block;
  width: 200rpx;
}
.acty-infor.show-time{
  padding: 40rpx 30rpx;
  font-size:32rpx;
  display: flex;
  flex-wrap: wrap;
  text-align: left;
}
.acty-infor.show-time>view{
  width: 50%;
}
.acty-infor.show-time .time-tit{
  font-size: 24rpx;
  color: #fffcca;
}