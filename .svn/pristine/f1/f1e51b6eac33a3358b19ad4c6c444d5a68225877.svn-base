/* pages/confirmorder/confirmorder.wxss */
@import "../../pages/prizedetails/prizedetails.wxss";
.address{
  font-size: 32rpx;
  line-height: 1.5;
  margin-bottom: 20rpx;
  padding: 20rpx 40rpx;
}
.choose-address{
  display: flex;
  padding-bottom: 20rpx;
  line-height: 2;
}
.wechat-btn{
  font-size: 28rpx;
  padding: 0 20rpx;
  background: #f1f1f1;
  margin-left: auto;
  border-radius: 8rpx;
  display: flex;
}
.wechat-btn image{
  width: 40rpx;
  margin: 10rpx 5rpx 0 0;
}
.delivery-address{
  border-top: 1px solid #f1f1f1;
  padding: 15rpx 0;
}
.user-infor{
  display: flex;
  color: #666;
}
.user-infor .tel{
  margin-left: auto;
}
.add-details{
  width: 100%;
  display: flex;
  align-items: center;
  font-size: 28rpx;
}
.add-details .address-icon{
  width: 32rpx;
  float: left;
  margin-top: 9rpx;
}
.arrow{
  width: 40rpx;
  height: 40rpx;
  /* margin-top: 25rpx; */
  margin-left: auto;
}
.confirm-product{
  display: flex;
  align-content: center;
  padding: 40rpx;
  margin-bottom: 20rpx;
}
.product-img image{
  width: 200rpx;
  height: 200rpx;
  margin-right: 20rpx;
}
.status-icon image{
  width: 120rpx;
  margin: 0 auto 20rpx;
}
.product-infor{
  width: 70%;
  font-size: 30rpx;
  color: #999;
  line-height: 50rpx;
}
.product-infor .name{
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}
.special-tips{
  font-size: 30rpx;
  color: #666;
  padding: 30rpx 40rpx 150rpx;
}
.special-tips .title{
  font-size: 32rpx;
  color: #333;
  text-align: center;
  margin-bottom: 18rpx;
}
.btm-btn.rht{
  display: flex;
  background: #f1f1f1;
}
.btm-btn.rht .point{
  font-size: 36rpx;
  margin-top: 15rpx;
}
.btm-btn.rht .point .red{
  font-size: 40rpx;
  color: #d73021;
}
.btm-btn.rht .btn{
  width: 50%;
  margin: 0 0 0 auto;
}
.default-address{
  color: #999;
  padding: 10rpx 0;
}
.default-address .arrow{
  width: 30rpx;
  height: 30rpx;
  margin-top: 0;
}
.show{
  display: block;
}
.hide{
  display: none;
}