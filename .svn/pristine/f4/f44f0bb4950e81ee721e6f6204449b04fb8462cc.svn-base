    rule_id2: '',
    sex:1,
    score: 0,
    energy: 0,
    starTime: '',
    endTime: '',
    activityList: [],
    totalChallenge: 0,
    activityList2: [],
    totalActy: 0,
    page: 1,
    page2: 1,
    haveSuperActy: false,
    echartShow: false,
    echartShow2: false,
    monthWeekCount: '',
    ecBar: {
      layzLoad: true,
      disableTouch: true
    }, 
    ecPie0:{
      layzLoad: true,
      disableTouch: true
    },
    ecPie00:{
      layzLoad: true,
      disableTouch: true
    },
    //周数据
    ecPie1:{
      layzLoad: true,
      disableTouch: true
    },
