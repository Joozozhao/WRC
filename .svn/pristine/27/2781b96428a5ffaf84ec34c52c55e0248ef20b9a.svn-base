<!--index.wxml-->
<view class="top-part">
  <image src="../../images/wrc-logo.png" class="logo"></image>
  <view class="userinfo-avatar">
    <view bindtap="toUserCenter"><image src="{{avatarUrl}}" mode="widthFix"></image></view>
  </view>
</view>
<scroll-view scroll-y style="height:60%;margin-top:198rpx;">
  <view class="scroll-view-item" style="margin-bottom:150rpx;">
    <view class="swiper">
      <swiper indicator-dots="{{indicatorDots}}"
        autoplay="{{autoplay}}" interval="{{interval}}" duration="{{duration}}" style="height:{{height}}" circular="true">
        <block wx:for="{{challenge}}" wx:key="index" wx:if="{{index<4}}">
          <swiper-item>
          <navigator hover-class="none" url="../challengedetail/challengedetail?id={{item.id}}">
            <image src="{{item.acty_img}}" mode="widthFix" style="width:100%;height:auto;" bindload='goheight'/>
          </navigator>
          </swiper-item>
        </block>
      </swiper>
    </view>
    <view class="vw-wrap">
      
      <view class="infor-con">
        <view class="list">
          <block wx:for="{{userList}}" wx:key="index" wx:for-item="item" wx:if="{{index<8}}">
            <view class="item"><image src="{{item.header_url}}"></image></view>
          </block>
        </view>
        <view class="total" bindtap="toList">
          <view>{{actyIn}} <text class="gray">成员</text></view>
          <view class="add-arrow"><image src="../../images/arrow-r-gray.png" mode="widthFix"></image></view>
        </view>
      </view>
      <!-- <view class="infor-con">
        <view class="list">
          今日跑团动态
        </view>
        <view class="total" bindtap="toList">
          <view><text class="gray">完成跑步打卡</text></view>
          <view class="add-arrow"><image src="../../images/arrow-r-gray.png" mode="widthFix"></image></view>
        </view>
      </view> -->
      <view class="horizontal">
        <wxs src="../../utils/toDecimal2.wxs" module="module1" />
        <scroll-view scroll-x style="width:100%;white-space:nowrap;">
          <view class="member-item" wx:for="{{recordList}}" wx:key="index" data-img="{{item.sport_img}}" data-distance="{{item.distance}}" data-speed="{{item.speed}}" bindtap="popShow" wx:if="{{item.state!==2}}">
            <view class="user-item"><image src="{{item.header_url}}"></image><text class="nick-name ellipsis" wx:if="{{item.name}}">{{item.name}}</text><text class="nick-name ellipsis" wx:else>{{item.nick_name}}</text></view>
            <view class="rd-distance"><text class="distance">{{module1.toDecimal2(item.distance)}}</text> 公里</view>
            <view class="rd-speed">平均配速 {{item.speed}}</view>
          </view>
        </scroll-view>
      </view>
      <view class="daily-record">
        <view class="record">
          <view><text class="days">已连续打卡{{serialDay}}天</text></view>
          <view class="more">每日运动获取更多积分</view>
        </view>
        <view class="tips">{{myTip}}</view>
      </view>
      <!-- <view class="nor-title" style="position: relative;">今日跑团动态<view class="add-arrow">32人完成跑步打卡<image src="../../images/arrow-r-gray.png" mode="widthFix"></image></view></view> -->
    </view>
    <view class="vw-wrap">
      <view class="news-con">
        <view class="con-item" bindtap="toActy" wx:if="{{acty_name !== ''}}">
          <image src="{{acty_img}}" mode="aspectFill"></image>
          <view class="bg-wrap ellipsis">{{acty_name}}</view>
        </view>
        <view class="con-item" bindtap="toNews">
          <image src="{{img_url}}" mode="aspectFill"></image>
          <view class="bg-wrap ellipsis">{{title}}</view>
        </view>
      </view>
    </view>
    <view class="grid-menu">
      <view class="flex-wrap">
        <view class="flex-item demo-text-3" bindtap="toRecord">
          <view class="icon-circle"><image src="../../images/index-icon1.svg" mode="widthFix"></image></view>
          <text>打卡记录</text>
        </view>
        <view class="flex-item demo-text-5">
          <navigator url="/pages/prize/prize" hover-class="none">
            <view class="icon-circle"><image src="../../images/index-icon2.svg" mode="widthFix"></image></view>
            <text>兑换好礼</text>
          </navigator>
        </view>
        <view class="flex-item demo-text-2" bindtap="toHistory">
          <view class="icon-circle"><image src="../../images/index-icon3.svg" mode="widthFix"></image></view>
          <text>我的奖品</text>
        </view>
        <view class="flex-item demo-text-6">
          <navigator url="/pages/news/news" hover-class="none">
            <view class="icon-circle"><image src="../../images/index-icon4.svg" mode="widthFix"></image></view>
            <text>关于跑团</text>
          </navigator>
        </view>
        <view class="flex-item demo-text-2" bindtap="toManage" wx:if="{{duty == '管理员'||duty == '管理员/团长'}}">
          <view class="icon-circle"><image src="../../images/index-icon7.svg" mode="widthFix"></image></view>
          <text>管理菜单</text>
        </view>
        <!-- <view class="flex-item demo-text-2" bindtap="toHope" wx:if="{{duty == '管理员'}}">
          <view class="icon-circle"><image src="../../images/index-icon7.svg" mode="widthFix"></image></view>
          <text>心愿墙</text>
        </view> -->
      </view>
    </view>
  </view>
</scroll-view>
<tabbar tabbar="{{tabbar}}"></tabbar>
<!-- 遮罩层 -->
<view class="modal-mask" bindtap="popHide" wx:if="{{personalInfor}}"></view>
  <!-- 弹出框 -->
  <view class="modal-dialog" wx:if="{{personalInfor}}" style="top: 55%;padding: 0 0 20rpx 0;">
    <view class="modal-header">
      <view>{{personalDis}}<text class="unit">公里</text></view>
      <view>{{personalSpeed}}</view>
    </view>
    <view class="modal-content" style="max-height:55vh;overflow-y:scroll;">
      <view class="per-infor">
        <image src="{{personalImg}}" mode="widthFix"></image>
      </view>
    </view>
    <!-- 操作按钮 -->
    <view class="modal-footer">
      <button class="btn btn-cancel" bindtap="popHide">关闭</button>
    </view>
  </view>
<view class="modal-login" bindtap="openLogin" wx:if="{{userId <= 0||userId == undefined}}"></view>