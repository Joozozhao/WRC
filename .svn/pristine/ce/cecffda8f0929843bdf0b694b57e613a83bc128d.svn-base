<!--pages/exchange/exchange.wxml-->
<view class="bg-gray">
  <view class="vw-wrap">
    <view class="box-part-wrap">
      <view class="box-part">
        <view>
          <view>我的积分</view>
          <view class="my-points">{{score}}</view>
        </view>
        <view>
          <view>我的能量</view>
          <view class="my-points">{{energy}}</view>
        </view>
      </view>
      <view class="flex-content">
        <view class=""><navigator url="../checkpoint/checkpoint" hover-class="none">积分记录 ></navigator></view>
        <view class=""><navigator url="../energy/energy" hover-class="none">能量记录 ></navigator></view>
        
      </view>
    </view>
  </view>
  <view class="tab-tit">
    <view wx:for="{{navTab}}" wx:key="index" data-idx="{{index}}" bindtap="currentTab" class="sub {{currentTab==index ? 'active' : ''}}"><text>{{item}}</text></view>
    <!-- <view class="sub active"><text>积分兑换区</text></view>
    <view class="sub"><text>能量兑换区</text></view> -->
  </view>
  <view class="{{tab1}}">
    <view class="vw-wrap list-wrap">
      <block wx:for="{{listData}}" wx:for-item="item" wx:key="index">
        <view class="all-list" bindtap="toPrize" data-id="{{item.id}}">
          <view class="img"><image src="{{item.goods_pic}}" mode="widthFix"></image></view>
          <view class="mode-infor">
            <view class="name ellipsis">{{item.goods_name}}</view>
              <view class="cost-point">
                <image src="../../images/point.png" class="point-ico"></image>
                <text class="points">{{item.score}}</text>
                <text class="btn">兑换</text>
              </view>
            <!-- </navigator> -->
          </view>
        </view>
      </block>
      <view style="padding: 30rpx;" wx:if="{{listData == ''}}">暂无可兑换奖品</view>
    </view>
  </view>
  
  <view class="{{tab2}}">
    <view class="vw-wrap list-wrap">
      <block wx:for="{{listData2}}" wx:for-item="item" wx:key="index">
        <view class="all-list" bindtap="toPrize2" data-id="{{item.id}}">
          <view class="img"><image src="{{item.goods_pic}}" mode="widthFix"></image></view>
          <view class="mode-infor">
            <view class="name ellipsis">{{item.goods_name}}</view>
            <!-- <navigator url="" hover-class="none" "></navigator> -->
              <view class="cost-point">
                <image src="../../images/en-ico.svg" class="point-ico"></image>
                <text class="points">{{item.energy}}</text>
                <text class="btn">兑换</text>
              </view>
            <!-- </navigator> -->
          </view>
        </view>
      </block>
      <view style="padding: 30rpx;" wx:if="{{listData2 == ''}}">暂无可兑换奖品</view>
    </view>
    <!-- <view style="padding: 30rpx;text-align:center;" wx:else>能量奖品，仅限 VIP 成员兑换，继续加油～</view> -->
  </view>
</view>
<view class="modal-login" bindtap="openLogin" wx:if="{{userId <= 0||userId == undefined}}"></view>
<home />
