<!--pages/mydata/mydata.wxml-->
<view class="vw-wrap bg-green">
  <view class="user-infor">
    <view class="user-pic {{level == 'VIP'?'add-bd':''}}" wx:if="{{level == 'VIP'}}">
      <image src="{{headerImg}}" mode="widthFix" class="pic"></image>
      <image src="../../images/vip_1.svg" mode="cover" class="vip"></image>
    </view>
    <view class="user-pic {{level == '普通'?'add-bd1':''}}" wx:if="{{level == '普通'}}">
      <image src="{{headerImg}}" mode="widthFix" class="pic"></image>
      <image src="../../images/normal.svg" mode="cover" class="vip"></image>
    </view>
    <view class="user-pic {{level == '非会员'?'add-bd2':''}}" wx:if="{{level == '非会员'}}">
      <image src="{{headerImg}}" mode="widthFix" class="pic"></image>
      <image src="../../images/none.svg" mode="cover" class="vip"></image>
    </view>
    <view style="width:50%">
      <view class="infor">
        <view class="user-name">{{nickName}}</view>
        <view class="sex" wx:if="{{sex == 1}}"><image src="../../images/man.svg"></image></view>
        <view class="sex" wx:if="{{sex == 2}}"><image src="../../images/woman.svg"></image></view>
      </view>
      <view class="user-name" style="margin-top:10rpx;"><text class="tag" style="margin-left:0;" wx:if="{{duty&&duty!=='团友'}}">{{duty}}</text><text class="tag" wx:if="{{userid>0}}">ID{{userid}}</text></view>
    </view>
  </view>
  <view class="box-part-wrap index-part">
    <view class="box-part">
      <view class="my-point">
        <view class="my-points">{{monthDistance}} km</view>
        <view>本月运动公里</view>
      </view>
      <view class="my-point">
        <view class="my-points">{{totalDistance}} km</view>
        <view>运动总里程</view>
      </view>
    </view>
  </view>
</view>
<view>
  <view class="acty-tit" wx:if="{{userid == userId}}">我的活动</view>
  <view class="acty-tit" wx:else>TA参加的活动</view>
  <block wx:for="{{activityList}}" wx:key="index" wx:for-item="item">
  <view class="activity" id="{{key}}">
    <view class="cover-img" bindtap="toDet" data-id="{{item.id}}" data-type="{{item.acty_type}}">
      <image src="{{item.acty_img}}" mode="aspectFill"></image>
      <view class="vw-cover" wx:if="{{item.acty_state == 0}}">
        <view class="state">{{acty_state}}</view>
      </view>
    </view>
    <wxs src="../../utils/toPlace.wxs" module="module1" />
    <view class="activity-infor" bindtap="toDet" data-id="{{item.id}}" data-type="{{item.acty_type}}">
      <view class="title">{{item.acty_name}}</view>
      <view wx:if="{{item.acty_type == '挑战'}}">
        <text class="tag">{{item.acty_type}}</text>
        <text class="tag org">{{module1.change(item.region)}}</text>
      </view>
      <view wx:else><text class="tag">{{item.acty_type}}</text><text class="tag org">{{item.region}}</text></view>
      <view class="time">{{item.start_timestr}}-{{item.end_timestr}}</view>
      <view class="address" wx:if="{{item.address !== ''}}"><image src="/images/place.png"></image>{{item.address}}</view>
      <view>已参加：{{item.joins}}人</view>
    </view>
  </view>
</block>
</view>
<home/>