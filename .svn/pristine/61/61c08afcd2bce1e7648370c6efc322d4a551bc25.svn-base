/**index.wxss**/
.circle_box,
.circle_draw {
  position: relative;
}
 
.circle_bg {
  position: absolute;
}
 
.circle_box {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
 
.circle_txt {
  position: absolute;
  font-size: 32rpx;
  top: 25%;
  color: #fff;
}
.circle_txt .text{
  font-size: 80rpx;
  font-weight: 700;
}
.circle_txt2{
  position: absolute;
  font-size: 20rpx;
  top: 150rpx;
  color: #999;
}