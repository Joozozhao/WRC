/* pages/lotterydetail/lottery.wxss */
@import "../activity/activity.wxss";
@import "../prizedetails/prizedetails.wxss";
/* @import "../activitydetail/activitydetail.wxss"; */
.pro-detail{
  margin-bottom: 20rpx;
  line-height: 2;
  font-size: 32rpx;
}
.detail-wrap{
  padding: 20rpx;
}
.detail-wrap .number{
  color: #999;
}
.detail-wrap .time{
  font-size: 24rpx;
  color: #999;
}
.nor-title {
  font-size: 32rpx;
  color: #666;
  font-weight: 700;
  line-height: 2;
}
.hasOrd{
  margin-bottom: 20rpx;
  padding: 20rpx;
}
.result-con{
  padding: 40rpx 0;
  text-align: center;
}
.result-con .result{
  color: #fc0;
  font-weight: 700;
  padding-bottom: 10rpx;
}
.result-con .result.fail{
  color: #999;
}
.result-con .prize{
  font-size: 32rpx;
  color: #333;
}
.person-list{
  display: flex;
  flex-wrap: wrap;
  padding: 30rpx;
  border: 1px solid #eeeeee;
}
.person-list .list-item{
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 28rpx;
}
.exchange-list{
  padding: 20rpx 0;
}
.avastar.big{
  width: 120rpx;
  height: 120rpx;
  min-height: 120rpx;
}
.prize-code{
  color: #999;
  font-size: 28rpx;
  padding: 10rpx 0;
}
.copyNum{
  display: inline;
  font-size: 24rpx;
  padding: 0 10rpx;
  border: 1px solid #e1e1e1;
  border-radius: 5rpx;
  margin-left: 10rpx;
}