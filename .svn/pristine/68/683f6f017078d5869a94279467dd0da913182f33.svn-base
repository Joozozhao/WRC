<!--pages/addtype/addtype.wxml-->
<view style="margin:30rpx 0 180rpx">
<!-- <view class="vw-wrap">
    <button class="add-type" data-index="{{index}}" bindtap='addNew'>添加规格</button>
  </view> -->
  <view class="vw-wrap">
    <view wx:for="{{typeInfor}}" wx:key="index">
      <view class="type-infor">
        <view class="type-name">{{index}}</view>
        <view>
          <view class="type-item" wx:for="{{item}}" wx:for-item="items" wx:for-index="childindex" wx:key="index">
          <view class="tag-desc" wx:if="{{items.tag_desc}}">{{items.tag_desc}}</view>
          <!-- <view class="tag-total" wx:if="{{item.stock}}">
            <view>-</view><view>{{item.stock}}</view><view>+</view>
          </view> -->
          <!-- <wxs src="../../utils/toPlace.wxs" module="module1" /> -->
          <wxs module="add">
          </wxs>
          <view class="tag-total stepper">  
            <!-- 减号 -->  
            <text class="sign {{items.stock <= 0 ? 'disabled' : 'normal'}}" 
            data-content="{{typeInfor}}"
            bindtap="delCount" 
            data-id="{{items.id}}" 
            data-count="{{items.stock}}" 
            data-parent='{{index}}'
                data-childindex="{{childindex}}">-</text>  
            <!-- 数值 -->  
            <input class="number" type="number" value="{{items.stock}}"  disabled="disabled"/>  
            <!-- 加号 -->  
            <text class="sign {{items.stock >= 1000 ? 'disabled' : 'normal'}}" 
            bindtap="addCount" 
            data-id="{{items.id}}" 
            data-count="{{items.stock}}"
            data-parent='{{index}}'
            data-childindex="{{childindex}}">+</text>  
          </view>
          <view bindtap="del" data-id="{{items.id}}">删除</view>
        </view>
        </view>
        
      </view>
    </view>
  </view>
  <form bindsubmit="submit">
    
    <view class="type-con">
      <view class="new-type"><input type="text" value="{{Type_Name}}" name="Type_Name" data-index="{{index}}" data-tag="Type_Name" placeholder="规格"></input><view class="new-btn" bindtap='addItem'>+</view></view>
      <view class="contact-type" wx:for="{{newItem}}" wx:key="index">
        <input type="text" name="Name{{index}}" placeholder="名称"></input>
        <input type="number" name="Total{{index}}" placeholder="库存"></input>
      </view>
    </view>
    <view class="full-btn">
      <button class="btn btnTwo" form-type="submit"  disabled="{{disable}}">完成</button>
    </view>
  </form>
</view>
