/* pages/mydata/mydata.wxss */
@import '../index/index.wxss';
@import '../activity/activity.wxss';
page{
  background: #89CCB5;
}
.user-pic .pic{
  width: 140rpx;
}
.user-infor .edit-infor{
  font-size: 28rpx;
  margin-left: auto;
  line-height: 40rpx;
}
.user-infor .edit-infor image{
  width: 50rpx;
}
.acty-tit{
  padding: 20rpx 40rpx 0;
  /* line-height: 100rpx; */
  font-size: 32rpx;
  line-height: 32rpx;
  color: #333;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.user-infor .infor{
  display: flex;
  align-items: center;
}
.user-infor .infor .sex image{
  width: 25rpx;
  height: 25rpx;
  margin-left: 10rpx;
}
.user-infor .infor .level{
  width: 100rpx;
  height: auto;
  margin-left: 10rpx;
}
.user-name .tag{
  margin-left: 0;
  margin-right: 10rpx;
}
.title-leader image{
  width: 50rpx;
  margin-top: 6rpx;
}
.box-part-wrap.index-part{
  color: #537780;
  border-radius: 10rpx;
}
.box-part-wrap.index-part .my-points{
  font-size: 45rpx;
}
.box-part-wrap.index-part .tit{
  font-size: 24rpx;
}
.week-data{
  margin-top: 30rpx;
}
.week-data .acty-tit.no-pl{
  padding: 0;
}
.week-con{
  background: #fff;
  height: 24vh;
  padding: 30rpx;
  border-radius: 10rpx;
  position: relative;
}
.time-region{
  font-size: 24rpx;
  font-weight: normal;
  float: right;
}
.girls-circle{
  width: 100%;
}
.girls-circle .pies-subwrap{
  height: 32vh;
  margin-top: 20rpx;
}
ec-canvas{
  width: 100%;
  height: 100%;
}
.data-con{
  padding: 30rpx;
  overflow: hidden;
  position: relative;
  color: #333;
  border-radius: 10rpx;
}
.bg-blue{
  background: #537780;
}
.data-header{
  position: relative;
}
.data-header .wrap-tit{
  color: #ff5579;
  font-size: 26rpx;
  text-align: center;
  font-weight: bold;
  line-height: 50rpx;
}
.data-header .end-date{
  font-size: 24rpx;
  color: #333;
  position: absolute;
  left: 20rpx;
  top: 10rpx;
}
.icon-bg{
  width: 120rpx;
  height: 120rpx;
  background: rgba(53,229,88,.5);
  border-radius: 50%;
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  z-index: 4;
}
.icon-bg.red{
  background: rgba(255,0,0,.5);
}
.icon-bg .icon{
  width: 50rpx;
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  z-index: 6;
}
.flex-con{
  display: flex;
  justify-content: space-between;
  padding: 10rpx 30rpx;
}
.arrow image{
  width: 40rpx;
  height: 40rpx;
}
.progress-content{
  display: flex;
  padding: 0 40rpx;
}
.progress-content .progress-con{
  width: 100%;
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  text-shadow: 2rpx 2rpx 4rpx black;
  border-radius: 30rpx;
  overflow: hidden;
  position: relative;
}
.progress-content .progress-con .data{
  position: absolute;
  left: 20rpx;
  top: 10rpx;
}
.progress-content .progress-con .percent{
  position: absolute;
  right: 20rpx;
  top: 8rpx;
}
.progress{
  width: 50%;
  line-height: 60rpx;
  font-size: 42rpx;
  text-align: center;
}
.progress .compelte{
  font-size: 50rpx;
}
.progress .tit{
  font-size: 26rpx;
}
.ad-bdr{
  border-right: 1px solid #e0e0e0;
}
.data-body{
  position: relative;
  height: 290rpx;
}
.flex-con.pies-con{
  width: 100%;
  box-sizing: border-box;
  padding-top: 0;
  padding-bottom: 30rpx;
  /* position: absolute;
  left: 0;
  bottom: -72rpx; */
  justify-content: space-around;
  text-align: center;
}
.pies-wrap{
  position: relative;
  width: 30%;
}
.pies-subwrap{
  position: relative;
  width: 100%;
  height: 12vh;
}
.pies-subwrap .echart_panel,.echart_panel{
  width: 100%;
  height: 95%;
}
.pies-wrap .line{
  width: 1px;
  height: 40rpx;
  border-left: 1px dotted #24d8da;
  position: absolute;
  left: 50%;
  top: 9vh;
  transform: translate(-50%,0);
}
.pies-wrap .date{
  font-size: 24rpx;
}
/* swiper{
  overflow: hidden;
}
swiper-item{
  display: flex;
  justify-content: center;
  align-items: center;
  
}
.data-body{
  width: 100%;
} */









.activity {
  display: inline-block;
  background: none;
  padding: 0;
  margin: 0 30rpx 0 0 ;
}
.activity.normal-acty{
  width: 40%;
}
.activity.normal-acty .cover-img{
  height: 180rpx;
}
.activity.normal-acty .cover-img image{
  max-height: 180rpx !important;
}
.activity:nth-last-child(1){
  margin-right: 0;
}
.activity .cover-img {
  width: 100%;
  height: auto;
}
.activity .activity-infor{
  display: none;
}
.challenge .activity{
  width: 320rpx;
  height: 180rpx;
}
.challenge .cover-img image{
  height: 180rpx;
}
.activitys .activity{
  width: 280rpx;
  height: 210rpx;
}
.activitys .cover-img image{
  height: 210rpx;
}