// pages/activity/activity.js
const util = require('../../utils/util.js')
// 获取应用实例
const app = getApp()
Page({
  /**
   * 页面的初始数据
   */
  data: {
    activityList: [],
    duty: '',
    page: 1
  },
  creatNew: function () {
    wx.navigateTo({
      url: '../creat/creat'
    })
  },
  toDet: function(e){
    var id = e.currentTarget.dataset.id
    var name = e.currentTarget.dataset.name
    wx.navigateTo({
      url: '../activitydetail/activitydetail?id='+id
    })
    // wx.setNavigationBarTitle({
    //   title: name
    // })
  },
  editCon: function(e){
    var id = e.currentTarget.dataset.id
    wx.navigateTo({
      url: '../editactivity/editactivity?id='+id
    })
  },
  delCon: function(e){
    var that = this
    wx.showModal({   
      title: '是否确定删除内容？',
      success: function (res) {
        if (res.confirm) {             //点击确定后
          var id = e.currentTarget.dataset.id
          var data = {
            id: id
          }
          util.request('acty/del', 'POST', data, '数据加载中 ...', (res)=>{
            if(res.data.success){
              that.setData({
                page: 1
              })
              that.onLoad()
              console.log(res)
              wx.showToast({
                title: '已删除',
                icon: 'none',
                duration: 1500
              })    
              // wx.navigateBack({
              //   delta: -1,
              // })
              // wx.navigateTo({
              //   url: '../activity/activity',
              // })          
            }else{
              that.setData({
                activityList: []
              })
              wx.showToast({
                title: res.data.error,
                icon: 'none',
                duration: 1500
              })  
            }
          })
         } else {
           console.log('用户取消')
         }
       }
    })
  },
  /**
   * 生命周期函数--监听页面加载
   */
  onLoad: function (options) {
    this.initLimit()
  },
  initLimit: function(){
    var userId = app.globalData.userId
    var data = { 
      id : userId
    }
    util.request('user/get', 'POST', data, '数据加载中 ...', (res)=>{
      var that = this
      console.log(res)
      if(res.data.success){
        that.setData({
          duty: res.data.data.duty
        })
      }
    })
  },
  initActy: function(){
    var that = this
    var data = {
      page: that.data.page++,
      type: '团跑'
    }
    console.log(data)
    util.request('acty/getactylist', 'POST', data, '数据加载中 ...', (res)=>{
      console.log(res.data)      
      if(res.data.success){
        var allData = res.data.data
        for(var i=0; i<allData.length;i++){
          var createTime = allData[i].start_timestr.substring(0, 16)
          var endTime = allData[i].end_timestr.substring(11, 16)
          var createTime1 = this.dislodgeZero(createTime)
          var endTime1 = this.dislodgeZero(endTime)
          allData[i].start_timestr = createTime1 
          allData[i].end_timestr = endTime1
          that.setData({
            activityList: allData,
            start_timestr: createTime1,
            end_timestr: endTime1
          })
          if(allData[i].acty_state == 0){
            that.setData({
              acty_state: '已结束'
            })
          }
        }
    }else{
      that.setData({
        activityList: []
      })
        // wx.showToast({
        //   title: res.data.error,
        //   icon: 'none',
        //   duration: 1500
        // })  
      }
    })
  },
  dislodgeZero(str) {
    let strArray = str.split("-");
    strArray = strArray.map(function(val) {
      if (val[0] == "0") {
        return (val = val.slice(1));
      } else {
        return val;
      }
    });
    return strArray.join("-");
  },
  /**
   * 生命周期函数--监听页面初次渲染完成
   */
  onReady: function () {

  },

  /**
   * 生命周期函数--监听页面显示
   */
  onShow: function () {
    this.setData({
      page: 1
    })
    this.initActy()
  },

  /**
   * 生命周期函数--监听页面隐藏
   */
  onHide: function () {

  },

  /**
   * 生命周期函数--监听页面卸载
   */
  onUnload: function () {

  },

  /**
   * 页面相关事件处理函数--监听用户下拉动作
   */
  onPullDownRefresh: function () {

  },

  /**
   * 页面上拉触底事件的处理函数
   */
  onReachBottom: function () {
    this.loadMore()
  },
  loadMore: function () {
    var that = this
    console.log(that.data)
    var data = {
      page: that.data.page ++,
      type: '团跑'
    }
    util.request('acty/getactylist', 'POST', data, '数据加载中...', (res)=>{
      if(res.data.success){
        var allData = res.data.data
        var content = this.data.activityList.concat(allData)
        for(var i=0; i<allData.length;i++){
          var createTime = allData[i].start_timestr.substring(0, 16)
          var endTime = allData[i].end_timestr.substring(11, 16)
          var createTime1 = this.dislodgeZero(createTime)
          var endTime1 = this.dislodgeZero(endTime)
          allData[i].start_timestr = createTime1 
          allData[i].end_timestr = endTime1
          that.setData({
            activityList: content,
            start_timestr: createTime1,
            end_timestr: endTime1
          })
          if(allData[i].acty_state == 0){
            that.setData({
              acty_state: '已结束'
            })
          }
        }
    }else{
        // wx.showToast({
        //   title: res.data.error,
        //   icon: 'none',
        //   duration: 1500
        // })  
      }
    })
    //   if(res.data.success){
    //     console.log(eachData)
    //     var eachData = res.data.data
    //     var content = this.data.activityList.concat(eachData)
    //     that.setData({
    //       activityList : content
    //     })
    //   }
      
    // })
  },
  /**
   * 用户点击右上角分享
   */
  onShareAppMessage: function () {

  }
})