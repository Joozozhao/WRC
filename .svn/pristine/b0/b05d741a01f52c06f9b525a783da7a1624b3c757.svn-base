<!--pages/activity/activity.wxml-->
<view>
  <block wx:for="{{activityList}}" wx:key="index" wx:for-item="item">
    <view class="activity" id="{{key}}">
      <view class="cover-img" bindtap="toDet" data-id="{{item.id}}" data-name="{{item.acty_name}}">
        <image src="{{item.acty_img}}" mode="aspectFill"></image>
        <view class="vw-cover" wx:if="{{item.acty_state == 0}}">
          <view class="state">{{acty_state}}</view>
        </view>
      </view>
      <view class="activity-infor" bindtap="toDet" data-id="{{item.id}}">
        <view class="title">{{item.acty_name}}</view>
        <view><text class="tag">{{item.acty_type}}</text><text class="tag org">{{item.region}}</text></view>
        <view class="time"><image src="/images/time.png"></image>{{item.start_timestr}}-{{item.end_timestr}}</view>
        <view class="address"><image src="/images/place.png"></image>{{item.address}}</view>
        <view>已参加：{{item.joins}}人</view>
      </view>
      <view class="act-btn" wx:if="{{duty == '管理员'||duty == '管理员/团长'}}"><text class="btn edit" bindtap="editCon" data-id="{{item.id}}">编辑</text><text class="btn del" bindtap="delCon" data-index="{{index}}" data-id="{{item.id}}">删除</text></view>
    </view>
  </block>
</view>
<tabbar tabbar="{{tabbar}}"></tabbar>
<!-- <view class="full-btn" wx:if="{{duty == '管理员'}}">item.acty_state == 2&&
  <button class="btn btnTwo" bindtap="creatNew">创建活动</button>
</view> -->