/* pages/creat/creat.wxss */
.form-con{
  padding-bottom: 150rpx;
}
.form-item{
  display: flex;
  border-bottom: 1px solid #e1e1e1;
  font-size: 32rpx;
  line-height: 100rpx;
  position: relative;
}
/* .form-item:nth-last-child(1){
  border: none;
} */
.form-item .add-arrow image{
  width: 30rpx;
  height: 30rpx;
  position: absolute;
  right: 20rpx;
  top: 50%;
  margin-top: -15rpx;
}
.form-item .ipt{
  margin-left: auto;
  text-align: right;
  height: 100rpx;
  line-height: 100rpx;
  margin-right: 20rpx;
  color: #999;
}
.form-item .ipt picker,.form-item .ipt .picker{
  height: 100rpx;
  line-height: 100rpx;
}
.form-item.upload-cover{
  flex-direction: column;
  border: none;
  margin-bottom: 20rpx;
}
.form-item.upload-cover .add-pic image{
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
  border: 2px dashed #fff;
  border-radius: 5rpx;
}
.add-pic{
  width: 100%;
  padding: 100rpx 40rpx;
  position: relative;
  background: url(data:image/jpeg;base64,);
  background-size: 100% 100%;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}
.show-pic image{
  width: 100%;
}
.show-pic{
  position: relative;
  /* padding: 20rpx 0 0 0; */
}
.show-pic .del{
  position: absolute;
  bottom: 0rpx;
  right: 42%;
  display: none;
}
.show-pic .del image{
  width: 100rpx;
  height: 100rpx;
  /* margin-left: -50rpx; */
}
.sub-tit{
  font-size: 28rpx;
  color: #999;
  line-height: 1.5;
  margin-top: 40rpx;
}
.form-item .ipt.no-mr{
  margin-right: 0rpx;
}
.show{
  display: block;
}
.hide{
  display: none;
}
.bg-wrap{
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,.3);
  position: absolute;
  left: 0;
  top: 0;
}