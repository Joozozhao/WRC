<!--pages/orderlist/orderlist.wxml-->
<block wx:for="{{orderList}}" wx:key="index" wx:for-item="item">
  <view class="activity">
    <view class="cover-img" data-id="{{item.id}}" bindtap="toDetail">
      <image src="{{item.goods_pic}}" mode="widthFix" style="height:auto;"></image>
    </view>
    <view class="activity-infor" data-id="{{item.id}}">
    <view data-id="{{item.id}}"  bindtap="toDetail">
      <view class="avastar">
        <image src="{{item.header_url}}" mode="widthFix" style="height:auto;"></image>
        <view wx:if="{{item.user_name!==''}}">{{item.user_name}}</view>
        <view wx:else>{{item.nick_name}}</view>
      </view>
      <view>消耗：<text wx:if="{{item.score>0}}">{{item.score}}积分</text><text wx:if="{{item.energy>0}}">{{item.energy}}能量</text></view>
      <view>订单号：{{item.order_num}}</view>
      <view>兑换时间：{{item.create_timestr}}</view>
    </view>
      <view class="act-btn" style="position:static;">
        <text class="btn edit" wx:if="{{item.state == 0}}">待发货</text>
        <text class="btn gray" wx:if="{{item.state == 1}}">已发货</text>
        <text class="btn gray" wx:if="{{item.state == 2}}">已签收</text>
        <text class="btn gray" wx:if="{{item.state == 3}}">已退单</text>
        <text class="btn" bindtap="resetCon" data-id="{{item.id}}" data-state="{{item.state}}" data-energy="{{item.energy}}" data-score="{{item.score}}" data-userid="{{item.user_id}}" data-num="{{item.order_num}}" wx:if="{{item.state == 0||item.state == 1}}">设置</text>
        <text class="btn" bindtap="delCon" data-id="{{item.id}}" data-idx="{{index}}" wx:if="{{item.state == 3}}">删除</text>
      </view>
    </view>
    
  </view>
</block>
<!-- 遮罩层 -->
<view class="modal-mask" wx:if="{{changeModal}}"></view>
<!-- 弹出框 -->
<view class="modal-dialog" wx:if="{{changeModal}}" style="top: 30%;">
  <form bindsubmit="onConfirm">
    <view class="modal-content">
      <view class="form-con">
        <view class="fm-tit">状态：</view>
        <radio-group class="radio-group" name="stateId" data-val="{{item.value}}" bindchange="setState">
          <label for="" wx:for="{{radioItem}}" wx:key="index">
            <view style="display:inline-block;float: left;margin:0 0 20rpx 0;">
              <radio value="{{item.value}}"  checked="{{item.checked}}" />{{item.name}}</view>
            </label>
        </radio-group>
      </view>
    </view>
    <!-- 操作按钮 -->
    <view class="modal-footer">
      <button class="btn btn-confirm" bindtap="onCancel" data-status="cancel">取消</button>
      <button class="btn btn-cancel" form-type="submit" data-status="confirm">确定</button>
    </view>
  </form>
</view>
<view class="noHistory {{noHistory?'show':'hide'}}">
  <view class="main">暂无订单</view>
</view>