/* pages/record/record.wxss */
.color-tip{
  display: flex;
  padding: 0 25rpx 10rpx;
  font-size: 24rpx;
  color: #666;
}
.color-tip .tips{
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}
.spot{
  width: 8rpx;
  height: 8rpx;
  background-color: #aad4f5;
  border-radius: 50%;
  margin-right: 15rpx;
}
.spot.spot2{
  background-color: #f5a8f0;
}
.activity{
  display: flex;
  align-items: center;
  background: #fff;
  margin: 20rpx 0;
  padding: 20rpx 30rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  position: relative;
}
.cover-img{
  display: flex;
  align-items: center;
  width: 210rpx;
  height: 210rpx;
  overflow: hidden;
  position: relative;
  margin-right: 30rpx;
}
.cover-img image{
  width: 100%;
  max-height: 280rpx !important;
}
.activity-infor .title{
  color: #000;
  font-size: 30rpx;
}
.activity-infor .time{
  font-weight: bold;
}
.activity-infor .distance{
  display: inline-block;
  font-weight: 500;
  font-size: 78rpx;
}
.acty-type{
  position: absolute;
  left: 30rpx;
  top: 20rpx;
  color: #fff;
  font-size: 20rpx;
  padding: 5rpx 10rpx;
  border-radius: 0 0 10rpx 0;
}
.act-btn{
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
}
.activity .acty-tag{
  position: absolute;
  right: 0;
  top: 20rpx;
}
.activity .acty-tag image{
  width: 100rpx;
  height: 50rpx;
}
.activity .acty-tag .title{
  width: 100%;
  font-size: 24rpx;
  color: #fff;
  line-height: 50rpx;
  text-align: center;
  position: absolute;
  right: 0;
  top: 0;
}
.calendar {
  background-color:white; /*背景色为白色*/
  padding-top: 10px;    /*上内边距为10px*/
  color: #38ACFF;
  /* border-radius: 15px; */
  border: 2rpx solid #38ACFF;
  box-shadow:0 0 10px #38ACFF;
  border-top: 0;
}
.state-bg{
  padding: 10rpx 20rpx;
  background: #7bcfa6;
  font-size: 20rpx;
  color: #fff;
  border-radius: 50rpx 0 0 50rpx;
  position: absolute;
  right: 0;
  top: 96rpx;
}
.pass{
  display: flex;
  align-items: center;
}
.pass image{
  width: 20rpx;
  height: 20rpx;
}
.state-bg.bg2{
  background: rgba(255,0,0,.3);
}
/* .act-btn{
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
} */
.act-btn .btn{
  display: inline-block;
  padding: 0 10rpx;
  line-height: 1.5;
  border: 1px solid #e1e1e1;
  border-radius: 5rpx;
  margin-left: 20rpx;
}
