  },
  
  /**
   * 生命周期函数--监听页面加载
   */
  onLoad: function (options) {
    var id = options.id
    var userId = app.globalData.userId
    this.initInfor(id)
    this.initActy(id)
    this.setData({
      userid: id, //别人的id
      userId: userId //自己的id
    })
  },
  initInfor: function(id){
    var data = { 
      userId : id
    }
    util.request('user/getsportinfo', 'POST', data, '数据加载中 ...', (res)=>{
      var that = this
      console.log(res)
      if(res.data.success){
        var myData = res.data.data
        that.setData({
          headerImg: myData.headerImg,
          userName: myData.userName,
          nickName: myData.nickName,
          sex: myData.sex,
          duty: myData.duty,
          level: myData.level,
          monthDistance: myData.monthDistance,
          totalDistance: myData.totalDistance          
        })
      }
    })
  },
  initActy: function(id){
    var that = this
    var data = {
      userId: id,
      page: 1
    }
    console.log(data)
    util.request('acty/getacty', 'POST', data, '数据加载中 ...', (res)=>{
      console.log(res.data)      
      if(res.data.success){
        var allData = res.data.data
        for(var i=0; i<allData.length;i++){
          var createTime = allData[i].start_timestr.substring(0, 16)
          var endTime = allData[i].end_timestr.substring(11, 16)
          allData[i].start_timestr = createTime 
          allData[i].end_timestr = endTime 
          that.setData({
            activityList: allData,
            start_timestr: createTime,
            end_timestr: endTime
          })
        } 
    }else{
      that.setData({
        activityList: []
      })
        wx.showToast({
          title: res.data.error,
          icon: 'none',
          duration: 1500
        })  
      }
    })
  },
  toDet: function(e){
    var id = e.currentTarget.dataset.id
    var type = e.currentTarget.dataset.type
    if(type == '挑战'){
      wx.navigateTo({
        url: '../challengedetail/challengedetail?id='+id + '&userid=' + this.data.userid
      })
    } else {
      wx.navigateTo({
        url: '../activitydetail/activitydetail?id='+id + '&userid=' + this.data.userid
      })
    }
  },
  /**
   * 页面上拉触底事件的处理函数
   */
  onReachBottom: function () {
    // this.loadMore()
  },
  loadMore: function(){
    var that = this
    var data = {
      userId: that.data.userid,
      page: that.data.page++
    }
    console.log(data)
    // wx.showLoading({
    //   title: '加载中',
    //   icon: 'loading'
    // })
    util.request('acty/getacty', 'POST', data, '数据加载中 ...', (res)=>{
      console.log(res.data)      
      if(res.data.success){
        var allData = res.data.data
        var content = that.data.activityList.concat(allData)
        for(var i=0; i<allData.length;i++){
          var createTime = allData[i].start_timestr.substring(0, 16)
          var endTime = allData[i].end_timestr.substring(11, 16)
          allData[i].start_timestr = createTime 
          allData[i].end_timestr = endTime 
          if(that.data.page<=res.data.page_total){
            that.setData({
              activityList: content,
              start_timestr: createTime,
              end_timestr: endTime
            })
          } else {

          }
        }
        // wx.hideLoading({
        //   success: (res) => {},
        // })
    }else{
      // wx.hideLoading({
      //   success: (res) => {},
      // })
      // that.setData({
      //   activityList: []
      // })
        // wx.showToast({
        //   title: res.data.error,
        //   icon: 'none',
        //   duration: 1500
        // })  
      }
    })
  },
  loadMore2: function(){
    var that = this
    var data = {
      userId: that.data.userid,
      page: that.data.page2++
    }
    console.log(data)
    // wx.showLoading({
    //   title: '加载中',
    //   icon: 'loading'
    // })
    util.request('acty/getacty', 'POST', data, '数据加载中 ...', (res)=>{
      console.log(res.data)      
      if(res.data.success){
        var allData = res.data.data
        var content = that.data.activityList.concat(allData)
        for(var i=0; i<allData.length;i++){
          var createTime = allData[i].start_timestr.substring(0, 16)
          var endTime = allData[i].end_timestr.substring(11, 16)
          allData[i].start_timestr = createTime 
          allData[i].end_timestr = endTime 
          if(that.data.page2<=res.data.page_total){
            that.setData({
              activityList: content,
              start_timestr: createTime,
              end_timestr: endTime
            })
          }
        }
        // wx.hideLoading({
        //   success: (res) => {},
        // })
    }else{
      // wx.hideLoading({
      //   success: (res) => {},
      // })
      // that.setData({
      //   activityList: []
      // })
        // wx.showToast({
        //   title: res.data.error,
        //   icon: 'none',
        //   duration: 1500
        // })  
      }
    })
  }
})
function getBarOption() {
  return {
    tooltip: {
      trigger: 'axis',
      axisPointer: {            // 坐标轴指示器，坐标轴触发有效
        type: 'line'        // 默认为直线，可选为：'line' | 'shadow'
      }
    },
    grid: {
      left: 20,
      right: 20,
      bottom: 15,
      top: 40,
      containLabel: true
    },
    xAxis: 
      {
        type: 'category',
        data: ['周一', '周二', '周三', '周四', '周五', '周六', '周日'],
        axisLine:{
          lineStyle:{
              color:'#bebebe',
              width:1,//这里是为了突出显示加上的
          },
        },
        axisTick: {
          show: false
        }
      }
    ,
    yAxis: 
      {
        type: 'value',
        min: 0,
        max: 60,
        splitNumber: 3,
        splitLine: {
          show: true,
          lineStyle:{
             color: ['#eaebed']
          }
        }
      }
    ,
    series: [
      {
        type: 'bar',
        label: {
          normal: {
            show: true,
            position: 'top'
          }
        },
        data: [30, 20, 40, 34, 10, 6, 10],
        showBackground: true,
        backgroundStyle: {
          color: 'rgba(243, 253, 253)'
        },
        itemStyle: {
          color: '#25cdd4',
          borderRadius: [10,10,0,0]
        },
        barWidth: 15,
        emphasis: {
          itemStyle:{
            color: '#1874ef'
          }
        }
      }
    ]
  };
}