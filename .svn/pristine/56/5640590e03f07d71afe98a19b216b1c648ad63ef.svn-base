/* pages/record/record.wxss */
page{
  padding-bottom: 100rpx;
}
.color-tip{
  display: flex;
  padding: 0 25rpx 10rpx;
  font-size: 24rpx;
  color: #666;
}
.color-tip .tips{
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}
.spot{
  width: 8rpx;
  height: 8rpx;
  background-color: #aad4f5;
  border-radius: 50%;
  margin-right: 15rpx;
}
.spot.spot2{
  background-color: #f5a8f0;
}
.activity{
  display: flex;
  align-items: center;
  background: #fff;
  margin: 20rpx 0;
  padding: 20rpx 30rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  position: relative;
  position: relative;
}
.cover-img{
  display: flex;
  align-items: center;
  width: 210rpx;
  height: 280rpx;
  position: relative;
  margin-right: 30rpx;
}
.cover-img image{
  width: 100%;
  max-height: 280rpx !important;
}
.activity-infor .title{
  color: #000;
  font-size: 30rpx;
}
.activity-infor .distance{
  display: inline-block;
  font-weight: 500;
  font-size: 64rpx;
}
.activity .acty-tag{
  position: absolute;
  right: 0;
  top: 20rpx;
}
.activity .acty-tag image{
  width: 100rpx;
  height: 50rpx;
}
.activity .acty-tag .title{
  font-size: 24rpx;
  color: #fff;
  line-height: 50rpx;
  text-align: center;
  position: absolute;
  right: 10rpx;
  top: 0;
}
.calendar {
  background-color:white; /*背景色为白色*/
  padding-top: 10px;    /*上内边距为10px*/
  color: #38ACFF;
  /* border-radius: 15px; */
  border: 2rpx solid #38ACFF;
  box-shadow:0 0 10px #38ACFF;
  border-top: 0;
}