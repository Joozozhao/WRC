<!--pages/clockin/clockin.wxml-->
<view class="top-part">
  <view class="back-btn" bindtap="back"><image src="../../images/arrow-l.png" mode="widthFix"></image></view>
  <image src="../../images/clock-bg.png" class="bg" mode="widthFix"></image>
</view>

<scroll-view scroll-y style="height:60%;margin-top:20rpx;">
  <form bindsubmit="submit">
    <view class="form-con clockin">
    <view class="form-item upload-cover vw-wrap {{addView?'show':'hide'}}" bindtap="uploadAction">
      <view class="upload-file" style="width: 100%;">
        <view class="upload-btn"><text class="add">+</text></view>
        <view class="t-tips">请上传含日期、里程数、用时的运动截图</view>
      </view>
    </view>
    <view class="form-item vw-wrap" class="{{showView?'show':'hide'}}" bindtap="uploadAction">
      <view class="upload-file show-pic">
        <image 
        src="{{tempFilePaths}}" 
        mode="widthFix"
        class="fixed-wh"
        >
        </image>
        <view class="del" bindtap="delete"><image src="../../images/delete.png"></image></view>
      </view>
    </view>
    <view class="content-wrap">
      <view class="con-tit">以下字段为必填项</view>
      <view class="con-all bg-white">
        <view class="vw-wrap">
          <image src="../../images/distance.svg" class="icons"></image>
          <view class="form-item">
            <label for="" class="title">里程</label>
            <input type="digit" focus="{{focus}}" value="{{distance}}" name="distance" class="ipt ellipsis" placeholder="请输入运动里程"></input>
          </view>
        </view>
        <view class="vw-wrap">
          <view class="form-item">
          <image src="../../images/speed.svg" class="icons"></image>
          <label for="" class="title">配速</label>
          <input type="number" focus="{{focus}}" class="ipt {{clas}}" wx:if="{{speed == ''}}" value="请选择运动配速" bindtap="pickerSpeed" disabled="disabled"></input>
          <input type="number" focus="{{focus}}" value="{{speed}}" bindtap="pickerSpeed" name="speed" class="ipt" disabled="disabled" wx:else></input>
          <picker
          style='font-size:32rpx;color:#999;letter-spacing:2rpx;overflow: hidden;text-overflow: ellipsis;white-space: nowrap;'
          bindchange="pickerSpeed"
          isShowPicker="{{isShow_03}}"
          bindsure="sureCallBack_03"
          bindcancle="cancleCallBack_03"
          scrollType="normal"
          listData="{{timeArray}}"
          >
          </picker>
        </view>
        </view>
        
      </view>
    </view>
    <view class="content-wrap">
      <view class="con-tit">以下字段为选填项</view>
      <view class="con-all bg-white">
        <view class="vw-wrap">
          <image src="../../images/default.svg" class="icons"></image>
          <view class="form-item">
            <label for="" class="title">运动时长</label>
            <input type="text" focus="{{focus}}" value="{{time}}" name="time" class="ipt ellipsis" placeholder="请输入运动时长"></input>
          </view>
        </view>
        <view class="vw-wrap">
          <image src="../../images/default.svg" class="icons"></image>
          <view class="form-item">
            <label for="" class="title">消耗热量</label>
            <input type="digit" focus="{{focus}}" value="{{energy}}" name="energy" class="ipt ellipsis" placeholder="请输入消耗热量"></input>
          </view>
        </view>
        <view class="vw-wrap">
          <image src="../../images/default.svg" class="icons"></image>
          <view class="form-item">
            <label for="" class="title">运动时间</label>
            <input type="text" focus="{{focus}}" value="{{date}}" name="date" class="ipt ellipsis" placeholder="请输入运动时间"></input>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="full-btn">
    <button class="btn green" form-type="submit" disabled="{{disable}}">打卡</button>
  </view>
  </form>
</scroll-view>