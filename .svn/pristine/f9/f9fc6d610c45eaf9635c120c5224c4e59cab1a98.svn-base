/* pages/news/news.wxss */
page{
  background: #fff;
}
.news-list{
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}
.news-list .text{
  display: flex;
  align-items: center;
  width: 70%;
  height: 166rpx;
  /* box-sizing: border-box; */
  border-bottom: 1px solid #f1f1f1;
  padding-bottom: 40rpx;
}
.news-list .img{
  margin-left: auto;
}
.news-list .img image{
  width: 160rpx;
  height: 120rpx;
}
.logo{
  text-align: center;
}
.logo image{
  display: inline-block;
  width: 30%;
}
.new-con{
  font-size: 28rpx;
  line-height: 2;
  text-align: justify;
  padding-top: 60rpx;
}
.tit-main{
  display: inline-block;
  text-align: center;
  margin: 50rpx 0 30rpx;
  padding: 4rpx;
  border-top: 2px solid rgb(71, 193, 168);
  border-bottom: 2px solid rgb(71, 193, 168);
}
.tit-one{
  font-size: 32rpx;
  font-weight: bold;
  margin: 30rpx 0;
}
.tit-wrap{
  text-align: center;
}
.tit-two{
  display: inline-block;
  color: #000;
  border-bottom: 2px solid #000;
  margin: 20rpx 0;
}
.tips{
  /* color: #999; */
  margin: 20rpx 0;
}
.all-con{
  background: rgb(239, 247, 255);
  padding: 20rpx;
  border: 1px solid #000;
  border-color: rgb(243, 100, 82) rgb(122, 175, 231) rgb(247, 192, 95) rgb(109, 203, 155);
}
.team-show{
  display: flex;
  justify-content: space-between;
  text-align: center;
  margin: 20rpx 0 160rpx;
}
.team-item{
  width: 20%;
}
.team-item image{
  width: 100%;
  border-radius: 50%;
  margin-bottom: 20rpx;
}
.team-item .title{
  font-size: 26rpx;
  color: rgb(71, 193, 168);
}
.sub-tit{
  margin: 20rpx 0 ;
}
.user-wrap{
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  padding-top: 40rpx;
}
.user-pic{
  width: 25%;
  position: relative;
  margin-bottom: 40rpx;
  display: flex;
  text-align: center;
  flex-direction: column;
  align-items: center;
}
.user-pic.add-bd .pic{
  border: 3px solid #fcb81d;
  margin-right: 0;
  margin-bottom: 10rpx;
}
.user-pic .vip{
  width: 40rpx;
  height: 40rpx;
  position: absolute;
  right: 20rpx;
  bottom: 0;
}
.vip-list {
  width: 25%;
}