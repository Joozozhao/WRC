<!--pages/hope/hope.wxml-->
<view class="page-wrap">
  <view class="hope-list">
    <view class="hope-item" wx:for="{{hopeList}}" wx:key="index" wx:if="{{index%2==0}}">
      <view class="hope-pic">
        <image src="{{item.hopePic}}" mode="aspectFill"></image>
      </view>
      <view class="hope-name">{{item.hopeName}}</view>
      <view class="btm-content">
        <view></view>
        <view class="mla" wx:if="{{item.hopeNum==0}}"><image src="/images/heart0.svg" class="ico"></image>想要</view>
        <view class="mla" wx:else><image src="/images/heart.svg" class="ico"></image>{{item.hopeNum}}</view>
      </view>
    </view>
  </view>
  <view class="hope-list">
    <view class="hope-item" wx:for="{{hopeList}}" wx:key="index" wx:if="{{index%2==1}}">
      <view class="hope-pic">
        <image src="{{item.hopePic}}" mode="aspectFill"></image>
      </view>
      <view class="hope-name">{{item.hopeName}}</view>
      <view class="btm-content">
        <view></view>
        <view class="mla" wx:if="{{item.hopeNum==0}}"><image src="/images/heart0.svg" class="ico"></image>想要</view>
        <view class="mla" wx:else><image src="/images/heart.svg" class="ico"></image>{{item.hopeNum}}</view>
      </view>
    </view>
  </view>
</view>
<view class="full-btn">
  <button class="btn btnTwo" bindtap="toLoad" disabled="{{disable}}">上传心愿</button>
</view>