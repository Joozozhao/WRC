/* pages/challenge/challenge.wxss */
page{
  background: #333;
}
.challenge{
  /* background: #333; */
  /* padding: 30rpx 30rpx 0; */
}
.challenge-img{
  position: relative;
  overflow: hidden;
}
.challenge-img .challenge-wrap{
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,.7);
  left: 0;
  top: 0;
  z-index: 1;
}
.challenge-img .challenge-state{
  width: 80vw;
  height: 80vh;
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%,-50%);
  z-index: 2;
}
.challenge .challenge-cover{
  width: 100%;
}
.acty-infors{
  padding: 20rpx;
  font-size: 24rpx;
  color: #fff;
}
.acty-infors .acty-state{
  color: #ff5e62;
  margin-right: 10rpx;
}
.acty-infors .flex-con{
  display: flex;
  align-items: center;
  margin: 10rpx 0;
}
.acty-infors .acty-name{
  font-size: 32rpx;
}
.acty-infors .num{
  margin-left: auto;
}