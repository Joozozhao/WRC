/* pages/hope/hope.wxss */
.page-wrap{
  padding: 3vw 30rpx 180rpx;
}
.hope-list{
  /* display: flex;
  flex-wrap: wrap;
  justify-content: space-evenly; */
  display: inline-block;
  width: 48%;
}

.hope-list:nth-child(2){
  float: right;
}
.hope-item{
  width: 100%;
  background: #fff;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
}
.hope-item .hope-pic{
  width: 100%;
}
.hope-item .hope-pic image{
  width: 100%;
  height: 400rpx;
}
.hope-item .hope-name{
  padding:10rpx 20rpx;
  text-align: justify;
  /* line-height: 60rpx; */
}
.btm-content{
  display: flex;
  color: #999;
}

.btm-content .mla{
  display: flex;
  padding: 0 20rpx 20rpx;
  margin-left: auto;
}
.btm-content .mla .ico{
  width: 40rpx;
  height: 40rpx;
  margin-right: 6rpx;
}