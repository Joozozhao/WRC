<!--pages/address/address.wxml-->
<view class="address-list">
<block wx:for="{{addressList}}" wx:key="index">
    <view class="vw-wrap bg-white list-item">
      <!-- <navigator url="../confirmorder/confirmorder?id={{item.id}}" hover-class="none"> -->
        <view class="address-infor" data-id="{{item.id}}" bindtap="chooseAdd">
          <view class="receiver">
            <view class="name">{{item.name}}</view>
            <view class="number">{{item.mobile}}</view>
          </view>
          <view class="address-details">{{item.address}}</view>
        </view>
      <!-- </navigator> -->
      <view class="edit-address">
        <view class="default">
            <label class="radio" >
                <radio value='{{item.id}}' bindtap="setdefAdd" data-id="{{item.id}}" checked="{{item.id==id}}" />
                <text>设为默认地址</text>
            </label>
        </view>
        <view class="icons">
          <view class="icon" bindtap="editIt" data-id="{{item.id}}"><image src="../../images/edit-gray.png"></image></view>
          <view class="icon" bindtap="delIt" data-id="{{item.id}}"><image src="../../images/del-gray.png"></image></view>
        </view>
      </view>
    </view>
</block>
</view>

<view class="bg-white full-btn">
  <navigator url="/pages/newaddress/newaddress" hover-class="none"><button class="btn btnOne">添加新地址</button></navigator>
</view>