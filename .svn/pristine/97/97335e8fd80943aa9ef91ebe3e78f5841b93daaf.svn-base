<!--pages/challenge/challenge.wxml-->
<view>
  <block wx:for="{{challengeList}}" wx:key='index'>
    <view class="challenge" wx:if="{{item.acty_type!=='V挑战'}}">
      <view class="challenge-img" bindtap="toDetail" data-id="{{item.acty_id}}" data-name="{{item.acty_name}}">
        <image src="{{item.acty_img}}" mode="widthFix" style="height:auto;" class="challenge-cover"></image>
        <view wx:if="{{item.days < 0}}">
          <view class="challenge-wrap"></view>
          <image src="/images/2-1.png" mode="widthFix" style="height:auto;" class="challenge-state" wx:if="{{item.rate == '100%'&&item.join_time !== '未参加该挑战!'}}"></image>
          <image src="../../images/3-1.png" mode="widthFix" style="height:auto;" class="challenge-state" wx:if="{{item.join_time == '未参加该挑战!'}}"></image>
          <image src="/images/1-1.png" mode="widthFix" style="height:auto;" class="challenge-state" wx:if="{{item.rate !== '100%'&&item.join_time !== '未参加该挑战!'}}"></image>
        </view>
      </view>
      <view class="acty-infors" wx:if="{{item.days >= 0}}" bindtap="toDetail" data-id="{{item.acty_id}}" data-name="{{item.acty_name}}">
        <view><text class="acty-state">火热进行中</text> 剩余{{item.days+1}}天</view>
        <view class="flex-con"><text class="acty-name">{{item.acty_name}}</text><!-- <text class="num">{{item.joins}}人参与</text> --></view>
      </view>
      <view class="acty-infors" wx:else>
        <view><text class="acty-state">挑战结束</text> <text class="num">结束日期：{{item.end_time}}</text></view>
        <view class="flex-con"><text class="acty-name">{{item.acty_name}}</text><!-- <text class="num">{{item.joins}}人参与</text> --></view>
      </view>
      <view class="act-btn" wx:if="{{duty == '管理员'||duty == '管理员/团长'}}">
        <text class="btn edit" wx:if="{{item.days>=0&&item.acty_type=='V挑战'}}" bindtap="addRules" data-id="{{item.acty_id}}">+规则</text>
        <text class="btn edit" wx:if="{{item.days>=0&&item.acty_type=='V挑战'}}" bindtap="delRules" data-id="{{item.acty_id}}">删除规则</text>
        <text class="btn edit" wx:if="{{item.days>=0}}" bindtap="editCon" data-id="{{item.acty_id}}">编辑</text>
        <text class="btn del" wx:if="{{item.rank_list==0}}" bindtap="toTop" data-id="{{item.acty_id}}">上榜</text>
        <text class="btn del" wx:if="{{item.rank_list==1}}" bindtap="upTop" data-id="{{item.acty_id}}">下榜</text>
        <text class="btn del" bindtap="delCon" data-index="{{index}}" data-id="{{item.acty_id}}">删除</text>
      </view>
    </view>
    <view class="challenge" wx:if="{{item.acty_type=='V挑战'&&(duty=='管理员'||duty=='管理员/团长')}}">
      <view class="challenge-img" bindtap="toDetail" data-id="{{item.acty_id}}" data-name="{{item.acty_name}}">
        <image src="{{item.acty_img}}" mode="widthFix" style="height:auto;" class="challenge-cover"></image>
        <view wx:if="{{item.days < 0}}">
          <view class="challenge-wrap"></view>
          <image src="/images/2-1.png" mode="widthFix" style="height:auto;" class="challenge-state" wx:if="{{item.rate == '100%'&&item.join_time !== '未参加该挑战!'}}"></image>
          <image src="../../images/3-1.png" mode="widthFix" style="height:auto;" class="challenge-state" wx:if="{{item.join_time == '未参加该挑战!'}}"></image>
          <image src="/images/1-1.png" mode="widthFix" style="height:auto;" class="challenge-state" wx:if="{{item.rate !== '100%'&&item.join_time !== '未参加该挑战!'}}"></image>
        </view>
      </view>
      <view class="acty-infors" wx:if="{{item.days >= 0}}" bindtap="toDetail" data-id="{{item.acty_id}}" data-name="{{item.acty_name}}">
        <view><text class="acty-state">火热进行中</text> 剩余{{item.days+1}}天</view>
        <view class="flex-con"><text class="acty-name">{{item.acty_name}}</text><!--<text class="num">{{item.joins}}人参与</text> --></view>
      </view>
      <view class="acty-infors" wx:else>
        <view><text class="acty-state">挑战结束</text> <text class="num">结束日期：{{item.end_time}}</text></view>
        <view class="flex-con"><text class="acty-name">{{item.acty_name}}</text><!--<text class="num">{{item.joins}}人参与</text> --></view>
      </view>
      <view class="act-btn" wx:if="{{duty == '管理员'||duty == '管理员/团长'}}">
        <text class="btn edit" wx:if="{{item.days>=0&&item.acty_type=='V挑战'}}" bindtap="addRules" data-id="{{item.acty_id}}">+规则</text>
        <text class="btn edit" wx:if="{{item.days>=0&&item.acty_type=='V挑战'}}" bindtap="delRules" data-id="{{item.acty_id}}">删除规则</text>
        <text class="btn edit" wx:if="{{item.days>=0}}" bindtap="editCon" data-id="{{item.acty_id}}">编辑</text>
        <text class="btn del" bindtap="delCon" data-index="{{index}}" data-id="{{item.acty_id}}">删除</text>
      </view>
    </view>
  </block>
</view>
<tabbar tabbar="{{tabbar}}"></tabbar>
















