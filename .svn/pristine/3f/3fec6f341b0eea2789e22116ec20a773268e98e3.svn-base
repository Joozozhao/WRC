/* pages/addtype/addtype.wxss */
.add-type{
  width: 100% !important;
  line-height: 80rpx;
  background: #4e505f;
  text-align: center;
  color: #fff;
  border-radius: 0;
  font-weight: normal;
  margin-top: 30rpx;
}
.type-name{
  flex: 1;
  min-width: 100rpx;
  line-height: 50rpx;
}
.type-right{
  flex: 3;
}
.type-item{
  display: flex;
  margin-bottom: 20rpx;
}
.type-item:nth-last-child(1){
  margin-bottom: 0;
}
.tag-desc{
  flex: 1;
  background: #4e505f;
  color: #fff;
  padding: 0 20rpx;
  line-height: 50rpx;
}
.tag-total{
  display: flex;
}

.type-con{
  padding: 30rpx;
  position: relative;
}
.type-con .del{
  width: 60rpx;
  height: 60rpx;
  position: absolute;
  top: 10rpx;
  left: 20rpx;
}
.new-type{
  display: flex;
}
.new-type input,.contact-type input{
  width: 80%;
  border: 1px solid #e1e1e1;
  height: 100rpx;
  line-height: 100rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.new-btn{
  width: 16%;
  line-height: 100rpx;
  background: #4e505f;
  margin-left: auto;
  font-size: 70rpx;
  color: #fff;
  text-align: center;
}
.contact-type{
  display: flex;
  align-items: center;
  margin-top: 30rpx;
}
.contact-type input{
  width: 48%; 
}
.contact-type input:nth-child(2){
  margin-left: auto;
}
.type-infor{
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 0;
  line-height: 50rpx;
}
.type-infor>view{
  margin-right: 20rpx;
}
.type-con.old .contact-type input{
  flex: 1;
  margin-right: 20rpx;
}
.type-con.old .contact-type .desc{
  flex: 3;
}
.type-con.old .contact-type .stock{
  text-align: center;
}
.type-con.old .contact-type .del-btn{
  width: auto;
  flex: 1;
  font-size: 32rpx;
}
.default-tit{
  padding: 20rpx 30rpx 0;
  font-size: 24rpx;
  color: #666;
}
.act-btn.add-con{
  width: 100%;
  font-size: 32rpx;
  color: #fff;
  text-align: center;
  line-height: 100rpx;
  background: #4e505f;
}
.act-btn.del-con{
  background: #E66671;
}
.good-name{
  font-size: 32rpx;
  padding: 30rpx 30rpx 0;
  color: #333;
}