<!--pages/lottery/lottery.wxml-->
<form bindsubmit="submit">
  <view class="form-con">
    <view class="form-item vw-wrap">
      <label for="" class="title">选择活动</label>
      <input type="text" value="{{actyName}}" name="actyName" placeholder="请选择" class="ipt ellipsis" disabled="disabled" bindtap="toChooseActy"></input>
      <view class="add-arrow"><image src="../../images/arrow-r-gray.png" mode="widthFix"></image></view>
    </view>
    <view class="form-item vw-wrap">
      <label for="" class="title">活动地区</label>
      <view class="ipt" bindtap="pickArea">
        <view wx:if="{{sealType == ''}}">请选择</view>
        <input type="text" class="ipt" wx:else class="picker {{clas}}" name="sealType" value="{{sealType}}" disabled="disabled"></input>
      </view>
      <!-- 遮罩层 -->
      <view class="modal-mask" wx:if="{{showModal}}"></view>
      <!-- 弹出框 -->
      <view class="modal-dialog" wx:if="{{showModal}}">
        <view class="modal-content">
          <checkbox-group data-index="{{index}}" bindchange="checkboxChange" name="sealType">
            <label class="checkbox" wx:for="{{sealTypeList}}" wx:key="key" wx:for-item="item">
              <checkbox value="{{item.id}}" checked="{{item.checked}}" color="#2A98BD" />
              <view class="checked_label" style="color:#37383B">{{item.gzkind}}</view>
            </label>
          </checkbox-group>
        </view>
        <!-- 操作按钮 -->
        <view class="modal-footer">
          <button class="btn btn-cancel" bindtap="onCancel" data-status="cancel">取消</button>
          <button class="btn btn-confirm" bindtap="onConfirm" data-status="confirm">确定</button>
        </view>
      </view>
      <view class="add-arrow"><image src="../../images/arrow-r-gray.png" mode="widthFix"></image></view>
    </view>
    <view class="form-item vw-wrap">
      <label for="" class="title">选择奖品</label>
      <input type="text" value="{{goodsName}}" name="goodsName" placeholder="请选择" class="ipt ellipsis" disabled="disabled" bindtap="toChoosePrize"></input>
      <view class="add-arrow"><image src="../../images/arrow-r-gray.png" mode="widthFix"></image></view>
    </view>
    <!-- <view class="form-item vw-wrap">
      <label for="" class="title">奖品名称</label>
      <input type="text" value="{{autoName}}" name="autoName" placeholder="请输入" class="ipt" disabled="disabled"></input>
      <view class="add-arrow"><image src="../../images/arrow-r-gray.png" mode="widthFix"></image></view>
    </view> -->
    <view class="form-item vw-wrap">
      <label for="" class="title">奖品份数</label>
      <input type="number" value="{{actyNum}}" name="actyNum" placeholder="请输入奖品份数" class="ipt"></input>
      <view class="add-arrow"><image src="../../images/arrow-r-gray.png" mode="widthFix"></image></view>
    </view>
    <view class="form-item vw-wrap">
      <label for="" class="title">开奖时间</label>
      <view class="ipt">
        
        <picker class='time-picker' mode="multiSelector" bindchange="bindStartMultiPickerChange" bindtap='pickerTap' bindcolumnchange="bindMultiPickerColumnChange" value="{{multiIndex}}" range="{{multiArray}}">
          <view style="margin-right:0;" wx:if="{{startDate == ''}}" class="ipt" bindtap='pickerTap'>请选择日期</view>
          <!-- <input type="text" value="请选择日期" bindtap='pickerTap' disabled="disabled" style="margin-right:0;" wx:if="{{startDate == ''}}" class="ipt"></input> -->
          <input type="text" value="{{startDate}}"  bindtap='pickerTap' disabled="disabled" style="margin-right:0;" wx:else class="ipt"></input>
        </picker>
      </view>
      <view class="add-arrow"><image src="../../images/arrow-r-gray.png" mode="widthFix"></image></view>
    </view>
  </view>
  <view class="full-btn">
    <button class="btn btnTwo" form-type="submit">完成</button>
  </view>
</form>