<!--pages/newsDetails/newsDetails.wxml-->
<import src="../../wxParse/wxParse.wxml"/>
<view class="vw-wrap">
  <view class="newsDetails">
    <view class="news-tit">{{title}}</view>
    <view class="news-infor"><text class="author">{{author}}</text><text class="date">{{pubdate}}</text></view>
    <view class="news-content">
      <view class="wxParse">
      <!-- 这里data中article为bindName -->
      <template is="wxParse" data="{{wxParseData:article.nodes}}"/>
      </view>
    </view>
  </view>
</view>
<home />