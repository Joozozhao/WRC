<!--pages/mydata/mydata.wxml-->
<wxs src="../../utils/toDecimal2.wxs" module="module1" />
<view class="gradient-bg">
  <scroll-view scroll-y="true" style="height: 100vh;">
    <view class="vw-wrap">
      <view class="user-infor">
        <view class="user-pic">
          <image src="{{headerImg}}" mode="widthFix" class="pic"></image>
        </view>
        <view style="width:50%">
          <view class="infor">
            <view class="user-name" wx:if="{{userName==''}}">{{nickName}}</view>
            <view class="user-name" wx:else>{{userName}}</view>
            <view class="sex" wx:if="{{sex == 1}}">
              <image src="../../images/me-n.svg"></image>
            </view>
            <view class="sex" wx:if="{{sex == 2}}">
              <image src="../../images/me-v.svg"></image>
            </view>
            <view wx:if="{{level == 'VIP'}}">
              <image src="../../images/superVIP.svg" mode="widthFix" class="level"></image>
            </view>
            <view wx:if="{{level == '普通'}}">
              <image src="../../images/normalVIP.svg" mode="widthFix" class="level"></image>
            </view>
          </view>
          <view class="user-name" style="margin-top:10rpx;">
            <text class="tag" wx:if="{{userId>0}}">ID{{userId}}</text>
            <view class="tag title" wx:if="{{duty=='团长'||duty=='管理员/团长'}}"><text> 团团 ヅ </text></view>
          </view>
        </view>
        <view class="edit-infor" bindtap="editInfor">
          <image src="../../images/ellipsis.svg" mode="widthFix"></image>
        </view>
      </view>
      <view class="box-part-wrap index-part">
        <view class="box-part">
          <view class="my-point" bindtap="checkPoint">
            <view class="my-points">{{score}}</view>
            <view class="tit">积分</view>
          </view>
          <view class="my-point" bindtap="checkEnergy">
            <view class="my-points">{{energy}}</view>
            <view class="tit">能量</view>
          </view>
          <view class="my-point">
            <view class="my-points">{{module1.slice(monthDistance)}}</view>
            <view class="tit">本月</view>
          </view>
          <view class="my-point">
            <view class="my-points">{{module1.slice(totalDistance)}}</view>
            <view class="tit">总量</view>
          </view>
        </view>
      </view>
    </view>
    <view class="week-data">
      <view class="vw-wrap">
        <view class="week-con">
          <view class="acty-tit tit-toggle small">
          <view class="sub-tit {{weekChoosed?'actived':''}}" bindtap="weekClick">本周</view>
          <view class="sub-tit {{monthChoosed?'actived':''}}" bindtap="monthClick">本月</view>
          <text class="time-region" wx:if="{{weekShow}}">({{starTime}} ~ {{endTime}})</text>
          </view>
          <view class="echart_panel" wx:if="{{weekShow}}">
            <ec-canvas ec="{{ecBar}}" bind:init="initBarData"></ec-canvas>
          </view>
          <view class="echart_panel" wx:if="{{monthShow}}">
            <ec-canvas ec="{{ecBar}}" bind:init="initMonthData"></ec-canvas>
          </view>
        </view>
      </view>
    </view>
    <view class="week-data" wx:if="{{haveSuperActy}}">
      <view class="vw-wrap">
        <view class="data-con bg-white" style="margin-bottom: 30rpx;padding-bottom: 20rpx;">
          <view class="acty-tit tit-toggle">挑战项<text class="time-region">({{pasStartDate2}} ~ {{passEndDate2}})</text></view>
          <swiper wx:if="{{sex==1}}" autoplay="{{swiper2.autoplay}}" interval="{{swiper2.interval}}" duration="{{swiper2.duration}}" current="{{swiper2.current}}" circular="{{swiper2.circular}}" previous-margin="-30rpx" next-margin="-30rpx" style="height: 26vh;overflow: hidden;">
            <swiper-item wx:for="{{swiper2.qualifications}}" wx:key="index">
              <view class="data-body">
                <view class="flex-con">
                  <view class="pre arrow" bindtap="prev2">
                    <image src="/images/prev.svg" mode="widthFix"></image>
                  </view>
                  <view class="choose-date">{{index}}</view>
                  <view class="next arrow" bindtap="next2">
                    <image src="/images/next.svg" mode="widthFix"></image>
                  </view>
                </view>
                <view class="flex-con pies-con">
                  <view class="pies-wrap" wx:for="{{item.week_temps}}" wx:for-item="items" wx:for-index="childindex" wx:key="index">
                    <view class="pies-subwrap" wx:if="{{echartShow}}">
                      <view class="echart_panel">
                        <ec-canvas ec="{{ecPie1}}" bind:init="initPie2" data-times="{{items.sport_days}}"></ec-canvas>
                      </view>
                    </view>
                    <view class="line"></view>
                    <view class="date">
                      <view>{{childindex}}</view>
                    </view>
                  </view>
                </view>
                <view class="progress-content">
                  <view class="progress-con">
                    <view class="data">{{item.sport_amount}}/{{passDistance2}}</view>
                    <view class="percent">{{module1.slice(module1.GetPercent(item.sport_amount,passDistance2))}}%</view>
                    <view wx:if="{{module1.GetPercent(item.sport_amount,passDistance2) >= 100}}">
                      <progress percent="{{module1.GetPercent(item.sport_amount,passDistance2)}}" stroke-width="30" color="#4ecca3" backgroundColor="#f7f6e7" />
                    </view>
                    <view wx:else>
                      <progress percent="{{module1.GetPercent(item.sport_amount,passDistance2)}}" stroke-width="30" color="#fb929e" backgroundColor="#f7f6e7" />
                    </view>
                  </view>
                </view>
              </view>
            </swiper-item>
          </swiper>
          <swiper wx:if="{{sex==2}}" autoplay="{{swiper2.autoplay}}" interval="{{swiper2.interval}}" duration="{{swiper2.duration}}" current="{{swiper2.current}}" circular="{{swiper2.circular}}" previous-margin="-30rpx" next-margin="-30rpx" style="height: 43vh;overflow: hidden;">
            <swiper-item wx:for="{{swiper2.qualifications}}" wx:key="index">
              <view class="data-body">
                <view class="flex-con">
                  <view class="pre arrow" bindtap="prev2">
                    <image src="/images/prev.svg" mode="widthFix"></image>
                  </view>
                  <view class="choose-date">{{index}}</view>
                  <view class="next arrow" bindtap="next2">
                    <image src="/images/next.svg" mode="widthFix"></image>
                  </view>
                </view>
                <view class="girls-circle">
                  <view class="pies-subwrap">
                    <view class="echart_panel">
                      <ec-canvas ec="{{ecPie00}}" bind:init="initPie00" data-days="{{item.sport_days}}" data-list="{{item.week_list}}"></ec-canvas>
                    </view>
                  </view>
                </view>
                <view class="progress-content">
                  <view class="progress-con">
                    <view class="data">{{item.sport_amount}}/{{passDistance2}}</view>
                    <view class="percent">{{module1.slice(module1.GetPercent(item.sport_amount,passDistance2))}}%</view>
                    <view wx:if="{{module1.GetPercent(item.sport_amount,passDistance2) >= 100}}">
                      <progress percent="{{module1.GetPercent(item.sport_amount,passDistance2)}}" stroke-width="30" color="#4ecca3" backgroundColor="#f7f6e7" />
                    </view>
                    <view wx:else>
                      <progress percent="{{module1.GetPercent(item.sport_amount,passDistance2)}}" stroke-width="30" color="#fb929e" backgroundColor="#f7f6e7" />
                    </view>
                  </view>
                </view>
              </view>
            </swiper-item>
          </swiper>
        </view>
        <view class="data-con bg-white" style="margin-bottom: 30rpx;padding-bottom: 20rpx;">
          <view class="acty-tit tit-toggle">资格项<text class="time-region">({{pasStartDate}} ~ {{passEndDate}})</text></view>
          <swiper wx:if="{{sex==1}}" autoplay="{{swiper.autoplay}}" interval="{{swiper.interval}}" duration="{{swiper.duration}}" current="{{swiper.current}}" circular="{{swiper.circular}}" previous-margin="-30rpx" next-margin="-30rpx" style="height: 26vh;overflow: hidden;">
            <swiper-item wx:for="{{swiper.qualifications}}" wx:key="index">
              <view class="data-body">
                <view class="flex-con">
                  <view class="pre arrow" bindtap="prev">
                    <image src="/images/prev.svg" mode="widthFix"></image>
                  </view>
                  <view class="choose-date">{{index}}</view>
                  <view class="next arrow" bindtap="next">
                    <image src="/images/next.svg" mode="widthFix"></image>
                  </view>
                </view>
                <view class="flex-con pies-con">
                  <view class="pies-wrap" wx:for="{{item.week_temps}}" wx:for-item="items" wx:for-index="childindex" wx:key="index">
                    <view class="pies-subwrap" wx:if="{{echartShow}}">
                      <view class="echart_panel">
                        <ec-canvas ec="{{ecPie1}}" bind:init="initPie1" data-times="{{items.sport_days}}"></ec-canvas>
                      </view>
                    </view>
                    <view class="line"></view>
                    <view class="date">
                      <view>{{childindex}}</view>
                    </view>
                  </view>
                </view>
                <view class="progress-content">
                  <view class="progress-con">
                    <view class="data">{{item.sport_amount}}/{{passDistance}}</view>
                    <view class="percent">{{module1.slice(module1.GetPercent(item.sport_amount,passDistance))}}%</view>
                    <view wx:if="{{module1.GetPercent(item.sport_amount,passDistance) >= 100}}">
                      <progress percent="{{module1.GetPercent(item.sport_amount,passDistance)}}" stroke-width="30" color="#4ecca3" backgroundColor="#f7f6e7" />
                    </view>
                    <view wx:else>
                      <progress percent="{{module1.GetPercent(item.sport_amount,passDistance)}}" stroke-width="30" color="#fb929e" backgroundColor="#f7f6e7" />
                    </view>
                  </view>
                </view>
              </view>
            </swiper-item>
          </swiper>
          <swiper wx:if="{{sex==2}}" autoplay="{{swiper.autoplay}}" interval="{{swiper.interval}}" duration="{{swiper.duration}}" current="{{swiper.current}}" circular="{{swiper.circular}}" previous-margin="-30rpx" next-margin="-30rpx" style="height: 43vh;overflow: hidden;">
            <swiper-item wx:for="{{swiper.qualifications}}" wx:key="index">
              <view class="data-body">
                <view class="flex-con">
                  <view class="pre arrow" bindtap="prev">
                    <image src="/images/prev.svg" mode="widthFix"></image>
                  </view>
                  <view class="choose-date">{{index}}</view>
                  <view class="next arrow" bindtap="next">
                    <image src="/images/next.svg" mode="widthFix"></image>
                  </view>
                </view>
                <view class="girls-circle">
                  <view class="pies-subwrap">
                    <view class="echart_panel">
                      <ec-canvas ec="{{ecPie0}}" bind:init="initPie0" data-days="{{item.sport_days}}" data-list="{{item.week_list}}"></ec-canvas>
                    </view>
                  </view>
                </view>
                <view class="progress-content">
                  <view class="progress-con">
                    <view class="data">{{item.sport_amount}}/{{passDistance}}</view>
                    <view class="percent">{{module1.slice(module1.GetPercent(item.sport_amount,passDistance))}}%</view>
                    <view wx:if="{{module1.GetPercent(item.sport_amount,passDistance) >= 100}}">
                      <progress percent="{{module1.GetPercent(item.sport_amount,passDistance)}}" stroke-width="30" color="#4ecca3" backgroundColor="#f7f6e7" />
                    </view>
                    <view wx:else>
                      <progress percent="{{module1.GetPercent(item.sport_amount,passDistance)}}" stroke-width="30" color="#fb929e" backgroundColor="#f7f6e7" />
                    </view>
                  </view>
                </view>
              </view>
            </swiper-item>
          </swiper>
        </view>
      </view>
    </view>
    <all-activity totalChallenge="{{totalChallenge}}" totalActy="{{totalActy}}" activityList="{{activityList}}" activityList2="{{activityList2}}" bind:parentEvent="loadMore" bind:parentEvent2="loadMore2" bind:parentEvent3="toDet"></all-activity>
    <view style="height: 100rpx;"></view>
  </scroll-view>
</view>
<tabbar tabbar="{{tabbar}}"></tabbar>