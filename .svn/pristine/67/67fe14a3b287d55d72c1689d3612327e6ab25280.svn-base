<!--pages/actyin/actyin.wxml-->
<view class="vw-wrap" style="padding: 0 30rpx 150rpx;height:{{getH}};overflow-y:hidden;">
  <view class="selected-con">
    <view class="sel-item">
      <view bindtap="clickLevel"><view class="sel-tit">类型<image src="{{iconState?'/images/arrow-r.svg':'/images/arrow-d.svg'}}"></image></view></view>
    </view>
    <view class="sel-item">
      <view bindtap="clickSort" wx:if="{{state1}}"><view class="sel-tit sort">排序<image src="/images/up-icon.svg"></image></view></view>
      <view bindtap="clickSort2" wx:if="{{state2}}"><view class="sel-tit sort">排序<image src="/images/down-icon.svg"></image></view></view>
    </view>
    <view class="sel-tit sel-btn" bindtap="selBtn">筛选</view>
  </view>
  <view class="item-pop {{selAll?'show':'hide'}}">
    <view class="all-item">
      <text class="{{id==index ? 'active' : ''}}" wx:for="{{selList}}" wx:key="index" data-id="{{index}}" data-txt="{{item}}" bindtap="choose">{{item}}</text>
    </view>
  </view>
  <block wx:for="{{memberList}}" wx:key="id" >
    <view class="member" data-userid="{{item.id}}" bindtap="myData">
      <view class="user-infor">
        <view class="user-pic {{item.level == 'VIP'?'add-bd':''}}" wx:if="{{item.level == 'VIP'}}">
          <image src="{{item.header_url}}" mode="widthFix" class="pic"></image>
          <image src="../../images/vip_1.svg" mode="cover" class="vip"></image>
        </view>
        <view class="user-pic {{item.level == '普通'?'add-bd1':''}}" wx:if="{{item.level == '普通'}}">
          <image src="{{item.header_url}}" mode="widthFix" class="pic"></image>
          <image src="../../images/normal.svg" mode="cover" class="vip"></image>
        </view>
        <view class="user-pic {{item.level == '非会员'?'add-bd2':''}}" wx:if="{{item.level == '非会员'}}">
          <image src="{{item.header_url}}" mode="widthFix" class="pic"></image>
          <image src="../../images/none.svg" mode="cover" class="vip"></image>
        </view>
        <view class="more-infor">
          <view class="nick-name">{{item.user_name}}</view>
          <view class="user-con">
            <view class="sex" wx:if="{{item.sex == 1}}"><image src="../../images/man.svg"></image></view>
            <view class="sex" wx:if="{{item.sex == 2}}"><image src="../../images/woman.svg"></image></view>
            <view class="state over">已参加</view>
          </view>
        </view>
      </view>
      <wxs module="fn1">
        module.exports = {
          GetPercent: function (num, total) {
            num = parseFloat(num);
            total = parseFloat(total);
            if (isNaN(num) || isNaN(total)) {
                return 0;
            }
            return total <= 0 ? "0%" : (Math.round(num / total * 10000) / 100.00);
          },
          // toSplit: function(value) { //字符串拆分
          //   return value.split('_');
          // }
          //等等
        }
      </wxs>
      <view class="progress-con">
        <view>{{item.finish_distance}}/{{item.distance}}</view>
        <view wx:if="{{fn1.GetPercent(item.finish_distance,item.distance) >= 100}}">
          <progress percent="100" stroke-width="3" color="#4ec17e" wx:if="{{item.finish_distance>item.distance}}"  />
          <progress percent="{{fn1.GetPercent(item.finish_distance,item.distance)}}" stroke-width="3" color="#4ec17e" wx:else  />
        </view>
        <view wx:if="{{fn1.GetPercent(item.finish_distance,item.distance)>=50&&fn1.GetPercent(item.finish_distance,item.distance)<100}}">
          <progress percent="100" stroke-width="3" color="#566dd0" wx:if="{{item.finish_distance>item.distance}}"  />
          <progress percent="{{fn1.GetPercent(item.finish_distance,item.distance)}}" stroke-width="3" color="#566dd0" wx:else  />
        </view>
        <view wx:if="{{fn1.GetPercent(item.finish_distance,item.distance) < 50}}">
          <progress percent="100" stroke-width="3" color="#ec6262" wx:if="{{item.finish_distance>item.distance}}"  />
          <progress percent="{{fn1.GetPercent(item.finish_distance,item.distance)}}" stroke-width="3" color="#ec6262" wx:else  />
        </view>
        
        <!-- #43b0d4 #f2c863 #ec6262 --> 
      </view>
    </view>
  </block>
  <view wx:if="{{noList}}" style="padding: 30rpx 0;text-align:center;">暂无数据</view>
</view>
<home />