<!--pages/toNews/toNews.wxml-->
<view class="address-list">
  <block wx:for="{{newsList}}" wx:key="index">
      <view class="vw-wrap bg-white list-item">
        <view class="address-infor" data-id="{{item.id}}" bindtap="chooseAdd">
          <view class="address-details">{{item.title}}</view>
          <view class="creat-time">{{item.create_time}}</view>
        </view>
        <view class="edit-address">
          <view class="icons">
            <view class="icon" bindtap="editIt" data-id="{{item.id}}"><image src="../../images/edit-gray.png"></image></view>
            <view class="icon" bindtap="delCon" data-id="{{item.id}}"><image src="../../images/del-gray.png"></image></view>
          </view>
        </view>
      </view>
  </block>
</view>
<view class="bg-white full-btn">
  <button class="btn btnOne" bindtap="toAdd">添加资讯</button>
</view>