/* pages/activity/activity.wxss */
page{
  padding-bottom: 100rpx;
}
.activity{
  display: flex;
  align-items: center;
  background: #fff;
  margin-bottom: 20rpx;
  padding: 20rpx 30rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  position: relative;
}
.activity:last-child{
  margin-bottom: 50rpx;
}
.cover-img{
  display: flex;
  align-items: center;
  width: 48%;
  height: 210rpx;
  position: relative;
  margin-right: 20rpx;
}
.cover-img image{
  width: 100%;
  max-height: 210rpx !important;
}
.activity-infor .title{
  color: #000;
  font-size: 30rpx;
}
.activity-infor{
  width: 52%;
}
.activity-infor .tag{
  display: inline-block;
  margin: 15rpx 0;
  background: #4ec17e;
  color: #fff;
  font-size: 22rpx;
  padding: 0 15rpx;
  border-radius: 20rpx;
}
.activity-infor .tag.org{
  background: #f46b45;
  margin-left: 10rpx;
}
.activity-infor .time image,.activity-infor .address image{
  width: 30rpx;
  height: 30rpx;
  margin: 5rpx 10rpx 0 0;
  float: left;
}
.activity .vw-cover{
  width: 100%;
  height: 100%;
  background: rgba(255,255,255,.6);
  position: absolute;
  top: 0;
  left: 0;
}
.cover-img .state{
  width: 100%;
  height: 50rpx;
  background: rgba(0, 0, 0, .6);
  color: #fff;
  text-align: center;
  line-height: 50rpx;
  position: absolute;
  left: 0;
  bottom: 0;
}
.act-btn{
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
}
.act-btn .btn{
  display: inline-block;
  padding: 0 10rpx;
  line-height: 1.5;
  border: 1px solid #e1e1e1;
  border-radius: 5rpx;
  margin-left: 20rpx;
}