/* pages/mydata/mydata.wxss */
@import '../index/index.wxss';
@import '../activity/activity.wxss';
page{
  background: #f7f7f7;
}
.acty-tit{
  padding: 20rpx 40rpx 0;
  /* line-height: 100rpx; */
  font-size: 32rpx;
  color: #333;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.user-infor .infor{
  display: flex;
  align-items: center;
}
.user-infor .infor image{
  width: 25rpx;
  height: 25rpx;
  margin-left: 10rpx;
}
.week-con{
  height: 30vh;
  padding: 30rpx;
  position: relative;
}
.echart_panel{
  width:100%;
  height:100%;
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
}
ec-canvas{
  width: 100%;
  height: 100%;
}
.data-con{
  padding: 20rpx 30rpx;
  overflow: hidden;
  position: relative;
  color: #fff;
}
.bg-blue{
  background: #415065;
}
.data-header{
  position: relative;
}
.data-header .wrap-tit{
  color: #ff5579;
  font-size: 26rpx;
  text-align: center;
  font-weight: bold;
  line-height: 50rpx;
}
.data-header .end-date{
  font-size: 24rpx;
  color: #fff;
  position: absolute;
  left: 20rpx;
  top: 10rpx;
}
.icon-bg{
  width: 120rpx;
  height: 120rpx;
  background: rgba(53,229,88,.5);
  border-radius: 50%;
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  z-index: 4;
}
.icon-bg.red{
  background: rgba(255,0,0,.5);
}
.icon-bg .icon{
  width: 50rpx;
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  z-index: 6;
}
.flex-con{
  display: flex;
  justify-content: space-between;
  padding: 30rpx 0;
}
.arrow image{
  width: 40rpx;
  height: 40rpx;
}
.progress-content{
  background: #64c07f;
  border-radius: 10rpx;
}
.progress{
  width: 50%;
  line-height: 80rpx;
  font-size: 42rpx;
  color: #fff;
  text-align: center;
}
.progress .compelte{
  font-size: 60rpx;
}
.progress .tit{
  font-size: 26rpx;
}
.ad-bdr{
  border-right: 1px solid #e0e0e0;
}
.flex-con.pies-con{
  justify-content: space-around;
  text-align: center;
}
.pies-wrap{
  position: relative;
  width: 25%;
}
.pies-subwrap{
  position: relative;
  width: 100%;
  height: 15vh;
}
.pies-subwrap .echart_panel{
  width: 100%;
  height: 90%;
}
.pies-wrap .line{
  width: 1px;
  height: 50rpx;
  border-left: 1px dotted #24d8da;
  position: absolute;
  left: 50%;
  top: 11vh;
  transform: translate(-50%,0);
}











.activity {
  display: inline-block;
  background: none;
  padding: 0;
  margin: 0 30rpx 0 0 ;
}
.activity.normal-acty{
  width: 40%;
}
.activity.normal-acty .cover-img{
  height: 180rpx;
}
.activity.normal-acty .cover-img image{
  max-height: 180rpx !important;
}
.activity:nth-last-child(1){
  margin-right: 0;
}
.activity .cover-img {
  width: 100%;
  height: auto;
}
.activity .activity-infor{
  display: none;
}
.challenge .activity{
  width: 320rpx;
  height: 180rpx;
}
.challenge .cover-img image{
  height: 180rpx;
}
.activitys .activity{
  width: 280rpx;
  height: 210rpx;
}
.activitys .cover-img image{
  height: 210rpx;
}