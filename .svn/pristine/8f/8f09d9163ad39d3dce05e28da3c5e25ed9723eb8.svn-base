/* pages/userinfor/userinfor.wxss */
.page-tips{
  line-height: 3;
  font-size: 28rpx;
  color: #666;
}
.user-infor{
  padding-top: 40rpx;
  padding-bottom: 150rpx;
}
.user-wrap{
  display: flex;
  justify-content: center;
}
.user-pic{
  position: relative;
  margin-bottom: 40rpx;
  display: flex;
  text-align: center;
  flex-direction: column;
  align-items: center;
}
.user-pic.add-bd .pic{
  border: 3px solid #fcb81d;
  margin-right: 0;
  margin-bottom: 10rpx;
}
.user-pic.add-bd1 .pic{
  border: 3px solid #e97376;
}
.user-pic.add-bd2 .pic{
  border: 3px solid #aaaaaa;
}
.user-pic .vip{
  width: 40rpx;
  height: 40rpx;
  position: absolute;
  right: 0;
  bottom: 50rpx;
}
.vw-form{
  display: flex;
  line-height: 3;
}
.vw-form .fm-tit{
  width: 28%;
  font-size: 32rpx;
}
.vw-form .must{
  color: #d73021;
  padding: 0 10rpx;
}
.vw-form .fm-con{
  width: 72%;
  border-bottom: 1px solid #f1f1f1;
  font-size:28rpx;
  position: relative;
}
/* .vw-form:nth-last-child(1) .fm-con{
  border-bottom: none;
} */
.vw-form .fm-con input{
  padding-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}
.vw-form .fm-con radio{
  color: #333;
  /* margin-right: 20rpx; */
}
.sex label{
  /* display: inline-block; */
  font-size: 32rpx;
  margin-right: 15rpx;
  float: left;
}
checkbox-group label{
  display: inline-block;
  width: 25%;
  font-size: 32rpx;
}
checkbox-group checkbox .wx-checkbox-input{
  width: 40rpx;
  height: 40rpx;
}
.other-data{
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
}
.other-data .fm-con{
  display: flex;
  width: 49%;
  font-size: 28rpx;
  border-bottom: 1px solid #f1f1f1;
  line-height: 3;
}
.vw-form .other-data .fm-con input{
  width: 50%;
  padding-top: 20rpx;
}
.fm-icon{
  width: 40rpx;
  margin :26rpx 10rpx 0 0;
  float: left;
}
.change-only{
  color: #999;
  position: absolute;
  right: 0;
  top: 5rpx;
}
.sub-tit{
  width: 120rpx;
}
.btn-group{
  display: flex;
  width: 100%;
  box-sizing: border-box;
  position: fixed;
  bottom: 0;
  left: 0;
  z-index: 2;
}
.btn-group .btn{
  width: 50%;
  height: 140rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: normal;
  color: #fff;
  border-radius: 0;
}
.btn-group .btn.green{
  background: linear-gradient(to right, #38ef7d, #11998e);
}
.btn-group .btn.red{
  background: linear-gradient(to right, #ff5e62, #ff9966);
}
.lgo-btn{
  width: 100%;
  line-height: 80rpx;
  box-sizing: border-box;
  border: 1px solid #e1e1e1;
  border-radius: 5rpx;
  margin: 30rpx 0;
  text-align: center;
  font-size: 32rpx;
  color: #666;
}