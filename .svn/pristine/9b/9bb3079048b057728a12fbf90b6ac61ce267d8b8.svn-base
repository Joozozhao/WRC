<!--index.wxml-->
<view class="top-part">
  <image src="{{logoSrc}}" class="logo"></image>
  <view class="userinfo-avatar">
    <view bindtap="openLogin" wx:if="{{userId==''}}">
      <image src="{{avatarUrl}}" mode="widthFix"></image>
    </view>
    <view bindtap="toUserCenter" wx:else>
      <image src="{{avatarUrl}}" mode="widthFix"></image>
    </view>
  </view>
</view>
<scroll-view scroll-y style="height:60%;margin-top:198rpx;">
  <view class="scroll-view-item nav-mb">
    <view class="swiper">
      <swiper indicator-dots="{{indicatorDots}}" autoplay="{{autoplay}}" interval="{{interval}}" duration="{{duration}}" style="height:{{height}}" circular="true">
        <block wx:for="{{challenge}}" wx:key="index" wx:if="{{index<4}}">
          <swiper-item>
            <navigator hover-class="none" url="../challengedetail/challengedetail?id={{item.id}}">
              <image src="{{item.acty_img}}" mode="widthFix" style="width:100%;height:auto;" bindload='goheight' />
            </navigator>
          </swiper-item>
        </block>
      </swiper>
    </view>
    <view class="vw-wrap">
    <view class="weahter-wrap {{show?'aniamtion':'hide'}}">
      <!--index.wxml wx:if="{{weahterState}}"-->
      <view class="container">
        <view class="nowWeather">
          <view class="city"><image src="../../images/place-white.png" mode="widthFix" class="loction"></image>{{city}} {{district}}</view>
          <view style="display:flex;align-items: center;justify-content:center;">
            <view class="iconfont iconfont-{{daily_forecast[0].cond_code_d}} bigger"></view>
            <view style="display:flex;align-items: baseline;">
              <view class="temp b">{{tmp}}°</view>
              <!-- <view class="today-detail">
                <view class="weather">{{txt}}</view>
                <view class="weather">{{daily_forecast[0].tmp_min}}°/{{daily_forecast[0].tmp_max}}°</view>
              </view> -->
            </view>
            <view class="air-all" wx:if="{{qlty=='优'}}">
              <view>{{txt}}</view>
              <view class="air">
                <text class="good"></text>{{qlty}}
              </view>
            </view>
            <view class="air-all" wx:if="{{qlty=='良'}}">
              <view>{{txt}}</view>
              <view class="air">
                <text class="soso"></text>{{qlty}}
              </view>
            </view>
            <view class="air-all" wx:if="{{qlty=='轻度污染'}}">
              <view>{{txt}}</view>
              <view class="air">
                <text class="bad"></text>{{qlty}}
              </view>
            </view>
            <view class="air-all" wx:if="{{qlty=='中度污染'}}">
              <view>{{txt}}</view>
              <view class="air">
                <text class="warning"></text>{{qlty}}
              </view>
            </view>
            <view class="air-all" wx:if="{{qlty=='重度污染'}}">
              <view>{{txt}}</view>
              <view class="air">
                <text class="bader"></text>{{qlty}}
              </view>
            </view>
            <view class="air-all" wx:if="{{qlty=='严重污染'}}">
              <view>{{txt}}</view>
              <view class="air">
                <text class="dead"></text>{{qlty}}
              </view>
            </view>
          </view>
          <view class="update-time">更新时间：{{update_time}}</view>
        </view>
      </view>
      <view class="flex-weahter"> 
        <view class="weahter-item" wx:key="item" wx:for-items="{{daily_forecast}}" wx:for-index="i">
          <view class="iconfont iconfont-{{daily_forecast[0].cond_code_d}}"></view>
          <view class="hor forcast">
            <view class="day">{{day[i]}}</view>
            <view class="tmp">{{item.tmp_min}}°/ {{item.tmp_max}}°</view>
          </view>
        </view>
      </view>
    </view>
    </view>
    
    
    <view class="vw-wrap">
      <view class="infor-con" wx:if="{{userId!=0}}">
        <view class="list">
          <block wx:for="{{userList}}" wx:key="index" wx:for-item="item" wx:if="{{index<8}}">
            <view class="item">
              <image src="{{item.header_url}}"></image>
            </view>
          </block>
        </view>
        <view class="total" bindtap="toList">
          <view>{{actyIn}} <text class="gray">成员</text></view>
          <view class="add-arrow">
            <image src="../../images/arrow-r-gray.png" mode="widthFix"></image>
          </view>
        </view>
      </view>
      <view class="horizontal" wx:if="{{userId!=0}}">
        <wxs src="../../utils/toDecimal2.wxs" module="module1" />
        <scroll-view scroll-x style="width:100%;white-space:nowrap;">
          <view class="member-item" wx:for="{{recordList}}" wx:key="index" data-img="{{item.sport_img}}" data-distance="{{item.distance}}" data-speed="{{item.speed}}" bindtap="popShow" wx:if="{{item.state!==2}}">
            <view class="user-item">
              <image src="{{item.header_url}}"></image><text class="nick-name ellipsis" wx:if="{{item.name}}">{{item.name}}</text><text class="nick-name ellipsis" wx:else>{{item.nick_name}}</text>
            </view>
            <view class="rd-distance"><text class="distance letter-spacing">{{module1.toDecimal2(item.distance)}}</text> 公里</view>
            <view class="rd-speed">平均配速 {{item.speed}}</view>
          </view>
        </scroll-view>
      </view>
      <view class="daily-record">
        <view class="record">
          <view><text class="days">打卡{{serialDay}}天</text></view>
          <view class="more">坚持运动获得更多积分</view>
        </view>
        <view class="tips">{{myTip}}</view>
      </view>
    </view>
    <view class="vw-wrap">
      <view class="news-con">
        <view class="con-item" bindtap="toActy" wx:if="{{acty_name !== ''}}">
          <image src="{{acty_img}}" mode="aspectFill"></image>
          <view class="bg-wrap ellipsis">{{acty_name}}</view>
          <image src="../../images/flag.png" mode="widthFix" class="cover-fix"></image>
        </view>
        <view class="con-item" bindtap="toNews">
          <image src="{{img_url}}" mode="aspectFill"></image>
          <view class="bg-wrap ellipsis">{{title}}</view>
        </view>
      </view>
    </view>
    <view class="grid-menu">
      <view class="flex-wrap">
        <view class="flex-item demo-text-3" bindtap="toRecord">
          <view class="icon-circle">
            <image src="../../images/i-4.svg" mode="widthFix"></image>
          </view>
          <text>打卡记录</text>
        </view>
        <view class="flex-item demo-text-5">
          <navigator url="/pages/prize/prize" hover-class="none">
            <view class="icon-circle">
              <image src="../../images/i-2.svg" mode="widthFix"></image>
            </view>
            <text>兑换好礼</text>
          </navigator>
        </view>
        <view class="flex-item demo-text-2" bindtap="toHistory">
          <view class="icon-circle">
            <image src="../../images/i-1.svg" mode="widthFix"></image>
          </view>
          <text>我的兑换</text>
        </view>
        <view class="flex-item demo-text-6">
          <navigator url="/pages/news/news" hover-class="none">
            <view class="icon-circle">
              <image src="../../images/i-3.svg" mode="widthFix"></image>
            </view>
            <text>关于跑团</text>
          </navigator>
        </view>
        <view class="flex-item demo-text-2" bindtap="toManage" wx:if="{{duty == '管理员'||duty == '管理员/团长'}}">
          <view class="icon-circle">
            <image src="../../images/i-1.svg" mode="widthFix"></image>
          </view>
          <text>Admin</text>
        </view>
        <!--<view class="flex-item demo-text-2" bindtap="toHope" wx:if="{{duty == '管理员'||duty == '管理员/团长'}}">
          <view class="icon-circle"><image src="../../images/i-2.svg" mode="widthFix"></image></view>
          <text>心愿墙</text>
        </view>-->
      </view>
    </view>
  </view>
</scroll-view>
<tabbar tabbar="{{tabbar}}"></tabbar>
<!-- 遮罩层 -->
<view class="modal-mask" bindtap="popHide" wx:if="{{personalInfor}}"></view>
<!-- 弹出框 -->
<view class="modal-dialog" wx:if="{{personalInfor}}" style="padding: 0;">
  <view class="modal-content" style="max-height:65vh;overflow-y:scroll;">
    <view class="per-infor">
      <image src="{{personalImg}}" mode="widthFix"></image>
    </view>
  </view>
  <!-- 操作按钮 -->
  <view class="modal-footer" style="background: linear-gradient(to left, rgba(56,239,125,.7), rgba(17,153,142,.7)); padding-bottom: 20rpx;;">
    <button class="btn btn-cancel white" bindtap="popHide">关闭</button>
    <view style="clear: both;"></view>
  </view>
</view>