.image-viewer {
  position: fixed;
  z-index: 99999;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(5, 10, 9, 0.96);
  animation: viewer-fade-in 180ms ease-out both;
}

.viewer-topbar {
  position: absolute;
  z-index: 2;
  top: 0;
  left: 0;
  right: 0;
  padding: 0 34rpx 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.viewer-count {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.viewer-count text {
  color: rgba(255, 255, 255, 0.58);
  font-weight: 400;
}

.viewer-close {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.viewer-close-x,
.viewer-close-y {
  position: absolute;
  width: 30rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: #fff;
  transform: rotate(45deg);
}

.viewer-close-y { transform: rotate(-45deg); }

.viewer-swiper {
  width: 100%;
  height: 100%;
}

.viewer-slide {
  display: flex;
  align-items: center;
  justify-content: center;
}

.viewer-image {
  width: 100%;
  height: 100%;
  animation: viewer-image-in 220ms ease-out both;
}

@keyframes viewer-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes viewer-image-in {
  from { opacity: 0.65; transform: scale(0.985); }
  to { opacity: 1; transform: scale(1); }
}

/* 卡片模式：查看轨迹凭证等非全屏场景 */
.image-viewer--card {
  background: rgba(7, 47, 39, 0.48);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.viewer-card {
  width: 632rpx;
  background: #fbfcf9;
  border-radius: 28rpx;
  padding: 30rpx 30rpx 26rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 72rpx rgba(7, 47, 39, 0.3);
  animation: viewer-card-in 240ms cubic-bezier(0.2, 0.9, 0.25, 1) both;
}

.viewer-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.viewer-card-title-wrap {
  display: flex;
  flex-direction: column;
}

.viewer-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #072f27;
  letter-spacing: 2rpx;
  line-height: 1.3;
}

.viewer-card-sub {
  font-size: 18rpx;
  color: rgba(7, 47, 39, 0.38);
  letter-spacing: 5rpx;
  line-height: 1.6;
}

.viewer-card-close {
  position: relative;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eef3ea;
  border: 1rpx solid rgba(7, 47, 39, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 160ms ease, background 160ms ease;
}

.viewer-card-close:active {
  transform: scale(0.92);
  background: #e2ebdb;
}

.viewer-card-close-x,
.viewer-card-close-y {
  position: absolute;
  width: 26rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: #0b503b;
  transform: rotate(45deg);
}

.viewer-card-close-y { transform: rotate(-45deg); }

.viewer-card-body {
  position: relative;
  height: 60vh;
  max-height: 860rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #e9efe6;
  border: 1rpx solid rgba(7, 47, 39, 0.06);
}

.viewer-card-swiper {
  width: 100%;
  height: 100%;
}

.viewer-card-slide {
  display: flex;
  align-items: center;
  justify-content: center;
}

.viewer-card-image {
  width: 100%;
  height: 100%;
}

.viewer-card-count {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(7, 47, 39, 0.55);
  color: #fff;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.viewer-card-count text {
  color: rgba(255, 255, 255, 0.62);
  font-weight: 400;
}

.viewer-card-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 200;
  color: rgba(7, 47, 39, 0.36);
  letter-spacing: 1rpx;
}

@keyframes viewer-card-in {
  from { opacity: 0; transform: translateY(36rpx) scale(0.94); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
