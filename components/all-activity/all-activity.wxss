/* components/all-activity/all-activity.wxss */
.all-activity-wrap {
  width: 100%;
  box-sizing: border-box;
}

.record-card {
  background: #ffffff;
  border: 1rpx solid #e3ebe4;
  border-radius: 24rpx;
  padding: 26rpx 24rpx 28rpx;
  margin-top: 22rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 14rpx rgba(7, 47, 39, 0.02);
}

.record-card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
  padding: 0 6rpx;
}

.record-head-main {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.record-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #072f27;
  line-height: 1;
}

.record-kicker {
  font-size: 18rpx;
  font-weight: 200;
  color: #84918a;
  letter-spacing: 1.5rpx;
}

.record-count-pill {
  display: flex;
  align-items: baseline;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  background: #f0f5ee;
  color: #0b503b;
  font-size: 22rpx;
  font-weight: 700;
  gap: 4rpx;
}

.count-number {
  font-size: 26rpx;
  font-weight: 800;
  color: #072f27;
  font-variant-numeric: tabular-nums;
}

.count-unit {
  font-size: 20rpx;
  color: #64786d;
  font-weight: 200;
}

.count-arrow {
  font-size: 24rpx;
  color: #0b503b;
  margin-left: 2rpx;
}

.pill-touch {
  opacity: 0.7;
}

.record-scroll {
  width: 100%;
  white-space: nowrap;
}

.record-list {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  padding-bottom: 4rpx;
  box-sizing: border-box;
}

.record-item {
  position: relative;
  flex: none;
  display: flex;
  flex-direction: column;
  border-radius: 18rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(7, 47, 39, 0.06);
  box-sizing: border-box;
}

/* 挑战尺寸 (海报 16:9 + 底部信息带) */
.challenge-item {
  width: 300rpx;
}

/* 团跑尺寸 (摄影画幅) */
.run-item {
  width: 280rpx;
}

.item-img-wrap {
  position: relative;
  width: 100%;
  background: #e6ede7;
}

.challenge-item .item-img-wrap { height: 168rpx; }
.run-item .item-img-wrap { height: 186rpx; }

.item-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.item-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #547262;
  font-size: 24rpx;
  font-weight: 200;
}

/* 海报下方纯白信息带：不再用深色遮罩压图，活动图完整露出。 */
.item-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 14rpx 16rpx 16rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.item-name {
  color: #072f27;
  font-size: 23rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
}

.item-date {
  color: #718175;
  font-size: 19rpx;
  font-weight: 200;
  margin-top: 5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-variant-numeric: tabular-nums;
}

.record-more-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  flex: none;
  border-radius: 18rpx;
  background: #f4f8f4;
  border: 1rpx dashed #d0dcd2;
  box-sizing: border-box;
  min-height: 252rpx;
}

.more-challenge {
  min-height: 252rpx;
}

.more-run {
  min-height: 270rpx;
}

.more-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #0b503b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

.more-label {
  margin-top: 10rpx;
  font-size: 20rpx;
  font-weight: 200;
  color: #547262;
}

.item-touch {
  opacity: 0.86;
  transform: scale(0.98);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
