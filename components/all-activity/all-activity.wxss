/* components/all-activity/all-activity.wxss · 方案B 时间列表 */
.tl-wrap {
  width: 100%;
  box-sizing: border-box;
  background: transparent;
}

/* ---------- 分类切换 ---------- */
.tl-tabs {
  display: flex;
  align-items: center;
  gap: 36rpx;
  border-bottom: 1rpx solid #e6ede6;
}

.tl-tab {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.tl-tab::after {
  content: '';
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  bottom: -1rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: transparent;
}

.tl-tab.is-active::after {
  background: #d9ff3f;
}

.tl-tab-text {
  font-size: 28rpx;
  font-weight: 300;
  color: #64786d;
  line-height: 1.2;
}

.tl-tab.is-active .tl-tab-text {
  font-weight: 800;
  color: #072f27;
}

.tl-tab-count {
  font-size: 24rpx;
  font-weight: 300;
  color: #84918a;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.tl-tab.is-active .tl-tab-count {
  color: #072f27;
}

.tl-tab-touch {
  opacity: 0.6;
}

/* ---------- 骨架 ---------- */
.tl-skeleton {
  padding-top: 8rpx;
}

.sk-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef3ee;
  box-sizing: border-box;
}

.sk-texts {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.sk-line {
  height: 22rpx;
  border-radius: 11rpx;
  background: #e8efe8;
  animation: tl-pulse 1.2s ease-in-out infinite;
}

.sk-line-type { width: 72rpx; }
.sk-line-title { width: 78%; height: 26rpx; }
.sk-line-date { width: 132rpx; }

.sk-thumb {
  flex: none;
  width: 150rpx;
  height: 108rpx;
  margin-left: 24rpx;
  border-radius: 12rpx;
  background: #e8efe8;
  animation: tl-pulse 1.2s ease-in-out infinite;
}

@keyframes tl-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

.tl-status-text {
  display: block;
  padding: 24rpx 0 8rpx;
  font-size: 22rpx;
  font-weight: 300;
  color: #84918a;
  text-align: center;
}

/* ---------- 错误 ---------- */
.tl-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #f0d9c8;
  border-radius: 16rpx;
  background: #fdf6ef;
  box-sizing: border-box;
}

.tl-error-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 300;
  color: #8a5a33;
  line-height: 1.4;
}

.tl-retry {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: #072f27;
  color: #fbfcf9;
  font-size: 24rpx;
  font-weight: 700;
  box-sizing: border-box;
}

/* ---------- 空态 ---------- */
.tl-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx 56rpx;
  box-sizing: border-box;
}

.tl-empty-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #072f27;
  line-height: 1.3;
}

.tl-empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 300;
  color: #84918a;
  line-height: 1.4;
}

.tl-empty-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 36rpx;
}

.tl-empty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 200rpx;
  min-height: 88rpx;
  padding: 0 36rpx;
  border-radius: 44rpx;
  background: #072f27;
  color: #d9ff3f;
  font-size: 26rpx;
  font-weight: 700;
  box-sizing: border-box;
}

/* ---------- 时间列表 ---------- */
.tl-group {
  margin-top: 8rpx;
}

.tl-group-label {
  padding: 26rpx 0 6rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #072f27;
  line-height: 1.3;
}

.tl-items {
  position: relative;
  padding-left: 40rpx;
  box-sizing: border-box;
}

.tl-rail {
  position: absolute;
  left: 10rpx;
  top: 16rpx;
  bottom: 24rpx;
  width: 2rpx;
  background: #dbe5dd;
}

.tl-item {
  position: relative;
}

.tl-dot {
  position: absolute;
  left: -36rpx;
  top: 52rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #fbfcf9;
  border: 4rpx solid #0b503b;
  box-sizing: border-box;
}

.tl-item-main {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e6ede6;
  box-sizing: border-box;
}

.tl-item-main.is-last {
  border-bottom: none;
}

.tl-item-texts {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.tl-item-type {
  font-size: 20rpx;
  font-weight: 300;
  color: #84918a;
  letter-spacing: 2rpx;
  line-height: 1.3;
}

.tl-item-title {
  margin-top: 8rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #072f27;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.tl-item-date {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 300;
  color: #718175;
  font-variant-numeric: tabular-nums;
  line-height: 1.3;
}

.tl-thumb {
  flex: none;
  width: 150rpx;
  height: 108rpx;
  margin-left: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #eef3ee;
}

.tl-thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.tl-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 18rpx;
  font-weight: 300;
  color: #84918a;
}

.tl-item-touch {
  opacity: 0.72;
}

/* ---------- 加载更多与页脚 ---------- */
.tl-foot {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0 8rpx;
  box-sizing: border-box;
}

.tl-more {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 240rpx;
  min-height: 88rpx;
  padding: 0 40rpx;
  margin-top: 16rpx;
  border-radius: 44rpx;
  border: 1rpx solid #cfdccf;
  background: transparent;
  box-sizing: border-box;
}

.tl-more.is-disabled {
  opacity: 0.5;
}

.tl-more-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #072f27;
}

.tl-foot-count {
  margin-top: 20rpx;
  font-size: 20rpx;
  font-weight: 300;
  color: #84918a;
  font-variant-numeric: tabular-nums;
}
