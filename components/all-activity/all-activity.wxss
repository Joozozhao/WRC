/* components/all-activity/all-activity.wxss */
.all-activity-wrap {
  padding: 0 40rpx;
  box-sizing: border-box;
}

.record-card {
  background: #ffffff;
  border: 1rpx solid #e3ebe4;
  border-radius: 24rpx;
  padding: 26rpx 24rpx 28rpx;
  margin-top: 22rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 14rpx rgba(7, 47, 39, 0.02);
}

.record-card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
  padding: 0 6rpx;
}

.record-head-main {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.record-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #072f27;
  line-height: 1;
}

.record-kicker {
  font-size: 18rpx;
  font-weight: 700;
  color: #84918a;
  letter-spacing: 1.5rpx;
}

.record-count-pill {
  display: flex;
  align-items: baseline;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  background: #f0f5ee;
  color: #0b503b;
  font-size: 22rpx;
  font-weight: 700;
  gap: 4rpx;
}

.count-number {
  font-size: 26rpx;
  font-weight: 800;
  color: #072f27;
  font-variant-numeric: tabular-nums;
}

.count-unit {
  font-size: 20rpx;
  color: #64786d;
}

.count-arrow {
  font-size: 24rpx;
  color: #0b503b;
  margin-left: 2rpx;
}

.pill-touch {
  opacity: 0.7;
}

.record-scroll {
  width: 100%;
  white-space: nowrap;
}

.record-list {
  display: flex;
  gap: 18rpx;
  padding-bottom: 4rpx;
  box-sizing: border-box;
}

.record-item {
  position: relative;
  flex: none;
  border-radius: 18rpx;
  overflow: hidden;
  background: #e6ede7;
  border: 1rpx solid rgba(7, 47, 39, 0.06);
  box-sizing: border-box;
}

/* 挑战尺寸 (16:9比例) */
.challenge-item {
  width: 320rpx;
  height: 180rpx;
}

/* 团跑尺寸 (摄影画幅) */
.run-item {
  width: 280rpx;
  height: 196rpx;
}

.item-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.item-tag {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.2;
  z-index: 2;
  letter-spacing: 0.5rpx;
}

.item-tag.is-challenge {
  background: #d9ff3f;
  color: #062b23;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.item-tag.is-run {
  background: rgba(255, 255, 255, 0.94);
  color: #072f27;
  backdrop-filter: blur(4px);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.item-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 30rpx 14rpx 12rpx;
  background: linear-gradient(to top, rgba(7, 47, 39, 0.88) 0%, rgba(7, 47, 39, 0.45) 70%, transparent 100%);
  display: flex;
  flex-direction: column;
  z-index: 2;
  box-sizing: border-box;
}

.item-name {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 750;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
}

.item-date {
  color: rgba(255, 255, 255, 0.78);
  font-size: 18rpx;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-variant-numeric: tabular-nums;
}

.record-more-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  flex: none;
  border-radius: 18rpx;
  background: #f4f8f4;
  border: 1rpx dashed #d0dcd2;
  box-sizing: border-box;
}

.more-challenge {
  height: 180rpx;
}

.more-run {
  height: 196rpx;
}

.more-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #0b503b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

.more-label {
  margin-top: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #547262;
}

.item-touch {
  opacity: 0.86;
  transform: scale(0.98);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
