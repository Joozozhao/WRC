<view class="all-activity-wrap">
  <!-- 挑战记录卡片 -->
  <view class="record-card challenge-record" wx:if="{{activityList.length > 0}}">
    <view class="record-card-head">
      <view class="record-head-main">
        <text class="record-title">挑战</text>
        <text class="record-kicker">CHALLENGE</text>
      </view>
      <view class="record-count-pill" bindtap="toChallengeTab" hover-class="pill-touch" role="button" aria-label="查看全部挑战">
        <text class="count-number">{{totalChallenge}}</text>
        <text class="count-unit">次</text>
        <text class="count-arrow">›</text>
      </view>
    </view>
    <scroll-view 
      class="record-scroll" 
      scroll-x="true" 
      enable-flex="true" 
      enhanced="true" 
      show-scrollbar="false" 
      bindscrolltolower="onTapChild"
    >
      <view class="record-list">
        <block wx:for="{{activityList}}" wx:key="id" wx:for-item="item">
          <view 
            class="record-item challenge-item" 
            bindtap="getInfor" 
            data-id="{{item.id}}" 
            data-type="{{item.acty_type || '挑战'}}" 
            hover-class="item-touch"
            role="button"
            aria-label="{{item.acty_name || '挑战详情'}}"
          >
            <image class="item-cover" src="{{item.acty_img}}" mode="aspectFill" lazy-load="true"></image>
            <view class="item-tag is-challenge">挑战</view>
            <view class="item-overlay" wx:if="{{item.acty_name}}">
              <text class="item-name">{{item.acty_name}}</text>
            </view>
          </view>
        </block>
        <view class="record-more-card more-challenge" bindtap="toChallengeTab" hover-class="item-touch" role="button" aria-label="查看全部挑战">
          <view class="more-circle">→</view>
          <text class="more-label">全部挑战</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 团跑记录卡片 -->
  <view class="record-card run-record" wx:if="{{activityList2.length > 0}}">
    <view class="record-card-head">
      <view class="record-head-main">
        <text class="record-title">团跑</text>
        <text class="record-kicker">GROUP RUN</text>
      </view>
      <view class="record-count-pill" bindtap="toActivityTab" hover-class="pill-touch" role="button" aria-label="查看全部团跑">
        <text class="count-number">{{totalActy}}</text>
        <text class="count-unit">次</text>
        <text class="count-arrow">›</text>
      </view>
    </view>
    <scroll-view 
      class="record-scroll" 
      scroll-x="true" 
      enable-flex="true" 
      enhanced="true" 
      show-scrollbar="false" 
      bindscrolltolower="onTapChild2"
    >
      <view class="record-list">
        <block wx:for="{{activityList2}}" wx:key="id" wx:for-item="item">
          <view 
            class="record-item run-item" 
            bindtap="getInfor" 
            data-id="{{item.id}}" 
            data-type="{{item.acty_type || '团跑'}}" 
            hover-class="item-touch"
            role="button"
            aria-label="{{item.acty_name || '团跑详情'}}"
          >
            <image class="item-cover" src="{{item.acty_img}}" mode="aspectFill" lazy-load="true"></image>
            <view class="item-tag is-run">团跑</view>
            <view class="item-overlay">
              <text class="item-name">{{item.acty_name}}</text>
              <text class="item-date" wx:if="{{item.start_timestr}}">{{item.start_timestr}}</text>
            </view>
          </view>
        </block>
        <view class="record-more-card more-run" bindtap="toActivityTab" hover-class="item-touch" role="button" aria-label="查看全部团跑">
          <view class="more-circle">→</view>
          <text class="more-label">全部团跑</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
