<view class="tabbar_box {{isIphoneX ? 'iphoneX-height' : ''}}" style="background-color:{{tabbar.backgroundColor}}">
  <block wx:for="{{tabbar.list}}" wx:key="pagePath">
    <view class="tabbar_slot">
      <navigator class="tabbar_nav {{item.selected ? 'is-selected' : ''}}" hover-class="none" url="{{item.pagePath}}" style="color:{{item.selected ? tabbar.selectedColor : tabbar.color}}" open-type="switchTab">
        <image class="tabbar_icon" src="{{item.iconPath}}" mode="aspectFit"></image>
        <text>{{item.text}}</text>
      </navigator>
    </view>
  </block>
</view>
