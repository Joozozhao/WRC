.tabbar_box {
  position: fixed;
  z-index: 999;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 102rpx;
  padding-bottom: 14rpx;
  display: flex;
  align-items: stretch;
  border-top: 1rpx solid #e7ebe7;
  box-sizing: content-box;
}
.tabbar_box.iphoneX-height { padding-bottom: 60rpx; }
.tabbar_slot {
  width: 25%;
  height: 100%;
  flex: 0 0 25%;
  box-sizing: border-box;
}
.tabbar_nav {
  position: relative;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #87928c;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
}
.tabbar_nav.is-selected { font-weight: 750; }
.tabbar_nav.is-selected::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  width: 28rpx;
  height: 5rpx;
  border-radius: 6rpx;
  background: #d9ff3f;
}
.tabbar_icon { width: 46rpx; height: 46rpx; margin-bottom: 6rpx; opacity: .67; }
.tabbar_nav.is-selected .tabbar_icon { opacity: 1; animation: iconPop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) both; }

@keyframes iconPop {
  0% { transform: scale(1); }
  40% { transform: scale(0.8); }
  70% { transform: scale(1.15); }
  100% { transform: scale(1); }
}
