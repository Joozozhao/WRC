/* pages/record/record.wxss */
page {
  min-height: 100%;
  background: #fbfcf9;
  color: #072f27;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.record-page {
  min-height: 100vh;
  padding: 0 36rpx 100rpx;
  box-sizing: border-box;
}

/* Hero Section */
.record-hero {
  padding: 18rpx 4rpx 28rpx;
  border-bottom: 1rpx solid #e1e9e3;
}

.record-eyebrow {
  display: block;
  color: #0d6447;
  font-size: 22rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}

.record-title {
  display: block;
  margin-top: 24rpx;
  font-size: 68rpx;
  line-height: 1.15;
  font-weight: 800;
  letter-spacing: -2rpx;
  color: #072f27;
}

.record-title-line {
  width: 185rpx;
  height: 7rpx;
  margin-top: 6rpx;
  border-radius: 10rpx;
  background: #d9ff3f;
  transform: rotate(-2deg);
}

.record-intro {
  display: block;
  margin-top: 20rpx;
  color: #7a8980;
  font-size: 26rpx;
  line-height: 1.6;
}

.record-loaded-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  color: #718078;
  font-size: 22rpx;
  font-weight: 600;
}

.meta-dot {
  color: #0b503b;
  font-size: 16rpx;
}

/* Tabs */
.record-tabs {
  display: flex;
  margin-top: 24rpx;
  border-bottom: 1rpx solid #e1e9e3;
}

.record-tab {
  position: relative;
  flex: 1;
  padding: 22rpx 0 24rpx;
  color: #78867e;
  text-align: center;
  font-size: 28rpx;
  font-weight: 650;
}

.record-tab.is-active {
  color: #0b503b;
  font-weight: 800;
}

.tab-mark {
  position: absolute;
  right: 28%;
  bottom: -1rpx;
  left: 28%;
  height: 6rpx;
  border-radius: 8rpx;
  background: #d9ff3f;
}

/* Section */
.record-section {
  padding-top: 30rpx;
}

/* State Cards */
.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 68rpx 40rpx;
  border: 1rpx solid #e3ebe4;
  border-radius: 24rpx;
  background: #fff;
  text-align: center;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.state-icon-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f0f5ed;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.state-icon-circle.is-error {
  background: #fdf2f0;
}

.state-icon {
  font-size: 42rpx;
}

.state-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #072f27;
  margin-bottom: 12rpx;
}

.state-copy {
  font-size: 24rpx;
  color: #7a8980;
  line-height: 1.6;
  max-width: 520rpx;
  margin-bottom: 32rpx;
}

.state-action-btn {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 48rpx;
  border-radius: 42rpx;
  background: #d9ff3f;
  color: #062b23;
  font-size: 28rpx;
  font-weight: 800;
  border: none;
}

.state-action-btn::after {
  border: none;
}

.retry-btn {
  padding: 16rpx 44rpx;
  border-radius: 30rpx;
  background: #f0f4ee;
  color: #0b503b;
  font-size: 26rpx;
  font-weight: 750;
}

.retry-btn:active {
  background: #e4ece2;
}

.loading-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 4rpx solid #e3ebe4;
  border-top-color: #0b503b;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* Record Card */
.record-card {
  background: #fff;
  border: 1rpx solid #e3ebe4;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f4f0;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.type-tag {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 750;
  white-space: nowrap;
}

.tag-daily {
  background: #fef7e2;
  color: #b27a00;
}

.tag-group {
  background: #e8f9e6;
  color: #1e7e22;
}

.record-time {
  font-size: 23rpx;
  color: #829087;
  font-weight: 600;
}

.status-pill {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 750;
  white-space: nowrap;
}

.status-pill.is-passed {
  background: #eefaeb;
  color: #0b593e;
}

.status-pill.is-pending {
  background: #d9ff3f;
  color: #062b23;
}

.status-pill.is-refused {
  background: #fdf0f0;
  color: #cf3a3a;
}

/* Card Body */
.card-body {
  display: flex;
  align-items: center;
  padding-top: 22rpx;
}

.thumb-wrap {
  position: relative;
  width: 170rpx;
  height: 170rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #eef2ed;
  flex: none;
  border: 1rpx solid #e8efe9;
}

.record-thumb {
  width: 100%;
  height: 100%;
}

.thumb-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 6rpx 0;
  background: rgba(7, 47, 39, 0.65);
  text-align: center;
}

.thumb-badge-text {
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
}

.stats-col {
  flex: 1;
  min-width: 0;
  padding-left: 26rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.stat-main {
  display: flex;
  align-items: baseline;
}

.dist-num {
  font-size: 60rpx;
  line-height: 1;
  font-weight: 800;
  color: #0b503b;
  letter-spacing: -2rpx;
}

.dist-unit {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #7a8980;
  font-weight: 600;
}

.stat-meta-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 14rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-label {
  font-size: 22rpx;
  color: #88958e;
}

.meta-value {
  font-size: 23rpx;
  font-weight: 750;
  color: #072f27;
}

.stat-sub-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.sub-tag {
  padding: 2rpx 12rpx;
  background: #f0f4ee;
  border-radius: 12rpx;
  font-size: 20rpx;
  color: #526b5e;
}

/* Card Remark Box */
.card-remark-box {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #fff8f6;
  border: 1rpx solid #fde2dc;
  border-radius: 14rpx;
}

.remark-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #cf3a3a;
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin-top: 2rpx;
}

.remark-content {
  flex: 1;
  min-width: 0;
}

.remark-title {
  display: block;
  font-size: 22rpx;
  font-weight: 750;
  color: #cf3a3a;
}

.remark-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #7f3b3b;
  line-height: 1.45;
}

.remark-score {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #b32d2d;
  font-weight: 700;
}

/* Card Footer */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0f4f0;
}

.footer-note {
  font-size: 21rpx;
}

.note-passed {
  color: #0b6949;
  font-weight: 600;
}

.note-pending {
  color: #7b872b;
}

.note-refused {
  color: #8c9690;
}

.card-action-del {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  background: #f6f8f6;
  border: 1rpx solid #e1e9e3;
  color: #728178;
  font-size: 21rpx;
  font-weight: 650;
}

.card-action-del:active {
  background: #fdf0f0;
  border-color: #f7d2d2;
  color: #cf3a3a;
}

.del-icon {
  font-size: 22rpx;
}

/* Pagination */
.list-pagination {
  padding: 36rpx 0 20rpx;
  text-align: center;
  font-size: 23rpx;
  color: #88958e;
}

.pagination-loading {
  color: #718078;
}

.pagination-retry {
  color: #0b503b;
  font-weight: 750;
}

.pagination-end {
  color: #a4b0a8;
  font-size: 21rpx;
}
