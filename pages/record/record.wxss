/* pages/record/record.wxss */
page {
  padding: 10rpx 30rpx;
  box-sizing: border-box;
  font-family: 'Times New Roman', Times, serif;
  background: #fafafa;
}
.color-tip {
  display: flex;
  padding: 0 25rpx 10rpx;
  font-size: 24rpx;
  color: #666;
}
.letter-indent {
  text-indent: -5px;
}

.activity {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  align-items: center;
  margin: 30rpx 0;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  position: relative;
  border-radius: 10rpx;

}
.activity .product-item-wrap{
  display: flex;
  align-items: center;
}
.activity movable-area {
  height: 210rpx;
  width: calc(100% - 120rpx);
}

.activity movable-view {
  height: 210rpx;
  width: calc(100vw - 60rpx);
  background: #fff;
  z-index: 999;
}
.cover-img {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  width: 210rpx;
  height: 210rpx;
  overflow: hidden;
  position: relative;
  margin-right: 30rpx;
  box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);
}

.cover-img image {
  width: 100%;
  max-height: 280rpx !important;
}
.activity-infor{
  flex: 1;
}
.activity-infor .title {
  color: #000;
  font-size: 30rpx;
}

.activity-infor .time {
  font-weight: bold;
}

.activity-infor .distance {
  display: inline-block;
  font-weight: 500;
  font-size: 98rpx;
  line-height: 1.2;
}
.delete-btn{
  position: absolute;
  top: 0;
  bottom: 0;
  right: 2rpx; 
  width: 120rpx;
  font-family: PingFangSC-Regular;
  font-size: 24rpx;
  color: #000;
  height: 210rpx;
  line-height: 210rpx;
  z-index: 1;
  background: #E66671;
  text-align: center;
}
.acty-type {
  position: absolute;
  left: 0;
  top: 0;
  color: #fff;
  font-size: 20rpx;
  padding: 5rpx 10rpx;
  border-radius: 0 0 10rpx 0;
}

.activity .acty-tag {
  position: absolute;
  right: 0;
  top: 20rpx;
}

.activity .acty-tag image {
  width: 100rpx;
  height: 50rpx;
}

.activity .acty-tag .title {
  width: 100%;
  font-size: 24rpx;
  color: #fff;
  line-height: 50rpx;
  text-align: center;
  position: absolute;
  right: 0;
  top: 0;
}

.state-bg {
  padding: 10rpx 20rpx;
  background: #4CB944;
  font-size: 20rpx;
  color: #fff;
  border-radius: 50rpx 0 0 50rpx;
  position: absolute;
  right: 0;
  top: 20rpx;
}

.pass {
  display: flex;
  align-items: center;
}

.pass image {
  width: 20rpx;
  height: 20rpx;
}

.state-bg.bg2 {
  background: rgba(255, 0, 0, .3);
}
