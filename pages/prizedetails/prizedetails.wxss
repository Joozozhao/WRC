/* pages/prizedetails/prizedetails.wxss */
.pg-wrap{
  padding-bottom: 200rpx;
}
.prize-infor{
  padding: 30rpx 20rpx;
}
.prize-infor .need-points{
  display: flex;
  font-size: 32rpx;
  color: #666;
  line-height: 50rpx;
  padding-bottom: 20rpx;
}
.goods-style {
  line-height: 2;
  font-size: 1.1em;
  color: #4CB944;
}
.need-points .ico{
  width: 50rpx;
  height: 50rpx;
}
.need-points .points{
  color: #d73021;
  font-size: 40rpx;
  margin-right: 10rpx;
}
.prize-infor .prize-tit{
  font-weight: bold;
}
.page-tit{
  display: flex;
  justify-content: space-around;
  line-height: 60rpx;
  font-size: 36rpx;
}
.main-pic image{
  width: 100%;
}
.total-wrap{
  display: inline;
  margin-left: 10rpx;
  font-weight: normal;
}
.tpye-con{
  display: flex;
  margin: 10rpx 0;
}
.tpye-con .tag-desc{
  border: 1px solid #e1e1e1;
  padding: 10rpx 30rpx;
  margin: 0 20rpx 20rpx 0;
}
.tpye-con .tag-desc.active{
  border: 1px solid #333;
  background: #333;
  color: #fff;
}
.tpye-con .tag-desc.active.dis{
  border: 1px solid #e1e1e1;
  background: #e1e1e1;
  color: #fff;
}
.use-code{
  display: inline-block;
  padding: 0 10rpx;
  color: #fff;
  border: 1px solid #fff;
  border-radius: 10rpx;
  font-size: 24rpx;
  margin-top: 10rpx;
}
.page-tit{
  margin: 40rpx 0;
}
.page-tit .line{
  width: 25%;
  height: 1px;
  background: #999;
  margin-top: 31rpx;
}
.prize-details{
  padding: 30rpx 40rpx;
  font-size: 28rpx;
}
.prize-details image{
  margin-bottom: 20rpx;
}
.pop-up{
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,.5);
  position: fixed;
  left: 0;
  top: 0;
  z-index: 3;
}
.isRuleShow{
  display: block;
}
.isRuleHide{
  display: none;
}
.pop-up .content{
  width: 100%;
  color: #fff;
  background: none;
  text-align: center;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%,-50%);
  z-index: 4;
}
.prize-name{
  font-weight: bold;
  font-size: 42rpx;
  padding: 40rpx 0;
}
.exchange-list{
  margin-bottom: 50rpx;
}
.exchange-list .tit{
  text-align: left;
  padding: 20rpx 0;
  margin: 20rpx;
}
.user-list{
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}
.avastar{
  width: 80rpx;
  height: 80rpx;
  min-height: 80rpx;
  border-radius: 50%;
  margin: 10rpx;
}
.content .btn{
  width: 35%;
  line-height: 2.5;
  font-size: 28rpx;
  color: #fff;
  border: 1px solid #fff;
  border-radius: 5rpx;
  margin: 0 auto 20rpx;
}
.content .btn.white-btn{
  background: #fff;
  color: #333;
}
.btm-btn .btn{
  line-height: 90rpx;
}
.swiper .wx-swiper-dot-active{
  background: #333;
}
.modal-choose{
  width: 100%;
  background: #fff;
  position: fixed;
  left: 0;
  bottom: 0;
  z-index: 4;
  box-sizing: border-box;
}
.modal-choose .top-con{
  padding: 30rpx;
}
.modal-choose .btnOne{
  width: 100%;
  border-radius: 0;
  color: #fff;
  font-weight: normal;
  line-height: 100rpx;
}
.mycon-tit{
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  font-weight: bold;
}
.total-num{
  color: #d73021;
  text-align: right;
}
.prize-type{
  padding: 20rpx;
  margin-top: 20rpx;
}
.tab-wrap{
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  line-height: 80rpx;
  font-size: 26rpx;
  color: #666;
}
.tab-wrap .tab-item{
  border: 1px solid #f1f1f1;
}

.tab-wrap .tab-item1{
  flex: 1;
}
.tab-wrap .tab-item2{
  flex: 2;
}
.tab-wrap .tab-item3{
  flex: 3;
}