<site-header show-back="{{true}}" back-url="/pages/challenge/challenge"></site-header>
<!-- WRC Edit Challenge: 编辑挑战 -->
<view class="edit-page">
  <form bindsubmit="submit">
    <view class="edit-header">
      <text class="eyebrow">WRC · CHALLENGE MANAGEMENT</text>
      <text class="page-title">编辑挑战</text>
      <text class="page-subtitle">修改挑战目标、起止日期、奖励与规则说明</text>
    </view>

    <!-- 01 挑战基本信息 -->
    <view class="form-card">
      <view class="card-badge">01 / 基础信息</view>

      <view class="form-group">
        <label class="form-label">挑战名称</label>
        <input
          class="form-input"
          name="actyName"
          value="{{actyName}}"
          placeholder="例如：2026年10月月度里程挑战"
          placeholder-class="placeholder-text" />
      </view>

      <view class="form-group">
        <label class="form-label">挑战类型</label>
        <view class="form-input is-disabled">{{actyType}}</view>
      </view>

      <view class="form-group" bindtap="pickerShow">
        <label class="form-label">挑战起止日期</label>
        <view class="time-display-box">
          <view class="time-item">
            <text class="time-sub">开始日期</text>
            <text class="time-val"><block wx:if="{{startTime}}">{{startTime}}</block><block wx:else>点击选择开始日期</block></text>
          </view>
          <text class="time-arrow">→</text>
          <view class="time-item">
            <text class="time-sub">结束日期</text>
            <text class="time-val"><block wx:if="{{endTime}}">{{endTime}}</block><block wx:else>点击选择结束日期</block></text>
          </view>
        </view>
      </view>

      <view class="form-group">
        <label class="form-label">挑战目标距离 (公里)</label>
        <input
          class="form-input"
          type="digit"
          name="distance"
          value="{{distance}}"
          placeholder="例如：100"
          placeholder-class="placeholder-text" />
      </view>

      <view class="form-group">
        <label class="form-label">挑战说明与规则</label>
        <textarea
          class="form-textarea"
          name="remark"
          value="{{remark}}"
          placeholder="请输入本次挑战的规则、达标条件或鼓励寄语"
          placeholder-class="placeholder-text"
          maxlength="-1" />
      </view>
    </view>

    <!-- 02 挑战封面图片 -->
    <view class="form-card">
      <view class="card-badge">02 / 封面图片</view>

      <view class="cover-uploader" wx:if="{{!tempFilePaths}}" bindtap="uploadAction">
        <view class="uploader-icon">🎯</view>
        <text class="uploader-title">点击上传挑战封面</text>
        <text class="uploader-sub">建议使用 300 × 240 等比例跑步插画或海报</text>
      </view>

      <view class="cover-preview-box" wx:else>
        <image class="cover-image" src="{{tempFilePaths}}" mode="aspectFill" bindtap="uploadAction"></image>
        <view class="cover-actions">
          <view class="cover-btn change-btn" bindtap="uploadAction">重新选择</view>
          <view class="cover-btn delete-btn" bindtap="deleteCover">删除</view>
        </view>
      </view>
    </view>

    <!-- 03 挑战奖励设置 -->
    <view class="form-card">
      <view class="card-badge">03 / 达标奖励</view>

      <view class="form-group">
        <label class="form-label">奖励类型</label>
        <view class="chip-group">
          <view
            class="chip {{stype === 0 ? 'active' : ''}}"
            data-type="0"
            bindtap="chooseRewardType">
            积分
          </view>
          <view
            class="chip {{stype === 1 ? 'active' : ''}}"
            data-type="1"
            bindtap="chooseRewardType">
            小花儿
          </view>
        </view>
      </view>

      <view class="form-group">
        <label class="form-label">奖励分值 / 数量</label>
        <input
          class="form-input"
          type="digit"
          name="score"
          value="{{score}}"
          placeholder="例如：50"
          placeholder-class="placeholder-text" />
      </view>
    </view>

    <!-- 04 参与设置 -->
    <view class="form-card">
      <view class="card-badge">04 / 报名填写项</view>

      <view class="switch-row">
        <view class="switch-info">
          <text class="switch-title">跑友真实姓名</text>
          <text class="switch-sub">系统默认必需项</text>
        </view>
        <switch checked="{{true}}" disabled color="#075b40" />
      </view>

      <view class="switch-row border-top">
        <view class="switch-info">
          <text class="switch-title">联系手机号码</text>
          <text class="switch-sub">开启后，跑友加入挑战需提供联系电话</text>
        </view>
        <switch checked="{{hasMobile === 1}}" bindchange="toggleMobile" color="#075b40" />
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="bottom-action-bar">
      <button class="primary-submit-btn" form-type="submit" hover-class="btn-pressed">保存挑战修改</button>
    </view>
  </form>

</view>

<!-- 日期选择器 -->
<time-picker
  pickerShow="{{isPickerShow}}"
  id="picker"
  wx:if="{{isPickerRender}}"
  bind:hidePicker="pickerHide"
  bind:setPickerTime="setPickerTime"
  config="{{pickerConfig}}">
</time-picker>
