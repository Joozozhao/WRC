/* pages/orderdetail/orderdetail.wxss —— 暖白 / 深松绿 / 荧光黄绿（对齐 docs/design/redesign-baseline.md 与 prizedetails） */
page {
  background: #fbfcf9;
  color: #072f27;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}
.od-page {
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.od-kicker {
  display: block;
  color: #0d6447;
  font-size: 21rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}

/* 加载骨架 */
.od-loading {
  padding: 50rpx 40rpx;
}
.od-skeleton-card {
  height: 220rpx;
  margin-bottom: 30rpx;
  border-radius: 20rpx;
  background: #eaf0e9;
}
.od-skeleton-line {
  width: 45%;
  height: 30rpx;
  margin: 18rpx 0;
  border-radius: 8rpx;
  background: #eaf0e9;
}
.od-skeleton-line-long {
  width: 76%;
}
.od-state-tip {
  display: block;
  margin-top: 36rpx;
  color: #73867b;
  font-size: 25rpx;
}

/* 错误态 */
.od-error {
  padding: 24rpx 40rpx 60rpx;
}
.od-error-title {
  display: block;
  margin-top: 32rpx;
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 800;
}
.od-error-copy {
  display: block;
  margin-top: 18rpx;
  color: #697d70;
  font-size: 26rpx;
  line-height: 1.6;
}
.od-retry-button {
  width: 240rpx;
  height: 84rpx;
  margin: 40rpx 0 0;
  border-radius: 44rpx;
  background: #d9ff3f;
  color: #092f27;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 84rpx;
}
.od-retry-button::after {
  border: 0;
}

/* 头部 */
.od-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx 10rpx;
}
.od-head-label {
  color: #819187;
  font-size: 21rpx;
}

/* 分区 */
.od-section {
  margin: 28rpx 40rpx 0;
}
.od-section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.od-section-title {
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 800;
}
.od-section-index {
  color: #8a9b8e;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* 收货信息卡 */
.od-address-card {
  padding: 28rpx;
  border: 1rpx solid #e3ebe4;
  border-radius: 22rpx;
  background: #fff;
}
.od-address-top {
  display: flex;
  align-items: baseline;
}
.od-address-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #072f27;
}
.od-address-tel {
  margin-left: auto;
  color: #345747;
  font-size: 26rpx;
  font-weight: 700;
}
.od-address-detail {
  display: block;
  margin-top: 12rpx;
  color: #4c6355;
  font-size: 25rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

/* 商品卡 */
.od-product-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border: 1rpx solid #e3ebe4;
  border-radius: 22rpx;
  background: #fff;
}
.od-product-img {
  flex: none;
  width: 180rpx;
  height: 180rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #edf2eb;
}
.od-product-img image {
  width: 100%;
  height: 100%;
}
.od-product-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.od-product-name {
  display: block;
  color: #072f27;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.od-product-spec {
  display: block;
  margin-top: 10rpx;
  color: #6c8072;
  font-size: 23rpx;
  overflow-wrap: anywhere;
}
.od-product-cost {
  display: block;
  margin-top: 10rpx;
  color: #0b503b;
  font-size: 25rpx;
  font-weight: 750;
}
.od-total {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 22rpx 28rpx;
  border: 1rpx solid #e3ebe4;
  border-radius: 18rpx;
  background: #fff;
}
.od-total-label {
  color: #345747;
  font-size: 25rpx;
  font-weight: 750;
}
.od-total-value {
  color: #0b503b;
  font-size: 32rpx;
  font-weight: 800;
}

/* 订单信息卡 */
.od-info-card {
  padding: 6rpx 28rpx;
  border: 1rpx solid #e3ebe4;
  border-radius: 22rpx;
  background: #fff;
}
.od-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f0f4ef;
}
.od-info-row:last-child {
  border-bottom: 0;
}
.od-info-label {
  flex: none;
  margin-right: 24rpx;
  color: #819187;
  font-size: 24rpx;
}
.od-info-value {
  color: #304d3d;
  font-size: 25rpx;
  text-align: right;
  overflow-wrap: anywhere;
}
.od-state {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 750;
}
.od-state.is-pending {
  background: #d9ff3f;
  color: #092f27;
}
.od-state.is-shipped {
  background: #edf5dd;
  color: #0b503b;
}
.od-state.is-done {
  background: #f0f4ef;
  color: #64756b;
}
.od-state.is-returned {
  background: #f7ede1;
  color: #815b32;
}

/* 底部操作条 */
.od-action {
  position: fixed;
  z-index: 5;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 15rpx 40rpx calc(19rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #dfe8df;
  background: #fbfcf9;
}
.od-action-button {
  display: flex;
  width: 100%;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  border-radius: 48rpx;
  background: #d9ff3f;
  color: #092f27;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.2;
}
.od-action-button::after {
  border: 0;
}
.od-action-hint {
  display: block;
  padding: 20rpx 0;
  color: #627b69;
  font-size: 24rpx;
  text-align: center;
}
