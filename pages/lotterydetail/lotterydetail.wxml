<site-header show-back="{{true}}" back-url="/pages/manage/manage"></site-header>
<!--pages/lotterydetail/lotterydetail.wxml-->
<view class="luck-page">
  <view class="luck-hero">
    <text class="luck-eyebrow">WRC · LUCKY DRAW</text>
    <text class="luck-title">抽奖详情</text>
    <view class="luck-title-line"></view>
  </view>

  <view class="luck-prize">
    <view class="luck-prize-media">
      <image src="{{imgSrc}}" mode="aspectFit"></image>
    </view>
    <view class="luck-prize-info">
      <view class="luck-row"><text class="luck-label">奖品名称</text><text class="luck-value">{{goodName}}</text></view>
      <view class="luck-row"><text class="luck-label">奖品数量</text><text class="luck-value">{{goods_num}} 份</text></view>
      <view class="luck-row"><text class="luck-label">开奖时间</text><text class="luck-value">{{luckTime}}</text></view>
    </view>
  </view>

  <view class="luck-section-head">
    <text class="luck-section-title">关联活动</text>
    <text class="luck-section-index">01 / ACTIVITY</text>
  </view>
  <view class="luck-acty">
    <view class="luck-acty-cover">
      <image src="{{acty_img}}" mode="aspectFill"></image>
      <view class="luck-acty-mask" wx:if="{{state == '已结束'}}">
        <view class="luck-acty-state">{{state}}</view>
      </view>
    </view>
    <view class="luck-acty-info">
      <view class="luck-acty-title">{{acty_name}}</view>
      <view class="luck-tags"><text class="luck-tag">{{acty_type}}</text><text class="luck-tag luck-tag-org">{{addr}}</text></view>
      <view class="luck-meta">
        <image src="/images/time.png" class="luck-meta-ico"></image>
        <text class="luck-meta-text">{{start_time}}-{{end_time}}</text>
      </view>
      <view class="luck-meta">
        <image src="/images/place.png" class="luck-meta-ico"></image>
        <text class="luck-meta-text">{{address}}</text>
      </view>
    </view>
  </view>

  <view class="luck-result" wx:if="{{luckState == 1&&joinState==1}}">
    <block wx:if="{{lucky}}">
      <view class="luck-result-title">恭喜您！已经中奖</view>
      <view class="luck-code">
        <text>兑换码 {{codeNum}}</text>
        <view class="luck-code-btn" bindtap="textPaste">去兑换</view>
      </view>
    </block>
    <view class="luck-result-title is-fail" wx:else>很遗憾，您未中奖</view>
  </view>

  <block wx:if="{{luckState == 1}}">
    <block wx:if="{{luckList.length>0}}">
      <view class="luck-section-head">
        <text class="luck-section-title">中奖名单</text>
        <text class="luck-section-index">02 / WINNERS</text>
      </view>
      <view class="luck-card">
        <view class="luck-winners">
          <block wx:for="{{luckList}}" wx:key="index" wx:if="{{item.state==1}}">
            <view class="luck-winner">
              <image src="{{item.header_url}}" class="luck-avatar luck-avatar-big" mode="aspectFill"></image>
              <view class="luck-winner-name" wx:if="{{item.name==''}}">{{item.nick_name}}</view>
              <view class="luck-winner-name" wx:else>{{item.name}}</view>
            </view>
          </block>
        </view>
      </view>
    </block>
  </block>

  <block wx:if="{{luckList.length>0}}">
    <view class="luck-section-head">
      <text class="luck-section-title">{{luckList.length}}人已参与抽奖活动</text>
      <text class="luck-section-index">03 / JOINED</text>
    </view>
    <view class="luck-card">
      <view class="luck-joined">
        <block wx:for="{{luckList}}" wx:key="index">
          <image src="{{item.header_url}}" class="luck-avatar" mode="aspectFill"></image>
        </block>
      </view>
    </view>
  </block>
</view>
