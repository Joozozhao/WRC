/* pages/addtype/addtype.wxss */
page { background: #fbfcf9; color: #072f27; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.spec-page { min-height: 100vh; padding-top: 0;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.spec-hero { padding: 24rpx 44rpx 32rpx; border-bottom: 1rpx solid #e1e9e3; }
.spec-eyebrow { display: block; color: #0d6447; font-size: 22rpx; font-weight: 750; letter-spacing: 3rpx; }
.spec-title { display: block; margin-top: 27rpx; font-size: 72rpx; line-height: 1.15; font-weight: 800; letter-spacing: -2rpx; }
.spec-title-line { width: 185rpx; height: 7rpx; margin-top: 4rpx; border-radius: 10rpx; background: #d9ff3f; transform: rotate(-2deg); }
.spec-intro { display: block; margin-top: 22rpx; color: #7a8980; font-size: 26rpx; line-height: 1.6; }
.spec-card { margin: 26rpx 40rpx 0; padding: 26rpx 28rpx 28rpx; border: 1rpx solid #e3ebe4; border-radius: 22rpx; background: #fff; box-sizing: border-box; }
.spec-head { display: flex; align-items: center; }
.spec-name-ipt { flex: 1; min-width: 0; height: 88rpx; padding: 0 24rpx; border: 1rpx solid #dfe8df; border-radius: 14rpx; background: #fbfcf9; color: #072f27; font-size: 28rpx; box-sizing: border-box; }
.spec-add { display: flex; flex: none; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; margin-left: 18rpx; border-radius: 14rpx; background: #d9ff3f; color: #0b392b; font-size: 56rpx; font-weight: 700; line-height: 1; }
.spec-row { display: flex; align-items: center; margin-top: 20rpx; }
.spec-ipt { height: 88rpx; padding: 0 24rpx; border: 1rpx solid #dfe8df; border-radius: 14rpx; background: #fbfcf9; color: #072f27; font-size: 27rpx; box-sizing: border-box; }
.spec-ipt-desc { flex: 3; min-width: 0; }
.spec-ipt-stock { flex: 2; min-width: 0; margin-left: 16rpx; text-align: center; }
.spec-del { flex: none; margin-left: 18rpx; padding: 8rpx 18rpx; border: 1rpx solid #ecd8d2; border-radius: 24rpx; color: #a8432c; font-size: 23rpx; }
.spec-ph { color: #9aa8a0; font-size: 27rpx; }
.spec-addtag { margin: 26rpx 40rpx 0; padding: 30rpx 0; border: 2rpx dashed #cfe0c9; border-radius: 22rpx; background: #fff; color: #0b593e; text-align: center; font-size: 28rpx; font-weight: 750; }
.spec-footer { position: fixed; z-index: 5; right: 0; bottom: 0; left: 0; padding: 15rpx 40rpx calc(19rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #dfe8df; background: #fbfcf9; }
.spec-submit { display: flex; width: 100%; height: 92rpx; align-items: center; justify-content: center; box-sizing: border-box; margin: 0; border-radius: 48rpx; background: #d9ff3f; color: #092f27; font-size: 29rpx; font-weight: 800; line-height: 1.2; }
.spec-submit::after { border: 0; }
