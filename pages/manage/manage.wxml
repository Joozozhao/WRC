<!--pages/manage/manage.wxml-->
<view class="vw-wrap">
  <view class="meun-item awesome-bg b-purple" bindtap="creatNew">创建团跑<image src="/images/arrow-r-gray.png" class="add-arrow"></image>
  </view>
  <view class="meun-item awesome-bg b-green" bindtap="creatChallenge">创建挑战<image src="/images/arrow-r-gray.png" class="add-arrow"></image>
  </view>
  <view class="meun-item awesome-bg b-purple" bindtap="toLottery">抽奖管理<image src="/images/arrow-r-gray.png" class="add-arrow"></image>
  </view>
