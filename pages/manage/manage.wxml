  </view>
  <view class="meun-item awesome-bg b-rainbow" bindtap="toRecord">打卡管理<image src="/images/arrow-r-gray.png" class="add-arrow"></image>
  </view>
  <view class="meun-item awesome-bg b-purple" bindtap="toUser">会员管理<image src="/images/arrow-r-gray.png" class="add-arrow"></image>
  </view>
