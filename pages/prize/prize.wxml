<site-header show-back="{{true}}" back-url="/pages/mydata/mydata"></site-header>
<view class="prize-page">
  <view class="prize-hero">
    <text class="prize-eyebrow">WRC · REWARDS</text>
    <text class="prize-title">兑换中心</text>
    <view class="prize-title-line"></view>
    <text class="prize-intro">用每一步积累，换一份喜欢的奖励</text>
  </view>

  <view class="balance-row">
    <navigator class="balance-item" url="../checkpoint/checkpoint" hover-class="none">
      <text class="balance-label">我的积分</text>
      <text class="balance-value">{{score}}</text>
      <text class="balance-link">查看积分记录 ›</text>
    </navigator>
    <navigator class="balance-item balance-flower" url="../energy/energy" hover-class="none">
      <text class="balance-label">我的小花儿</text>
      <text class="balance-value">{{energy}}<text class="balance-unit" wx:if="{{energy != '--'}}"> 朵</text></text>
      <text class="balance-link">查看小花儿记录 ›</text>
    </navigator>
  </view>
  <view class="balance-note" wx:if="{{balanceState == 'guest'}}">登录后查看你的积分与小花儿余额</view>
  <view class="balance-note" wx:if="{{balanceState == 'error'}}">余额暂时无法加载</view>

  <view class="prize-tabs">
    <view class="prize-tab {{currentTab == 0 ? 'is-active' : ''}}" data-idx="0" bindtap="currentTab">
      <text>积分兑换</text><view class="tab-mark" wx:if="{{currentTab == 0}}"></view>
    </view>
    <view class="prize-tab {{currentTab == 1 ? 'is-active' : ''}}" data-idx="1" bindtap="currentTab">
      <text>小花儿兑换</text><view class="tab-mark" wx:if="{{currentTab == 1}}"></view>
    </view>
  </view>

  <view class="prize-section" wx:if="{{currentTab == 0}}">
    <view class="section-heading">
      <text class="section-title">积分好礼</text>
      <text class="section-note">使用积分兑换</text>
    </view>
    <view class="prize-grid" wx:if="{{listState == 'ready' && listData.length}}">
      <view class="prize-card" wx:for="{{listData}}" wx:for-item="item" wx:key="id" bindtap="toPrize" data-id="{{item.id}}">
        <view class="prize-image"><image src="{{item.goods_pic}}" mode="aspectFill"></image></view>
        <view class="prize-copy">
          <text class="prize-name">{{item.goods_name}}</text>
          <view class="prize-cost"><image src="../../images/point.png" mode="aspectFit"></image><text>{{item.score}} 积分</text><text class="prize-action">兑换 ›</text></view>
        </view>
      </view>
    </view>
    <view class="prize-state" wx:if="{{listState == 'loading'}}">正在加载兑换商品…</view>
    <view class="prize-state" wx:if="{{listState == 'error'}}"><text>商品暂时无法加载</text><text class="retry-action" bindtap="retryPrize">点击重试</text></view>
    <view class="prize-state" wx:if="{{listState == 'ready' && !listData.length}}">暂无可兑换的积分商品</view>
    <view class="prize-tail" wx:if="{{listState == 'ready' && listData.length && loadingMore}}">正在加载更多…</view>
    <view class="prize-tail retry-action" wx:if="{{listState == 'ready' && moreError}}" bindtap="retryMore">加载失败，点击重试</view>
    <view class="prize-tail" wx:if="{{listState == 'ready' && listData.length && !hasMore}}">已经到底了</view>
  </view>

  <view class="prize-section" wx:if="{{currentTab == 1}}">
    <view class="section-heading">
      <text class="section-title">小花儿好礼</text>
      <text class="section-note">超级会员专享兑换资格</text>
    </view>
    <view class="prize-grid" wx:if="{{listState == 'ready' && listData2.length}}">
      <view class="prize-card" wx:for="{{listData2}}" wx:for-item="item" wx:key="id" bindtap="toPrize2" data-id="{{item.id}}">
        <view class="prize-image"><image src="{{item.goods_pic}}" mode="aspectFill"></image></view>
        <view class="prize-copy">
          <text class="prize-name">{{item.goods_name}}</text>
          <view class="prize-cost"><image src="../../images/en-ico.svg" mode="aspectFit"></image><text>{{item.energy}} 朵</text><text class="prize-action">兑换 ›</text></view>
        </view>
      </view>
    </view>
    <view class="prize-state" wx:if="{{listState == 'loading'}}">正在加载兑换商品…</view>
    <view class="prize-state" wx:if="{{listState == 'error'}}"><text>商品暂时无法加载</text><text class="retry-action" bindtap="retryPrize">点击重试</text></view>
    <view class="prize-state" wx:if="{{listState == 'ready' && !listData2.length}}">暂无可兑换的小花儿商品</view>
    <view class="prize-tail" wx:if="{{listState == 'ready' && listData2.length && loadingMore}}">正在加载更多…</view>
    <view class="prize-tail retry-action" wx:if="{{listState == 'ready' && moreError}}" bindtap="retryMore">加载失败，点击重试</view>
    <view class="prize-tail" wx:if="{{listState == 'ready' && listData2.length && !hasMore}}">已经到底了</view>
  </view>
</view>
