<site-header show-back="{{true}}" back-url="/pages/manage/manage"></site-header>
<!-- WRC Lottery: 发起抽奖 -->
<view class="edit-page">
  <form bindsubmit="submit">
    <view class="edit-header">
      <text class="eyebrow">WRC · LUCKY DRAW</text>
      <text class="page-title">发起抽奖</text>
      <text class="page-subtitle">选择活动与奖品，设置开奖时间</text>
    </view>

    <view class="form-card">
      <view class="card-badge">01 / 抽奖设置</view>

      <view class="form-group" bindtap="toChooseActy">
        <label class="form-label">选择活动</label>
        <view class="select-field">
          <input class="form-input select-input" type="text" value="{{actyName}}" name="actyName" placeholder="请选择活动" placeholder-class="placeholder-text" disabled="disabled" />
          <text class="select-arrow">›</text>
        </view>
      </view>

      <view class="form-group" bindtap="pickArea">
        <label class="form-label">活动地区</label>
        <view class="select-field">
          <view class="form-input select-input {{sealType == '' ? 'is-placeholder' : ''}}">{{sealType == '' ? '请选择地区' : sealType}}</view>
          <input type="text" class="hidden-input" name="sealType" value="{{sealType}}" disabled="disabled" />
          <text class="select-arrow">›</text>
        </view>
      </view>

      <view class="form-group" bindtap="toChoosePrize">
        <label class="form-label">选择奖品</label>
        <view class="select-field">
          <input class="form-input select-input" type="text" value="{{goodsName}}" name="goodsName" placeholder="请选择奖品" placeholder-class="placeholder-text" disabled="disabled" />
          <text class="select-arrow">›</text>
        </view>
      </view>

      <view class="form-group">
        <label class="form-label">奖品份数</label>
        <input class="form-input" type="number" focus="{{focus}}" value="{{actyNum}}" name="actyNum" placeholder="请输入奖品份数" placeholder-class="placeholder-text" />
        <text class="field-tip" wx:if="{{total > 0}}">当前奖品库存 {{total}} 份</text>
      </view>

      <view class="form-group">
        <label class="form-label">开奖时间</label>
        <picker class="time-picker" mode="multiSelector" bindchange="bindStartMultiPickerChange" bindtap="pickerTap" bindcolumnchange="bindMultiPickerColumnChange" value="{{multiIndex}}" range="{{multiArray}}">
          <view class="form-input select-field-inner {{startDate == '' ? 'is-placeholder' : ''}}">
            <block wx:if="{{startDate == ''}}">请选择开奖日期与时间</block>
            <block wx:else>{{startDate}}</block>
          </view>
        </picker>
      </view>
    </view>

    <!-- 地区选择弹窗（保留在表单内，维持原提交字段） -->
    <view class="modal-mask" wx:if="{{showModal}}" bindtap="onCancel" data-status="cancel"></view>
    <view class="area-modal" wx:if="{{showModal}}">
      <view class="modal-head">
        <text class="modal-title">选择活动地区</text>
        <text class="modal-sub">可多选，确定后生效</text>
      </view>
      <checkbox-group data-index="{{index}}" bindchange="checkboxChange" name="sealType">
        <label class="area-row" wx:for="{{sealTypeList}}" wx:key="id" wx:for-item="item">
          <checkbox value="{{item.id}}" checked="{{item.checked}}" color="#075b40" />
          <text class="area-name">{{item.gzkind}}</text>
        </label>
      </checkbox-group>
      <view class="modal-foot">
        <view class="modal-btn cancel-btn" bindtap="onCancel" data-status="cancel">取消</view>
        <view class="modal-btn confirm-btn" bindtap="onConfirm" data-status="confirm">确定</view>
      </view>
    </view>

    <!-- 底部固定操作栏 -->
    <view class="bottom-action-bar">
      <button class="primary-submit-btn" form-type="submit" disabled="{{disable}}" hover-class="btn-pressed">发起抽奖</button>
    </view>
  </form>
</view>
