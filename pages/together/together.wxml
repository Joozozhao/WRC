<site-header show-back="{{true}}" back-url="/pages/activity/activity"></site-header>
<!--pages/together/together.wxml-->
<view class="together-page">
  <view class="together-header">
    <text class="eyebrow">WRC · RUN TOGETHER</text>
    <text class="page-title">聚跑成员</text>
    <view class="title-line"></view>
    <text class="page-subtitle" wx:if="{{loaded}}">共 {{totalCount}} 位跑友一起完成了这次聚跑</text>
    <text class="page-subtitle" wx:else>正在聚合同跑名单…</text>
  </view>

  <view class="member-list" wx:if="{{actyMember.length > 0}}">
    <block wx:for="{{actyMember}}" wx:key="id">
      <view class="member-card" data-userid="{{item.id}}" bindtap="myData" hover-class="card-hover">
        <image class="member-avatar" src="{{item.header_url || '/images/default.png'}}" mode="aspectFill"></image>

        <view class="member-info">
          <view class="name-row">
            <text class="member-name" wx:if="{{item.user_name !== ''}}">{{item.user_name}}</text>
            <text class="member-name" wx:else>{{item.nick_name || '跑友'}}</text>
            <image wx:if="{{item.level == 'VIP'}}" src="/images/superVIP.svg" mode="aspectFit" class="vip-icon"></image>
            <image wx:elif="{{item.level == '普通'}}" src="/images/normalVIP.svg" mode="aspectFit" class="vip-icon"></image>
            <image wx:if="{{item.sex == 1}}" src="/images/man.svg" mode="aspectFit" class="sex-icon"></image>
            <image wx:elif="{{item.sex == 2}}" src="/images/woman.svg" mode="aspectFit" class="sex-icon"></image>
          </view>
          <view class="meta-row">
            <text class="member-id">ID {{item.id}}</text>
            <text class="state-tag">已聚跑</text>
          </view>
        </view>

        <view class="member-action">
          <text class="action-text">TA的主页</text>
          <text class="action-arrow">→</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view class="empty-block" wx:elif="{{loaded && actyMember.length === 0}}">
    <view class="empty-mark">🏃</view>
    <text class="empty-title">暂无聚跑成员</text>
    <text class="empty-desc">跑友完成聚跑打卡后将展示在此处</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-block" wx:elif="{{loading && !loaded}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载聚跑成员…</text>
  </view>
</view>
