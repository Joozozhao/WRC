/* WRC Signin: 自包含视觉规范（暖白/深绿/荧光黄绿） */
page {
  background-color: #fafbf7;
  color: #103d2e;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.edit-page {
  min-height: 100vh;
  padding: 180rpx 36rpx 180rpx;
  box-sizing: border-box;
}

.edit-header {
  margin-bottom: 28rpx;
}

.eyebrow {
  display: block;
  color: #547767;
  font-size: 20rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
  margin-bottom: 12rpx;
}

.page-title {
  display: block;
  color: #073329;
  font-size: 54rpx;
  font-weight: 850;
  line-height: 1.15;
  letter-spacing: -1.5rpx;
}

.page-subtitle {
  display: block;
  color: #7d8b82;
  font-size: 24rpx;
  margin-top: 10rpx;
  line-height: 1.4;
}

.form-card {
  background: #ffffff;
  border: 1rpx solid #e3ebe4;
  border-radius: 26rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 47, 39, 0.03);
}

.card-badge {
  font-size: 22rpx;
  font-weight: 800;
  color: #105942;
  letter-spacing: 1rpx;
  margin-bottom: 22rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 750;
  color: #073329;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 84rpx;
  background: #f7faf7;
  border: 1rpx solid #dfe9df;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  color: #073329;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.target-input {
  font-size: 40rpx;
  font-weight: 800;
  color: #0c6246;
}

.field-tip {
  display: block;
  font-size: 21rpx;
  color: #87998d;
  margin-top: 10rpx;
}

.placeholder-text {
  color: #9cb0a3;
  font-size: 26rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 20rpx;
  text-align: center;
}

.empty-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 750;
  color: #073329;
}

.empty-sub {
  font-size: 22rpx;
  color: #87998d;
  margin-top: 8rpx;
}

.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 36rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(250, 251, 247, 0.96);
  backdrop-filter: blur(12px);
  border-top: 1rpx solid #e3ede3;
  z-index: 100;
}

.primary-submit-btn {
  background: #d9ff3f;
  color: #123d2f;
  font-size: 30rpx;
  font-weight: 850;
  border-radius: 999rpx;
  height: 94rpx;
  line-height: 94rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(18, 61, 47, 0.12);
}

.primary-submit-btn::after {
  border: none;
}

.primary-submit-btn[disabled] {
  background: #e6ede2;
  color: #9db0a2;
  box-shadow: none;
}

.btn-pressed {
  transform: scale(0.985);
  background: #cbf22f;
}

/* 未登录遮罩：保留原有点击登录逻辑 */
.modal-login {
  width: 100vw;
  height: 100vh;
  position: fixed;
  left: 0;
  top: 0;
  background: rgba(7, 47, 39, 0.35);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-tip {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 44rpx 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.18);
}

.login-tip-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #073329;
}

.login-tip-sub {
  font-size: 22rpx;
  color: #7d8b82;
  margin-top: 10rpx;
}
