/* pages/userinfor/userinfor.wxss */
page {
  background: #fbfcf9;
  color: #072f27;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}
.userinfor-page {
  min-height: 100vh;
  padding: 0 40rpx 180rpx;
  box-sizing: border-box;
}

/* Header Avatar Card */
.profile-header-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #fff;
  border: 1rpx solid #e3ebe4;
  border-radius: 24rpx;
  margin-bottom: 36rpx;
}
.avatar-wrap {
  width: 108rpx;
  height: 108rpx;
  flex: none;
}
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #e6eee7;
}
.profile-header-meta {
  flex: 1;
  min-width: 0;
  padding-left: 24rpx;
}
.profile-header-nick {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #072f27;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.profile-header-level {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #84918a;
}
.edit-avatar-btn {
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  background: #f0f5ee;
  color: #0b503b;
  font-size: 23rpx;
  font-weight: 750;
  flex: none;
}

/* Section */
.form-section {
  margin-bottom: 36rpx;
}
.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 27rpx;
  font-weight: 800;
  color: #072f27;
}
.section-badge {
  font-size: 21rpx;
  color: #87938c;
}
.section-badge.is-optional {
  color: #9aa69e;
}
.form-card {
  padding: 0 28rpx;
  background: #fff;
  border: 1rpx solid #e3ebe4;
  border-radius: 24rpx;
}
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 1rpx solid #f0f4ef;
}
.form-row:last-child {
  border-bottom: none;
}
.row-label {
  font-size: 27rpx;
  font-weight: 750;
  color: #082f27;
  width: 170rpx;
  flex: none;
}
.row-input {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #072f27;
}
.row-placeholder {
  color: #9aa69e;
}
.row-picker {
  flex: 1;
  text-align: right;
}
.picker-value {
  font-size: 26rpx;
  color: #072f27;
}
.picker-arrow {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #798782;
}

/* Gender Selection */
.gender-group {
  display: flex;
  gap: 16rpx;
}
.gender-label {
  padding: 8rpx 28rpx;
  border-radius: 24rpx;
  background: #f0f5ee;
  color: #64756b;
  font-size: 24rpx;
  font-weight: 700;
}
.gender-label.is-checked {
  background: #d9ff3f;
  color: #062b23;
  font-weight: 800;
}
.hidden-radio {
  display: none;
}

/* Bottom Actions */
.form-bottom-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 50rpx;
}
.action-btn {
  flex: 1;
  height: 94rpx;
  line-height: 94rpx;
  border-radius: 50rpx;
  font-size: 29rpx;
  font-weight: 800;
  border: none;
}
.action-btn::after { border: none; }
.btn-cancel {
  background: #f0f4ee;
  color: #68796e;
}
.btn-save {
  background: #d9ff3f;
  color: #062b23;
}
.version-tip {
  margin-top: 36rpx;
  color: #a4b0a7;
  font-size: 20rpx;
  text-align: center;
}
