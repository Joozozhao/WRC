<site-header show-back="{{true}}" back-url="/pages/mydata/mydata"></site-header>
<!--pages/userinfor/userinfor.wxml-->
<form bindsubmit="onSubmit" class="userinfor-form">
  <view class="userinfor-page">
    <!-- Header Avatar & Level Card -->
    <view class="profile-header-card">
      <view class="avatar-wrap">
        <image class="avatar-img" src="{{avatarUrl || '/images/default.png'}}" mode="aspectFill"></image>
        <image wx:if="{{level == 'VIP'}}" class="vip-badge" src="/images/vip_1.svg" mode="aspectFit"></image>
        <image wx:elif="{{level == '普通'}}" class="vip-badge" src="/images/normal.svg" mode="aspectFit"></image>
      </view>
      <view class="profile-header-meta">
        <text class="profile-header-nick">{{nickName || '跑者昵称'}}</text>
        <text class="profile-header-level">{{level ? level + '会员' : '微跑团跑者'}}</text>
      </view>
      <view class="edit-avatar-btn" bindtap="editUrl">修改资料</view>
    </view>

    <!-- Section 1: Required Fields -->
    <view class="form-section">
      <view class="section-title-row">
        <text class="section-title">01 / 基本资料</text>
        <text class="section-badge">必填</text>
      </view>
      <view class="form-card">
        <view class="form-row">
          <text class="row-label">真实姓名</text>
          <input type="text" value="{{name}}" name="name" class="row-input" placeholder="请输入姓名" placeholder-class="row-placeholder" />
        </view>
        <view class="form-row">
          <text class="row-label">手机号码</text>
          <input type="number" maxlength="11" value="{{mobile}}" name="mobile" class="row-input" placeholder="请输入手机号" placeholder-class="row-placeholder" />
        </view>
        <view class="form-row">
          <text class="row-label">性别</text>
          <radio-group class="gender-group" name="sex">
            <label class="gender-label {{sex == 1 ? 'is-checked' : ''}}" bindtap="radiocon1">
              <radio value="1" checked="{{sex == 1}}" class="hidden-radio" />
              <text>男</text>
            </label>
            <label class="gender-label {{sex == 2 ? 'is-checked' : ''}}" bindtap="radiocon2">
              <radio value="2" checked="{{sex == 2}}" class="hidden-radio" />
              <text>女</text>
            </label>
          </radio-group>
        </view>
        <view class="form-row">
          <text class="row-label">身份证号</text>
          <input type="text" maxlength="18" value="{{birthday}}" name="birthday" class="row-input" placeholder="输入身份证号（用于赛事/保险）" placeholder-class="row-placeholder" />
        </view>
        <view class="form-row">
          <text class="row-label">常跑地区</text>
          <picker mode="selector" range="{{addressArray}}" bindchange="pickerSelected" value="{{address}}" class="row-picker">
            <view class="picker-value {{address ? '' : 'row-placeholder'}}">
              {{address || '请选择地区'}} <text class="picker-arrow">▾</text>
            </view>
          </picker>
          <input type="text" name="address" value="{{address}}" style="display:none;" />
        </view>
      </view>
    </view>

    <!-- Section 2: Optional Gear Sizes -->
    <view class="form-section">
      <view class="section-title-row">
        <text class="section-title">02 / 团服尺码</text>
        <text class="section-badge is-optional">选填 · 定制团服参考</text>
      </view>
      <view class="form-card">
        <view class="form-row">
          <text class="row-label">上衣尺码</text>
          <picker mode="selector" range="{{jacketArray}}" bindchange="pickerJacket" value="{{jacket}}" class="row-picker">
            <view class="picker-value {{jacket ? '' : 'row-placeholder'}}">
              {{jacket || '请选择'}} <text class="picker-arrow">▾</text>
            </view>
          </picker>
          <input type="text" name="jacket" value="{{jacket}}" style="display:none;" />
        </view>
        <view class="form-row">
          <text class="row-label">裤子尺码</text>
          <picker mode="selector" range="{{trousersArray}}" bindchange="pickerTrousers" value="{{trousers}}" class="row-picker">
            <view class="picker-value {{trousers ? '' : 'row-placeholder'}}">
              {{trousers || '请选择'}} <text class="picker-arrow">▾</text>
            </view>
          </picker>
          <input type="text" name="trousers" value="{{trousers}}" style="display:none;" />
        </view>
        <view class="form-row">
          <text class="row-label">头围</text>
          <picker mode="selector" range="{{headArray}}" bindchange="pickerHead" value="{{headSize}}" class="row-picker">
            <view class="picker-value {{headSize ? '' : 'row-placeholder'}}">
              {{headSize || '请选择'}} <text class="picker-arrow">▾</text>
            </view>
          </picker>
          <input type="text" name="headSize" value="{{headSize}}" style="display:none;" />
        </view>
        <view class="form-row">
          <text class="row-label">手长</text>
          <picker mode="selector" range="{{handArray}}" bindchange="pickerHand" value="{{handSize}}" class="row-picker">
            <view class="picker-value {{handSize ? '' : 'row-placeholder'}}">
              {{handSize || '请选择'}} <text class="picker-arrow">▾</text>
            </view>
          </picker>
          <input type="text" name="handSize" value="{{handSize}}" style="display:none;" />
        </view>
        <view class="form-row">
          <text class="row-label">跑鞋尺码</text>
          <picker mode="selector" range="{{shoesArray}}" bindchange="pickerShoes" value="{{shoes}}" class="row-picker">
            <view class="picker-value {{shoes ? '' : 'row-placeholder'}}">
              {{shoes || '请选择'}} <text class="picker-arrow">▾</text>
            </view>
          </picker>
          <input type="text" name="shoes" value="{{shoes}}" style="display:none;" />
        </view>
      </view>
    </view>

    <!-- Bottom Buttons -->
    <view class="form-bottom-actions">
      <button class="action-btn btn-cancel" bindtap="cancle">取消</button>
      <button class="action-btn btn-save" form-type="submit">保存资料</button>
    </view>
    <view class="version-tip" wx:if="{{versionNumber}}">WRC 版本号：{{versionNumber}}</view>
  </view>
</form>
