<site-header show-back="{{true}}" back-url="/pages/activity/activity"></site-header>
<!-- WRC Activity Data: 活动成绩榜 -->
<view class="actdata-page">
  <view class="actdata-header">
    <text class="eyebrow">WRC · ACTIVITY LEADERBOARD</text>
    <text class="page-title">活动成绩榜</text>
    <text class="page-subtitle">本期团跑实跑打卡与配速记录 · 共 {{dataList.length}} 条记录</text>
  </view>

  <!-- 我的本次成绩高亮卡片 -->
  <view class="my-card" wx:if="{{myRecord}}" data-id="{{myRecord.user_id}}" bindtap="myData">
    <view class="my-card-head">
      <view class="my-tag">我的本次打卡</view>
      <view class="my-rank">第 {{myRecord.rankNum}} 名</view>
    </view>
    <view class="my-card-body">
      <view class="my-dist-col">
        <text class="my-dist-val">{{myRecord.displayDistance}}</text>
        <text class="my-dist-unit">公里 (KM)</text>
      </view>
      <view class="my-divider"></view>
      <view class="my-speed-col">
        <text class="my-speed-val">{{myRecord.speed || "—"}}</text>
        <text class="my-speed-unit">平均配速</text>
      </view>
    </view>
  </view>

  <!-- 榜单列表 -->
  <view class="rank-list" wx:if="{{dataList.length > 0}}">
    <block wx:for="{{dataList}}" wx:key="index">
      <view class="rank-card {{item.isMe ? 'is-me' : ''}}" data-id="{{item.user_id}}" bindtap="myData" hover-class="card-hover">
        <view class="rank-index {{item.rankNum <= 3 ? 'top' : ''}}">
          <text wx:if="{{item.rankNum < 10}}">0{{item.rankNum}}</text>
          <text wx:else>{{item.rankNum}}</text>
        </view>

        <image class="runner-avatar" src="{{item.header_url || '/images/default.png'}}" mode="aspectFill"></image>

        <view class="runner-info">
          <view class="name-row">
            <text class="runner-name">{{item.nick_name || "跑者"}}</text>
            <text class="me-badge" wx:if="{{item.isMe}}">我</text>
            <image wx:if="{{item.level === 'VIP'}}" src="/images/superVIP.svg" mode="aspectFit" class="vip-icon"></image>
            <image wx:elif="{{item.level === '普通'}}" src="/images/normalVIP.svg" mode="aspectFit" class="vip-icon"></image>
            <image wx:if="{{item.sex == 1}}" src="/images/man.svg" mode="aspectFit" class="sex-icon"></image>
            <image wx:elif="{{item.sex == 2}}" src="/images/woman.svg" mode="aspectFit" class="sex-icon"></image>
          </view>
          <view class="meta-row">
            <text class="speed-pill">配速 {{item.speed || "—"}}</text>
          </view>
        </view>

        <view class="runner-dist-col">
          <text class="dist-val">{{item.displayDistance}}</text>
          <text class="dist-unit">KM</text>
        </view>
      </view>
    </block>

    <view class="list-footer">
      <text wx:if="{{loading}}">正在加载更多数据…</text>
      <text wx:elif="{{!hasMore}}">已经到底了 · 共 {{dataList.length}} 条记录</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-block" wx:elif="{{loaded && dataList.length === 0}}">
    <view class="empty-mark">📊</view>
    <text class="empty-title">暂无活动成绩数据</text>
    <text class="empty-desc">跑友完成团跑打卡后将展示于此</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-block" wx:elif="{{loading && !loaded}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在读取活动数据…</text>
  </view>
</view>
