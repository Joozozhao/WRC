/* WRC Activity Data: 活动数据视觉规范 */
page {
  background-color: #fafbf7;
  color: #103d2e;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.actdata-page {
  min-height: 100vh;
  padding: 180rpx 36rpx 80rpx;
  box-sizing: border-box;
}

.actdata-header {
  margin-bottom: 28rpx;
}

.eyebrow {
  display: block;
  color: #547767;
  font-size: 20rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
  margin-bottom: 12rpx;
}

.page-title {
  display: block;
  color: #073329;
  font-size: 54rpx;
  font-weight: 850;
  line-height: 1.15;
  letter-spacing: -1.5rpx;
}

.page-subtitle {
  display: block;
  color: #7d8b82;
  font-size: 24rpx;
  margin-top: 10rpx;
  line-height: 1.4;
}

/* 我的本次成绩卡片 */
.my-card {
  background: #f0f6ec;
  border: 1rpx solid #cce0cb;
  border-left: 6rpx solid #146342;
  border-radius: 22rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(12, 98, 70, 0.06);
}

.my-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.my-tag {
  background: #0b503b;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 750;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.my-rank {
  font-size: 24rpx;
  font-weight: 800;
  color: #0b503b;
}

.my-card-body {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.my-dist-col,
.my-speed-col {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.my-dist-val {
  font-size: 44rpx;
  font-weight: 850;
  color: #073329;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.my-dist-unit,
.my-speed-unit {
  font-size: 20rpx;
  color: #7a8c80;
  margin-top: 6rpx;
}

.my-divider {
  width: 1rpx;
  height: 52rpx;
  background: #c8dac7;
  margin: 0 24rpx;
}

.my-speed-val {
  font-size: 36rpx;
  font-weight: 800;
  color: #0c6246;
  line-height: 1;
}

/* 列表卡片 */
.rank-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rank-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #e3ebe4;
  border-radius: 22rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 14rpx rgba(7, 47, 39, 0.02);
  transition: background 0.15s ease;
}

.rank-card.is-me {
  background: #f7faf5;
  border-color: #bad3ba;
}

.card-hover {
  background: #f8faf6;
}

.rank-index {
  width: 48rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #92a297;
  font-variant-numeric: tabular-nums;
  flex: none;
  text-align: center;
}

.rank-index.top {
  color: #0c6246;
  font-weight: 850;
  font-size: 28rpx;
}

.runner-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 2rpx solid #e5eee4;
  background: #e9f0e8;
  flex: none;
  margin-left: 8rpx;
}

.runner-info {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  padding-right: 12rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.runner-name {
  font-size: 29rpx;
  font-weight: 800;
  color: #083427;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 220rpx;
}

.me-badge {
  background: #d9ff3f;
  color: #123d2f;
  font-size: 18rpx;
  font-weight: 800;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  flex: none;
}

.vip-icon {
  width: 28rpx;
  height: 28rpx;
  flex: none;
}

.sex-icon {
  width: 24rpx;
  height: 24rpx;
  flex: none;
}

.meta-row {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.speed-pill {
  font-size: 21rpx;
  color: #72877a;
  background: #f3f7f2;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.runner-dist-col {
  display: flex;
  align-items: baseline;
  flex: none;
  font-variant-numeric: tabular-nums;
}

.dist-val {
  font-size: 36rpx;
  font-weight: 850;
  color: #0c6246;
  line-height: 1;
}

.dist-unit {
  font-size: 19rpx;
  font-weight: 750;
  color: #788c7f;
  margin-left: 6rpx;
}

.list-footer {
  text-align: center;
  padding: 34rpx 0 16rpx;
  font-size: 22rpx;
  color: #8fa094;
}

.empty-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-mark {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #103d2e;
}

.empty-desc {
  font-size: 24rpx;
  color: #7e8d83;
  margin-top: 12rpx;
}

.loading-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid #dce8db;
  border-top-color: #0c6246;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #768a7d;
  margin-top: 18rpx;
}
