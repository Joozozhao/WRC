/* pages/address/address.wxss —— 暖白 / 深松绿 / 荧光黄绿（对齐 docs/design/redesign-baseline.md 与 prizedetails） */
page {
  background: #fbfcf9;
  color: #072f27;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}
.addr-page {
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.addr-kicker {
  display: block;
  color: #0d6447;
  font-size: 21rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}
.addr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx 10rpx;
}
.addr-head-label {
  color: #819187;
  font-size: 21rpx;
}

/* 加载骨架 */
.addr-loading {
  padding: 20rpx 40rpx;
}
.addr-skeleton-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e3ebe4;
  border-radius: 22rpx;
  background: #fff;
}
.addr-skeleton-line {
  width: 55%;
  height: 30rpx;
  margin: 14rpx 0;
  border-radius: 8rpx;
  background: #eaf0e9;
}
.addr-skeleton-line-long {
  width: 82%;
}
.addr-state-tip {
  display: block;
  margin-top: 30rpx;
  color: #73867b;
  font-size: 24rpx;
  text-align: center;
}

/* 错误态 */
.addr-error {
  padding: 100rpx 40rpx 60rpx;
}
.addr-error-title {
  display: block;
  margin-top: 32rpx;
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 800;
}
.addr-error-copy {
  display: block;
  margin-top: 18rpx;
  color: #697d70;
  font-size: 26rpx;
  line-height: 1.6;
}
.addr-retry-button {
  width: 240rpx;
  height: 84rpx;
  margin: 40rpx 0 0;
  border-radius: 44rpx;
  background: #d9ff3f;
  color: #092f27;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 84rpx;
}
.addr-retry-button::after {
  border: 0;
}

/* 空态 */
.addr-empty {
  padding: 120rpx 40rpx;
  text-align: center;
}
.addr-empty-title {
  display: block;
  color: #304d3d;
  font-size: 34rpx;
  font-weight: 800;
}
.addr-empty-copy {
  display: block;
  margin-top: 14rpx;
  color: #84918a;
  font-size: 24rpx;
}

/* 地址卡片 */
.addr-card {
  margin: 20rpx 40rpx 8rpx;
  padding: 28rpx 28rpx 12rpx;
  border: 1rpx solid #e3ebe4;
  border-radius: 22rpx;
  background: #fff;
}
.addr-main {
  padding-bottom: 20rpx;
}
.addr-top {
  display: flex;
  align-items: baseline;
}
.addr-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #072f27;
}
.addr-tel {
  margin-left: 20rpx;
  color: #345747;
  font-size: 26rpx;
  font-weight: 700;
}
.addr-default-tag {
  margin-left: auto;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #d9ff3f;
  color: #092f27;
  font-size: 20rpx;
  font-weight: 750;
}
.addr-detail {
  display: block;
  margin-top: 12rpx;
  color: #4c6355;
  font-size: 25rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.addr-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-top: 1rpx solid #f0f4ef;
}
.addr-default {
  display: flex;
  align-items: center;
  min-height: 72rpx;
}
.addr-radio {
  transform: scale(.78);
}
.addr-default-text {
  color: #4c6355;
  font-size: 24rpx;
}
.addr-ops {
  display: flex;
}
.addr-op {
  min-width: 120rpx;
  height: 64rpx;
  margin: 0 0 0 16rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dfe8df;
  border-radius: 32rpx;
  background: #fff;
  color: #0b503b;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 62rpx;
}
.addr-op::after {
  border: 0;
}
.addr-op.is-danger {
  border-color: #ecdfc9;
  color: #815b32;
}

/* 底部操作条 */
.addr-bar {
  position: fixed;
  z-index: 5;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 15rpx 40rpx calc(19rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #dfe8df;
  background: #fbfcf9;
}
.addr-bar-nav {
  display: block;
}
.addr-bar-button {
  display: flex;
  width: 100%;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  border-radius: 48rpx;
  background: #d9ff3f;
  color: #092f27;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.2;
}
.addr-bar-button::after {
  border: 0;
}
