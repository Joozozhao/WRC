<site-header show-back="{{true}}" back-url="/pages/activity/activity"></site-header>
<!-- WRC Member List: 活动成员 -->
<view class="member-page">
  <view class="member-header">
    <text class="eyebrow">WRC · SQUAD MEMBERS</text>
    <text class="page-title">活动报名成员</text>
    <text class="page-subtitle">共 {{totalCount}} 位跑友参与本期活动 · 一起跑更精彩</text>
  </view>

  <view class="member-list" wx:if="{{memberList.length > 0}}">
    <block wx:for="{{memberList}}" wx:key="id">
      <view class="member-card" data-userid="{{item.id}}" bindtap="myData" hover-class="card-hover">
        <view class="rank-index {{item.rankNum <= 3 ? 'top' : ''}}">
          <text wx:if="{{item.rankNum < 10}}">0{{item.rankNum}}</text>
          <text wx:else>{{item.rankNum}}</text>
        </view>

        <image class="member-avatar" src="{{item.header_url || '/images/default.png'}}" mode="aspectFill"></image>

        <view class="member-info">
          <view class="name-row">
            <text class="member-name">{{item.user_name || item.nick_name || '跑友'}}</text>
            <image wx:if="{{item.level === 'VIP'}}" src="/images/superVIP.svg" mode="aspectFit" class="vip-icon"></image>
            <image wx:elif="{{item.level === '普通'}}" src="/images/normalVIP.svg" mode="aspectFit" class="vip-icon"></image>
            <image wx:if="{{item.sex == 1}}" src="/images/man.svg" mode="aspectFit" class="sex-icon"></image>
            <image wx:elif="{{item.sex == 2}}" src="/images/woman.svg" mode="aspectFit" class="sex-icon"></image>
          </view>
          <view class="meta-row">
            <text class="member-id">ID {{item.id}}</text>
            <text class="member-tag" wx:if="{{item.address}}">{{item.address}}</text>
          </view>
        </view>

        <view class="member-action">
          <text class="action-text">TA的主页</text>
          <text class="action-arrow">→</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view class="empty-block" wx:elif="{{loaded && memberList.length === 0}}">
    <view class="empty-mark">🏃</view>
    <text class="empty-title">暂无报名成员</text>
    <text class="empty-desc">跑友报名后将展示在此处</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-block" wx:elif="{{loading && !loaded}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载活动成员…</text>
  </view>
</view>
