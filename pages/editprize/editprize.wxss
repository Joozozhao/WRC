/* pages/editprize/editprize.wxss 自包含：不再 @import creatchallenge.wxss 等旧样式 */
page { background: #fbfcf9; color: #072f27; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.fp-page { min-height: 100vh; padding-top: 180rpx;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.fp-hero { padding: 42rpx 44rpx 32rpx; border-bottom: 1rpx solid #e1e9e3; }
.fp-eyebrow { display: block; color: #0d6447; font-size: 22rpx; font-weight: 750; letter-spacing: 3rpx; }
.fp-title { display: block; margin-top: 27rpx; font-size: 72rpx; line-height: 1.15; font-weight: 800; letter-spacing: -2rpx; }
.fp-title-line { width: 185rpx; height: 7rpx; margin-top: 4rpx; border-radius: 10rpx; background: #d9ff3f; transform: rotate(-2deg); }
.fp-intro { display: block; margin-top: 22rpx; color: #7a8980; font-size: 26rpx; line-height: 1.6; }
.fp-card { margin: 26rpx 40rpx 0; padding: 12rpx 28rpx 30rpx; border: 1rpx solid #e3ebe4; border-radius: 22rpx; background: #fff; box-sizing: border-box; }
.fp-field { padding-top: 24rpx; }
.fp-label { display: block; margin-bottom: 14rpx; color: #345747; font-size: 25rpx; font-weight: 750; }
.fp-ipt { height: 88rpx; padding: 0 24rpx; border: 1rpx solid #dfe8df; border-radius: 14rpx; background: #fbfcf9; color: #072f27; font-size: 28rpx; box-sizing: border-box; }
.fp-ph { color: #9aa8a0; font-size: 27rpx; }
.fp-consume { display: flex; align-items: center; }
.fp-radios { display: flex; align-items: center; }
.fp-radio { display: flex; align-items: center; margin-right: 30rpx; color: #153d31; font-size: 27rpx; }
.fp-radio radio { transform: scale(.85); }
.fp-score { flex: 1; min-width: 140rpx; }
.fp-imgs { display: flex; flex-wrap: wrap; }
.fp-imgbox { overflow: hidden; width: 180rpx; height: 180rpx; margin: 0 18rpx 18rpx 0; border: 1rpx solid #dfe8df; border-radius: 14rpx; background: #f2f6f0; box-sizing: border-box; }
.fp-imgbox image { width: 100%; height: 100%; }
.fp-imgbox-add { display: flex; align-items: center; justify-content: center; border: 2rpx dashed #cfe0c9; }
.fp-add { color: #0d6447; font-size: 60rpx; font-weight: 300; line-height: 1; }
.fp-tips { color: #8d9991; font-size: 22rpx; line-height: 1.5; }
.fp-textarea { width: 100%; min-height: 160rpx; padding: 20rpx 24rpx; border: 1rpx solid #dfe8df; border-radius: 14rpx; background: #fbfcf9; color: #072f27; font-size: 28rpx; line-height: 1.6; box-sizing: border-box; }
.fp-footer { position: fixed; z-index: 5; right: 0; bottom: 0; left: 0; padding: 15rpx 40rpx calc(19rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #dfe8df; background: #fbfcf9; }
.fp-submit { display: flex; width: 100%; height: 92rpx; align-items: center; justify-content: center; box-sizing: border-box; margin: 0; border-radius: 48rpx; background: #d9ff3f; color: #092f27; font-size: 29rpx; font-weight: 800; line-height: 1.2; }
.fp-submit::after { border: 0; }
