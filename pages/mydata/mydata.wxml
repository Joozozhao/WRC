<wxs src="../../utils/toDecimal2.wxs" module="number" />
<site-header avatar="{{headerImg}}" bindprofiletap="openProfile"></site-header>
<view class="profile-page {{pageMotion ? 'page-enter-motion' : ''}}">
  <view class="profile-hero">
    <text class="profile-eyebrow">WRC · MY RUNNING</text>
    <text class="profile-title">跑步，<text class="profile-title-break">就服自己！</text></text>
    <view class="profile-title-line"></view>
    <text class="profile-intro">每一步都算数。把每一次坚持，跑成自己的故事。</text>
  </view>
  <view class="profile-shell">
      <view class="profile-person">
        <view class="profile-avatar-wrap" bindtap="openProfile" hover-class="profile-touch" role="button" aria-label="{{userId > 0 ? '查看个人资料' : '登录'}}">
          <image class="profile-avatar" src="{{headerImg || '/images/default.png'}}" mode="aspectFill"></image>
        </view>
        <view class="profile-person-main" bindtap="openProfile" hover-class="profile-touch">
          <view class="profile-name-row">
            <text class="profile-name">{{userId > 0 ? (userName || nickName || '跑者') : '你好，跑者'}}</text>
            <text class="profile-duty-tag" wx:if="{{userId > 0 && (duty == '团长' || duty == '管理员/团长' || duty == '管理员')}}">{{duty == '管理员' ? '管理员' : '团长'}}</text>
          </view>
          <view class="profile-badge-row" wx:if="{{userId > 0}}">
            <text class="profile-badge" wx:if="{{levelLabel}}">{{levelLabel}}</text>
            <text class="profile-badge profile-gender-badge" wx:if="{{sex == 1 || sex == 2}}">{{sex == 1 ? '男' : '女'}}</text>
            <view class="profile-badge profile-region-badge" wx:if="{{regionLabel}}"><image class="profile-region-icon" src="/images/place.png" mode="aspectFit"></image><text>{{regionLabel}}</text></view>
            <text class="profile-badge profile-id-badge">id {{userId}}</text>
          </view>
          <text class="profile-sub" wx:else>登录后，记录你的每一步</text>
        </view>
        <view class="profile-asset-buttons" wx:if="{{userId > 0}}">
          <view class="profile-asset-btn" bindtap="checkPoint" hover-class="profile-asset-btn-hover" role="button" aria-label="查看积分">
            <image class="profile-asset-btn-icon" src="/images/score.svg" mode="aspectFit"></image>
            <text class="profile-asset-btn-num">{{statsLoaded ? score : '0'}}</text>
            <text class="profile-asset-btn-label">积分</text>
            <text class="profile-asset-btn-arrow">→</text>
          </view>
          <view class="profile-asset-btn" bindtap="checkEnergy" hover-class="profile-asset-btn-hover" role="button" aria-label="查看小花儿">
            <image class="profile-asset-btn-icon" src="/images/flower.svg" mode="aspectFit"></image>
            <text class="profile-asset-btn-num">{{statsLoaded ? number.slice(energy) : '0'}}</text>
            <text class="profile-asset-btn-label">小花</text>
            <text class="profile-asset-btn-arrow">→</text>
          </view>
        </view>
      </view>
    </view>

    <view class="profile-content">
      <view class="profile-summary">
        <view class="profile-summary-head">
          <text>本月跑量</text>
          <text class="profile-summary-period">MONTHLY DISTANCE</text>
        </view>
        <view class="profile-summary-main">
          <text class="profile-summary-number">{{userId > 0 && statsLoaded ? number.toDecimal2(monthDistance) : '—'}}</text>
          <text class="profile-summary-unit">公里</text>
        </view>
        <view class="profile-summary-accent"></view>
        <view class="profile-summary-stats">
          <view class="profile-summary-stat">
            <text class="profile-stat-value">{{userId > 0 && weekLoaded ? weekDistance : '—'}}</text>
            <text class="profile-stat-label">本周跑量 / 公里</text>
          </view>
          <view class="profile-summary-stat">
            <text class="profile-stat-value">{{userId > 0 && yearLoaded ? yearDistance : '—'}}</text>
            <text class="profile-stat-label">本年跑量 / 公里</text>
          </view>
          <view class="profile-summary-stat">
            <text class="profile-stat-value profile-stat-total">{{userId > 0 && statsLoaded ? number.slice(totalDistance) : '—'}}</text>
            <text class="profile-stat-label">累计跑量 / 公里</text>
          </view>
        </view>
      </view>

      <view class="profile-heatmap-section">
        <view class="profile-heatmap-heading">
          <text class="profile-heatmap-title">最近 {{heatmapRangeValue}} 个月跑步打卡 <text class="profile-heatmap-days">{{heatmapDaysText}}</text> 天</text>
          <picker class="profile-heatmap-picker" mode="selector" range="{{heatmapRangeLabels}}" value="{{heatmapRangeIndex}}" bindchange="onHeatmapRangeChange">
            <view class="profile-heatmap-picker-inner" hover-class="profile-touch" aria-role="button" aria-label="选择统计月份范围">
              <text>{{heatmapRangeLabels[heatmapRangeIndex]}}</text>
              <view class="profile-heatmap-caret"></view>
            </view>
          </picker>
        </view>
        <block wx:if="{{heatmapStatus == 'ready'}}">
          <view class="profile-heatmap-body" role="img" aria-label="最近 {{heatmapRangeValue}} 个月跑步热力图，颜色越深表示当天跑量越多">
            <view class="profile-heatmap-weekdays">
              <view class="profile-heatmap-weekday-spacer" style="height: {{heatmapMonthAxisHeight}}rpx;"></view>
              <view class="profile-heatmap-weekday" wx:for="{{heatmapWeekdayRows}}" wx:key="index" style="height: {{heatmapCellSize}}rpx; margin-bottom: {{heatmapColumnGap}}rpx;">{{item}}</view>
            </view>
            <scroll-view class="profile-heatmap-scroll" scroll-x="true" scroll-left="{{heatmapScrollLeft}}" scroll-with-animation="true" show-scrollbar="{{false}}">
              <view class="profile-heatmap-canvas" style="width: {{heatmapCanvasWidth}}rpx;">
                <view class="profile-heatmap-months" style="height: {{heatmapMonthAxisHeight}}rpx; width: {{heatmapCanvasWidth}}rpx;">
                  <view class="profile-heatmap-month" wx:for="{{recentHeatmap.monthLabels}}" wx:key="key" style="left: {{item.index * heatmapColumnStride}}rpx;">{{item.label}}</view>
                </view>
                <view class="profile-heatmap-grid">
                  <view class="profile-heatmap-week" wx:for="{{recentHeatmap.weeks}}" wx:for-item="week" wx:key="key" style="width: {{heatmapCellSize}}rpx; margin-right: {{heatmapColumnGap}}rpx;">
                    <view class="profile-heatmap-day level-{{day.level}} {{day.isPadding ? 'is-padding' : ''}}" wx:for="{{week.days}}" wx:for-item="day" wx:key="key" style="width: {{heatmapCellSize}}rpx; height: {{heatmapCellSize}}rpx; margin-bottom: {{heatmapColumnGap}}rpx;"></view>
                  </view>
                </view>
              </view>
            </scroll-view>
          </view>
          <view class="profile-heatmap-footer">
            <text class="profile-heatmap-hint">颜色越深，当天跑量越多</text>
            <view class="profile-heatmap-legend" aria-label="颜色越深，跑量越多">
              <text>少</text>
              <view class="profile-heatmap-swatch level-0"></view>
              <view class="profile-heatmap-swatch level-1"></view>
              <view class="profile-heatmap-swatch level-2"></view>
              <view class="profile-heatmap-swatch level-3"></view>
              <view class="profile-heatmap-swatch level-4"></view>
              <text>多</text>
            </view>
          </view>
        </block>
        <view wx:elif="{{heatmapStatus == 'error'}}" class="profile-heatmap-state">
          <text>跑步记录暂时无法加载</text>
          <view class="profile-heatmap-retry" bindtap="retryHeatmap" hover-class="profile-touch" role="button" aria-label="重新加载跑步热力图">重新加载 →</view>
        </view>
        <view wx:else class="profile-heatmap-state">{{heatmapStatus == 'guest' ? '登录后，点亮你的跑步足迹' : '正在加载跑步足迹…'}}</view>
      </view>

      <view wx:if="{{userId <= 0}}" class="profile-guest">
        <view class="profile-login" bindtap="openLogin" hover-class="profile-touch" role="button" aria-label="登录并同步跑步数据">
          <text>登录并同步跑步数据</text><text>→</text>
        </view>
        <view class="profile-section-head profile-guest-head">
          <text class="profile-section-title">开始探索</text>
          <text class="profile-section-note">和跑友一起出发</text>
        </view>
        <view class="profile-guide-row" bindtap="goActivity" hover-class="profile-touch" role="button" aria-label="发现团跑">
          <text>发现团跑</text><text class="profile-guide-desc">看看附近的活动 →</text>
        </view>
        <view class="profile-guide-row" bindtap="goChallenge" hover-class="profile-touch" role="button" aria-label="看看挑战">
          <text>看看挑战</text><text class="profile-guide-desc">为自己定个目标 →</text>
        </view>
      </view>

      <block wx:if="{{userId > 0}}">
        <view class="profile-services">
          <view class="profile-section-head">
            <text class="profile-section-title">常用服务</text>
            <text class="profile-section-note">记录 · 兑换 · 管理</text>
          </view>
          <view class="profile-services-card">
            <view class="profile-service-row" bindtap="toRecord" hover-class="profile-touch" role="button" aria-label="查看打卡记录">
              <view class="profile-service-main">
                <text class="profile-service-name">打卡记录</text>
                <text class="profile-service-desc">日常跑步轨迹与凭证</text>
              </view>
              <text class="profile-service-arrow">→</text>
            </view>
            <view class="profile-service-row" bindtap="toHistory" hover-class="profile-touch" role="button" aria-label="查看我的兑换">
              <view class="profile-service-main">
                <text class="profile-service-name">我的兑换</text>
                <text class="profile-service-desc">历史兑换记录与物流</text>
              </view>
              <text class="profile-service-arrow">→</text>
            </view>
            <view class="profile-service-row" bindtap="toPrize" hover-class="profile-touch" role="button" aria-label="兑换好礼">
              <view class="profile-service-main">
                <text class="profile-service-name">兑换好礼</text>
                <text class="profile-service-desc">用积分与小花兑换跑团福利</text>
              </view>
              <text class="profile-service-arrow">→</text>
            </view>
            <view class="profile-service-row" wx:if="{{duty == '管理员' || duty == '管理员/团长'}}" bindtap="toManage" hover-class="profile-touch" role="button" aria-label="进入跑团管理">
              <view class="profile-service-main">
                <text class="profile-service-name">跑团管理</text>
                <text class="profile-service-desc">审核打卡与活动发布</text>
              </view>
              <text class="profile-service-arrow">→</text>
            </view>
          </view>
        </view>

        <view class="profile-races" wx:if="{{marathons.length}}">
          <view class="profile-section-head">
            <view class="profile-section-left">
              <text class="profile-section-title">马拉松成绩</text>
              <text class="profile-section-note">你的高光时刻</text>
            </view>
            <view class="profile-section-link" bindtap="navigateWithParams" hover-class="profile-touch" role="button" aria-label="查看全部马拉松成绩">查看全部成绩 →</view>
          </view>
          <view class="profile-races-card">
            <view class="profile-race" wx:for="{{marathons}}" wx:key="index" bindtap="navigateWithParams" hover-class="profile-touch" role="button" aria-label="查看马拉松成绩">
              <view class="profile-race-info">
                <view class="profile-race-meta">
                  <text class="profile-race-type">{{item.events_type}} · {{item.project_type}}</text>
                  <text class="profile-race-date">{{item.playing_time}}</text>
                </view>
                <text class="profile-race-name">{{item.marathon_name}}</text>
              </view>
              <view class="profile-race-score-wrap">
                <text class="profile-race-score">{{item.accurate_score}}</text>
                <text class="profile-race-score-label">净成绩</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view class="profile-section-head profile-activity-head" wx:if="{{userId > 0}}">
      <view class="profile-section-heading-copy">
        <text class="profile-section-title">参与记录</text>
        <text class="profile-section-note">每一次挑战与团聚</text>
      </view>
    </view>
    <all-activity wx:if="{{userId > 0}}"
      totalChallenge="{{totalChallenge}}" totalActy="{{totalActy}}"
      activityList="{{activityList}}" activityList2="{{activityList2}}"
      challengeStatus="{{challengeStatus}}" runStatus="{{runStatus}}"
      challengeHasMore="{{challengeHasMore}}" runHasMore="{{runHasMore}}"
      challengeCountKnown="{{challengeCountKnown}}" runCountKnown="{{runCountKnown}}"
      bind:parentEvent="loadMore" bind:parentEvent2="loadMore2" bind:parentEvent3="toDet"></all-activity>
    <view class="profile-bottom-space"></view>
</view>
<tabbar tabbar="{{tabbar}}"></tabbar>
