/* 我的：沿用 WRC 暖白、松绿与荧光黄绿的视觉语言 */
page {
  background: #fbfcf9;
  color: #072f27;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.profile-page { display: flex; flex-direction: column; height: 100vh; background: #fbfcf9; }
.profile-scroll { flex: 1; min-height: 0; }
/* 紧凑资料区，让本月跑量与跑步足迹热力图在首屏相邻呈现。 */
.profile-shell { padding: 32rpx 40rpx 0; }
.profile-hero { padding: 8rpx 0 22rpx; }
.profile-eyebrow {
  display: block;
  color: #0d6447;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}
.profile-title-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin-top: 10rpx; }
.profile-title { color: #072f27; font-size: 52rpx; font-weight: 800; line-height: 1.25; letter-spacing: -1rpx; }
.profile-intro { color: #667970; font-size: 23rpx; line-height: 1.6; }
.profile-person {
  display: flex;
  align-items: center;
  min-height: 124rpx;
  padding: 18rpx 0 24rpx;
  box-sizing: border-box;
}
.profile-avatar-wrap {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  flex: none;
}
.profile-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e5ece6;
  display: block;
}
.profile-vip-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 32rpx;
  height: 32rpx;
}
.profile-person-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding-left: 22rpx;
}
.profile-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.profile-name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #072f27;
  font-size: 32rpx;
  font-weight: 800;
}
.profile-duty-tag {
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  background: #d9ff3f;
  color: #062b23;
  font-size: 20rpx;
  font-weight: 750;
  line-height: 1.3;
}
.profile-sub {
  margin-top: 7rpx;
  color: #667970;
  font-size: 23rpx;
}
.profile-asset-buttons {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: none;
  margin-left: 16rpx;
}
.profile-asset-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  height: 76rpx;
  padding: 0 16rpx;
  background: #ffffff;
  border: 1rpx solid #e1e9e3;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 8rpx rgba(7, 47, 39, 0.04);
  box-sizing: border-box;
  transition: background 0.15s ease, transform 0.1s ease;
}
.profile-asset-btn-hover {
  background: #f4f8f4;
  transform: scale(0.97);
}
.profile-asset-btn-num {
  font-size: 27rpx;
  font-weight: 800;
  color: #072f27;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.profile-asset-btn-label {
  font-size: 19rpx;
  font-weight: 500;
  color: #6d8276;
  line-height: 1.1;
  margin-top: 4rpx;
}

.profile-content { padding: 12rpx 40rpx 0; }
.profile-summary {
  overflow: hidden;
  position: relative;
  padding: 33rpx 34rpx 30rpx;
  border-radius: 28rpx;
  background: #072f27;
  color: #fff;
}
.profile-summary-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  color: #e7f0e8;
  font-size: 27rpx;
  font-weight: 700;
}
.profile-summary-period {
  color: #a3baa9;
  font-size: 17rpx;
  font-weight: 650;
  letter-spacing: 1.5rpx;
}
.profile-summary-main {
  display: flex;
  align-items: baseline;
  margin-top: 18rpx;
}
.profile-summary-number {
  color: #fff;
  font-size: 82rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
}
.profile-summary-unit {
  margin-left: 10rpx;
  color: #b7cebe;
  font-size: 26rpx;
  font-weight: 600;
}
.profile-summary-accent {
  width: 140rpx;
  height: 6rpx;
  margin-top: 22rpx;
  border-radius: 8rpx;
  background: #d9ff3f;
}
.profile-summary-stats {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
}
.profile-summary-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.profile-summary-stat:last-child { text-align: right; }
.profile-summary-stat:nth-child(2) { text-align: center; }
.profile-stat-value {
  color: #fff;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}
.profile-stat-value.profile-stat-total { color: #d9ff3f; }
.profile-stat-label {
  margin-top: 7rpx;
  color: #9cb5a3;
  font-size: 19rpx;
}

.profile-guest {
  margin-top: 36rpx;
}
.profile-login {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 98rpx;
  padding: 0 34rpx;
  border-radius: 26rpx;
  background: #d9ff3f;
  color: #072f27;
  font-size: 30rpx;
  font-weight: 800;
  box-sizing: border-box;
}
.profile-guest-head { margin-top: 44rpx; }
.profile-guide-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 108rpx;
  border-bottom: 1rpx solid #e1e9e3;
  color: #072f27;
  font-size: 30rpx;
  font-weight: 750;
}
.profile-guide-desc {
  color: #4e765f;
  font-size: 23rpx;
  font-weight: 600;
}

.profile-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 44rpx 4rpx 20rpx;
}
.profile-section-title {
  color: #072f27;
  font-size: 34rpx;
  font-weight: 800;
}
.profile-section-note {
  margin-left: 14rpx;
  color: #667970;
  font-size: 22rpx;
}

.profile-services-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.profile-service-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: calc((100% - 16rpx) / 2);
  min-height: 104rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e1e9e3;
  border-radius: 20rpx;
  background: #fff;
  box-sizing: border-box;
  color: #072f27;
  font-size: 27rpx;
  font-weight: 700;
}
.profile-service-arrow { color: #0b503b; font-size: 28rpx; }
.profile-touch { opacity: .72; }
.profile-section-heading-copy { display: flex; flex-direction: column; }
.profile-section-heading-copy .profile-section-note { margin: 5rpx 0 0; }

/* 跑步热力图：月份轴 + 固定星期轴 + 横向滚动的周列方格，格内不绘制日期与公里数。 */
.profile-heatmap-section {
  margin-top: 18rpx;
  padding: 26rpx;
  border: 1rpx solid #e1e9e3;
  border-radius: 24rpx;
  background: #fff;
  box-sizing: border-box;
  font-weight: 100;
}
.profile-heatmap-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
/* 标题可换行，天数用更大字号强调；右侧 picker 不被压缩。 */
.profile-heatmap-title {
  flex: 1 1 auto;
  min-width: 0;
  color: #072f27;
  font-size: 27rpx;
  font-weight: 300;
  line-height: 1.4;
}
.profile-heatmap-days {
  color: #0b503b;
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}
.profile-heatmap-picker { flex: none; }
/* 48rpx 透明触控区向上留白；底部补偿标题与范围字号的行框差。 */
.profile-heatmap-picker-inner {
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  min-height: 48rpx;
  padding: 0 0 3rpx 12rpx;
  background: transparent;
  color: #1d5b45;
  font-size: 24rpx;
  font-weight: 100;
  line-height: 1.4;
  box-sizing: border-box;
}
.profile-heatmap-caret {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  margin-bottom: 13rpx;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 7rpx solid #4d7a63;
}
.profile-heatmap-body { display: flex; align-items: flex-start; }
.profile-heatmap-weekdays { flex: none; width: 56rpx; margin-right: 8rpx; display: flex; flex-direction: column; }
.profile-heatmap-weekday {
  display: flex;
  align-items: center;
  color: #6f8478;
  font-size: 17rpx;
  font-weight: 100;
  line-height: 1;
}
.profile-heatmap-weekday:last-child { margin-bottom: 0 !important; }
.profile-heatmap-scroll { flex: 1; min-width: 0; }
.profile-heatmap-canvas { display: block; }
/* 月份轴：按列绝对定位（left = index * stride），首月被后月替换时也不会错位。 */
.profile-heatmap-months { position: relative; }
.profile-heatmap-month {
  position: absolute;
  bottom: 0;
  box-sizing: border-box;
  color: #7c8f84;
  font-size: 18rpx;
  line-height: 1;
  white-space: nowrap;
  overflow: visible;
}
.profile-heatmap-grid { display: flex; align-items: flex-start; }
.profile-heatmap-week { flex: none; display: flex; flex-direction: column; }
.profile-heatmap-week:last-child { margin-right: 0 !important; }
.profile-heatmap-day { border-radius: 4rpx; box-sizing: border-box; }
.profile-heatmap-day:last-child { margin-bottom: 0 !important; }
.profile-heatmap-day.is-padding { visibility: hidden; }
.level-0 { background: #edf2ec; }
.level-1 { background: #cfe7b4; }
.level-2 { background: #94c86c; }
.level-3 { background: #4f9455; }
.level-4 { background: #125c3f; }
.profile-heatmap-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eef3ee;
}
.profile-heatmap-hint { color: #8a9b90; font-size: 19rpx; }
.profile-heatmap-legend { display: flex; align-items: center; gap: 6rpx; color: #667970; font-size: 19rpx; }
.profile-heatmap-swatch { width: 18rpx; height: 18rpx; border-radius: 4rpx; }
.profile-heatmap-state { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 240rpx; color: #667970; font-size: 24rpx; line-height: 1.6; text-align: center; }
.profile-heatmap-retry { display: flex; align-items: center; justify-content: center; min-height: 88rpx; margin-top: 10rpx; padding: 0 24rpx; color: #0b503b; font-size: 25rpx; font-weight: 100; }

.profile-race {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 142rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e1e9e3;
  box-sizing: border-box;
}
.profile-race-info { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.profile-race-type { color: #3b7855; font-size: 20rpx; font-weight: 700; }
.profile-race-name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-top: 7rpx;
  color: #113d30;
  font-size: 27rpx;
  font-weight: 700;
}
.profile-race-date { margin-top: 6rpx; color: #718175; font-size: 21rpx; }
.profile-race-score {
  flex: none;
  margin-left: 16rpx;
  color: #0b503b;
  font-size: 28rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.profile-race-more {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: #135f42;
  font-size: 23rpx;
  font-weight: 700;
}

.profile-activity-head {
  padding: 42rpx 40rpx 4rpx;
  box-sizing: border-box;
}

.profile-bottom-space { height: 230rpx; }
