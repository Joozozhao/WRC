/* pages/orderlist/orderlist.wxss —— 暖白 / 深松绿 / 荧光黄绿（对齐 docs/design/redesign-baseline.md 与 prizedetails） */
page {
  background: #fbfcf9;
  color: #072f27;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}
.orders-page {
  min-height: 100vh;
  padding-top: 180rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.orders-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx 10rpx;
}
.orders-kicker {
  display: block;
  color: #0d6447;
  font-size: 21rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}
.orders-head-label {
  color: #819187;
  font-size: 21rpx;
}

/* 加载骨架 */
.orders-loading {
  padding: 20rpx 40rpx;
}
.orders-skeleton-card {
  display: flex;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e3ebe4;
  border-radius: 22rpx;
  background: #fff;
}
.orders-skeleton-media {
  flex: none;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #eaf0e9;
}
.orders-skeleton-lines {
  flex: 1;
  margin-left: 24rpx;
}
.orders-skeleton-line {
  width: 55%;
  height: 28rpx;
  margin: 16rpx 0;
  border-radius: 8rpx;
  background: #eaf0e9;
}
.orders-skeleton-line-long {
  width: 82%;
}
.orders-state-tip {
  display: block;
  margin-top: 30rpx;
  color: #73867b;
  font-size: 24rpx;
  text-align: center;
}

/* 错误态 */
.orders-error {
  padding: 120rpx 40rpx 60rpx;
}
.orders-error-title {
  display: block;
  margin-top: 32rpx;
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 800;
}
.orders-error-copy {
  display: block;
  margin-top: 18rpx;
  color: #697d70;
  font-size: 26rpx;
  line-height: 1.6;
}
.orders-retry-button {
  width: 240rpx;
  height: 84rpx;
  margin: 40rpx 0 0;
  border-radius: 44rpx;
  background: #d9ff3f;
  color: #092f27;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 84rpx;
}
.orders-retry-button::after {
  border: 0;
}

/* 空态 */
.orders-empty {
  padding: 140rpx 40rpx;
  text-align: center;
}
.orders-empty-title {
  display: block;
  color: #304d3d;
  font-size: 34rpx;
  font-weight: 800;
}
.orders-empty-copy {
  display: block;
  margin-top: 14rpx;
  color: #84918a;
  font-size: 24rpx;
}

/* 订单卡片 */
.order-card {
  margin: 20rpx 40rpx 8rpx;
  padding: 28rpx;
  border: 1rpx solid #e3ebe4;
  border-radius: 22rpx;
  background: #fff;
}
.order-card-main {
  display: flex;
}
.order-cover {
  flex: none;
  width: 160rpx;
  height: 160rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #edf2eb;
}
.order-cover image {
  width: 100%;
  height: 100%;
}
.order-main-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.order-user {
  display: flex;
  align-items: center;
}
.order-avatar {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #e1ebe0;
}
.order-user-name {
  font-size: 26rpx;
  font-weight: 750;
  color: #0c3a2c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-cost {
  margin-top: 14rpx;
  color: #304d3d;
  font-size: 24rpx;
}
.order-cost-value {
  color: #0b503b;
  font-weight: 700;
}
.order-spec {
  display: block;
  margin-top: 8rpx;
  color: #6c8072;
  font-size: 23rpx;
  overflow-wrap: anywhere;
}
.order-meta {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0f4ef;
}
.order-meta-line {
  display: block;
  color: #697d70;
  font-size: 23rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
}
.order-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f4ef;
}
.order-state {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 750;
}
.order-state.is-pending {
  background: #d9ff3f;
  color: #092f27;
}
.order-state.is-shipped {
  background: #edf5dd;
  color: #0b503b;
}
.order-state.is-done {
  background: #f0f4ef;
  color: #64756b;
}
.order-state.is-returned {
  background: #f7ede1;
  color: #815b32;
}
.order-actions {
  display: flex;
}
.order-action-btn {
  min-width: 132rpx;
  height: 64rpx;
  margin: 0 0 0 16rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dfe8df;
  border-radius: 32rpx;
  background: #fff;
  color: #0b503b;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 62rpx;
}
.order-action-btn::after {
  border: 0;
}
.order-action-btn.is-danger {
  border-color: #ecdfc9;
  color: #815b32;
}

/* 状态设置弹层 */
.state-modal-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(7, 47, 39, .45);
}
.state-modal-dialog {
  position: fixed;
  z-index: 21;
  top: 50%;
  left: 50%;
  width: 620rpx;
  max-width: 86vw;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 24rpx;
  background: #fbfcf9;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}
.state-modal-title {
  display: block;
  color: #072f27;
  font-size: 32rpx;
  font-weight: 800;
}
.state-modal-order {
  display: block;
  margin-top: 8rpx;
  color: #84918a;
  font-size: 22rpx;
  overflow-wrap: anywhere;
}
.state-options {
  display: block;
  margin-top: 26rpx;
}
.state-option {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  margin-bottom: 14rpx;
  padding: 0 24rpx;
  border: 2rpx solid #dfe8df;
  border-radius: 16rpx;
  background: #fff;
  color: #0c3a2c;
  font-size: 26rpx;
  box-sizing: border-box;
}
.state-option.is-checked {
  border-color: #0b503b;
  background: #edf5dd;
  font-weight: 750;
}
.state-radio {
  margin-right: 16rpx;
  transform: scale(.8);
}
.orders-pagination {
  padding: 24rpx 0 54rpx;
  color: #89978d;
  font-size: 23rpx;
  text-align: center;
}

.state-modal-footer {
  display: flex;
  margin-top: 30rpx;
}
.state-btn {
  flex: 1;
  height: 88rpx;
  margin: 0;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
}
.state-btn + .state-btn {
  margin-left: 20rpx;
}
.state-btn::after {
  border: 0;
}
.state-btn-cancel {
  background: #f0f4ee;
  color: #68796e;
}
.state-btn-confirm {
  background: #d9ff3f;
  color: #062b23;
}
