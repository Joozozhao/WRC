<site-header show-back="{{true}}" back-url="/pages/manage/manage"></site-header>
<!--pages/userlist/userlist.wxml-->
<view class="ul-page">
  <view class="ul-header">
    <text class="eyebrow">WRC · MEMBERS</text>
    <text class="page-title">成员管理</text>
    <view class="title-line"></view>
    <text class="page-subtitle">共 {{userList.length}} 位团员 · 点击头像查看联系方式与装备数据</text>
  </view>

  <!-- 筛选栏（吸顶） -->
  <view class="filter-zone">
    <view class="filter-bar">
      <view class="filter-trigger {{selAll ? 'is-open' : ''}}" bindtap="clickLevel" hover-class="filter-hover">
        <text class="filter-label">类型</text>
        <image class="filter-arrow" src="{{iconState ? '/images/arrow-r.svg' : '/images/arrow-d.svg'}}" mode="aspectFit"></image>
      </view>
      <view class="filter-trigger {{sortAll ? 'is-open' : ''}}" bindtap="clickSort" hover-class="filter-hover">
        <text class="filter-label">默认排序</text>
        <image class="filter-arrow" src="{{iconState2 ? '/images/arrow-r.svg' : '/images/arrow-d.svg'}}" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 类型筛选面板 -->
    <view class="filter-pop {{selAll ? 'show' : 'hide'}}">
      <view class="filter-panel">
        <text class="filter-option {{id == index ? 'active' : ''}}" wx:for="{{selList}}" wx:key="index" data-id="{{index}}" data-level="{{item.value}}" catchtap="choose">{{item.text}}</text>
      </view>
    </view>

    <!-- 排序筛选面板 -->
    <view class="filter-pop {{sortAll ? 'show' : 'hide'}}">
      <view class="filter-panel">
        <text class="filter-option {{id == index ? 'active' : ''}}" wx:for="{{sortList}}" wx:key="index" data-id="{{index}}" data-txt="{{item.text}}" catchtap="choose2">{{item.text}}</text>
      </view>
    </view>
  </view>

  <!-- 筛选遮罩 -->
  <view class="filter-mask {{selAll || sortAll ? 'show' : 'hide'}}" bindtap="close"></view>

  <!-- 成员列表 -->
  <view class="member-list" wx:if="{{userList.length > 0}}">
    <view class="member-block" wx:for="{{userList}}" wx:key="id">
      <view class="member-card">
        <view class="member-index">{{index + 1}}</view>

        <view class="member-avatar-wrap" data-id="{{item.id}}" bindtap="details" hover-class="avatar-hover">
          <view class="user-pic {{item.level == 'VIP' ? 'vip' : (item.level == '普通' ? 'normal' : 'guest')}}">
            <image src="{{item.header_url}}" mode="aspectFill" class="pic"></image>
          </view>
        </view>

        <view class="member-info">
          <view class="name-row">
            <text class="member-name" wx:if="{{item.name !== ''}}">{{item.name}}</text>
            <text class="member-name" wx:else>{{item.nick_name}}</text>
            <text class="member-level-label" wx:if="{{item.levelLabel}}">{{item.levelLabel}}</text>
            <text class="profile-badge profile-gender-badge" wx:if="{{item.genderLabel}}">{{item.genderLabel}}</text>
            <view class="profile-badge profile-region-badge" wx:if="{{item.regionLabel}}"><image class="profile-region-icon" src="/images/place.png" mode="aspectFit"></image><text>{{item.regionLabel}}</text></view>
            <text class="duty-tag" wx:if="{{item.duty == '团长'}}">团长</text>
            <text class="duty-tag" wx:if="{{item.duty == '管理员'}}">管理员</text>
            <text class="duty-tag" wx:if="{{item.duty == '管理员,团长' || item.duty == '团长,管理员'}}">管理员/团长</text>
          </view>
          <view class="member-id">ID {{item.id}}</view>
          <view class="member-stats">{{item.score}} 积分 · {{item.energy}} 小花儿 · 连续打卡 {{item.serial_day}} 天</view>
        </view>

        <view class="member-ops">
          <text class="op-set" data-userid="{{item.id}}" data-duty="{{item.duty}}" data-level="{{item.level}}" data-name="{{item.name || item.nick_name || '成员'}}" data-avatar="{{item.header_url}}" bindtap="setInfor" hover-class="op-hover">设置</text>
        </view>
      </view>

      <!-- 展开的成员详情 -->
      <view class="member-detail {{item.id == userid ? '' : 'hidden'}}">
        <view class="detail-grid">
          <view class="detail-item">
            <text class="detail-label">手机号</text>
            <text class="detail-value">{{item.mobile || '未填写'}}</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">生日</text>
            <text class="detail-value">{{item.birthday || '未填写'}}</text>
          </view>
        </view>
        <view class="detail-subtitle">装备数据</view>
        <view class="detail-grid">
          <view class="detail-item">
            <text class="detail-label">上衣</text>
            <text class="detail-value">{{item.jacket || '—'}}</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">裤子</text>
            <text class="detail-value">{{item.trousers || '—'}}</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">头围</text>
            <text class="detail-value">{{item.head_size || '—'}}</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">手长</text>
            <text class="detail-value">{{item.hand_size || '—'}}</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">鞋号</text>
            <text class="detail-value">{{item.shoe_size || '—'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-block" wx:elif="{{loaded && userList.length === 0}}">
    <view class="empty-mark">👥</view>
    <text class="empty-title">暂无成员</text>
    <text class="empty-desc">当前筛选条件下没有团员</text>
  </view>

  <!-- 遮罩层 -->
  <view class="ul-mask" wx:if="{{changeModal}}" bindtap="onCancel"></view>

  <!-- 成员设置弹窗 -->
  <view class="ul-modal" wx:if="{{changeModal}}">
    <form bindsubmit="onConfirm">
      <view class="modal-header">
        <view class="modal-user-brief">
          <image class="modal-user-avatar" src="{{targetUserAvatar || '/images/default.png'}}" mode="aspectFill"></image>
          <view class="modal-user-meta">
            <text class="modal-title">成员设置</text>
            <text class="modal-subtitle">{{targetUserName}} · ID {{userId}}</text>
          </view>
        </view>
      </view>

      <view class="modal-section">
        <view class="modal-label">职务权限（可多选）</view>
        <view class="modal-chips">
          <view class="modal-chip {{isAdmin ? 'is-active' : ''}}" data-type="admin" bindtap="toggleDuty">
            <text class="modal-chip-icon">{{isAdmin ? '✓' : '+'}}</text>
            <text class="modal-chip-text">管理员</text>
          </view>
          <view class="modal-chip {{isLeader ? 'is-active' : ''}}" data-type="leader" bindtap="toggleDuty">
            <text class="modal-chip-icon">{{isLeader ? '✓' : '+'}}</text>
            <text class="modal-chip-text">团长</text>
          </view>
        </view>
      </view>

      <view class="modal-section">
        <view class="modal-label">会员级别（单选）</view>
        <view class="modal-chips">
          <view class="modal-chip {{level === 'VIP' ? 'is-active' : ''}}" data-level="VIP" bindtap="selectLevel">
            <text class="modal-chip-text">SVip</text>
          </view>
          <view class="modal-chip {{level === '普通' ? 'is-active' : ''}}" data-level="普通" bindtap="selectLevel">
            <text class="modal-chip-text">Vip</text>
          </view>
          <view class="modal-chip {{level === '非会员' ? 'is-active' : ''}}" data-level="非会员" bindtap="selectLevel">
            <text class="modal-chip-text">PVip</text>
          </view>
        </view>
      </view>

      <view class="modal-footer">
        <button class="modal-btn cancel" bindtap="onCancel" data-status="cancel" hover-class="cancel-hover">取消</button>
        <button class="modal-btn confirm" form-type="submit" data-status="confirm" hover-class="confirm-hover">确定</button>
      </view>
    </form>
  </view>
</view>
