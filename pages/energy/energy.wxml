<site-header show-back="{{true}}" back-url="/pages/mydata/mydata"></site-header>
<!--pages/energy/energy.wxml-->
<view class="asset-page">
  <!-- Hero Section -->
  <view class="asset-hero">
    <text class="asset-eyebrow">WRC · FLOWERS</text>
    <text class="asset-title">我的小花儿</text>
    <view class="asset-title-line"></view>
    <text class="asset-intro">团跑收获的小花儿，积攒起来兑换跑团心意好礼</text>
  </view>

  <!-- 余额总览 -->
  <view class="balance-card">
    <view class="balance-stat">
      <text class="balance-label">小花儿余额</text>
      <view class="balance-value-row">
        <text class="balance-value">{{balanceState === 'ready' ? energy : '—'}}</text>
        <text class="balance-unit" wx:if="{{balanceState === 'ready'}}">朵</text>
        <image class="balance-flower" wx:if="{{balanceState === 'ready'}}" src="../../images/f.svg" mode="aspectFit"></image>
      </view>
    </view>
    <view class="balance-stat">
      <text class="balance-label">参与团跑</text>
      <view class="balance-value-row">
        <text class="balance-value">{{balanceState === 'ready' ? actyTimes : '—'}}</text>
        <text class="balance-unit" wx:if="{{balanceState === 'ready'}}">次</text>
      </view>
    </view>
    <text class="balance-hint" wx:if="{{balanceState === 'error'}}" bindtap="retryBalance">余额加载失败，点击重试</text>
  </view>

  <!-- 增加 / 扣除 切换 -->
  <view class="asset-tabs">
    <view class="asset-tab {{currentTab === index ? 'is-active' : ''}}" wx:for="{{navTab}}" wx:key="index" data-idx="{{index}}" bindtap="currentTab">
      <text class="tab-text">{{item}}</text>
      <view class="tab-mark" wx:if="{{currentTab === index}}"></view>
    </view>
  </view>

  <!-- Content Section -->
  <view class="asset-section">
    <!-- 1. Guest State -->
    <view class="state-card" wx:if="{{listState === 'guest'}}">
      <view class="state-icon-circle">
        <text class="state-icon">👤</text>
      </view>
      <text class="state-title">登录后查看小花儿流水</text>
      <text class="state-copy">登录后可查看小花儿余额，以及每一笔增加、扣除记录</text>
      <button class="state-action-btn" bindtap="goLogin">前往登录 →</button>
    </view>

    <!-- 2. Loading State -->
    <view class="state-card" wx:elif="{{listState === 'loading'}}">
      <view class="loading-spinner"></view>
      <text class="state-copy">正在加载小花儿流水…</text>
    </view>

    <!-- 3. Error State -->
    <view class="state-card" wx:elif="{{listState === 'error'}}">
      <view class="state-icon-circle is-error">
        <text class="state-icon">⚠️</text>
      </view>
      <text class="state-title">小花儿流水加载失败</text>
      <text class="state-copy">网络连接稍有迟疑，请点击下方重试</text>
      <view class="retry-btn" bindtap="retry">点击重试</view>
    </view>

    <!-- 4. Ready State -->
    <block wx:elif="{{listState === 'ready'}}">
      <!-- Empty State：按当前分类提示 -->
      <view class="state-card" wx:if="{{currentTab === 0 && addCon.length === 0}}">
        <view class="state-icon-circle">
          <text class="state-icon">🌸</text>
        </view>
        <text class="state-title">暂无小花儿增加记录</text>
        <text class="state-copy">参加团跑活动即可获得小花儿，快去跑一场吧</text>
      </view>
      <view class="state-card" wx:elif="{{currentTab === 1 && reduceCon.length === 0}}">
        <view class="state-icon-circle">
          <text class="state-icon">🎁</text>
        </view>
        <text class="state-title">暂无小花儿扣除记录</text>
        <text class="state-copy">您还未使用小花儿兑换过奖品，去兑换页看看吧</text>
      </view>

      <!-- Flow List -->
      <view class="flow-list" wx:else>
        <view class="flow-row" wx:for="{{currentTab === 0 ? addCon : reduceCon}}" wx:key="index">
          <view class="flow-detail">
            <text class="flow-remark">{{item.remark}}</text>
            <text class="flow-time">{{item.create_time}}</text>
          </view>
          <text class="flow-score {{currentTab === 0 ? 'is-add' : 'is-reduce'}}">{{currentTab === 0 ? '+' : ''}}{{item.score}}</text>
        </view>
      </view>

      <!-- Load More / Footer Info -->
      <view class="list-pagination" wx:if="{{addCon.length > 0 || reduceCon.length > 0}}">
        <view class="pagination-loading" wx:if="{{loadingMore}}">
          <text>正在加载更多记录…</text>
        </view>
        <view class="pagination-retry" wx:elif="{{moreError}}" bindtap="retryMore">
          <text>加载失败，点击重试</text>
        </view>
        <view class="pagination-end" wx:elif="{{!hasMore}}">
          <text>— 已显示全部小花儿记录 —</text>
        </view>
      </view>
    </block>
  </view>
</view>
