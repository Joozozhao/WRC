<site-header show-back="{{true}}" back-url="/pages/manage/manage"></site-header>
<!--pages/lotterylist/lotterylist.wxml-->
<view class="draw-page">
  <view class="draw-hero">
    <text class="draw-eyebrow">WRC · LUCKY DRAW</text>
    <text class="draw-title">抽奖管理</text>
    <view class="draw-title-line"></view>
    <text class="draw-intro">发起的抽奖与开奖状态都在这里</text>
  </view>

  <view class="draw-list" wx:if="{{orderList.length}}">
    <view class="draw-card" wx:for="{{orderList}}" wx:key="index" wx:for-item="item">
      <view class="draw-main" data-id="{{item.id}}" bindtap="toLty">
        <view class="draw-cover">
          <image src="{{item.goods_pic}}" mode="aspectFill"></image>
        </view>
        <view class="draw-info">
          <view class="draw-name">{{item.goods_name}}<text class="draw-num"> × {{item.goods_num}}</text></view>
          <view class="draw-line">关联活动：{{item.acty_name}}</view>
          <view class="draw-line">开奖时间：{{item.start_time}}</view>
          <view class="draw-state is-pending" wx:if="{{item.state==0}}">待开奖</view>
          <view class="draw-state" wx:if="{{item.state==1}}">已结束</view>
        </view>
      </view>
      <view class="draw-ops">
        <text class="draw-op is-danger" data-id="{{item.id}}" bindtap="delIt">删除</text>
      </view>
    </view>
  </view>
  <view class="draw-empty" wx:if="{{noHistory}}">暂无抽奖活动</view>
</view>
<view class="draw-footer">
  <button class="draw-submit" bindtap="toLott">发起抽奖</button>
</view>
