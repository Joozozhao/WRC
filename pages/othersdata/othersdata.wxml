<!-- pages/othersdata/othersdata.wxml -->
<site-header show-back="{{true}}" back-url="/pages/index/index"></site-header>
<view class="others-page {{pageMotion ? 'page-enter-motion' : ''}}">
  <!-- 头部大字英雄区（对齐“我的”页面 profile-hero 样式） -->
  <view class="profile-hero">
    <text class="profile-eyebrow">WRC · RUNNER PROFILE</text>
    <text class="profile-title">{{sex == 2 ? '看她，' : '看他，'}}<text class="profile-title-break">如何多娇！</text></text>
    <view class="profile-title-line"></view>
    <text class="profile-intro">每一步都算数。把每一次坚持，跑成自己的故事。</text>
  </view>

  <!-- 跑者身份信息条（对齐“我的”页面 profile-person 样式） -->
  <view class="profile-person">
    <view class="profile-avatar-wrap">
      <image class="profile-avatar" src="{{headerImg || '/images/default.png'}}" mode="aspectFill"></image>
    </view>
    <view class="profile-person-main">
      <view class="profile-name-row">
        <text class="profile-name">{{userName || nickName || '跑者'}}</text>
      </view>
      <view class="profile-badge-row">
        <text class="profile-badge" wx:if="{{levelLabel}}">{{levelLabel}}</text>
        <text class="profile-badge profile-gender-badge" wx:if="{{sex == 1 || sex == 2}}">{{sex == 1 ? '男' : '女'}}</text>
        <view class="profile-badge profile-region-badge" wx:if="{{regionLabel}}"><image class="profile-region-icon" src="/images/place.png" mode="aspectFit"></image><text>{{regionLabel}}</text></view>
        <text class="profile-badge profile-id-badge">id {{targetUserId}}</text>
      </view>
    </view>
    <view class="profile-asset-buttons" wx:if="{{statsLoaded}}">
      <view class="profile-asset-btn">
        <image class="profile-asset-btn-icon" src="/images/score.svg" mode="aspectFit"></image>
        <text class="profile-asset-btn-num">{{score}}</text>
        <text class="profile-asset-btn-label">积分</text>
      </view>
      <view class="profile-asset-btn">
        <image class="profile-asset-btn-icon" src="/images/flower.svg" mode="aspectFit"></image>
        <text class="profile-asset-btn-num">{{energy}}</text>
        <text class="profile-asset-btn-label">小花</text>
      </view>
    </view>
  </view>

  <!-- 跑量数据概览卡片（对齐“我的”页面 profile-summary 规范） -->
  <view class="profile-summary-card">
    <view class="summary-head">
      <text class="summary-title">跑量好猛</text>
      <text class="summary-subtitle">AWESOME</text>
    </view>
    <view class="summary-accent-line"></view>
    <view class="summary-stats-grid">
      <view class="summary-stat-col is-left">
        <text class="stat-col-val">{{weekLoaded ? weekDistance : '—'}}</text>
        <text class="stat-col-label">本周跑量 / 公里</text>
      </view>
      <view class="summary-stat-col is-center">
        <text class="stat-col-val">{{yearLoaded ? yearDistance : '—'}}</text>
        <text class="stat-col-label">本年跑量 / 公里</text>
      </view>
      <view class="summary-stat-col is-right">
        <text class="stat-col-val stat-col-total">{{statsLoaded ? totalDistance : '—'}}</text>
        <text class="stat-col-label">累计跑量 / 公里</text>
      </view>
    </view>
  </view>

  <!-- 跑步日历模块：以月为单位，支持左右划动查看每天打卡情况 -->
  <view class="section-card calendar-section">
    <view class="section-head">
      <view class="section-heading-wrap">
        <text class="section-title">跑步日历</text>
      </view>
      <!-- 月份前后切换 -->
      <view class="calendar-nav" wx:if="{{heatmapStatus === 'ready'}}">
        <view class="nav-arrow {{canPrevMonth ? '' : 'disabled'}}" bindtap="onPrevMonth">‹</view>
        <text class="nav-month-label">{{monthPages[currentMonthIndex].monthLabel}}</text>
        <view class="nav-arrow {{canNextMonth ? '' : 'disabled'}}" bindtap="onNextMonth">›</view>
      </view>
    </view>

    <!-- 支持左右划动的月历 Swiper -->
    <block wx:if="{{heatmapStatus === 'ready'}}">
      <view class="month-stats-banner" wx:if="{{monthPages[currentMonthIndex]}}">
        <text>当月跑步打卡 <text class="highlight-days">{{monthPages[currentMonthIndex].runDaysCount}}</text> 天</text>
        <text class="dot">·</text>
        <text>月累计跑量 <text class="highlight-km">{{monthPages[currentMonthIndex].totalDistance}}</text> 公里</text>
      </view>

      <view class="weekdays-bar">
        <text wx:for="{{['一', '二', '三', '四', '五', '六', '日']}}" wx:key="*this">{{item}}</text>
      </view>

      <swiper
        class="calendar-swiper"
        style="height: {{monthPages[currentMonthIndex].gridHeight}}rpx;"
        current="{{currentMonthIndex}}"
        bindchange="onMonthSwiperChange"
        duration="250">
        <swiper-item wx:for="{{monthPages}}" wx:key="monthKey" wx:for-item="monthItem">
          <view class="days-grid">
            <view
              wx:for="{{monthItem.days}}"
              wx:key="dateKey"
              class="day-cell level-{{item.level}} {{item.isOtherMonth ? 'is-other-month' : ''}} {{item.isFuture ? 'is-future' : ''}} {{item.isToday ? 'is-today' : ''}}">
              <!-- 无打卡：展示日历日期 -->
              <text class="cell-day-num" wx:if="{{item.distance <= 0}}">{{item.day}}</text>
              <!-- 有打卡：突出展示打卡公里数（与首页日历完全一致） -->
              <view class="cell-run {{item.displayKm >= 100 ? 'is-condensed' : ''}}" wx:if="{{item.distance > 0}}">
                <text class="cell-run-value">{{item.displayKm}}</text><text class="cell-run-unit">km</text>
              </view>
            </view>
          </view>
        </swiper-item>
      </swiper>

      <!-- 底部跑量等级图例 -->
      <view class="calendar-legend-bar">
        <text class="legend-hint">颜色越深，当天跑量越多</text>
        <view class="legend-swatches">
          <text>少</text>
          <view class="legend-swatch level-0"></view>
          <view class="legend-swatch level-1"></view>
          <view class="legend-swatch level-2"></view>
          <view class="legend-swatch level-3"></view>
          <view class="legend-swatch level-4"></view>
          <text>多</text>
        </view>
      </view>
    </block>

    <view class="calendar-loading-box" wx:elif="{{heatmapStatus === 'loading'}}">
      <text class="calendar-loading-text">正在读取跑步日历…</text>
    </view>
    <view class="calendar-loading-box" wx:elif="{{heatmapStatus === 'error'}}">
      <text class="calendar-error-text">跑步日历暂时无法加载</text>
    </view>
  </view>

  <!-- 马拉松成绩（对齐“我的”页面 profile-races 卡片） -->
  <view class="section-card" wx:if="{{marathons.length > 0}}">
    <view class="section-head" bindtap="toMarathonAll">
      <view class="section-heading-wrap">
        <text class="section-title">马拉松成绩</text>
        <text class="section-desc">共完赛 {{totalMarathons}} 场认证赛事</text>
      </view>
      <text class="section-link-action">全部成绩 →</text>
    </view>

    <view class="marathon-card-list">
      <view class="marathon-card-item" wx:for="{{marathons}}" wx:key="index" bindtap="toMarathonAll">
        <view class="marathon-card-info">
          <view class="marathon-meta-line">
            <text class="marathon-date">{{item.playing_time}}</text>
            <text class="marathon-pb-tag" wx:if="{{item.is_pb == 1}}">★ PB</text>
          </view>
          <text class="marathon-name-line">{{item.marathon_name}}</text>
        </view>
        <view class="marathon-score-wrap">
          <text class="marathon-score-num">{{item.accurate_score || '—'}}</text>
          <text class="marathon-score-unit">净成绩</text>
        </view>
      </view>
    </view>
  </view>

  <view class="page-bottom-padding"></view>
</view>
