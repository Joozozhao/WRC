<!-- WRC Runner Profile: TA的主页 -->
<site-header show-back="{{true}}" back-url="/pages/index/index"></site-header>
<view class="others-page">
  <!-- 头部英雄区 -->
  <view class="hero-card">
    <view class="eyebrow">WRC · RUNNER PROFILE</view>
    <view class="person-row">
      <view class="avatar-wrap">
        <image class="avatar-img" src="{{headerImg}}" mode="aspectFill"></image>
        <image wx:if="{{level === 'VIP'}}" class="vip-badge" src="/images/vip_1.svg" mode="aspectFit"></image>
      </view>
      <view class="person-info">
        <view class="name-line">
          <text class="runner-name">{{userName || nickName || "跑者"}}</text>
          <image wx:if="{{sex == 1}}" class="sex-icon" src="/images/me-n.svg" mode="aspectFit"></image>
          <image wx:elif="{{sex == 2}}" class="sex-icon" src="/images/me-v.svg" mode="aspectFit"></image>
          <text class="duty-tag" wx:if="{{duty}}">{{duty}}</text>
        </view>
        <view class="id-line">
          <text class="id-tag">跑者 ID · {{targetUserId}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 数据概览四宫格卡片 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-number highlight">{{statsLoaded ? monthDistance : "—"}}</text>
      <text class="stat-label">本月跑量 (公里)</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-number">{{statsLoaded ? totalDistance : "—"}}</text>
      <text class="stat-label">累计跑量 (公里)</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-number">{{statsLoaded ? score : "—"}}</text>
      <text class="stat-label">积分资产</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-number">{{statsLoaded ? energy : "—"}}</text>
      <text class="stat-label">小花儿</text>
    </view>
  </view>

  <!-- 跑步日历热力图 -->
  <view class="section-card">
    <view class="section-head">
      <view class="section-title-wrap">
        <text class="section-title">跑步日历</text>
        <text class="section-sub">打卡足迹与跑量分布</text>
      </view>
      <view class="heatmap-nav" wx:if="{{heatmapStatus === 'ready'}}">
        <view class="nav-arrow {{canPrevMonth ? '' : 'disabled'}}" bindtap="onPrevMonth">‹</view>
        <text class="nav-label">{{myHeatmap.monthLabel}}</text>
        <view class="nav-arrow {{canNextMonth ? '' : 'disabled'}}" bindtap="onNextMonth">›</view>
      </view>
    </view>

    <view class="calendar-grid" wx:if="{{heatmapStatus === 'ready'}}">
      <view class="weekdays-row">
        <text wx:for="{{['一', '二', '三', '四', '五', '六', '日']}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="days-grid">
        <block wx:for="{{myHeatmap.days}}" wx:key="index">
          <view wx:if="{{item.isEmpty}}" class="day-cell is-empty"></view>
          <view
            wx:else
            class="day-cell level-{{item.level}} {{item.isFuture ? 'is-future' : ''}} {{item.isToday ? 'is-today' : ''}}">
            <text class="cell-day-text" wx:if="{{item.distance <= 0}}">{{item.day}}</text>
            <view class="cell-run-wrap" wx:if="{{item.distance > 0}}">
              <text class="cell-run-km">{{item.displayKm}}</text>
              <text class="cell-run-unit">km</text>
            </view>
          </view>
        </block>
      </view>
    </view>
    <view class="calendar-loading" wx:elif="{{heatmapStatus === 'loading'}}">
      <text>正在读取跑步日历…</text>
    </view>
  </view>

  <!-- 马拉松成绩 -->
  <view class="section-card" wx:if="{{marathons.length > 0}}">
    <view class="section-head" bindtap="toMarathonAll">
      <view class="section-title-wrap">
        <text class="section-title">马拉松成绩</text>
        <text class="section-sub">共完赛 {{totalMarathons}} 场认证赛事</text>
      </view>
      <text class="section-link">全部成绩 →</text>
    </view>

    <view class="marathon-list">
      <block wx:for="{{marathons}}" wx:key="index">
        <view class="marathon-card" bindtap="toMarathonAll">
          <view class="marathon-head">
            <text class="marathon-title">{{item.marathon_name}}</text>
            <text class="pb-tag" wx:if="{{item.is_pb == 1}}">★ PB</text>
          </view>
          <view class="marathon-body">
            <text class="marathon-type">{{item.events_type || "认证赛事"}} · {{item.playing_time}}</text>
            <text class="marathon-score">{{item.accurate_score || "—"}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 参与活动与挑战 -->
  <view class="section-card">
    <view class="section-tabs">
      <view
        class="tab-item {{activeTab === 'challenge' ? 'active' : ''}}"
        data-tab="challenge"
        bindtap="switchTab">
        参与的挑战 ({{totalChallenge}})
      </view>
      <view
        class="tab-item {{activeTab === 'activity' ? 'active' : ''}}"
        data-tab="activity"
        bindtap="switchTab">
        参与的团跑 ({{totalActy}})
      </view>
    </view>

    <!-- 挑战列表 -->
    <view class="acty-grid" wx:if="{{activeTab === 'challenge'}}">
      <block wx:for="{{activityList}}" wx:key="id">
        <view class="acty-card" data-id="{{item.id || item.acty_id}}" bindtap="toChallengeDetail">
          <image class="acty-img" src="{{item.acty_img || '/images/default.png'}}" mode="aspectFill"></image>
          <text class="acty-name">{{item.acty_name}}</text>
        </view>
      </block>
      <view class="empty-tip" wx:if="{{activityList.length === 0}}">TA 暂未参加挑战</view>
    </view>

    <!-- 团跑列表 -->
    <view class="acty-grid" wx:if="{{activeTab === 'activity'}}">
      <block wx:for="{{activityList2}}" wx:key="id">
        <view class="acty-card" data-id="{{item.id || item.acty_id}}" bindtap="toActivityDetail">
          <image class="acty-img" src="{{item.acty_img || '/images/default.png'}}" mode="aspectFill"></image>
          <text class="acty-name">{{item.acty_name}}</text>
        </view>
      </block>
      <view class="empty-tip" wx:if="{{activityList2.length === 0}}">TA 暂未参加团跑活动</view>
    </view>
  </view>
</view>
