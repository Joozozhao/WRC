page { background: #fbfcf9; color: #072f27; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.run-page { min-height: 100vh; padding: 42rpx 40rpx 205rpx; box-sizing: border-box; }
.run-hero { padding: 18rpx 4rpx 42rpx; border-bottom: 1rpx solid #e1e9e3; }
.run-eyebrow { display: block; color: #0d6447; font-size: 22rpx; font-weight: 750; letter-spacing: 3rpx; }
.run-title { display: block; margin-top: 28rpx; font-size: 79rpx; line-height: 1.13; font-weight: 800; letter-spacing: -3rpx; }
.run-title-break { display: block; }
.run-title-line { width: 188rpx; height: 7rpx; margin-top: 3rpx; border-radius: 10rpx; background: #d9ff3f; transform: rotate(-2deg); }
.run-intro { display: block; margin-top: 24rpx; color: #7a8980; font-size: 26rpx; line-height: 1.6; }
.run-section-head { display: flex; align-items: flex-end; justify-content: space-between; padding: 39rpx 4rpx 23rpx; }
.run-section-title { display: block; font-size: 36rpx; font-weight: 800; }
.run-section-note { display: block; margin-top: 7rpx; color: #84918a; font-size: 22rpx; }
.run-create { padding: 12rpx 17rpx; border-radius: 25rpx; background: #d9ff3f; color: #092f24; font-size: 22rpx; font-weight: 750; white-space: nowrap; }
.run-list { display: flex; flex-direction: column; gap: 25rpx; }
.run-card { position: relative; overflow: hidden; border: 1rpx solid #e3ebe4; border-radius: 24rpx; background: #fff; }
.run-card-main { position: relative; }
.run-poster { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background: #e6eee7; }
.run-state { position: absolute; left: 22rpx; top: 20rpx; padding: 9rpx 20rpx; border-radius: 24rpx; background: #d9ff3f; color: #062b23; font-size: 21rpx; font-weight: 800; z-index: 2; }
.run-state.is-ended { background: #eef2ed; color: #65746a; }
.run-card-copy {
  position: relative;
  padding: 290rpx 26rpx 25rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0) 34%, rgba(255, 255, 255, 0.5) 48%, rgba(255, 255, 255, 0.86) 62%, rgba(255, 255, 255, 0.97) 78%, #ffffff 100%);
}
.run-card-region { display: block; color: #648174; font-size: 21rpx; font-weight: 650; }
.run-card-title { display: block; margin: 10rpx 0 13rpx; font-size: 34rpx; font-weight: 800; line-height: 1.3; }
.run-card-meta { display: block; margin-top: 5rpx; color: #68786f; font-size: 23rpx; line-height: 1.45; }
.run-card-foot { display: flex; justify-content: space-between; margin-top: 20rpx; padding-top: 19rpx; border-top: 1rpx solid #e8eee9; color: #65786e; font-size: 22rpx; }
.run-card-arrow { color: #0b593e; font-weight: 750; }
.run-admin {
  position: absolute;
  top: 20rpx;
  right: 22rpx;
  z-index: 3;
  display: flex;
  align-items: center;
  padding: 4rpx;
  border: 1rpx solid rgba(227, 235, 228, 0.9);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(7, 47, 39, 0.16);
  color: #0b503e;
  font-size: 22rpx;
  font-weight: 750;
}
.run-admin text { padding: 7rpx 20rpx; }
.run-admin text + text { border-left: 1rpx solid #e3ebe4; }
.run-empty { display: flex; flex-direction: column; align-items: flex-start; margin-top: 15rpx; padding: 35rpx 28rpx; border: 1rpx solid #e3ebe4; border-radius: 24rpx; background: #fff; }
.run-empty-symbol { width: 84rpx; height: 84rpx; border-radius: 50%; background: #eefaeb; color: #0b593e; text-align: center; line-height: 84rpx; font-size: 44rpx; }
.run-empty-title { margin-top: 24rpx; font-size: 32rpx; font-weight: 750; }
.run-empty-copy { margin-top: 8rpx; color: #829087; font-size: 24rpx; }
.run-empty-action { margin-top: 28rpx; color: #0b593e; font-size: 24rpx; font-weight: 750; }
.run-tail { padding-top: 36rpx; color: #9ba79e; text-align: center; font-size: 22rpx; }
