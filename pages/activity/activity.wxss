/* pages/activity/activity.wxss */
.activity {
  display: flex;
  background-color: #4CB944;
  border-radius: 15rpx;
  align-items: center;
  margin: 20rpx;
  font-size: 26rpx;
  color: #fff;
  line-height: 1.5;
  position: relative;
}

.activity.marg {
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}

.cover-img {
  display: flex;
  align-items: center;
  width: 48%;
  height: 210rpx;
  position: relative;
  margin-right: 20rpx;
  border-radius: 10rpx;
}

.cover-img image {
  width: 100%;
  max-height: 210rpx !important;
  border-radius: 10rpx 0 0 10rpx;
}

.activity-infor .title {
  color: #fff;
  font-size: 32rpx;
}

.activity-infor {
  width: 52%;
}

.activity-infor .tag {
  display: inline-block;
  background: #4CB944;
  color: #fff;
  font-size: 22rpx;
  padding: 0 15rpx;
  border-radius: 20rpx;
}

.activity-infor .tag.org {
  background: #fff;
  color: #4CB944;
  margin-right: 10rpx;
}

.activity-infor .time image,
.activity-infor .address image {
  width: 30rpx;
  height: 30rpx;
  margin: 5rpx 10rpx 0 0;
  float: left;
}

.activity .vw-cover {
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, .6);
  position: absolute;
  top: 0;
  left: 0;
  z-index: 4;
}

.cover-img .state {
  width: 100%;
  height: 50rpx;
  background: rgba(0, 0, 0, .6);
  color: #fff;
  text-align: center;
  line-height: 50rpx;
  position: absolute;
  left: 0;
  bottom: 0;
  z-index: 5;
}

.cover-img .cover-fix {
  width: 150rpx;
  height: 150rpx;
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 3;
}

/* .activity:last-child{
  margin-bottom: 120rpx;
} */
.act-btn {
  position: absolute;
  right: 20rpx;
  bottom: 0rpx;
}

.act-btn .btn {
  display: inline-block;
  padding: 0 10rpx;
  line-height: 1.5;
  border: 1px solid #4CB944;
  border-radius: 5rpx;
  margin-left: 20rpx;
  color: #fff;
  background-color: #4CB944;
}