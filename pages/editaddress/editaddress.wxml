<site-header show-back="{{true}}" back-url="/pages/address/address"></site-header>
<!--pages/editaddress/editaddress.wxml-->
<view class="addrform-page">
  <form bindsubmit="onSubmit">
    <view class="addrform-head">
      <text class="addrform-kicker">WRC · ADDRESS</text>
      <text class="addrform-head-label">编辑收货地址</text>
    </view>

    <view class="addrform-section">
      <view class="addrform-title-row">
        <text class="addrform-title">01 / 收货信息</text>
        <text class="addrform-badge">必填</text>
      </view>
      <view class="addrform-card">
        <view class="addrform-row">
          <text class="addrform-label">联系人</text>
          <input type="text" placeholder="请输入联系人" placeholder-class="addrform-placeholder" value="{{name}}" name="name" class="addrform-input" />
        </view>
        <view class="addrform-row">
          <text class="addrform-label">手机号</text>
          <input type="tel" maxlength="11" placeholder="请输入手机号" placeholder-class="addrform-placeholder" value="{{mobile}}" name="mobile" class="addrform-input" />
        </view>
        <view class="addrform-row">
          <text class="addrform-label">省/市/区</text>
          <picker mode="region" bindchange="bindRegionChange" value="{{address}}" custom-item="{{customItem}}" name="address" class="addrform-picker">
            <view class="addrform-picker-value {{address == '' ? 'addrform-placeholder' : ''}}">{{address == '' ? '请选择' : address}}<text class="addrform-arrow">▾</text></view>
          </picker>
        </view>
        <view class="addrform-row">
          <text class="addrform-label">详细地址</text>
          <input type="text" placeholder="请输入详细地址" placeholder-class="addrform-placeholder" value="{{addressDet}}" name="addressDet" class="addrform-input" />
        </view>
      </view>
    </view>

    <view class="addrform-footer">
      <button class="addrform-save" form-type="submit">保存</button>
    </view>
  </form>
</view>
