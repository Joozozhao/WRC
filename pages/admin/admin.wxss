/* WRC Club Config: 跑团配置视觉规范 */
page {
  background-color: #fbfcf9;
  color: #072f27;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.cfg-page {
  min-height: 100vh;
  padding: 0 36rpx calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.cfg-header {
  padding-top: 24rpx;
  margin-bottom: 34rpx;
}

.eyebrow {
  display: block;
  color: #0d6447;
  font-size: 22rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}

.page-title {
  display: block;
  margin-top: 20rpx;
  color: #072f27;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -2rpx;
}

.title-line {
  width: 140rpx;
  height: 6rpx;
  margin-top: 18rpx;
  border-radius: 8rpx;
  background: #d9ff3f;
}

.page-subtitle {
  display: block;
  color: #78897e;
  font-size: 24rpx;
  margin-top: 18rpx;
  line-height: 1.4;
}

.cfg-card {
  background: #ffffff;
  border: 1rpx solid #e3ebe4;
  border-radius: 24rpx;
  padding: 6rpx 28rpx;
  box-shadow: 0 4rpx 14rpx rgba(7, 47, 39, 0.02);
}

.cfg-row {
  display: flex;
  align-items: center;
  min-height: 110rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef3ee;
  box-sizing: border-box;
}

.cfg-row:last-child {
  border-bottom: none;
}

.cfg-main {
  flex: 1;
  min-width: 0;
}

.cfg-label {
  display: block;
  color: #072f27;
  font-size: 29rpx;
  font-weight: 650;
}

.cfg-hint {
  display: block;
  margin-top: 6rpx;
  color: #8a998f;
  font-size: 21rpx;
}

.cfg-control {
  flex: none;
  margin-left: 20rpx;
}

.logo-upload {
  width: 140rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 32rpx;
  background: #072f27;
  color: #d9ff3f;
  font-size: 24rpx;
  font-weight: 650;
}

.logo-preview {
  width: 96rpx;
  height: 96rpx;
  border: 1rpx solid #e3ebe4;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f6faf1;
}

.logo-preview image {
  width: 100%;
  height: 100%;
}

.logo-hover {
  opacity: 0.8;
}

.cfg-input {
  flex: none;
  width: 320rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: right;
  color: #072f27;
  font-size: 30rpx;
  font-weight: 650;
}

.cfg-ph {
  color: #a9b6ad;
  font-size: 24rpx;
  font-weight: 400;
}

.cfg-radios {
  display: flex;
  flex: none;
  gap: 28rpx;
  margin-left: 20rpx;
}

.cfg-radio {
  display: flex;
  align-items: center;
  color: #103d2e;
  font-size: 26rpx;
}

/* 底部操作栏（含安全区） */
.cfg-action {
  position: fixed;
  z-index: 5;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 40rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fbfcf9;
  border-top: 1rpx solid #e0e9e1;
}

.cfg-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: #d9ff3f;
  color: #092f24;
  font-size: 32rpx;
  font-weight: 800;
  text-align: center;
}

.cfg-btn::after {
  border: none;
}

.cfg-btn-hover {
  background: #c8f22e;
  color: #092f24;
}
