/* pages/challenge/challenge.wxss */
page{
  background: #4CB944;
}
.challenge{
  padding: 0 20rpx 20rpx;
  position: relative;
}
.challenge:last-child{
  margin-bottom: 120rpx;
}
.challenge-img{
  position: relative;
  overflow: hidden;
}
.challenge-img .challenge-wrap{
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,.7);
  left: 0;
  top: 0;
  z-index: 1;
}
.challenge-img .challenge-state{
  width: 60vw;
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%,-50%);
  z-index: 2;
}
.challenge .challenge-cover{
  width: 100%;
}
.acty-infors{
  padding: 20rpx 0;
  font-size: 24rpx;
  color: #fff;
}
.acty-infors .acty-state{
  color: #fff;
  margin-right: 10rpx;
}
.acty-infors .flex-con{
  display: flex;
  align-items: center;
  margin: 10rpx 0;
}
.acty-infors .acty-name{
  font-size: 32rpx;
}
.acty-infors .num{
  margin-left: auto;
}
.act-btn{
  position: absolute;
  right: 50rpx;
  top: 25rpx;
  color: #fff;
  z-index: 10;
}
.act-btn .btn{
  display: inline-block;
  background: #333;
  padding: 0 10rpx;
  line-height: 1.5;
  border: 1px solid #e1e1e1;
  border-radius: 5rpx;
  margin-left: 20rpx;
}