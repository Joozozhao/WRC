page { background: #fbfcf9; color: #072f27; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.challenge-page { min-height: 100vh; padding: 42rpx 40rpx 205rpx; box-sizing: border-box; }
.challenge-hero { padding: 18rpx 4rpx 42rpx; border-bottom: 1rpx solid #e1e9e3; }
.challenge-eyebrow { display: block; color: #0d6447; font-size: 22rpx; font-weight: 750; letter-spacing: 3rpx; }
.challenge-title { display: block; margin-top: 28rpx; font-size: 79rpx; line-height: 1.13; font-weight: 800; letter-spacing: -3rpx; }
.challenge-title-break { display: block; }
.challenge-title-line { width: 200rpx; height: 7rpx; margin-top: 3rpx; border-radius: 10rpx; background: #d9ff3f; transform: rotate(-2deg); }
.challenge-intro { display: block; margin-top: 24rpx; color: #7a8980; font-size: 26rpx; line-height: 1.6; }
.challenge-heading { display: flex; justify-content: space-between; align-items: flex-end; padding: 39rpx 4rpx 23rpx; }
.challenge-heading-copy { display: flex; flex-direction: column; min-width: 0; }
.challenge-heading-title { color: #072f27; font-size: 36rpx; font-weight: 800; }
.challenge-heading-count { margin-top: 7rpx; color: #819087; font-size: 22rpx; font-weight: 500; }
.challenge-create { padding: 12rpx 17rpx; border-radius: 25rpx; background: #d9ff3f; color: #062b23; font-size: 22rpx; font-weight: 750; white-space: nowrap; box-shadow: 0 4rpx 16rpx rgba(217, 255, 63, 0.25); }
.challenge-list { display: flex; flex-direction: column; gap: 25rpx; }
.challenge-card { position: relative; overflow: hidden; border: 1rpx solid #e3ebe4; border-radius: 24rpx; background: #fff; }
.challenge-card-main { position: relative; }
.challenge-poster { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background: #e5ede6; transform: translateY(-5%); }
.challenge-state { position: absolute; top: 20rpx; left: 22rpx; z-index: 2; padding: 9rpx 18rpx; border-radius: 24rpx; background: #d9ff3f; color: #082d23; font-size: 21rpx; font-weight: 750; }
.challenge-state.is-ended { background: #eef2ed; color: #65746a; }
.challenge-card-content {
  position: relative;
  padding: 300rpx 26rpx 25rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0) 36%, rgba(255, 255, 255, 0.5) 50%, rgba(255, 255, 255, 0.86) 64%, rgba(255, 255, 255, 0.97) 80%, #ffffff 100%);
}
.challenge-kicker { display: block; color: #0e6948; font-size: 21rpx; font-weight: 750; }
.challenge-card-title { display: block; margin: 10rpx 0 16rpx; font-size: 35rpx; line-height: 1.3; font-weight: 800; }
.challenge-meta { display: flex; justify-content: space-between; color: #68786f; font-size: 23rpx; }
.challenge-card-foot { display: flex; justify-content: space-between; margin-top: 20rpx; padding-top: 19rpx; border-top: 1rpx solid #e8eee9; color: #65786e; font-size: 22rpx; }
.challenge-detail-link { color: #0b593e; font-weight: 750; }
.challenge-admin {
  position: absolute;
  top: 20rpx;
  right: 22rpx;
  z-index: 3;
  display: flex;
  align-items: center;
  padding: 4rpx;
  border: 1rpx solid rgba(227, 235, 228, 0.9);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(7, 47, 39, 0.16);
  color: #0b503e;
  font-size: 22rpx;
  font-weight: 750;
}
.challenge-admin text { padding: 7rpx 20rpx; }
.challenge-admin text + text { border-left: 1rpx solid #e3ebe4; }
.challenge-empty { display: flex; flex-direction: column; align-items: flex-start; margin-top: 15rpx; padding: 35rpx 28rpx; border: 1rpx solid #e3ebe4; border-radius: 24rpx; background: #fff; }
.challenge-empty-symbol { width: 84rpx; height: 84rpx; border-radius: 50%; background: #eefaeb; color: #0b593e; text-align: center; line-height: 84rpx; font-size: 44rpx; }
.challenge-empty-title { margin-top: 24rpx; font-size: 32rpx; font-weight: 750; }
.challenge-empty-copy { margin-top: 8rpx; color: #829087; font-size: 24rpx; }
.challenge-empty-action { margin-top: 28rpx; color: #0b593e; font-size: 24rpx; font-weight: 750; }
.challenge-tail { padding-top: 36rpx; color: #9ba79e; text-align: center; font-size: 22rpx; }

.challenge-progress-bar { width: 100%; height: 12rpx; margin-top: 14rpx; border-radius: 8rpx; background: #e8eae8; overflow: hidden; }
.challenge-progress-fill { height: 100%; border-radius: inherit; background: #075b40; }
