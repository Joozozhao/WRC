/* pages/prizelist/prizelist.wxss 自包含：不再 @import orderlist.wxss */
page { background: #fbfcf9; color: #072f27; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.pick-page { min-height: 100vh; padding: 180rpx 40rpx calc(190rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.pick-hero { padding: 18rpx 4rpx 35rpx; border-bottom: 1rpx solid #e1e9e3; }
.pick-eyebrow { display: block; color: #0d6447; font-size: 22rpx; font-weight: 750; letter-spacing: 3rpx; }
.pick-title { display: block; margin-top: 27rpx; font-size: 72rpx; line-height: 1.15; font-weight: 800; letter-spacing: -2rpx; }
.pick-title-line { width: 185rpx; height: 7rpx; margin-top: 4rpx; border-radius: 10rpx; background: #d9ff3f; transform: rotate(-2deg); }
.pick-intro { display: block; margin-top: 22rpx; color: #7a8980; font-size: 26rpx; line-height: 1.6; }
.pick-group { display: block; margin-top: 26rpx; }
.pick-item { display: flex; align-items: center; margin-bottom: 20rpx; padding: 20rpx 24rpx; border: 1rpx solid #e3ebe4; border-radius: 22rpx; background: #fff; box-sizing: border-box; }
.pick-item.is-checked { border: 2rpx solid #0b503b; background: #edf5dd; }
.pick-radio { flex: none; margin-right: 16rpx; }
.pick-radio radio { transform: scale(.85); }
.pick-cover { overflow: hidden; flex: none; width: 120rpx; height: 120rpx; margin-right: 20rpx; border-radius: 12rpx; background: #eef2ed; }
.pick-cover image { width: 100%; height: 100%; }
.pick-info { flex: 1; min-width: 0; }
.pick-name { overflow: hidden; color: #153d31; font-size: 28rpx; font-weight: 750; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.pick-stock { margin-top: 6rpx; color: #718078; font-size: 23rpx; }
.pick-empty { display: flex; min-height: 260rpx; align-items: center; justify-content: center; margin-top: 28rpx; border: 1rpx solid #e3ebe4; border-radius: 20rpx; background: #fff; color: #718078; font-size: 25rpx; }
.pick-footer { position: fixed; z-index: 5; right: 0; bottom: 0; left: 0; padding: 15rpx 40rpx calc(19rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #dfe8df; background: #fbfcf9; }
.pick-submit { display: flex; width: 100%; height: 92rpx; align-items: center; justify-content: center; box-sizing: border-box; margin: 0; border-radius: 48rpx; background: #d9ff3f; color: #092f27; font-size: 29rpx; font-weight: 800; line-height: 1.2; }
.pick-submit::after { border: 0; }
