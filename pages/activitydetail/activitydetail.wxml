<wxs src="../../utils/toDecimal2.wxs" module="number" />
<site-header show-back="{{true}}" back-url="/pages/activity/activity" bindprofiletap="openMyPage"></site-header>
<view class="detail-page">
  <view class="detail-message" wx:if="{{loading}}">团跑详情加载中…</view>
  <view class="detail-message" wx:elif="{{loadError}}">
    <text class="detail-message-title">暂时无法查看团跑</text>
    <text class="detail-message-copy">请检查网络后重试。</text>
    <button class="detail-retry" bindtap="retryLoad">重新加载</button>
  </view>
  <block wx:else>
    <view class="detail-cover">
      <image wx:if="{{acty_img}}" src="{{acty_img}}" mode="aspectFill"></image>
      <view class="detail-cover-fallback" wx:else>WRC · RUN TOGETHER</view>
      <text class="detail-cover-state" wx:if="{{state == '已结束'}}">已结束</text>
    </view>
    <view class="detail-intro">
      <text class="detail-eyebrow">WRC · 团跑活动</text>
      <text class="detail-title">{{acty_name}}</text>
      <view class="detail-tags">
        <text wx:if="{{acty_type}}">{{acty_type}}</text>
        <text wx:if="{{region}}">{{region}}</text>
        <text>活动 ID {{actyId}}</text>
      </view>
      <view class="detail-meta">
        <view wx:if="{{start_time}}"><text>时间</text><text>{{start_time}}{{end_time ? ' — ' + end_time : ''}}</text></view>
        <view wx:if="{{address}}"><text>地点</text><text>{{address}}</text></view>
      </view>
    </view>
    <view class="detail-distance">
      <view><text class="detail-section-kicker">本次目标</text><text class="detail-distance-number">{{distance}}</text><text class="detail-distance-unit">公里</text></view>
      <text class="detail-distance-note">一起跑，跑更远。</text>
    </view>
    <view class="detail-section detail-people" bindtap="toList">
      <view class="detail-section-heading"><text>已报名团员</text><text class="detail-section-link">查看全部 →</text></view>
      <view class="detail-people-row">
        <view class="detail-avatars">
          <image wx:for="{{avastars}}" wx:key="id" wx:if="{{index < 12 && item.header_url}}" src="{{item.header_url}}" mode="aspectFill"></image>
        </view>
        <text class="detail-people-count">{{memberLoaded ? actyIn : '—'}} 人</text>
      </view>
    </view>
    <view class="detail-section" wx:if="{{acty_level == 1 && actyMember.length}}" bindtap="toList2">
      <view class="detail-section-heading"><text>聚跑团员</text><text class="detail-section-link">查看全部 →</text></view>
      <view class="detail-people-row">
        <view class="detail-avatars"><image wx:for="{{actyMember}}" wx:key="id" wx:if="{{index < 12 && item.header_url}}" src="{{item.header_url}}" mode="aspectFill"></image></view>
        <text class="detail-people-count">{{actyMember.length}} 人</text>
      </view>
    </view>
    <view class="detail-section" wx:if="{{actyImg.length}}">
      <view class="detail-section-heading"><text>活动相册</text><text class="detail-section-caption">点击照片查看</text></view>
      <swiper class="detail-gallery" indicator-dots="{{indicatorDots}}" autoplay="{{autoplay}}" interval="{{interval}}" duration="{{duration}}" circular="true">
        <swiper-item wx:for="{{actyImg}}" wx:key="id" data-url="{{item.img_url}}" bindtap="preview"><image src="{{item.img_url}}" mode="aspectFill"></image></swiper-item>
      </swiper>
    </view>
    <view class="detail-section" wx:if="{{ltyList.length}}">
      <view class="detail-section-heading"><text>本期抽奖</text></view>
      <view class="detail-prizes">
        <view class="detail-prize" wx:for="{{ltyList}}" wx:key="id" data-id="{{item.id}}" bindtap="toLty">
          <image src="{{item.goods_pic}}" mode="aspectFill"></image>
          <view><text>{{item.address || '抽奖奖品'}}</text><text wx:if="{{item.goods_num}}">{{item.goods_num}} 件</text></view>
        </view>
      </view>
    </view>
    <view class="detail-section" bindtap="toactyData">
      <view class="detail-section-heading"><text>活动数据</text><text class="detail-section-link">查看详情 →</text></view>
      <view class="detail-stats">
        <view><text class="detail-stat-value">{{statsLoaded ? allNum : '—'}}</text><text class="detail-stat-label">运动人数</text></view>
        <view><text class="detail-stat-value">{{statsLoaded ? number.toDecimal2(allDistance) : '—'}}</text><text class="detail-stat-label">总跑量 / 公里</text></view>
      </view>
    </view>
    <!-- 活动报名成员列表（由原 member 页面移至此处） -->
    <view class="detail-section detail-members-section">
      <view class="detail-section-heading">
        <text>活动报名成员</text>
        <text class="detail-section-caption" wx:if="{{memberLoaded}}">共 {{actyIn}} 位跑友</text>
      </view>
      <view class="member-list" wx:if="{{avastars.length > 0}}">
        <view class="member-card" wx:for="{{avastars}}" wx:key="id" data-userid="{{item.id}}" bindtap="toUserDetail" hover-class="card-hover">
          <view class="rank-index {{index < 3 ? 'top' : ''}}">
            <text wx:if="{{index + 1 < 10}}">0{{index + 1}}</text>
            <text wx:else>{{index + 1}}</text>
          </view>
          <image class="member-avatar" src="{{item.header_url || '/images/default.png'}}" mode="aspectFill"></image>
          <view class="member-info">
            <view class="name-row">
              <text class="member-name">{{item.user_name || item.nick_name || '跑友'}}</text>
              <text class="level-badge vip" wx:if="{{item.level === 'VIP'}}">VIP</text>
            </view>
            <view class="meta-row">
              <text class="member-sex-tag male" wx:if="{{item.sex == 1}}">男</text>
              <text class="member-sex-tag female" wx:elif="{{item.sex == 2}}">女</text>
              <text class="member-id">ID {{item.id}}</text>
              <text class="member-tag" wx:if="{{item.address}}">{{item.address}}</text>
            </view>
          </view>
          <view class="member-action">
            <text class="action-text">TA的主页</text>
            <text class="action-arrow">→</text>
          </view>
        </view>
      </view>
      <view class="detail-no-members" wx:elif="{{memberLoaded}}">暂无报名成员</view>
    </view>
  </block>
</view>
<view class="detail-action" wx:if="{{!loading && !loadError && state != '已结束'}}">
  <button wx:if="{{signTrue}}" bindtap="signIn">{{userId > 0 ? '报名团跑' : '登录后报名'}}<text> →</text></button>
  <button class="detail-action-done" disabled="true" wx:else>已报名</button>
</view>
