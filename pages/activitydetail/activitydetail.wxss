page { background: #fbfcf9; color: #072f27; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.detail-page { min-height: 100vh; padding-bottom: 185rpx; box-sizing: border-box; }
.detail-message { padding: 200rpx 42rpx 130rpx; color: #78897e; font-size: 27rpx; }
.detail-message-title { display: block; color: #072f27; font-size: 40rpx; font-weight: 800; }
.detail-message-copy { display: block; margin-top: 14rpx; }
.detail-retry { display: inline-block; margin: 38rpx 0 0; padding: 0 35rpx; background: #d9ff3f; color: #072f27; border-radius: 40rpx; font-size: 25rpx; font-weight: 750; }
.detail-cover { position: relative; height: 520rpx; background: #164535; overflow: hidden; }
.detail-cover image { width: 100%; height: 100%; }
.detail-cover-fallback { height: 100%; display: flex; align-items: center; justify-content: center; color: #d9ff3f; font-size: 25rpx; letter-spacing: 3rpx; }
.detail-cover-state { position: absolute; right: 40rpx; bottom: 28rpx; padding: 10rpx 22rpx; border-radius: 30rpx; background: rgba(237, 242, 235, 0.92); color: #496151; font-size: 22rpx; font-weight: 750; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12); }
.detail-intro { padding: 40rpx 42rpx 35rpx; }
.detail-eyebrow { display: block; color: #0d6447; font-size: 22rpx; font-weight: 750; letter-spacing: 2rpx; }
.detail-title { display: block; margin-top: 18rpx; font-size: 58rpx; line-height: 1.2; font-weight: 800; letter-spacing: -2rpx; word-break: break-all; }
.detail-tags { display: flex; flex-wrap: wrap; margin-top: 25rpx; }
.detail-tags text { margin: 0 12rpx 12rpx 0; padding: 8rpx 16rpx; border-radius: 30rpx; background: #eaf1e9; color: #456b58; font-size: 21rpx; }
.detail-meta { margin-top: 26rpx; border-top: 1rpx solid #e1e9e3; }
.detail-meta view { display: flex; padding: 21rpx 0; border-bottom: 1rpx solid #e1e9e3; font-size: 25rpx; line-height: 1.5; }
.detail-meta view text:first-child { flex: none; width: 82rpx; color: #7d8b80; }
.detail-meta view text:last-child { flex: 1; min-width: 0; font-weight: 650; }
.detail-distance { display: flex; align-items: flex-end; justify-content: space-between; margin: 0 40rpx 20rpx; padding: 28rpx 32rpx 34rpx; border-radius: 24rpx; background: #103d30; color: #fff; }
.detail-section-kicker { display: block; color: #b9d0c2; font-size: 22rpx; }
.detail-distance-number { display: inline-block; margin-top: 8rpx; color: #d9ff3f; font-size: 92rpx; font-weight: 800; line-height: 1; }
.detail-distance-unit { margin-left: 8rpx; color: #d9ff3f; font-size: 26rpx; }
.detail-distance-note { max-width: 180rpx; color: #b9d0c2; font-size: 22rpx; text-align: right; }
.detail-section { margin: 0 40rpx; padding: 39rpx 0; border-bottom: 1rpx solid #e0e9e1; }
.detail-section-heading { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 23rpx; }
.detail-section-heading text:first-child { font-size: 34rpx; font-weight: 800; }
.detail-section-link { color: #0b6748; font-size: 23rpx; font-weight: 750; }
.detail-section-caption { color: #809187; font-size: 21rpx; }
.detail-people-row { display: flex; align-items: center; justify-content: space-between; min-height: 64rpx; }
.detail-avatars { display: flex; align-items: center; min-width: 0; }
.detail-avatars image { flex: none; width: 58rpx; height: 58rpx; margin-right: -16rpx; border: 3rpx solid #fbfcf9; border-radius: 50%; background: #e2eee4; }
.detail-people-count { flex: none; color: #3d6450; font-size: 25rpx; font-weight: 750; }
.detail-gallery { height: 335rpx; border-radius: 21rpx; overflow: hidden; background: #e9f0e8; }
.detail-gallery swiper-item image { width: 100%; height: 100%; }
.detail-prizes { display: flex; flex-wrap: wrap; justify-content: space-between; }
.detail-prize { width: 48%; margin-bottom: 22rpx; overflow: hidden; border-radius: 20rpx; background: #eef3ed; }
.detail-prize image { width: 100%; height: 165rpx; }
.detail-prize view { display: flex; flex-direction: column; padding: 15rpx 18rpx 18rpx; font-size: 23rpx; font-weight: 700; }
.detail-prize view text:last-child { margin-top: 5rpx; color: #758679; font-size: 21rpx; font-weight: 400; }
.detail-stats { display: flex; padding: 7rpx 0 0; }
.detail-stats view { display: flex; flex-direction: column; width: 50%; }
.detail-stats view + view { padding-left: 33rpx; border-left: 1rpx solid #e0e9e1; }
.detail-stat-value { font-size: 54rpx; font-weight: 800; line-height: 1.1; }
.detail-stat-label { margin-top: 10rpx; color: #76887d; font-size: 22rpx; }

/* 报名成员列表样式（迁移自 member 页面） */
.detail-members-section {
  border-bottom: none;
  padding-bottom: 20rpx;
}
.member-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
}
.member-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #e3ebe4;
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 14rpx rgba(7, 47, 39, 0.02);
  transition: background 0.15s ease;
}
.card-hover {
  background: #f8faf6;
}
.rank-index {
  width: 44rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #92a297;
  font-variant-numeric: tabular-nums;
  flex: none;
  text-align: center;
}
.rank-index.top {
  color: #0c6246;
  font-weight: 850;
  font-size: 26rpx;
}
.member-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 2rpx solid #e5eee4;
  background: #e9f0e8;
  flex: none;
  margin-left: 6rpx;
}
.member-info {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  padding-right: 10rpx;
}
.name-row { display: flex; align-items: center; gap: 8rpx; }
.member-name { font-size: 28rpx; font-weight: 800; color: #083427; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 220rpx; }
.level-badge { font-size: 18rpx; font-weight: 800; padding: 2rpx 10rpx; border-radius: 6rpx; line-height: 1.2; flex: none; }
.level-badge.vip { background: #fdf3d6; color: #a46d0a; border: 1rpx solid #f2db9d; }
.meta-row { display: flex; align-items: center; gap: 8rpx; margin-top: 6rpx; }
.member-sex-tag { font-size: 18rpx; font-weight: 700; padding: 2rpx 8rpx; border-radius: 6rpx; line-height: 1.2; flex: none; }
.member-sex-tag.male { background: #e8f3fe; color: #1a73e8; }
.member-sex-tag.female { background: #fdecf2; color: #e5427b; }
.member-id { font-size: 20rpx; color: #8fa094; }
.member-tag { background: #f1f6ef; color: #2b5f44; font-size: 19rpx; font-weight: 600; padding: 2rpx 10rpx; border-radius: 6rpx; }
.member-action { display: flex; align-items: center; gap: 4rpx; flex: none; }
.action-text { font-size: 20rpx; color: #637d6e; font-weight: 600; }
.action-arrow { font-size: 22rpx; color: #0c6246; font-weight: 800; }
.detail-no-members { display: block; color: #7c8b80; font-size: 24rpx; padding: 20rpx 0; }

.detail-action { position: fixed; z-index: 5; left: 0; right: 0; bottom: 0; padding: 18rpx 40rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fbfcf9; border-top: 1rpx solid #e0e9e1; }
.detail-action button { width: 100%; margin: 0; height: 94rpx; line-height: 94rpx; border-radius: 48rpx; background: #d9ff3f; color: #092f24; text-align: center; font-size: 30rpx; font-weight: 800; box-sizing: border-box; }
.detail-action button::after { border: none; }
.detail-action .detail-action-done { background: #e7ede6; color: #677a6c; }
