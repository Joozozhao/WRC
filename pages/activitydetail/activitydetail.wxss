/* pages/activitydetail/activitydetail.wxss */
@import "../index/index.wxss";
@import "../activity/activity.wxss";
@import "../activitydata/activitydata.wxss";
page {
  background:#00b8a9;
  color: #fff;
}
.activity.bg-blcak{
  background: rgba(0,0,0,0.2);
  color: #fff;
}
.box-part-wrap.index-part{
  box-shadow: 0 -3px 5px rgba(0,0,0,.1);
}
.activity.bg-blcak .title{
  color: #fff;
}
.activity-infor .time{
  font-size: 24rpx;
}
.data-wrap{
  padding: 0 20rpx;
}
.nor-title{
  font-size: 32rpx;
  color: #333;
  font-weight: 700;
  text-align: left;
}
.con-wrap{
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 5rpx;
  margin-bottom: 10rpx;
  margin-top: 10rpx;
  color: #fff;
}
.con-wrap2{
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 5rpx;
  margin-top: 5rpx;
}
.data-con{
  display: flex;
  text-align: center;
  padding: 40rpx 0;
  color:#11999e;
}
.data-con .data{
  width: 50%;
  font-size: 24rpx;
  border-right: 1px solid rgba(190, 192, 192, 0.2);
}
.activity.marg {
  padding-bottom: 0;
  margin-bottom: 20rpx;
}
.data-con.full{
  padding: 0 0 30rpx;
}
.data-con.full .data{
  width: 100%;
  font-size: 24rpx;
}
.data-con.full .data .num{
  font-size: 250rpx;
  font-weight: 900;
  line-height: 280rpx;
  color: #4CB944;
}
.data-con.full .data .unit{
  position: relative;
  bottom: 10rpx;
  font-size: 30rpx;
}
.data-con>view:nth-last-child(1){
  border: none;
}
.data-con .data.add-color{
  color: rgba(137, 200, 132);
}
.data-con .num{
  font-size: 70rpx;
}
.infor-con{
  display: flex;
  align-items: center;
  padding: 0 0 30rpx;
}
.list .item{
  width: 50rpx;
  height: 50rpx;
  background: #fff;
  border: 5rpx solid #fff;
  border-radius: 100rpx;
  float: left;
  margin-left: -20rpx;
}
.list .item image{
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.list .item:nth-child(1){
  margin-left: 0;
}
.total{
  position: relative;
  margin-left: auto;
  padding-right: 40rpx;
}
.total .green{
  color: #112d4e;
}
.add-arrow image{
  width: 30rpx;
  height: 30rpx;
  position: absolute;
  right: 0;
  top: 50%;
  margin-top: -15rpx;
}
.act-detail{
  color: #999;
  text-align: left;
  padding: 20rpx 0;
  line-height: 1.5;
}
.lottery-list{
  padding: 20rpx 0;
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  line-height: 2;
}
.lottery-list .con-item{
  width: 48%;
  position: relative;
  margin-bottom: 20rpx;
}
.lottery-list .con-item image{
  width: 100%;
  height: 210rpx;
}
.con-item .tag{
  line-height: 40rpx;
  padding: 0 10rpx;
  font-size: 24rpx;
  text-align: center;
}
.con-item .tag.tag1{
  background: #ff787e;
  position: absolute; 
  right: 0;
  top: 30rpx;
}
.con-item .tag.tag2{
  background: #1296db;
  position: absolute; 
  right: 0;
  top: 80rpx;
}
.member{
  padding: 30rpx 0;
  background-size:  100% 5%;
  background-repeat: repeat-x;
  background-position: left 0% bottom 0%;
}
.btn-group{
  display: flex;
  width: 100%;
  box-sizing: border-box;
  position: fixed;
  bottom: 0;
  left: 0;
  z-index: 2;
}
.btn-group .btn{
  width: 100%;
  height: 140rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 32rpx;
  color: #fff;
  border-radius: 0;
  font-weight: normal;
}
.btn-group .btn.green{
  background: linear-gradient(to right, #EE451F, #EE451F)
}
.btn-group .btn.red{
  background: linear-gradient(to right, #ffde7d, #ff9966);
}
.opacity{
  opacity: .7;
}
.swiper{
  line-height: 70rpx;
  /*margin-bottom: -20rpx;*/
}
.total,.nor-title,.total .green  {
  color: #fff;
}
.listext .other-infor, .listext .member .distance {
  color: #ebfffa;
}
