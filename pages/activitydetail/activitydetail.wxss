page { background: #fbfcf9; color: #072f27; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
button::after { border: none; }
.detail-page { min-height: 100vh; padding: 96px 32rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.detail-page.has-action { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.detail-message { padding: 96rpx 8rpx; color: #73877b; font-size: 26rpx; line-height: 1.65; }
.detail-message-title { display: block; color: #072f27; font-size: 38rpx; font-weight: 800; }
.detail-message-copy { display: block; margin-top: 16rpx; }
.detail-retry { display: inline-flex; margin: 30rpx 0 0; padding: 0 32rpx; background: #d9ff3f; color: #072f27; border-radius: 40rpx; font-size: 26rpx; font-weight: 700; }

.detail-intro { padding: 0 8rpx 28rpx; }
.detail-heading-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.detail-eyebrow { color: #0b503b; font-size: 20rpx; line-height: 1.5; font-weight: 750; letter-spacing: 2rpx; }
.detail-state { flex: none; padding: 6rpx 18rpx; border-radius: 24rpx; background: #eaf2e7; color: #0b503b; font-size: 21rpx; font-weight: 650; }
.detail-state.is-ended { background: #edf0ed; color: #758278; }
.detail-title { display: block; margin-top: 16rpx; font-size: 52rpx; font-weight: 850; line-height: 1.3; letter-spacing: -1.5rpx; overflow-wrap: break-word; }
.event-card { overflow: hidden; border-radius: 28rpx; background: #fff; border: 1rpx solid #e3ebe4; }
.event-cover-wrap { position: relative; }
.detail-cover { display: block; width: 100%; height: 280rpx; background: #e9efea; }
.detail-cover.is-photo { height: auto; }
.detail-cover.is-default { height: auto; }
.cover-photo-label { position: absolute; bottom: 16rpx; right: 18rpx; padding: 7rpx 16rpx; border-radius: 24rpx; background: rgba(7, 47, 39, .78); color: #fff; font-size: 20rpx; font-weight: 550; }
.event-info { padding: 22rpx 26rpx; }
.event-info-row { display: flex; align-items: flex-start; gap: 14rpx; font-size: 23rpx; font-weight: 550; color: #526b5f; line-height: 1.5; }
.event-info-row + .event-info-row { margin-top: 12rpx; }
.event-info-row text { flex: 1; min-width: 0; overflow-wrap: break-word; }
.event-info-icon { flex: none; width: 28rpx; height: 28rpx; margin-top: 3rpx; opacity: .7; }

.run-summary { position: relative; overflow: hidden; margin-top: 24rpx; padding: 30rpx; border-radius: 28rpx; background: #103d30; color: #fff; }
.summary-watermark { position: absolute; top: 32rpx; right: -8rpx; width: 300rpx; height: 180rpx; opacity: .08; filter: brightness(0) invert(1); pointer-events: none; }
.summary-main { position: relative; }
.summary-label { display: block; color: #dce8df; font-size: 25rpx; font-weight: 700; }
.summary-distance { display: flex; align-items: baseline; gap: 12rpx; margin-top: 8rpx; }
.summary-distance > text:first-child { min-width: 0; color: #d9ff3f; font-size: 88rpx; line-height: 1.12; letter-spacing: -3rpx; font-weight: 850; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.summary-unit { flex: none; color: #b9d0c2; font-size: 26rpx; font-weight: 550; }
.summary-grid { position: relative; display: flex; margin-top: 22rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(221, 236, 223, .2); }
.summary-stat { flex: 1; min-width: 0; display: flex; flex-direction: column; text-align: center; padding: 0 10rpx; }
.summary-stat + .summary-stat { border-left: 1rpx solid rgba(221, 236, 223, .2); }
.summary-value { font-size: 38rpx; font-weight: 800; line-height: 1.2; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.summary-stat-label { margin-top: 8rpx; font-size: 21rpx; line-height: 1.4; color: #bed3c5; }
.summary-stat-target .summary-value { color: #d9ff3f; font-size: 54rpx; line-height: 1; }
.summary-stat-target .summary-stat-label { color: #d9ff3f; font-weight: 650; }
.summary-notice { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; font-size: 22rpx; color: #dce8df; }
.summary-notice button { margin: 0; padding: 4rpx 18rpx; border-radius: 16rpx; color: #d9ff3f; background: rgba(255, 255, 255, .08); font-size: 22rpx; line-height: 1.6; }
.my-result { position: relative; display: flex; align-items: center; gap: 16rpx; margin: 24rpx -12rpx -12rpx; padding: 18rpx; border-radius: 20rpx; background: rgba(255, 255, 255, .07); }
.my-result-pressed { background: rgba(255, 255, 255, .13); }
.my-result-avatar { flex: none; width: 64rpx; height: 64rpx; border-radius: 50%; }
.my-result-info { flex: 1; min-width: 0; }
.my-result-label { display: block; color: #c6dbcd; font-size: 20rpx; }
.my-result-meta { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4rpx 14rpx; margin-top: 3rpx; }
.my-result-distance { color: #d9ff3f; font-size: 30rpx; font-weight: 800; font-variant-numeric: tabular-nums; }
.my-result-unit { font-size: 19rpx; font-weight: 600; }
.my-result-speed { color: #e0ebe2; font-size: 21rpx; white-space: nowrap; }
.my-result-rank { flex: none; padding-left: 18rpx; border-left: 1rpx solid rgba(221, 236, 223, .2); color: #d9ff3f; font-size: 25rpx; font-weight: 800; white-space: nowrap; }

.data-panel { margin-top: 24rpx; padding: 0 28rpx; border: 1rpx solid #e3ebe4; border-radius: 28rpx; background: #fff; overflow: hidden; }
.data-tabs { display: flex; gap: 36rpx; border-bottom: 1rpx solid #e3ebe4; }
.data-tab { position: relative; display: flex; align-items: center; gap: 8rpx; margin: 0; padding: 24rpx 0 22rpx; border-radius: 0; background: transparent; color: #7b8c82; font-size: 30rpx; font-weight: 700; line-height: 1.5; }
.data-tab.is-active { color: #072f27; }
.data-tab.is-active::before { content: ""; position: absolute; height: 6rpx; border-radius: 3rpx; bottom: 0; left: 0; right: 0; background: #d9ff3f; }
.tab-count { padding: 1rpx 10rpx; border-radius: 12rpx; font-size: 19rpx; background: #f0f4ef; color: #617c6b; }
.data-caption { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 60rpx; color: #7c8f82; font-size: 20rpx; }
.result-row, .member-row { display: flex; align-items: center; gap: 16rpx; min-height: 118rpx; padding: 20rpx 0; box-sizing: border-box; }
.result-row + .result-row, .member-row + .member-row { border-top: 1rpx solid #e8eee8; }
.result-row.is-me { background: #f4f8ee; margin: 0 -12rpx; padding-left: 12rpx; padding-right: 12rpx; border-radius: 16rpx; }
.row-pressed { background: #f4f8f1; }
.row-index { flex: none; width: 32rpx; color: #92a197; font-size: 23rpx; font-weight: 750; font-variant-numeric: tabular-nums; }
.row-index.is-top { color: #38624e; }
.row-avatar { flex: none; display: block; width: 72rpx; height: 72rpx; min-width: 72rpx; min-height: 72rpx; border-radius: 50%; object-fit: cover; background: #eef3ed; }
.row-info { flex: 1; min-width: 0; }
.row-name-line { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.row-name { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #072f27; font-size: 27rpx; line-height: 1.4; font-weight: 750; }
.me-label { flex: none; padding: 1rpx 8rpx; border-radius: 8rpx; background: #d9ff3f; color: #103d30; font-size: 18rpx; font-weight: 700; }
.row-secondary { display: block; margin-top: 6rpx; color: #7b8d81; font-size: 21rpx; line-height: 1.4; }
.row-distance { flex: none; max-width: 220rpx; text-align: right; color: #0b503b; font-size: 36rpx; font-weight: 800; line-height: 1.25; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.row-distance-unit { color: #71867a; font-size: 20rpx; font-weight: 600; }
.member-level { flex: none; padding: 2rpx 8rpx; border-radius: 8rpx; background: #edf5eb; color: #276247; font-size: 18rpx; font-weight: 700; }
.member-meta { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 6rpx; color: #7b8d81; font-size: 21rpx; line-height: 1.4; }
.row-chevron, .link-chevron { flex: none; width: 28rpx; height: 28rpx; opacity: .6; }
.text-button { display: inline-flex; align-items: center; gap: 2rpx; margin: 0; padding: 0; border-radius: 0; background: transparent; color: #0b6748; font-size: 21rpx; font-weight: 650; line-height: 1.8; }
.panel-state { display: flex; flex-direction: column; align-items: center; gap: 14rpx; padding: 46rpx 8rpx; color: #7b8d81; font-size: 23rpx; line-height: 1.6; text-align: center; }
.panel-state-title { color: #38624e; font-size: 26rpx; font-weight: 700; }
.panel-more { margin: 14rpx 0 24rpx; width: 100%; border-radius: 18rpx; background: #f3f7f0; color: #0b503b; font-size: 24rpx; font-weight: 700; line-height: 3; }
.panel-end { display: block; padding: 22rpx 0; color: #8a9a8f; font-size: 20rpx; text-align: center; }
.together-row { display: flex; align-items: center; gap: 16rpx; border-top: 1rpx solid #e3ebe4; padding: 24rpx 0; }
.together-row > view:first-child { flex: 1; }
.together-title { font-size: 25rpx; font-weight: 700; }
.together-avatars { display: flex; padding-right: 10rpx; }
.together-avatars image { flex: none; width: 48rpx; height: 48rpx; border: 3rpx solid #fff; border-radius: 50%; margin-right: -10rpx; }

.detail-section { margin-top: 24rpx; padding: 24rpx 26rpx; border: 1rpx solid #e3ebe4; border-radius: 28rpx; background: #fff; overflow: hidden; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 18rpx; }
.section-title { color: #072f27; font-size: 30rpx; font-weight: 800; }
.section-count { margin-left: 14rpx; color: #7b8d81; font-size: 21rpx; }
.section-caption { color: #7b8d81; font-size: 20rpx; }
.album-scroll { width: 100%; white-space: nowrap; }
.album-photos { display: flex; gap: 14rpx; }
.album-photo { display: block; flex: none; width: auto; height: 360rpx; border-radius: 18rpx; background: #e9efea; }
.prize-row { display: flex; align-items: center; gap: 18rpx; padding: 4rpx 0; }
.prize-row + .prize-row { border-top: 1rpx solid #e8eee8; margin-top: 18rpx; padding-top: 18rpx; }
.prize-image { flex: none; width: 112rpx; height: 100rpx; border-radius: 16rpx; background: #f0f4ef; }
.prize-info { flex: 1; min-width: 0; }
.prize-name { display: block; font-size: 27rpx; line-height: 1.4; font-weight: 700; overflow-wrap: break-word; }

.detail-action { position: fixed; z-index: 5; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 18rpx; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e0e9e1; background: #fbfcf9; }
.action-copy { flex: 1; min-width: 0; font-size: 24rpx; font-weight: 700; line-height: 1.5; }
.action-copy text { display: block; }
.action-copy .action-copy-sub { margin-top: 4rpx; color: #819185; font-size: 20rpx; font-weight: 400; }
.detail-action button { flex: none; display: flex; align-items: center; gap: 12rpx; min-width: 256rpx; height: 86rpx; margin: 0; padding: 0 26rpx; border-radius: 46rpx; background: #d9ff3f; color: #092f24; font-size: 27rpx; font-weight: 800; }
.action-chevron { width: 32rpx; height: 32rpx; }
.detail-action .detail-action-done { background: #e7ede6; color: #677a6c; }
.detail-action .detail-action-done-hover { background: #dbe5d8; color: #4c6350; }
