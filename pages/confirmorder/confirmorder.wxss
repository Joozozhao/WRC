/* pages/confirmorder/confirmorder.wxss —— 暖白 / 深松绿 / 荧光黄绿（对齐 docs/design/redesign-baseline.md 与 prizedetails） */
page {
  background: #fbfcf9;
  color: #072f27;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}
.co-page {
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.co-kicker {
  display: block;
  color: #0d6447;
  font-size: 21rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}
.co-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx 10rpx;
}
.co-head-label {
  color: #819187;
  font-size: 21rpx;
}

/* 分区 */
.co-section {
  margin: 28rpx 40rpx 0;
}
.co-section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.co-section-title {
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 800;
}
.co-section-index {
  color: #8a9b8e;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* 地址卡 */
.co-address-card {
  min-height: 120rpx;
  padding: 28rpx;
  border: 1rpx solid #e3ebe4;
  border-radius: 22rpx;
  background: #fff;
  box-sizing: border-box;
}
.co-address-top {
  display: flex;
  align-items: baseline;
}
.co-address-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #072f27;
}
.co-address-tel {
  margin-left: auto;
  color: #345747;
  font-size: 26rpx;
  font-weight: 700;
}
.co-address-detail {
  display: block;
  margin-top: 12rpx;
  color: #4c6355;
  font-size: 25rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.co-address-change {
  display: block;
  margin-top: 16rpx;
  color: #0b6446;
  font-size: 22rpx;
  font-weight: 750;
}
.co-address-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
}
.co-address-placeholder {
  color: #84918a;
  font-size: 27rpx;
}
.co-address-arrow {
  color: #9aa69e;
  font-size: 36rpx;
  line-height: 1;
}
.co-wechat-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin: 16rpx 0 0;
  padding: 0;
  border: 1rpx dashed #bcd0bd;
  border-radius: 18rpx;
  background: #f4f8ef;
  color: #0b503b;
  font-size: 25rpx;
  font-weight: 750;
  line-height: 88rpx;
}
.co-wechat-btn::after {
  border: 0;
}
.co-wechat-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

/* 兑换码 */
.co-code-card {
  padding: 24rpx 28rpx;
  border: 1rpx solid #e3ebe4;
  border-radius: 22rpx;
  background: #fff;
}
.co-code-input {
  width: 100%;
  height: 72rpx;
  color: #072f27;
  font-size: 28rpx;
  box-sizing: border-box;
}
.co-input-placeholder {
  color: #9aa69e;
}
.co-code-tips {
  display: block;
  margin-top: 8rpx;
  color: #815b32;
  font-size: 22rpx;
}

/* 商品卡 */
.co-product-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border: 1rpx solid #e3ebe4;
  border-radius: 22rpx;
  background: #fff;
}
.co-product-img {
  flex: none;
  width: 180rpx;
  height: 180rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #edf2eb;
}
.co-product-img image {
  width: 100%;
  height: 100%;
}
.co-product-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.co-product-name {
  display: block;
  color: #072f27;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.co-product-spec {
  display: block;
  margin-top: 10rpx;
  color: #6c8072;
  font-size: 23rpx;
  overflow-wrap: anywhere;
}
.co-product-cost {
  display: block;
  margin-top: 10rpx;
  color: #0b503b;
  font-size: 25rpx;
  font-weight: 750;
}

/* 兑换说明 */
.co-tips-card {
  padding: 28rpx;
  border: 1rpx solid #e3ebe4;
  border-radius: 22rpx;
  background: #fff;
}
.co-tips-title {
  display: block;
  color: #072f27;
  font-size: 26rpx;
  font-weight: 800;
}
.co-tips-item {
  display: block;
  margin-top: 14rpx;
  color: #6c8072;
  font-size: 23rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

/* 底部结算条 */
.co-bar {
  position: fixed;
  z-index: 5;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  padding: 15rpx 40rpx calc(19rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #dfe8df;
  background: #fbfcf9;
}
.co-bar-total {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
}
.co-bar-label {
  color: #345747;
  font-size: 24rpx;
  font-weight: 750;
}
.co-bar-value {
  margin-left: 14rpx;
  color: #0b503b;
  font-size: 36rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}
.co-bar-button {
  flex: none;
  width: 300rpx;
  height: 92rpx;
  margin: 0 0 0 24rpx;
  border-radius: 48rpx;
  background: #d9ff3f;
  color: #092f27;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 92rpx;
}
.co-bar-button::after {
  border: 0;
}

/* 弹层 */
.co-modal-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(7, 47, 39, .45);
}
.co-modal-dialog {
  position: fixed;
  z-index: 21;
  top: 50%;
  left: 50%;
  width: 600rpx;
  max-width: 86vw;
  padding: 48rpx 40rpx 36rpx;
  border-radius: 24rpx;
  background: #fbfcf9;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
  text-align: center;
}
.co-modal-kicker {
  display: block;
  color: #0d6447;
  font-size: 20rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}
.co-modal-title {
  display: block;
  margin-top: 16rpx;
  color: #072f27;
  font-size: 38rpx;
  font-weight: 800;
}
.co-modal-copy {
  margin-top: 22rpx;
  color: #4c6355;
  font-size: 26rpx;
  line-height: 1.6;
}
.co-modal-strong {
  color: #0b503b;
  font-weight: 800;
}
.co-modal-copy-plain {
  display: block;
  margin-top: 22rpx;
  color: #4c6355;
  font-size: 26rpx;
  line-height: 1.6;
}
.co-modal-prize {
  display: block;
  margin-top: 16rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #edf5dd;
  color: #0b503b;
  font-size: 26rpx;
  font-weight: 750;
  overflow-wrap: anywhere;
}
.co-modal-primary {
  width: 100%;
  height: 92rpx;
  margin: 32rpx 0 0;
  border-radius: 48rpx;
  background: #d9ff3f;
  color: #092f27;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 92rpx;
}
.co-modal-primary::after {
  border: 0;
}
.co-modal-ghost {
  width: 100%;
  height: 88rpx;
  margin: 16rpx 0 0;
  border: 1rpx solid #dfe8df;
  border-radius: 44rpx;
  background: #fff;
  color: #0b503b;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 88rpx;
}
.co-modal-ghost::after {
  border: 0;
}
.co-modal-text {
  width: 100%;
  height: 72rpx;
  margin: 6rpx 0 0;
  background: transparent;
  color: #84918a;
  font-size: 25rpx;
  line-height: 72rpx;
}
.co-modal-text::after {
  border: 0;
}
