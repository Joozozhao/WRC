<!-- WRC Participants: 挑战报名跑友 -->
<site-header show-back="{{true}}" back-url="/pages/challenge/challenge"></site-header>
<view class="actyin-page">
  <view class="actyin-header">
    <text class="eyebrow">WRC · RUNNING SQUAD</text>
    <text class="page-title">挑战报名跑友</text>
    <text class="page-subtitle">共 {{totalCount}} 位跑友参与挑战 · 每一步都在向前</text>
  </view>

  <!-- 筛选与排序栏 -->
  <view class="filter-sort-bar">
    <view class="level-tabs">
      <view
        wx:for="{{levelList}}"
        wx:key="*this"
        class="level-tab {{activeLevelIndex === index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="chooseLevel">
        {{item}}
      </view>
    </view>
    <view class="sort-btn" bindtap="toggleSort" hover-class="btn-hover">
      <text class="sort-text">跑量</text>
      <text class="sort-arrow">{{sortOrder === 1 ? '↓' : '↑'}}</text>
    </view>
  </view>

  <!-- 跑友列表 -->
  <view class="member-list" wx:if="{{memberList.length > 0}}">
    <block wx:for="{{memberList}}" wx:key="id">
      <view class="member-card" data-userid="{{item.id}}" bindtap="myData" hover-class="card-hover">
        <view class="rank-index {{item.rankNum <= 3 ? 'top' : ''}}">
          <text wx:if="{{item.rankNum < 10}}">0{{item.rankNum}}</text>
          <text wx:else>{{item.rankNum}}</text>
        </view>

        <!-- 头像 -->
        <image class="member-avatar" src="{{item.header_url || '/images/default.png'}}" mode="aspectFill"></image>

        <!-- 跑友信息 -->
        <view class="member-info">
          <view class="name-row">
            <text class="member-name">{{item.user_name || item.nick_name || '跑友'}}</text>
            <text class="level-badge vip" wx:if="{{item.level === 'VIP'}}">VIP</text>
          </view>
          <view class="meta-row">
            <text class="member-sex-tag male" wx:if="{{item.sex == 1}}">男</text>
            <text class="member-sex-tag female" wx:elif="{{item.sex == 2}}">女</text>
            <text class="member-id">ID {{item.id}}</text>
            <text class="member-status-tag" wx:if="{{item.isCompleted}}">已达标</text>
          </view>
        </view>

        <!-- 进度与距离 -->
        <view class="progress-col">
          <view class="distance-numbers">
            <text class="dist-finish">{{item.displayFinish}}</text>
            <text class="dist-sep">/</text>
            <text class="dist-target">{{item.displayTarget}}</text>
            <text class="dist-unit">KM</text>
          </view>
          <view class="progress-track">
            <view
              class="progress-fill {{item.isCompleted ? 'completed' : ''}}"
              style="width: {{item.percent}}%;">
            </view>
          </view>
          <view class="percent-label">{{item.percent}}%</view>
        </view>
      </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view class="empty-block" wx:elif="{{loaded && memberList.length === 0}}">
    <view class="empty-mark">🏃‍♂️</view>
    <text class="empty-title">暂无符合条件的报名成员</text>
    <text class="empty-desc">可尝试切换筛选条件或稍后下拉刷新</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-block" wx:elif="{{loading && !loaded}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载报名跑友…</text>
  </view>
</view>
