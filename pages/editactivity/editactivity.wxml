<site-header show-back="{{true}}" back-url="/pages/activity/activity"></site-header>
<!-- WRC Edit Activity: 编辑活动 -->
<view class="edit-page">
  <form bindsubmit="submit">
    <view class="edit-header">
      <text class="eyebrow">WRC · ACTIVITY MANAGEMENT</text>
      <text class="page-title">编辑活动</text>
      <text class="page-subtitle">修改团跑信息、报名项与聚跑合影记录</text>
    </view>

    <!-- 01 基础信息卡片 -->
    <view class="form-card">
      <view class="card-badge">01 / 基础信息</view>

      <!-- 地区选择 -->
      <view class="form-group">
        <label class="form-label">活动地区</label>
        <view class="chip-group">
          <view
            wx:for="{{regionOptions}}"
            wx:key="*this"
            class="chip {{region === item ? 'active' : ''}}"
            data-region="{{item}}"
            bindtap="selectRegion">
            {{item}}
          </view>
        </view>
      </view>

      <!-- 活动名称 -->
      <view class="form-group">
        <label class="form-label">活动名称</label>
        <input
          class="form-input"
          name="actyName"
          value="{{actyName}}"
          placeholder="例如：微网跑团 第280期奥森周六聚跑"
          placeholder-class="placeholder-text" />
      </view>

      <!-- 活动主题 -->
      <view class="form-group">
        <label class="form-label">活动主题</label>
        <view class="form-input is-disabled">{{actyType}}</view>
      </view>

      <!-- 起止时间 -->
      <view class="form-group" bindtap="pickerShow">
        <label class="form-label">起止时间</label>
        <view class="time-display-box">
          <view class="time-item">
            <text class="time-sub">开始</text>
            <text class="time-val"><block wx:if="{{startTime}}">{{startTime}}</block><block wx:else>点击选择开始时间</block></text>
          </view>
          <text class="time-arrow">→</text>
          <view class="time-item">
            <text class="time-sub">结束</text>
            <text class="time-val"><block wx:if="{{endTime}}">{{endTime}}</block><block wx:else>点击选择结束时间</block></text>
          </view>
        </view>
      </view>

      <!-- 活动地点 -->
      <view class="form-group">
        <label class="form-label">活动地点</label>
        <input
          class="form-input"
          name="address"
          value="{{address}}"
          placeholder="例如：奥林匹克森林公园南门"
          placeholder-class="placeholder-text" />
      </view>

      <!-- 活动距离 -->
      <view class="form-group">
        <label class="form-label">活动距离 (公里)</label>
        <input
          class="form-input"
          type="digit"
          name="distance"
          value="{{distance}}"
          placeholder="例如：10"
          placeholder-class="placeholder-text" />
      </view>
    </view>

    <!-- 02 活动封面卡片 -->
    <view class="form-card">
      <view class="card-badge">02 / 封面图片</view>

      <view class="cover-uploader" wx:if="{{!tempFilePaths}}" bindtap="uploadAction">
        <view class="uploader-icon">📷</view>
        <text class="uploader-title">点击上传活动封面</text>
        <text class="uploader-sub">建议使用清晰横版跑步活动照片</text>
      </view>

      <view class="cover-preview-box" wx:else>
        <image class="cover-image" src="{{tempFilePaths}}" mode="aspectFill" bindtap="uploadAction"></image>
        <view class="cover-actions">
          <view class="cover-btn change-btn" bindtap="uploadAction">重新选择</view>
          <view class="cover-btn delete-btn" bindtap="deleteCover">删除</view>
        </view>
      </view>
    </view>

    <!-- 03 报名设置卡片 -->
    <view class="form-card">
      <view class="card-badge">03 / 报名填写项</view>

      <view class="switch-row">
        <view class="switch-info">
          <text class="switch-title">跑友真实姓名</text>
          <text class="switch-sub">报名必需项，系统默认开启</text>
        </view>
        <switch checked="{{true}}" disabled color="#075b40" />
      </view>

      <view class="switch-row border-top">
        <view class="switch-info">
          <text class="switch-title">联系手机号码</text>
          <text class="switch-sub">开启后，跑友报名时需要提供手机号</text>
        </view>
        <switch checked="{{hasMobile === 1}}" bindchange="toggleMobile" color="#075b40" />
      </view>
    </view>

    <!-- 04 聚跑与合影卡片 -->
    <view class="form-card">
      <view class="card-badge">04 / 聚跑与现场合影</view>

      <view class="switch-row">
        <view class="switch-info">
          <text class="switch-title">聚跑功能</text>
          <text class="switch-sub">开启聚跑并记录实际到场参与人员</text>
        </view>
        <switch checked="{{hasPart === 1}}" bindchange="toggleGroupRun" color="#075b40" />
      </view>

      <!-- 聚跑成员列表 -->
      <view class="group-members-section" wx:if="{{runCon}}">
        <view class="group-members-head" bindtap="openMemberModal">
          <text class="section-title">已确认到场成员 ({{actyMember.length}}人)</text>
          <text class="section-link">选择成员 →</text>
        </view>
        <view class="member-avatar-row" wx:if="{{actyMember.length > 0}}" bindtap="openMemberModal">
          <image
            wx:for="{{actyMember}}"
            wx:key="id"
            wx:if="{{index < 8}}"
            class="stacked-avatar"
            src="{{item.header_url || '/images/default.png'}}"
            mode="aspectFill">
          </image>
          <view class="more-count" wx:if="{{actyMember.length > 8}}">+{{actyMember.length - 8}}</view>
        </view>
        <view class="member-empty-tip" wx:else bindtap="openMemberModal">点击选择已报名的到场跑友</view>
      </view>

      <!-- 聚跑合影 -->
      <view class="photos-section">
        <view class="section-title">聚跑合影照片</view>
        <view class="photo-grid">
          <view
            class="photo-item"
            wx:for="{{detailPics}}"
            wx:key="id"
            bindlongpress="deleteGroupPhoto"
            data-id="{{item.id}}">
            <image class="photo-img" src="{{item.img_url}}" mode="aspectFill"></image>
            <view class="photo-del-tag">长按删除</view>
          </view>
          <view class="photo-add-tile" bindtap="uploadGroupPhoto" wx:if="{{detailPics.length < 9}}">
            <text class="add-plus">＋</text>
            <text class="add-text">添加照片</text>
          </view>
        </view>
        <text class="photo-tips">支持最多 9 张合影 · 长按任意图片可直接删除</text>
      </view>
    </view>

    <!-- 底部固定操作栏 -->
    <view class="bottom-action-bar">
      <button class="primary-submit-btn" form-type="submit" hover-class="btn-pressed">保存活动修改</button>
    </view>
  </form>

  <!-- 成员选择弹窗 -->
  <view class="modal-mask" wx:if="{{runModal}}" bindtap="closeMemberModal"></view>
  <view class="member-modal" wx:if="{{runModal}}">
    <view class="modal-head">
      <text class="modal-title">选择到场聚跑成员</text>
      <text class="modal-count">已选 {{totalMan}} 人</text>
    </view>
    <scroll-view scroll-y="true" class="modal-scroll">
      <checkbox-group bindchange="checkboxChangeMember">
        <label class="member-picker-row" wx:for="{{avastars}}" wx:key="id">
          <checkbox value="{{item.id}}" checked="{{item.checked}}" color="#075b40" />
          <image class="picker-avatar" src="{{item.header_url || '/images/default.png'}}" mode="aspectFill"></image>
          <view class="picker-name-col">
            <text class="picker-name">{{item.user_name || item.nick_name || '跑友'}}</text>
            <text class="picker-meta">ID {{item.id}} · {{item.address || '跑团成员'}}</text>
          </view>
        </label>
      </checkbox-group>
    </scroll-view>
    <view class="modal-foot">
      <view class="modal-btn cancel-btn" bindtap="closeMemberModal">取消</view>
      <view class="modal-btn confirm-btn" bindtap="confirmMembers">确定选择 ({{totalMan}})</view>
    </view>
  </view>
</view>

<!-- 日期时间选择器 -->
<time-picker
  pickerShow="{{isPickerShow}}"
  id="picker"
  wx:if="{{isPickerRender}}"
  bind:hidePicker="pickerHide"
  bind:setPickerTime="setPickerTime"
  config="{{pickerConfig}}">
</time-picker>
