page { background: #fbfcf9; color: #072f27; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.detail-page { min-height: 100vh; padding: 0 0 185rpx; box-sizing: border-box; }
.detail-feedback { padding: 200rpx 40rpx 90rpx; }
.detail-feedback-title { display: block; font-size: 40rpx; font-weight: 800; }
.detail-feedback-copy { display: block; margin-top: 12rpx; color: #798a7e; font-size: 25rpx; }
.detail-feedback-action { display: inline-block; margin-top: 34rpx; color: #0b6645; font-size: 26rpx; font-weight: 750; }
.detail-hero { margin: 28rpx 40rpx 0; padding: 34rpx 32rpx 31rpx; border-radius: 25rpx; background: #103d30; color: #fff; }
.detail-hero-top { display: flex; align-items: flex-start; justify-content: space-between; }
.detail-eyebrow { max-width: 450rpx; color: #c4d8c6; font-size: 20rpx; font-weight: 750; letter-spacing: 2rpx; }
.detail-state { flex: none; padding: 7rpx 15rpx; border-radius: 22rpx; background: #d9ff3f; color: #103d30; font-size: 20rpx; font-weight: 750; }
.detail-state.is-ended { background: #dce7d9; color: #546959; }
.detail-title { display: block; margin-top: 26rpx; font-size: 55rpx; line-height: 1.22; font-weight: 800; word-break: break-all; }
.detail-title-line { width: 145rpx; height: 6rpx; margin-top: 19rpx; border-radius: 8rpx; background: #d9ff3f; }
.detail-hero-meta { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 28rpx; color: #c4d8c6; font-size: 22rpx; }
.detail-hero-meta text { margin: 5rpx 20rpx 5rpx 0; }
.detail-join-state { display: flex; align-items: center; flex-wrap: wrap; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #406959; color: #e4f1e5; font-size: 23rpx; }
.detail-join-state image { width: 47rpx; height: 47rpx; margin-right: 12rpx; border-radius: 50%; }
.detail-view-mine { margin-left: auto; color: #d9ff3f; font-size: 22rpx; font-weight: 700; }
.detail-cover { position: relative; height: 520rpx; background: #103d30; overflow: hidden; }
.detail-cover image { width: 100%; height: 100%; }
.detail-cover-fallback { height: 100%; display: flex; align-items: center; justify-content: center; color: #d9ff3f; font-size: 25rpx; letter-spacing: 3rpx; }
.detail-cover-state { position: absolute; right: 40rpx; bottom: 28rpx; padding: 10rpx 22rpx; border-radius: 30rpx; background: #d9ff3f; color: #103d30; font-size: 22rpx; font-weight: 750; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12); }
.detail-cover-state.is-ended { background: #dce7d9; color: #546959; }
.detail-section { margin: 0 40rpx; padding: 38rpx 2rpx; border-bottom: 1rpx solid #e1e9e3; }
.detail-section-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 22rpx; }
.detail-section-head text:first-child { font-size: 33rpx; font-weight: 800; }
.detail-section-note { color: #75887b; font-size: 21rpx; font-weight: 500; }
.detail-section-link text:last-child { color: #0b6748; font-size: 22rpx; font-weight: 750; }
.detail-progress-number { display: flex; align-items: baseline; flex-wrap: wrap; }
.detail-progress-current { font-size: 69rpx; line-height: 1.1; font-weight: 800; }
.detail-progress-target { margin-left: 12rpx; color: #677e6d; font-size: 25rpx; }
.detail-progress-track { height: 13rpx; margin-top: 25rpx; overflow: hidden; border-radius: 12rpx; background: #e1eae0; }
.detail-progress-fill { height: 100%; border-radius: 12rpx; background: #b4df24; }
.detail-progress-foot { display: flex; justify-content: space-between; margin-top: 15rpx; color: #678072; font-size: 22rpx; }
.detail-goal-number { display: flex; align-items: baseline; }
.detail-goal-number text:first-child { font-size: 76rpx; line-height: 1.15; font-weight: 800; }
.detail-goal-unit { margin-left: 10rpx; color: #60786b; font-size: 25rpx; }
.detail-goal-edit { display: inline-block; margin-top: 21rpx; padding: 15rpx 23rpx; border-radius: 30rpx; background: #e9f3d3; color: #235b33; font-size: 23rpx; font-weight: 750; }
.detail-muted { color: #798a7d; font-size: 23rpx; line-height: 1.6; }
.detail-result { display: flex; flex-direction: column; margin: 22rpx 40rpx 0; padding: 25rpx 30rpx; border-radius: 20rpx; background: #e8eee7; }
.detail-result text:first-child { font-size: 29rpx; font-weight: 800; }
.detail-result text:last-child { margin-top: 8rpx; color: #5e7463; font-size: 23rpx; }
.detail-result-success { background: #eaf7cb; }
.detail-time-row { display: flex; justify-content: space-between; padding: 15rpx 0; font-size: 24rpx; }
.detail-time-row text:first-child { color: #7a8b80; }
.detail-time-row text:last-child { font-weight: 650; }
.detail-reward { display: flex; align-items: baseline; color: #0c6b42; }
.detail-reward text:first-child { font-size: 58rpx; font-weight: 800; }
.detail-reward text:last-child { margin-left: 12rpx; font-size: 25rpx; font-weight: 700; }
.detail-rules { color: #466658; font-size: 25rpx; line-height: 1.7; }
.detail-people-summary { color: #4b6b58; font-size: 25rpx; }
.detail-avatars { display: flex; margin-top: 20rpx; }
.detail-avatar { display: flex; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; margin-right: -10rpx; overflow: hidden; border: 3rpx solid #fbfcf9; border-radius: 50%; background: #e0eadf; color: #65816b; font-size: 24rpx; }
.detail-avatar image { width: 100%; height: 100%; }
.detail-inline-action { color: #0b6748; font-weight: 750; }
.detail-lottery-list { display: flex; flex-direction: column; }
.detail-lottery-item { display: flex; align-items: center; padding: 13rpx 0; border-top: 1rpx solid #e7eee8; }
.detail-lottery-item image, .detail-lottery-placeholder { width: 100rpx; height: 100rpx; flex: none; border-radius: 13rpx; background: #e6eee7; }
.detail-lottery-placeholder { display: flex; align-items: center; justify-content: center; color: #7c8f80; font-size: 23rpx; }
.detail-lottery-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; margin-left: 17rpx; font-size: 25rpx; font-weight: 700; }
.detail-lottery-copy text:last-child { margin-top: 6rpx; color: #7a8b7f; font-size: 21rpx; font-weight: 400; }
.detail-lottery-arrow { color: #0b6748; font-size: 27rpx; }
.detail-action { position: fixed; z-index: 5; left: 0; right: 0; bottom: 0; padding: 18rpx 40rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e0e9e1; background: #fbfcf9; }
.detail-action button { width: 100%; height: 94rpx; line-height: 94rpx; margin: 0; border-radius: 48rpx; background: #d9ff3f; color: #092f24; font-size: 30rpx; font-weight: 800; box-sizing: border-box; }
.detail-action button::after { border: none; }
.modal-mask { position: fixed; z-index: 8; inset: 0; background: rgba(5, 33, 22, .45); }
.detail-modal { position: fixed; z-index: 9; left: 40rpx; right: 40rpx; top: 50%; padding: 34rpx; border-radius: 24rpx; background: #fff; transform: translateY(-50%); }
.detail-modal-title { display: block; font-size: 34rpx; font-weight: 800; }
.detail-modal-hint { display: block; margin-top: 11rpx; color: #728376; font-size: 23rpx; }
.detail-modal-input { height: 92rpx; margin-top: 29rpx; padding: 0 20rpx; border: 1rpx solid #cfddcf; border-radius: 13rpx; font-size: 29rpx; box-sizing: border-box; }
.detail-modal-actions { display: flex; margin-top: 28rpx; }
.detail-modal-actions button { width: 48%; margin: 0; border-radius: 40rpx; font-size: 26rpx; }
.detail-modal-actions button:first-child { background: #e9eee8; color: #45624e; }
.detail-modal-actions button:last-child { margin-left: auto; background: #d9ff3f; color: #092f24; font-weight: 750; }
.detail-modal-actions button::after { border: none; }
