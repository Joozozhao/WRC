page { background: #fbfcf9; color: #072f27; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.detail-page { min-height: 100vh; padding: 0 0 195rpx; box-sizing: border-box; }
.detail-feedback { padding: 200rpx 40rpx 90rpx; }
.detail-feedback-title { display: block; font-size: 40rpx; font-weight: 800; }
.detail-feedback-copy { display: block; margin-top: 12rpx; color: #798a7e; font-size: 25rpx; }
.detail-feedback-action { display: inline-block; margin-top: 34rpx; color: #0b6645; font-size: 26rpx; font-weight: 750; }

/* 封面与状态徽标 */
.detail-cover { position: relative; height: 520rpx; background: #103d30; overflow: hidden; }
.detail-cover image { width: 100%; height: 100%; }
.detail-cover-fallback { height: 100%; display: flex; align-items: center; justify-content: center; color: #d9ff3f; font-size: 25rpx; letter-spacing: 3rpx; }
.detail-cover-state { position: absolute; right: 40rpx; bottom: 28rpx; padding: 10rpx 24rpx; border-radius: 30rpx; background: #d9ff3f; color: #103d30; font-size: 22rpx; font-weight: 800; box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.16); }
.detail-cover-state.is-ended { background: #dce7d9; color: #546959; }

/* 挑战深绿 Hero 主卡 */
.detail-hero { margin: 28rpx 40rpx 0; padding: 38rpx 36rpx 34rpx; border-radius: 28rpx; background: #103d30; color: #fff; box-shadow: 0 8rpx 24rpx rgba(16, 61, 48, 0.12); }
.detail-hero-top { display: flex; align-items: flex-start; justify-content: space-between; }
.detail-eyebrow { max-width: 450rpx; color: #c4d8c6; font-size: 20rpx; font-weight: 750; letter-spacing: 2rpx; }
.detail-title { display: block; margin-top: 22rpx; font-size: 52rpx; line-height: 1.25; font-weight: 850; letter-spacing: -1rpx; word-break: break-all; }
.detail-title-line { width: 140rpx; height: 6rpx; margin-top: 20rpx; border-radius: 8rpx; background: #d9ff3f; }
.detail-hero-meta { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 28rpx; color: #c4d8c6; font-size: 23rpx; }
.detail-hero-meta text { margin: 4rpx 16rpx 4rpx 0; }
.detail-join-state { display: flex; align-items: center; flex-wrap: wrap; margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.18); color: #e4f1e5; font-size: 23rpx; }
.detail-join-state image { width: 48rpx; height: 48rpx; margin-right: 14rpx; border-radius: 50%; border: 2rpx solid #d9ff3f; }
.detail-view-mine { margin-left: auto; color: #d9ff3f; font-size: 22rpx; font-weight: 750; }

/* 内容 Section 统一规范 */
.detail-section { margin: 0 40rpx; padding: 38rpx 0; border-bottom: 1rpx solid #e3ebe4; }
.detail-section-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 22rpx; }
.detail-section-head text:first-child { font-size: 34rpx; font-weight: 800; color: #072f27; letter-spacing: -0.5rpx; }
.detail-section-note { color: #84968a; font-size: 20rpx; font-weight: 700; letter-spacing: 1rpx; }

/* 进度数据展示 */
.detail-progress-number { display: flex; align-items: baseline; flex-wrap: wrap; }
.detail-progress-current { font-size: 72rpx; line-height: 1.1; font-weight: 850; color: #072f27; }
.detail-progress-target { margin-left: 14rpx; color: #627969; font-size: 26rpx; font-weight: 600; }
.detail-progress-track { height: 16rpx; margin-top: 24rpx; overflow: hidden; border-radius: 12rpx; background: #e5ece4; }
.detail-progress-fill { height: 100%; border-radius: 12rpx; background: linear-gradient(90deg, #98d820 0%, #b8e628 100%); }
.detail-progress-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 18rpx; color: #698273; font-size: 23rpx; }
.detail-progress-stat { display: flex; align-items: center; gap: 6rpx; }
.detail-stat-highlight { color: #0b6748; font-weight: 800; }

/* 未报名时的目标设置展示 */
.detail-goal-number { display: flex; align-items: baseline; }
.detail-goal-number text:first-child { font-size: 76rpx; line-height: 1.15; font-weight: 850; color: #072f27; }
.detail-goal-unit { margin-left: 12rpx; color: #60786b; font-size: 26rpx; font-weight: 600; }
.detail-goal-edit { display: inline-block; margin-top: 24rpx; padding: 14rpx 28rpx; border-radius: 30rpx; background: #e9f3d3; color: #1e5c33; font-size: 23rpx; font-weight: 750; border: 1rpx solid #d4e7b8; }
.detail-muted { color: #829387; font-size: 23rpx; line-height: 1.6; }

/* 达成 / 结束状态条 */
.detail-result { display: flex; flex-direction: column; margin: 24rpx 40rpx 0; padding: 26rpx 32rpx; border-radius: 20rpx; background: #edf2eb; border: 1rpx solid #dfe7de; }
.detail-result text:first-child { font-size: 29rpx; font-weight: 800; color: #0a3328; }
.detail-result text:last-child { margin-top: 8rpx; color: #5a7060; font-size: 23rpx; }
.detail-result-success { background: #eaf7cb; border-color: #d6eda0; }
.detail-result-success text:first-child { color: #18522e; }

/* 挑战时间卡片 */
.detail-time-card { background: #ffffff; border: 1rpx solid #e3ede4; border-radius: 20rpx; padding: 14rpx 26rpx; box-shadow: 0 4rpx 14rpx rgba(7, 47, 39, 0.02); }
.detail-time-row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; font-size: 24rpx; }
.detail-time-row + .detail-time-row { border-top: 1rpx solid #f0f5ee; }
.detail-time-label { color: #7f9185; font-size: 23rpx; }
.detail-time-val { font-weight: 750; color: #0d3b2e; font-variant-numeric: tabular-nums; }

/* 额外奖励卡片 */
.detail-reward-card { display: flex; align-items: center; justify-content: space-between; background: #f2f8ee; border: 1rpx solid #dcebda; border-radius: 20rpx; padding: 22rpx 28rpx; }
.detail-reward-badge { display: flex; align-items: baseline; }
.detail-reward-num { font-size: 56rpx; font-weight: 850; color: #0c6b42; line-height: 1; }
.detail-reward-unit { margin-left: 10rpx; font-size: 25rpx; font-weight: 750; color: #0c6b42; }
.detail-reward-tip { font-size: 21rpx; color: #6d8474; }

/* 挑战规则卡片 */
.detail-rules-card { background: #ffffff; border: 1rpx solid #e5ede6; border-radius: 20rpx; padding: 24rpx 28rpx; box-shadow: 0 4rpx 14rpx rgba(7, 47, 39, 0.02); }
.detail-rules { color: #375748; font-size: 25rpx; line-height: 1.7; word-break: break-all; }
.detail-rules-empty { padding: 12rpx 0; }

/* 关联抽奖（仅在有抽奖数据时渲染） */
.detail-lottery-section { border-bottom: 1rpx solid #e3ebe4; }
.detail-lottery-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 4rpx; }
.detail-lottery-item { display: flex; align-items: center; padding: 20rpx 24rpx; border-radius: 20rpx; background: #ffffff; border: 1rpx solid #e3eee4; box-shadow: 0 4rpx 14rpx rgba(7, 47, 39, 0.03); }
.detail-lottery-item image, .detail-lottery-placeholder { width: 96rpx; height: 96rpx; flex: none; border-radius: 14rpx; background: #e6eee7; border: 1rpx solid #dae5db; }
.detail-lottery-placeholder { display: flex; align-items: center; justify-content: center; color: #7c8f80; font-size: 22rpx; font-weight: 700; }
.detail-lottery-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; margin-left: 20rpx; }
.detail-lottery-name { font-size: 26rpx; font-weight: 750; color: #093427; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.detail-lottery-count { margin-top: 8rpx; color: #6e8274; font-size: 21rpx; font-weight: 400; }
.detail-lottery-arrow { color: #0b6748; font-size: 28rpx; font-weight: 750; margin-left: 12rpx; }

/* 参赛跑友模块（最底部，原 actyin 数据整合） */
.detail-members-section {
  border-bottom: none;
  padding-bottom: 40rpx;
}

.filter-sort-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0 24rpx;
  gap: 16rpx;
}

.level-tabs {
  display: flex;
  gap: 12rpx;
  flex: 1;
}

.level-tab {
  padding: 8rpx 18rpx;
  background: #ffffff;
  border: 1rpx solid #dfe7df;
  border-radius: 999rpx;
  color: #4b6656;
  font-size: 22rpx;
  font-weight: 600;
  transition: all 0.15s ease;
}

.level-tab.active {
  background: #d9ff3f;
  border-color: #bcd930;
  color: #123d2f;
  font-weight: 800;
}

.sort-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #f1f6ed;
  border: 1rpx solid #dbe6d7;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  flex: none;
}

.sort-text {
  font-size: 21rpx;
  color: #27523f;
  font-weight: 700;
}

.sort-arrow {
  font-size: 22rpx;
  color: #0c6246;
  font-weight: 800;
}

.btn-hover {
  opacity: 0.7;
}

/* 跑友卡片列表 */
.member-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #e3ebe4;
  border-radius: 20rpx;
  padding: 18rpx 18rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 14rpx rgba(7, 47, 39, 0.02);
  transition: background 0.15s ease;
}

.card-hover {
  background: #f8faf6;
}

.rank-index {
  width: 44rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #92a297;
  font-variant-numeric: tabular-nums;
  flex: none;
  text-align: center;
}

.rank-index.top {
  color: #0c6246;
  font-weight: 850;
  font-size: 26rpx;
}

.member-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  border: 2rpx solid #e5eee4;
  background: #e9f0e8;
  flex: none;
  margin-left: 6rpx;
}

.member-info {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  padding-right: 10rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.member-name {
  font-size: 27rpx;
  font-weight: 800;
  color: #083427;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 170rpx;
}

.level-badge {
  font-size: 17rpx;
  font-weight: 800;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  line-height: 1.2;
  flex: none;
}

.level-badge.vip {
  background: #fdf3d6;
  color: #a46d0a;
  border: 1rpx solid #f2db9d;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 6rpx;
}


.member-id {
  font-size: 19rpx;
  color: #8fa094;
}

.member-status-tag {
  background: #eef7eb;
  color: #0b6338;
  font-size: 17rpx;
  font-weight: 700;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

/* 进度与距离 */
.progress-col {
  width: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex: none;
}

.distance-numbers {
  display: flex;
  align-items: baseline;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}

.dist-finish {
  font-size: 26rpx;
  font-weight: 800;
  color: #073a2c;
}

.dist-sep {
  font-size: 20rpx;
  color: #a4b2a8;
  margin: 0 4rpx;
}

.dist-target {
  font-size: 20rpx;
  color: #7d8e82;
}

.dist-unit {
  font-size: 15rpx;
  font-weight: 700;
  color: #92a297;
  margin-left: 4rpx;
}

.progress-track {
  width: 100%;
  height: 10rpx;
  background: #ebf1ea;
  border-radius: 8rpx;
  margin-top: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #0c6246;
  border-radius: inherit;
  transition: width 0.3s ease;
}

.progress-fill.completed {
  background: #50cf64;
}

.percent-label {
  font-size: 18rpx;
  color: #8fa094;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.member-empty-block {
  text-align: center;
  padding: 60rpx 0;
}

.member-empty-title {
  display: block;
  font-size: 27rpx;
  font-weight: 750;
  color: #4b6656;
}

.member-empty-desc {
  display: block;
  font-size: 22rpx;
  color: #8fa094;
  margin-top: 8rpx;
}

.member-loading-block {
  text-align: center;
  padding: 50rpx 0;
}

.member-loading-text {
  font-size: 23rpx;
  color: #8fa094;
}

.detail-inline-action { color: #0b6748; font-weight: 750; }

/* 底部操作固定栏 */
.detail-action { position: fixed; z-index: 5; left: 0; right: 0; bottom: 0; padding: 18rpx 40rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e0e9e1; background: #fbfcf9; }
.detail-action button { width: 100%; height: 94rpx; line-height: 94rpx; margin: 0; border-radius: 48rpx; background: #d9ff3f; color: #092f24; font-size: 30rpx; font-weight: 850; box-sizing: border-box; box-shadow: 0 8rpx 24rpx rgba(180, 223, 36, 0.28); }
.detail-action button::after { border: none; }

/* 目标弹窗 */
.modal-mask { position: fixed; z-index: 8; inset: 0; background: rgba(5, 33, 22, .45); }
.detail-modal { position: fixed; z-index: 9; left: 40rpx; right: 40rpx; top: 50%; padding: 36rpx; border-radius: 28rpx; background: #fff; transform: translateY(-50%); box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.18); }
.detail-modal-title { display: block; font-size: 34rpx; font-weight: 800; color: #072f27; }
.detail-modal-hint { display: block; margin-top: 12rpx; color: #728376; font-size: 23rpx; }
.detail-modal-input { height: 92rpx; margin-top: 28rpx; padding: 0 24rpx; border: 1.5rpx solid #cfddcf; border-radius: 16rpx; font-size: 30rpx; color: #072f27; box-sizing: border-box; }
.detail-modal-actions { display: flex; margin-top: 32rpx; }
.detail-modal-actions button { width: 48%; margin: 0; border-radius: 40rpx; font-size: 26rpx; font-weight: 750; }
.detail-modal-actions button:first-child { background: #eef2ec; color: #45624e; }
.detail-modal-actions button:last-child { margin-left: auto; background: #d9ff3f; color: #092f24; }
.detail-modal-actions button::after { border: none; }
