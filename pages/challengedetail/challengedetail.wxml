<!-- pages/challengedetail/challengedetail.wxml -->
<site-header show-back="{{true}}" back-url="/pages/challenge/challenge" bindprofiletap="openMyPage"></site-header>
<view class="detail-page">
  <view class="detail-feedback" wx:if="{{detailLoading}}">
    <text class="detail-feedback-title">正在加载挑战</text>
    <text class="detail-feedback-copy">请稍候…</text>
  </view>
  <view class="detail-feedback" wx:elif="{{detailError}}">
    <text class="detail-feedback-title">挑战暂时无法显示</text>
    <text class="detail-feedback-copy">{{detailError}}</text>
    <text class="detail-feedback-action" bindtap="retryLoad" wx:if="{{actyId}}">重新加载 →</text>
  </view>

  <view wx:elif="{{detailLoaded}}">
    <view class="detail-cover">
      <image wx:if="{{actyImg}}" src="{{actyImg}}" mode="aspectFill"></image>
      <view class="detail-cover-fallback" wx:else>WRC · CHALLENGE YOURSELF</view>
      <text class="detail-cover-state {{isEnded ? 'is-ended' : ''}}">{{statusText}}</text>
    </view>

    <view class="detail-hero">
      <view class="detail-hero-top">
        <text class="detail-eyebrow">WRC · CHALLENGE YOURSELF</text>
      </view>
      <text class="detail-title">{{actyName || '未命名挑战'}}</text>
      <view class="detail-title-line"></view>
      <view class="detail-hero-meta">
        <text wx:if="{{daysText}}">距离结束还有 {{daysText}} 天</text>
        <text wx:elif="{{isEnded && endTime}}">结束于 {{endTime}}</text>
        <text wx:else>挑战时间见下方</text>
        <text>{{participantCountText}} 人参与</text>
      </view>
      <view class="detail-join-state">
        <image wx:if="{{viewingOther && header_url}}" src="{{header_url}}" mode="aspectFill"></image>
        <text wx:if="{{hasClickon == 1}}">{{viewingOther ? 'TA已参加挑战' : '你已参加挑战'}}</text>
        <text wx:elif="{{hasClickon == 0}}">{{viewingOther ? 'TA尚未参加' : userId > 0 ? '尚未参加挑战' : '登录后可参与挑战'}}</text>
        <text wx:else>参与状态暂不可用</text>
        <text class="detail-view-mine" wx:if="{{viewingOther}}" bindtap="viewMine">查看我的挑战 →</text>
      </view>
    </view>

    <view class="detail-section" wx:if="{{acty_type != 'V挑战'}}">
      <view class="detail-section-head">
        <text>{{hasClickon == 1 ? (viewingOther ? 'TA的挑战进度' : '我的挑战进度') : '挑战目标'}}</text>
        <text class="detail-section-note">{{hasClickon == 1 ? '实时累计 · KM' : '目标里程 · KM'}}</text>
      </view>
      <view wx:if="{{hasClickon == 1}}">
        <view wx:if="{{progressAvailable}}">
          <view class="detail-progress-number">
            <text class="detail-progress-current">{{hasDistance}}</text>
            <text class="detail-progress-target">/ {{target}} 公里</text>
          </view>
          <view class="detail-progress-track"><view class="detail-progress-fill" style="width: {{per}}%;"></view></view>
          <view class="detail-progress-foot">
            <text class="detail-progress-stat">已完成 <text class="detail-stat-highlight">{{per}}%</text></text>
            <text class="detail-progress-stat">{{finalDis > 0 ? '还差 ' + finalDis + ' 公里' : '已达到目标'}}</text>
          </view>
        </view>
        <view class="detail-muted" wx:else>进度数据暂不可用，请稍后再查看。</view>
      </view>
      <view wx:else>
        <view class="detail-goal-number">
          <text>{{distance !== null ? distance : '—'}}</text>
          <text class="detail-goal-unit">公里</text>
        </view>
        <view class="detail-muted" wx:if="{{minimumDistance !== null}}">最低挑战公里数 {{minimumDistance}} 公里</view>
        <view class="detail-muted" wx:else>挑战目标暂未提供</view>
        <view class="detail-goal-edit" bindtap="changeIpt" wx:if="{{canEditGoal}}">挑战更高目标 →</view>
      </view>
    </view>

    <view class="detail-result detail-result-success" wx:if="{{isSuccess}}">
      <text>目标达成</text>
      <text>恭喜{{viewingOther ? 'TA' : '你'}}，挑战成功！</text>
    </view>
    <view class="detail-result" wx:elif="{{isFailure}}">
      <text>本次挑战已结束</text>
      <text>距离目标还差 {{finalDis}} 公里</text>
    </view>

    <view class="detail-section">
      <view class="detail-section-head">
        <text>挑战时间</text>
        <text class="detail-section-note">SCHEDULE</text>
      </view>
      <view class="detail-time-card">
        <view class="detail-time-row">
          <text class="detail-time-label">开始时间</text>
          <text class="detail-time-val">{{startTime || '暂未提供'}}</text>
        </view>
        <view class="detail-time-row">
          <text class="detail-time-label">结束时间</text>
          <text class="detail-time-val">{{endTime || '暂未提供'}}</text>
        </view>
      </view>
    </view>

    <view class="detail-section" wx:if="{{score !== null}}">
      <view class="detail-section-head">
        <text>完成挑战额外奖励</text>
        <text class="detail-section-note">REWARD</text>
      </view>
      <view class="detail-reward-card">
        <view class="detail-reward-badge">
          <text class="detail-reward-num">{{score}}</text>
          <text class="detail-reward-unit">{{rewardUnit}}</text>
        </view>
        <text class="detail-reward-tip">达成挑战目标后自动发放</text>
      </view>
    </view>

    <view class="detail-section">
      <view class="detail-section-head">
        <text>挑战规则</text>
        <text class="detail-section-note">RULES</text>
      </view>
      <view class="detail-rules-card" wx:if="{{remark}}">
        <rich-text class="detail-rules" nodes="{{remark}}"></rich-text>
      </view>
      <view class="detail-muted detail-rules-empty" wx:else>暂无挑战规则说明</view>
    </view>

    <!-- 关联抽奖模块：仅当有抽奖时显示，无关联抽奖则整块隐藏 -->
    <view class="detail-section detail-lottery-section" wx:if="{{ltyList && ltyList.length > 0}}">
      <view class="detail-section-head">
        <text>关联抽奖</text>
        <text class="detail-section-note">福利 · LOTTERY</text>
      </view>
      <view class="detail-lottery-list">
        <view class="detail-lottery-item" wx:for="{{ltyList}}" wx:key="id" data-id="{{item.id}}" bindtap="toLty">
          <image wx:if="{{item.goods_pic}}" src="{{item.goods_pic}}" mode="aspectFill"></image>
          <view class="detail-lottery-placeholder" wx:else>奖品</view>
          <view class="detail-lottery-copy">
            <text class="detail-lottery-name">{{item.address || '查看抽奖详情'}}</text>
            <text class="detail-lottery-count" wx:if="{{item.goods_num !== undefined && item.goods_num !== null}}">奖品数量 {{item.goods_num}} 件</text>
          </view>
          <text class="detail-lottery-arrow">→</text>
        </view>
      </view>
    </view>

    <!-- 底部：参赛跑友模块（原 actyin 数据直接整合显示在此处） -->
    <view class="detail-section detail-members-section">
      <view class="detail-section-head">
        <text>报名跑友</text>
        <text class="detail-section-note">SQUAD · {{totalMemberCount}}人</text>
      </view>

      <!-- 等级筛选与跑量排序栏 -->
      <view class="filter-sort-bar">
        <view class="level-tabs">
          <view
            wx:for="{{levelList}}"
            wx:key="value"
            class="level-tab {{activeLevelIndex === index ? 'active' : ''}}"
            data-index="{{index}}"
            bindtap="chooseLevel">
            {{item.label}}
          </view>
        </view>
        <view class="sort-btn" bindtap="toggleSort" hover-class="btn-hover">
          <text class="sort-text">跑量</text>
          <text class="sort-arrow">{{sortOrder === 1 ? '↓' : '↑'}}</text>
        </view>
      </view>

      <!-- 跑友列表卡片 -->
      <view class="member-list" wx:if="{{memberList.length > 0}}">
        <block wx:for="{{memberList}}" wx:key="id">
          <view class="member-card" data-userid="{{item.id}}" bindtap="toUserDetail" hover-class="card-hover">
            <view class="rank-index {{item.rankNum <= 3 ? 'top' : ''}}">
              <text wx:if="{{item.rankNum < 10}}">0{{item.rankNum}}</text>
              <text wx:else>{{item.rankNum}}</text>
            </view>

            <!-- 头像 -->
            <image class="member-avatar" src="{{item.header_url || '/images/default.png'}}" mode="aspectFill"></image>

            <!-- 跑友信息 -->
            <view class="member-info">
              <view class="name-row">
                <text class="member-name">{{item.user_name || item.nick_name || '跑友'}}</text>
                <text class="level-badge vip" wx:if="{{item.levelLabel}}">{{item.levelLabel}}</text>
              </view>
              <view class="meta-row">
                <text class="profile-badge profile-gender-badge" wx:if="{{item.genderLabel}}">{{item.genderLabel}}</text>
                <view wx:if="{{item.regionLabel}}" class="profile-badge profile-region-badge"><image class="profile-region-icon" src="/images/place.png" mode="aspectFit"></image><text>{{item.regionLabel}}</text></view>
                <text class="member-id">ID {{item.id}}</text>
                <text class="member-status-tag" wx:if="{{item.isCompleted}}">已达标</text>
              </view>
            </view>

            <!-- 进度与距离 -->
            <view class="progress-col">
              <view class="distance-numbers">
                <text class="dist-finish">{{item.displayFinish}}</text>
                <text class="dist-sep">/</text>
                <text class="dist-target">{{item.displayTarget}}</text>
                <text class="dist-unit">KM</text>
              </view>
              <view class="progress-track">
                <view
                  class="progress-fill {{item.isCompleted ? 'completed' : ''}}"
                  style="width: {{item.percent}}%;">
                </view>
              </view>
              <view class="percent-label">{{item.percent}}%</view>
            </view>
          </view>
        </block>
      </view>

      <!-- 空状态 -->
      <view class="member-empty-block" wx:elif="{{!participantsLoading && memberList.length === 0}}">
        <text class="member-empty-title">暂无符合条件的报名成员</text>
        <text class="member-empty-desc">可尝试切换筛选条件或稍后再看</text>
      </view>

      <!-- 加载中 -->
      <view class="member-loading-block" wx:elif="{{participantsLoading}}">
        <text class="member-loading-text">正在加载报名跑友…</text>
      </view>
      <view class="detail-muted" wx:elif="{{participantsError}}">
        跑友信息暂时无法加载 <text class="detail-inline-action" bindtap="loadParticipants">重试 →</text>
      </view>
    </view>
  </view>
</view>

<view class="detail-action" wx:if="{{detailLoaded && canJoin && !changeModal}}">
  <button bindtap="actyIn">{{userId > 0 ? '参与挑战' : '登录后参与挑战'}} <text>→</text></button>
</view>

<view class="modal-mask" wx:if="{{changeModal}}" bindtap="onCancel"></view>
<view class="detail-modal" wx:if="{{changeModal}}">
  <form bindsubmit="onConfirm">
    <text class="detail-modal-title">设定挑战目标</text>
    <text class="detail-modal-hint">不能低于当前的 {{distance}} 公里</text>
    <input class="detail-modal-input" type="number" name="newDistance" value="{{distance}}" placeholder="输入整数公里数"></input>
    <view class="detail-modal-actions">
      <button bindtap="onCancel">取消</button>
      <button form-type="submit">确定</button>
    </view>
  </form>
</view>
