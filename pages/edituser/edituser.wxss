/* WRC Edit Profile: 头像与昵称视觉规范 */
page {
  background-color: #fbfcf9;
  color: #072f27;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.eu-page {
  min-height: 100vh;
  padding: 180rpx 36rpx calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.eu-header {
  margin-bottom: 40rpx;
}

.eyebrow {
  display: block;
  color: #0d6447;
  font-size: 22rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}

.page-title {
  display: block;
  margin-top: 20rpx;
  color: #072f27;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -2rpx;
}

.title-line {
  width: 140rpx;
  height: 6rpx;
  margin-top: 18rpx;
  border-radius: 8rpx;
  background: #d9ff3f;
}

.page-subtitle {
  display: block;
  color: #78897e;
  font-size: 24rpx;
  margin-top: 18rpx;
  line-height: 1.4;
}

.eu-avatar-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 44rpx;
}

.avatar-wrapper {
  padding: 0;
  width: 160rpx !important;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #e9f0e8;
  border: 4rpx solid #d9ff3f;
  box-sizing: border-box;
}

.avatar-wrapper::after {
  border: none;
}

.avatar {
  display: block;
  width: 100%;
  height: 100%;
}

.avatar-hover {
  opacity: 0.85;
}

.eu-avatar-hint {
  margin-top: 18rpx;
  color: #78897e;
  font-size: 22rpx;
}

.eu-card {
  background: #ffffff;
  border: 1rpx solid #e3ebe4;
  border-radius: 24rpx;
  padding: 6rpx 28rpx;
  box-shadow: 0 4rpx 14rpx rgba(7, 47, 39, 0.02);
}

.eu-row {
  display: flex;
  align-items: center;
  min-height: 110rpx;
  padding: 18rpx 0;
  box-sizing: border-box;
}

.eu-label {
  flex: none;
  width: 140rpx;
  color: #072f27;
  font-size: 29rpx;
  font-weight: 650;
}

.eu-input {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  color: #072f27;
  font-size: 30rpx;
}

.eu-ph {
  color: #a9b6ad;
  font-size: 26rpx;
}

/* 底部操作栏（含安全区） */
.eu-action {
  position: fixed;
  z-index: 5;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 40rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fbfcf9;
  border-top: 1rpx solid #e0e9e1;
}

.eu-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: #d9ff3f;
  color: #092f24;
  font-size: 32rpx;
  font-weight: 800;
  text-align: center;
}

.eu-btn::after {
  border: none;
}

.eu-btn-hover {
  background: #c8f22e;
  color: #092f24;
}
