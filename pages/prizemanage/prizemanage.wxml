<site-header show-back="{{true}}" back-url="/pages/manage/manage"></site-header>
<!--pages/prizemanage/prizemanage.wxml-->
<view class="pm-page">
  <view class="pm-hero">
    <text class="pm-eyebrow">WRC · STOCK</text>
    <text class="pm-title">奖品管理</text>
    <view class="pm-title-line"></view>
    <text class="pm-intro">管理奖品库存、规格与分配</text>
  </view>

  <view class="pm-list" wx:if="{{prizeList.length}}">
    <view class="pm-card" wx:for="{{prizeList}}" wx:key="index" wx:for-item="item">
      <view class="pm-main">
        <view class="pm-cover" data-id="{{item.id}}" bindtap="toDetail">
          <image src="{{item.goods_pic}}" mode="aspectFill"></image>
        </view>
        <view class="pm-info" data-id="{{item.id}}" bindtap="toDetail">
          <view class="pm-name">{{item.goods_name}}</view>
          <view class="pm-badges">
            <text class="pm-badge" wx:if="{{item.energy>0}}">{{item.energy}}小花儿</text>
            <text class="pm-badge" wx:if="{{item.score>0}}">{{item.score}}积分</text>
          </view>
          <view class="pm-specs" wx:for="{{item.goodsStorageMap}}" wx:for-item="items" wx:for-index="childindex" wx:key="index">
            <view class="pm-spec-name">{{childindex}}</view>
            <view class="pm-spec-detail">
              <view class="pm-spec-item" wx:for="{{items}}" wx:for-index="childindex2" wx:key="index">
                <view>{{item.tag_desc}} 库存{{item.stock}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="pm-ops">
        <text class="pm-op is-accent" data-id="{{item.id}}" data-type="{{item.goods_type}}" data-total="{{item.total}}" data-score="{{item.score}}" data-energy="{{item.energy}}" bindtap="payGood">分配</text>
        <text class="pm-op" data-id="{{item.id}}" bindtap="editGood">编辑</text>
        <text class="pm-op is-solid" wx:if="{{item.state==1}}" data-index="{{index}}" data-id="{{item.id}}" data-state="{{item.state}}" data-num="{{item.goodsStorageMap}}" bindtap="setState">上架</text>
        <text class="pm-op" wx:if="{{item.state==0}}" data-index="{{index}}" data-id="{{item.id}}" data-state="{{item.state}}" data-num="{{item.goodsStorageMap}}" bindtap="setState">下架</text>
        <text class="pm-op" data-id="{{item.id}}" bindtap="setType">规格</text>
        <text class="pm-op is-danger" data-index="{{index}}" data-id="{{item.id}}" bindtap="delPrize">删除</text>
      </view>
    </view>
  </view>
  <view class="pm-empty" wx:if="{{noHistory}}">暂无奖品</view>
</view>

<!-- 遮罩层 -->
<view class="pm-mask" wx:if="{{memberModal}}" bindtap="closeIt"></view>
<!-- 弹出框 -->
<view class="pm-modal" wx:if="{{memberModal}}">
  <form bindsubmit="onConfirm">
    <view class="pm-modal-body">
      <view class="pm-modal-title">分配奖品</view>
      <block wx:if="{{allType}}">
        <view class="pm-spec-group" wx:for="{{allType}}" wx:key="index">
          <view class="pm-spec-tag">{{item.tagName}}</view>
          <view class="pm-chip-row">
            <view class="pm-chip {{typeId==items.id ? 'is-active' : ''}}" wx:for="{{item.goodsStorageList}}" wx:for-item="items" wx:for-index="childindex" wx:key="index" wx:if="{{items.tag_desc}}" data-id="{{items.id}}" bindtap="chooseOne">{{items.tag_desc}}</view>
          </view>
        </view>
      </block>
      <view class="pm-modal-empty" wx:else>暂无规格</view>

      <view class="pm-modal-label">用户姓名</view>
      <view class="pm-search">
        <input type="text" value="{{username}}" name="username" placeholder="请输入用户姓名" placeholder-class="pm-ph" bindinput="search" class="pm-search-ipt"></input>
        <view class="pm-search-cancel" bindtap="hideInput">取消</view>
      </view>
      <view class="pm-search-drop {{add?'is-tall':''}}">
        <scroll-view class="pm-search-list" wx:if='{{viewShowed}}' scroll-y>
          <view wx:for="{{nameList}}" wx:key="index" class="pm-search-item">
            <view class="pm-search-name" bindtap='name' data-name="{{item.name}}">{{item.name}}</view>
          </view>
        </scroll-view>
      </view>

      <view class="pm-modal-label">消耗方式</view>
      <radio-group name="stype" class="pm-radios">
        <label for="">
          <view class="pm-radio" bindtap="choose">
            <radio value="0" checked="{{stype === 0 ? 'true' : ''}}" color="#0b503b" />积分
          </view>
        </label>
        <label for="">
          <view class="pm-radio" bindtap="choose2">
            <radio value="1" checked="{{stype === 1 ? 'true' : ''}}" color="#0b503b" />小花儿
          </view>
        </label>
        <input type="digit" name="score" class="pm-score-ipt" wx:if="{{score>0}}" value="{{score}}" />
        <input type="digit" name="score" class="pm-score-ipt" wx:if="{{energy>0}}" value="{{energy}}" />
      </radio-group>
    </view>

    <!-- 操作按钮 -->
    <view class="pm-modal-foot">
      <button class="pm-foot-btn is-cancel" bindtap="onCancel" data-status="cancel">取消</button>
      <button class="pm-foot-btn is-confirm" form-type="submit">确定</button>
    </view>
  </form>
</view>

<view class="pm-footer">
  <button class="pm-submit" bindtap="uploadPri">上传奖品</button>
</view>
