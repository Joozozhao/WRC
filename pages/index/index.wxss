/* WRC 首页样式规范 - 精简优化版 */
page {
  background: #fbfcf9;
  color: #072f27;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.home-root {
  min-height: 100vh;
  padding-bottom: 200rpx;
  overflow: hidden;
  background: #fbfcf9;
  box-sizing: border-box;
}

.home-header {
  position: relative;
  padding-left: 44rpx;
  padding-right: 44rpx;
}

.home-brand {
  display: flex;
  align-items: center;
  height: 64rpx;
  white-space: nowrap;
}

.home-brand-mark {
  width: 86rpx;
  height: 52rpx;
  display: block;
}

.home-profile {
  width: 56rpx;
  height: 52rpx;
  margin-left: 18rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-profile image {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #e1e9e3;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  background: #e7ece8;
  display: block;
}

.home-hero {
  position: relative;
  padding: 60rpx 44rpx 0;
}

.home-watermark {
  position: absolute;
  right: -60rpx;
  top: 25rpx;
  width: 450rpx;
  height: 245rpx;
  opacity: .14;
  pointer-events: none;
}

.home-eyebrow {
  display: block;
  color: #0d6447;
  font-size: 22rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}

.home-hero-title {
  position: relative;
  margin-top: 28rpx;
  font-size: 90rpx;
  line-height: 1.16;
  font-weight: 800;
  letter-spacing: -3rpx;
  color: #062b23;
}

.home-hero-underline {
  position: relative;
  width: 200rpx;
  height: 7rpx;
  border-radius: 10rpx;
  background: #d9ff3f;
  transform: rotate(-1.5deg);
  margin-top: 4rpx;
}

.home-hero-intro {
  display: block;
  margin-top: 24rpx;
  color: #7a8980;
  font-size: 26rpx;
  line-height: 1.6;
}

.home-cta {
  width: auto;
  height: 150rpx;
  margin: 32rpx 44rpx 0;
  padding: 0 95rpx;
  border-radius: 80rpx;
  background: #d9ff3f;
  color: #062b23;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 1rpx;
  box-sizing: border-box;
  transition: transform 0.2s cubic-bezier(0.25, 0.8, 0.25, 1), background 0.2s ease;
}

.home-cta::after { border: none; }
.home-cta-pressed {
  background: #c6ed2e;
  transform: scale(0.98);
}
.home-cta-runner { width: 112rpx; height: 112rpx; flex: none; }
.home-cta-rule { width: 2rpx; height: 52rpx; background: #538046; margin: 0 26rpx; }
.home-cta-label { flex: 1; text-align: center; white-space: nowrap; font-weight: 900; }
.home-cta-arrow { width: 42rpx; height: 42rpx; margin-left: auto; flex: none; }

.home-section {
  margin: 54rpx 44rpx 0;
}

.home-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 54rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #073329;
}

.home-section-link {
  display: flex;
  align-items: center;
  color: #7d8984;
  font-size: 24rpx;
  font-weight: 300;
  transition: opacity 0.2s ease;
}
.home-section-link:active { opacity: 0.6; }
.home-section-link image {
  width: 28rpx;
  height: 28rpx;
  opacity: .55;
  margin-left: 4rpx;
  flex: none;
}

.home-month-card {
  margin-top: 40rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 24rpx 24rpx;
  border: 1rpx solid #e5ede7;
  box-shadow: 0 4rpx 16rpx rgba(7, 47, 39, 0.03);
  box-sizing: border-box;
}
.home-month-card.has-svip-avatars { margin-top: 15rpx; }

.home-svip-avatars {
  display: flex;
  align-items: center;
  width: auto;
  margin: 15rpx 44rpx 0;
  overflow: hidden;
  white-space: nowrap;
}
.home-svip-avatar {
  position: relative;
  z-index: 1;
  width: 45rpx;
  height: 45rpx;
  flex: 0 0 45rpx;
  box-sizing: content-box;
  border: 5rpx solid #f1f5f2;
  border-radius: 50%;
  margin-left: -15rpx;
  background: #f1f5f2;
}
.home-svip-avatar:first-child { margin-left: 0; }
.home-svip-avatar.heat-level-0 { border-color: #f1f5f2; }
.home-svip-avatar.heat-level-1 { border-color: #aae98f; }
.home-svip-avatar.heat-level-2 { border-color: #50cf64; }
.home-svip-avatar.heat-level-3 { border-color: #199c4f; }
.home-svip-avatar.heat-level-4 { border-color: #075b40; }

.home-month-title-left {
  display: flex;
  align-items: baseline;
}

.home-month-main-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #073329;
  letter-spacing: -0.5rpx;
}

.home-month-head-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #7d8984;
  font-size: 24rpx;
  font-weight: 300;
  padding: 4rpx 8rpx;
}

.home-calendar-entry {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 14rpx;
  border-radius: 20rpx;
  background: #edf5ee;
  cursor: pointer;
  box-sizing: border-box;
}
.home-calendar-entry:active {
  opacity: 0.75;
}
.home-calendar-entry-label {
  color: #0b503b;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 1;
}
.home-calendar-entry-arrow {
  width: 18rpx;
  height: 18rpx;
  transform: rotate(90deg);
  transition: transform 0.25s ease;
  opacity: 0.75;
  display: block;
}
.home-calendar-entry-arrow.is-expanded {
  transform: rotate(-90deg);
}

.home-month-sub {
  color: #7d8984;
  font-weight: 500;
  font-size: 22rpx;
}

.home-month-summary {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  min-height: 72rpx;
  margin-top: 14rpx;
  white-space: nowrap;
}

.home-month-distance {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.home-month-number {
  font-size: 64rpx;
  line-height: 1;
  font-weight: 850;
  letter-spacing: -3rpx;
  color: #0b503b;
  font-variant-numeric: tabular-nums;
}

.home-month-unit {
  margin-left: 12rpx;
  color: #7f8984;
  font-size: 24rpx;
  font-weight: 300;
}

.home-month-percent {
  flex: none;
  margin-left: 12rpx;
  color: #0b503b;
  font-size: 34rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.home-month-progress {
  width: 100%;
  height: 10rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #ebf0ec;
}

.home-month-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #0b503b, #1bb366);
  transition: width 0.3s ease;
}

.home-month-caption-wrap {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.home-month-caption {
  display: block;
  color: #7f8f85;
  font-size: 20rpx;
  font-weight: 300;
  line-height: 1.3;
  transition: color 0.2s ease;
}

.home-month-caption.is-error {
  color: #c94040;
  font-weight: 600;
}

.home-caption-retry-icon {
  width: 20rpx;
  height: 20rpx;
  margin-left: 6rpx;
  opacity: 0.7;
}

.home-metrics {
  display: flex;
  margin-top: 20rpx;
  padding: 0 0 4rpx;
}

.home-metric-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 8rpx;
  border-left: 1rpx solid #e5ede7;
  box-sizing: border-box;
}

.home-metric-item:first-child {
  border-left: 0;
}

.home-metric-number {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.15;
  color: #093b2e;
  white-space: nowrap;
  text-align: center;
  transition: color 0.3s ease;
}

.home-metric-label {
  margin-top: 6rpx;
  color: #89958e;
  font-size: 20rpx;
  font-weight: 300;
  white-space: nowrap;
  text-align: center;
}

.home-challenge { margin-top: 36rpx; padding-top: 0; border-top: none; }
.home-challenge-content {
  display: flex;
  align-items: center;
  min-height: 185rpx;
  margin-top: 18rpx;
  border-radius: 20rpx;
  padding: 10rpx;
  margin-left: -10rpx;
  margin-right: -10rpx;
  transition: background 0.2s ease, transform 0.15s ease;
}
.home-challenge-content:active {
  background: rgba(7, 47, 39, 0.03);
  transform: scale(0.99);
}

.home-challenge-ring {
  position: relative;
  width: 170rpx;
  height: 170rpx;
  margin-right: 20rpx;
  flex: none;
  border-radius: 50%;
}
.home-challenge-ring-art { position: absolute; top: 0; left: 0; width: 170rpx; height: 170rpx; }
.home-challenge-ring-inner {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  bottom: 14rpx;
  left: 14rpx;
  border-radius: 50%;
  background: #fbfcf9;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #073b2d;
  font-size: 37rpx;
  font-weight: 800;
  line-height: 1;
}
.home-challenge-ring-inner image { width: 45rpx; height: 45rpx; margin-bottom: 6rpx; }
.home-challenge-ring-unit { font-size: 21rpx; }
.home-challenge-main { flex: 1; min-width: 0; padding-right: 20rpx; }
.home-challenge-name { color: #082f27; font-size: 29rpx; font-weight: 750; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.home-challenge-sub { margin: 9rpx 0 27rpx; color: #819088; font-size: 23rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.home-challenge-progress { width: 100%; height: 24rpx; border-radius: 20rpx; background: #e8eae8; overflow: hidden; }
.home-challenge-progress > view { height: 100%; border-radius: inherit; background: #075b40; transition: width 0.4s ease; }
.home-challenge-remaining {
  width: 120rpx;
  min-height: 156rpx;
  flex: none;
  border-left: 1rpx solid #e2e9e4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #87928d;
  font-size: 23rpx;
  line-height: 1.4;
  white-space: nowrap;
}
.home-challenge-remaining-number { color: #0b503b; font-size: 58rpx; font-weight: 800; line-height: 1.1; }

.home-month-calendar {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf2ee;
}
.home-heatmap-weekdays {
  display: flex;
  justify-content: space-between;
  padding: 0 0 8rpx;
}
.home-heatmap-weekdays text {
  flex: 1;
  text-align: center;
  font-size: 19rpx;
  font-weight: 300;
  color: #8fa096;
}
.home-heatmap-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}
.home-heatmap-cell {
  width: calc((100% - 36rpx) / 7);
  height: 36rpx;
  border-radius: 11rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
}
.home-heatmap-cell.is-empty {
  background: transparent;
  pointer-events: none;
}
.home-heatmap-cell.is-future {
  background: transparent;
  pointer-events: none;
}
.home-heatmap-cell.is-future .cell-day-num {
  color: #cad6ce;
}
.home-heatmap-cell.level-0 {
  background: #f1f5f2;
}
.home-heatmap-cell.level-0 .cell-day-num {
  color: #4a6356;
}
.home-heatmap-cell.is-other-month.level-0 {
  background: #f7faf7;
}
.home-heatmap-cell.is-other-month .cell-day-num {
  color: #a4b3aa;
  opacity: 0.75;
}
.home-heatmap-cell.level-1 {
  background: #aae98f;
}
.home-heatmap-cell.level-1 .cell-day-num {
  color: #0b3d1b;
}
.home-heatmap-cell.level-2 {
  background: #50cf64;
}
.home-heatmap-cell.level-2 .cell-day-num {
  color: #042e13;
}
.home-heatmap-cell.level-3 {
  background: #199c4f;
}
.home-heatmap-cell.level-3 .cell-day-num {
  color: #ffffff;
}
.home-heatmap-cell.level-4 {
  background: #075b40;
}
.home-heatmap-cell.level-4 .cell-day-num {
  color: #ffffff;
}
.cell-day-num {
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1;
}
.cell-run {
  display: flex;
  align-items: baseline;
  justify-content: center;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  font-variant-numeric: tabular-nums;
}
.cell-run-value { font-size: 19rpx; font-weight: 750; line-height: 1; }
.cell-run-unit { margin-left: 2rpx; font-size: 11rpx; font-weight: 600; line-height: 1; }
.cell-run.is-condensed .cell-run-value { font-size: 13rpx; }
.home-heatmap-cell.level-1 .cell-run,
.home-heatmap-cell.level-2 .cell-run { color: #0b3d1b; }
.home-heatmap-cell.level-3 .cell-run,
.home-heatmap-cell.level-4 .cell-run { color: #ffffff; }

/* 跑友动态：现代化社区打卡卡片 */
.home-friends {
  margin-top: 68rpx;
  padding-top: 36rpx;
  border-top: 1rpx solid #e2e9e4;
}
.home-friends-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  min-height: 56rpx;
}
.home-friends-head-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}
.home-friends-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #073329;
  letter-spacing: -0.5rpx;
  line-height: 1.2;
}
.home-friends-count {
  font-size: 22rpx;
  color: #849087;
  font-weight: 500;
  white-space: nowrap;
}
.home-rank-entry {
  display: inline-flex;
  align-items: center;
  flex: none;
  background: #f1f6ed;
  border: 1rpx solid #dbe6d7;
  border-radius: 999rpx;
  padding: 8rpx 16rpx 8rpx 14rpx;
  box-sizing: border-box;
  transition: all 0.15s ease;
}
.home-rank-entry-active {
  background: #e4eed8;
  border-color: #c5dc9f;
  transform: scale(0.98);
}
.home-rank-trophy {
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
  flex: none;
}
.home-rank-title {
  font-size: 24rpx;
  font-weight: 750;
  color: #103d2e;
  line-height: 1;
}
.home-rank-entry-divider {
  width: 2rpx;
  height: 20rpx;
  background: #cbd8c8;
  margin: 0 10rpx;
  flex: none;
}
.home-rank-entry-tabs {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  line-height: 1;
}
.home-rank-tab-btn {
  color: #38634a;
  font-weight: 650;
  padding: 4rpx 4rpx;
  border-radius: 6rpx;
  transition: background 0.15s ease, color 0.15s ease;
}
.home-rank-tab-btn:active {
  color: #0a3a19;
  background: #d9ff3f;
  font-weight: 800;
}
.home-rank-tab-dot {
  color: #9cb0a2;
  margin: 0 2rpx;
  font-weight: 600;
}
.home-rank-entry-arrow {
  width: 20rpx;
  height: 20rpx;
  margin-left: 6rpx;
  opacity: 0.6;
  flex: none;
}
.home-friends-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.home-friend-card {
  background: #ffffff;
  border: 1rpx solid #e3ebe4;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  transition: transform 0.2s ease, background 0.2s ease;
}
.home-friend-card-active {
  transform: scale(0.985);
  background: #fafcfa;
}
.home-friend-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.home-friend-person { display: flex; align-items: center; min-width: 0; }
.home-friend-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex: none;
  border: 2rpx solid #e1e9e3;
  background: #e6ece6;
  display: block;
}
.home-friend-identity {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
  min-width: 0;
}
.home-friend-name {
  color: #072f27;
  font-size: 28rpx;
  font-weight: 750;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.home-friend-date {
  color: #89958e;
  font-size: 21rpx;
  margin-top: 4rpx;
  line-height: 1.2;
}
.home-friend-badge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #f1f5f2;
  border: 1rpx solid #e2ece5;
  font-size: 20rpx;
  font-weight: 600;
  color: #0b503b;
  flex: none;
}
.home-friend-card-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f6f2;
}
.home-friend-metrics {
  display: flex;
  align-items: flex-end;
  flex: 1;
  min-width: 0;
}
.home-friend-metric-col {
  display: flex;
  flex-direction: column;
}
.metric-val-big {
  color: #063d2d;
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -2rpx;
}
.metric-val-med {
  color: #072f27;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
}
.metric-lbl {
  color: #89958e;
  font-size: 20rpx;
  margin-top: 8rpx;
  white-space: nowrap;
}
.metric-divider {
  width: 1rpx;
  height: 52rpx;
  background: #e6eee7;
  margin: 0 28rpx;
  flex: none;
  align-self: center;
}
.home-friend-proof-wrap {
  position: relative;
  width: 130rpx;
  height: 100rpx;
  border-radius: 14rpx;
  overflow: hidden;
  flex: none;
  border: 1rpx solid #e0eae2;
  background: #edf2ee;
}
.home-friend-proof-img {
  width: 100%;
  height: 100%;
  display: block;
}
.home-friend-proof-tag {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 28rpx;
  line-height: 28rpx;
  background: rgba(7, 47, 39, 0.65);
  color: #ffffff;
  font-size: 15rpx;
  font-weight: 500;
  text-align: center;
}
.home-friends-empty { padding: 55rpx 0 30rpx; color: #89958e; font-size: 26rpx; }

.home-calendar-error-wrap {
  padding: 36rpx 0;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
}
.home-calendar-error-text {
  font-size: 24rpx;
  color: #c94040;
  font-weight: 600;
}
