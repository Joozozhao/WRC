<site-header show-back="{{true}}" back-url="/pages/challenge/challenge"></site-header>
<!-- WRC Create Challenge: 创建挑战 -->
<view class="edit-page">
  <form bindsubmit="submit">
    <view class="edit-header">
      <text class="eyebrow">WRC · CHALLENGE</text>
      <text class="page-title">创建挑战</text>
      <text class="page-subtitle">设置挑战时间、距离与奖励，邀请跑友一起完成目标</text>
    </view>

    <!-- 01 挑战封面 -->
    <view class="form-card">
      <view class="card-badge">01 / 挑战封面</view>
      <view class="cover-uploader {{addView?'show':'hide'}}" bindtap="uploadAction">
        <view class="uploader-icon">🏁</view>
        <text class="uploader-title">点击上传挑战封面</text>
        <text class="uploader-sub">建议使用清晰横版跑步照片</text>
      </view>
      <view class="cover-preview-box {{showView?'show':'hide'}}">
        <image class="cover-image" src="{{tempFilePaths}}" mode="aspectFill" bindtap="uploadAction"></image>
        <view class="cover-actions">
          <view class="cover-btn change-btn" bindtap="uploadAction">重新选择</view>
          <view class="cover-btn delete-btn" bindtap="delete">删除</view>
        </view>
      </view>
    </view>

    <!-- 02 挑战信息 -->
    <view class="form-card">
      <view class="card-badge">02 / 挑战信息</view>

      <view class="switch-row" bindtap="special">
        <view class="switch-info">
          <text class="switch-title">特别版挑战</text>
          <text class="switch-sub">开启后创建 V 挑战</text>
        </view>
        <switch name="switch" checked="{{special}}" color="#075b40" />
      </view>

      <view class="form-group">
        <label class="form-label">活动名称</label>
        <input class="form-input" type="text" focus="{{focus}}" value="{{actyName}}" name="actyName" placeholder="请输入活动名称" placeholder-class="placeholder-text" />
      </view>

      <view class="form-group" bindtap="pickerShow">
        <label class="form-label">起止时间</label>
        <view class="time-display-box">
          <view class="time-item">
            <text class="time-sub">开始</text>
            <text class="time-val"><block wx:if="{{startTime}}">{{startTime}}</block><block wx:else>点击选择开始时间</block></text>
          </view>
          <text class="time-arrow">→</text>
          <view class="time-item">
            <text class="time-sub">结束</text>
            <text class="time-val"><block wx:if="{{endTime}}">{{endTime}}</block><block wx:else>点击选择结束时间</block></text>
          </view>
        </view>
      </view>

      <view class="form-group">
        <label class="form-label">挑战距离 (公里)</label>
        <input class="form-input" type="digit" focus="{{focus}}" value="{{distance}}" name="distance" placeholder="请输入挑战距离" placeholder-class="placeholder-text" />
      </view>

      <view class="form-group">
        <label class="form-label">挑战奖励</label>
        <radio-group name="stype" class="reward-group">
          <label class="reward-chip {{stype === 0 ? 'active' : ''}}" bindtap="choose">
            <radio value="0" checked="{{stype === 0 ? 'true' : ''}}" color="#075b40" />积分
          </label>
          <label class="reward-chip {{stype === 1 ? 'active' : ''}}" bindtap="choose2">
            <radio value="1" checked="{{stype === 1 ? 'true' : ''}}" color="#075b40" />小花儿
          </label>
          <input class="reward-input" type="digit" name="score" value="{{score}}" placeholder="数量" placeholder-class="placeholder-text" />
        </radio-group>
      </view>

      <view class="form-group">
        <label class="form-label">挑战说明</label>
        <textarea class="form-textarea" name="remark" focus="{{focus}}" maxlength="-1" placeholder="请输入挑战说明" placeholder-class="placeholder-text" value="{{remark}}"></textarea>
      </view>
    </view>

    <!-- 03 报名填写项 -->
    <view class="form-card">
      <view class="card-badge">03 / 报名填写项</view>
      <view class="switch-row">
        <view class="switch-info">
          <text class="switch-title">跑友真实姓名</text>
          <text class="switch-sub">报名必需项，系统默认开启</text>
        </view>
        <switch name="switch" checked="true" disabled color="#075b40" />
      </view>
      <view class="switch-row border-top" bindtap="checkOr">
        <view class="switch-info">
          <text class="switch-title">联系手机号码</text>
          <text class="switch-sub">开启后，跑友报名时需要提供手机号</text>
        </view>
        <switch name="switch" checked="{{checkOr}}" color="#075b40" />
      </view>
    </view>

    <!-- 底部固定操作栏 -->
    <view class="bottom-action-bar">
      <button class="primary-submit-btn" form-type="submit" disabled="{{disable}}" hover-class="btn-pressed">完成创建</button>
    </view>
  </form>
</view>

<time-picker pickerShow="{{isPickerShow}}" id="picker" wx:if="{{isPickerRender}}" bind:hidePicker="pickerHide" bind:setPickerTime="setPickerTime" config="{{pickerConfig}}"></time-picker>
