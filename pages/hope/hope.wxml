<site-header show-back="{{true}}" back-url="/pages/index/index"></site-header>
<!--pages/hope/hope.wxml-->
<view class="hope-page">
  <view class="hope-hero">
    <text class="hope-eyebrow">WRC · WISHES</text>
    <text class="hope-title">心愿墙</text>
    <view class="hope-title-line"></view>
    <text class="hope-intro">写下想要的奖励，让每一步都有期待</text>
  </view>

  <view class="hope-waterfall" wx:if="{{hopeList.length}}">
    <view class="hope-list">
      <view class="hope-item" wx:for="{{hopeList}}" wx:key="index" wx:if="{{index%2==0}}">
        <view class="hope-pic">
          <image src="{{item.hopePic}}" mode="aspectFill"></image>
        </view>
        <view class="hope-name">{{item.hopeName}}</view>
        <view class="hope-meta">
          <view class="hope-want" wx:if="{{item.hopeNum==0}}"><image src="/images/heart0.svg" class="hope-ico"></image><text>想要</text></view>
          <view class="hope-want" wx:else><image src="/images/heart.svg" class="hope-ico"></image><text>{{item.hopeNum}}</text></view>
        </view>
      </view>
    </view>
    <view class="hope-list">
      <view class="hope-item" wx:for="{{hopeList}}" wx:key="index" wx:if="{{index%2==1}}">
        <view class="hope-pic">
          <image src="{{item.hopePic}}" mode="aspectFill"></image>
        </view>
        <view class="hope-name">{{item.hopeName}}</view>
        <view class="hope-meta">
          <view class="hope-want" wx:if="{{item.hopeNum==0}}"><image src="/images/heart0.svg" class="hope-ico"></image><text>想要</text></view>
          <view class="hope-want" wx:else><image src="/images/heart.svg" class="hope-ico"></image><text>{{item.hopeNum}}</text></view>
        </view>
      </view>
    </view>
  </view>
  <view class="hope-state" wx:else>心愿墙暂未开放，敬请期待</view>
</view>
<view class="hope-footer">
  <button class="hope-submit" disabled="true">暂未开放</button>
</view>
